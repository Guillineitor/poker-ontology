# =============================================================================
# Ontología de baraja: baraja_13r_12p
# Generada automáticamente por generador_ontologias.py
# =============================================================================
#
# Esta ontología modela la estructura de una baraja de cartas de tipo 'baraja_13r_12p'
# en OWL 2 DL. El dominio cubre palos, rangos, cartas y la clasificación de
# manos de cinco cartas. Otros aspectos del juego quedan fuera del alcance.
#
# =============================================================================
 
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_12p#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
 
# -----------------------------------------------------------------------------
# OWL trabaja bajo Open World Assumption (OWA): lo que no está afirmado es
# desconocido, no necesariamente falso. Sin intervención explícita, el razonador
# podría asumir la existencia de palos o rangos adicionales no declarados.
#
# Para evitarlo, Palo y Rango se cierran con owl:oneOf, fijando exactamente
# los individuos posibles. Los 156 individuos de cartas se declaran
# además AllDifferent para que el razonador los trate como entidades distintas
# y no intente unificarlas.
# -----------------------------------------------------------------------------
 
<http://www.ontologia-baraja.org/baraja_13r_12p>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de baraja baraja_13r_12p" ;
    rdfs:comment "Ontología OWL 2 DL que modela la baraja 'baraja_13r_12p' (12 palos x 13 rangos = 156 cartas)." ;
    owl:versionInfo "2.0.0" .


# =============================================================================
# Palos y Rangos
# =============================================================================

# Definición de la clase Palo.
# Palo se cierra con owl:oneOf para que el razonador no asuma palos adicionales.
poker:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Fuego poker:Agua poker:Planta poker:Electrico poker:Normal poker:Volador poker:Bicho poker:Veneno poker:Tierra poker:Roca poker:Lucha poker:Psiquico )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Fuego, Agua, Planta, Electrico, Normal, Volador, Bicho, Veneno, Tierra, Roca, Lucha, Psiquico." .

# Definición de la clase Rango.
# Rango se cierra con owl:oneOf para que el razonador no asuma rangos adicionales.
poker:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Uno poker:Dos poker:Tres poker:Cuatro poker:Cinco poker:Seis poker:Siete poker:Ocho poker:Nueve poker:Diez poker:Once poker:Doce poker:Trece )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Uno, Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Once, Doce, Trece." .

# Definición de la clase Carta.
# Cada carta tiene exactamente un palo y un rango, garantizado por las FunctionalProperty definidas más adelante.
poker:Carta a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:someValuesFrom poker:Palo
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:tieneRango ;
        owl:someValuesFrom poker:Rango
    ] ;
    rdfs:label "Carta" ;
    rdfs:comment "Una carta de la baraja, caracterizada por un palo y un rango únicos." .

# Subclases de Carta por palo.
# Se usan en los clasificadores de Color y Escalera de Color.
poker:CartaDeFuego a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Fuego
    ] ;
    rdfs:label "Carta de Fuego" ;
    rdfs:comment "Una carta de la baraja del palo de Fuego." .

poker:CartaDeAgua a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Agua
    ] ;
    rdfs:label "Carta de Agua" ;
    rdfs:comment "Una carta de la baraja del palo de Agua." .

poker:CartaDePlanta a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Planta
    ] ;
    rdfs:label "Carta de Planta" ;
    rdfs:comment "Una carta de la baraja del palo de Planta." .

poker:CartaDeElectrico a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Electrico
    ] ;
    rdfs:label "Carta de Eléctrico" ;
    rdfs:comment "Una carta de la baraja del palo de Eléctrico." .

poker:CartaDeNormal a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Normal
    ] ;
    rdfs:label "Carta de Normal" ;
    rdfs:comment "Una carta de la baraja del palo de Normal." .

poker:CartaDeVolador a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Volador
    ] ;
    rdfs:label "Carta de Volador" ;
    rdfs:comment "Una carta de la baraja del palo de Volador." .

poker:CartaDeBicho a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Bicho
    ] ;
    rdfs:label "Carta de Bicho" ;
    rdfs:comment "Una carta de la baraja del palo de Bicho." .

poker:CartaDeVeneno a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Veneno
    ] ;
    rdfs:label "Carta de Veneno" ;
    rdfs:comment "Una carta de la baraja del palo de Veneno." .

poker:CartaDeTierra a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Tierra
    ] ;
    rdfs:label "Carta de Tierra" ;
    rdfs:comment "Una carta de la baraja del palo de Tierra." .

poker:CartaDeRoca a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Roca
    ] ;
    rdfs:label "Carta de Roca" ;
    rdfs:comment "Una carta de la baraja del palo de Roca." .

poker:CartaDeLucha a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Lucha
    ] ;
    rdfs:label "Carta de Lucha" ;
    rdfs:comment "Una carta de la baraja del palo de Lucha." .

poker:CartaDePsiquico a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Psiquico
    ] ;
    rdfs:label "Carta de Psíquico" ;
    rdfs:comment "Una carta de la baraja del palo de Psíquico." .

# Subclases de Carta por rango.
# Se usan en los clasificadores de Par, Trío y Póker.
poker:CartaDeUno a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Uno ] ;
    rdfs:label "Carta de Uno" .

poker:CartaDeDos a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Dos ] ;
    rdfs:label "Carta de Dos" .

poker:CartaDeTres a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Tres ] ;
    rdfs:label "Carta de Tres" .

poker:CartaDeCuatro a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cuatro ] ;
    rdfs:label "Carta de Cuatro" .

poker:CartaDeCinco a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cinco ] ;
    rdfs:label "Carta de Cinco" .

poker:CartaDeSeis a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Seis ] ;
    rdfs:label "Carta de Seis" .

poker:CartaDeSiete a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Siete ] ;
    rdfs:label "Carta de Siete" .

poker:CartaDeOcho a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Ocho ] ;
    rdfs:label "Carta de Ocho" .

poker:CartaDeNueve a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Nueve ] ;
    rdfs:label "Carta de Nueve" .

poker:CartaDeDiez a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Diez ] ;
    rdfs:label "Carta de Diez" .

poker:CartaDeOnce a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Once ] ;
    rdfs:label "Carta de Once" .

poker:CartaDeDoce a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Doce ] ;
    rdfs:label "Carta de Doce" .

poker:CartaDeTrece a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Trece ] ;
    rdfs:label "Carta de Trece" .


# =============================================================================
# Tipos de Mano
# =============================================================================
#
# Jerarquía de menor a mayor valor de las manos posibles con esta baraja:
#
#   Mano
#   ├── CartaAlta      (1) Sin combinación; gana la carta más alta
#   ├── Par            (2) Dos cartas del mismo rango
#   ├── DoblePar       (3) Dos pares de rangos distintos
#   ├── Trio           (4) Tres cartas del mismo rango
#   ├── Escalera       (5) Cinco cartas de rangos consecutivos
#   ├── Color          (6) Cinco cartas del mismo palo
#   ├── Full           (7) Un trío más un par de rangos distintos
#   ├── Poker          (8) Cuatro cartas del mismo rango
#   ├── EscaleraColor  (9) Cinco cartas consecutivas del mismo palo
#   ├── EscaleraReal   (10) Los cinco rangos más altos del mismo palo
#
# Decisión de diseño: los tipos de mano no se declaran disjuntos entre sí.
# Si bien en el juego real esto es así, la ontología busca evaluar la capacidad
# de los razonadores OWL frente a ontologías suficientemente complejas. Una
# versión con clases disjuntas queda para trabajo futuro.
# =============================================================================

# Definición de la clase Mano.
poker:Mano a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:contieneCarta ;
        owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass poker:Carta
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:contieneCarta ;
        owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass poker:Carta
    ] ;
    rdfs:label "Mano" ;
    rdfs:comment "La mejor combinación de 5 cartas que puede formar un jugador con la baraja." .

# Definición de la clase CartaAlta.
# Mano sin una combinación específica; gana la carta más alta. La definición es simple
# a propósito: al no declarar las manos como clases disjuntas, técnicamente cualquier
# tipo de mano podría clasificarse también como CartaAlta.
poker:CartaAlta a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Restriction ;
                owl:onProperty poker:contieneCarta ;
                owl:someValuesFrom poker:Carta
            ]
        )
    ] ;
    rdfs:subClassOf poker:Mano ;
    rdfs:label "Carta Alta" ;
    rdfs:comment "Mano formada sin combinación; la carta más alta decide el ganador." .

# Definición de la clase Par.
# Mano que contiene dos cartas del mismo rango. Se usa unionOf sobre las subclases
# de rango porque OWL DL 2 no puede expresar «mismo rango» de forma genérica.
poker:Par a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeUno ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOnce ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDoce ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTrece ]
                )
            ]
        )
    ] ;
    rdfs:label "Par" ;
    rdfs:comment "Mano formada por dos cartas del mismo rango más tres cartas de rangos distintos." .

# Definición de la clase DoblePar.
# Mano que contiene dos pares de cartas de distintos rangos. Usa la propiedad auxiliar
# manoTienePar, que se agrega manualmente en la ABox. OWL DL 2 no puede contar pares
# «distintos» de forma nativa, así que se delega parte del trabajo al momento de
# instanciar la mano.
poker:DoblePar a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [ a owl:Restriction ;
              owl:onProperty poker:manoTienePar ;
              owl:minCardinality "2"^^xsd:nonNegativeInteger ]
        )
    ] ;
    rdfs:label "Doble Par" ;
    rdfs:comment "Mano formada por dos pares de rangos distintos, independientemente del palo." .

# Definición de la clase Trio.
# Mano que contiene tres cartas del mismo rango. Se usa unionOf sobre las subclases
# de rango porque OWL DL 2 no puede expresar «mismo rango» de forma genérica.
poker:Trio a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeUno ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOnce ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDoce ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTrece ]
                )
            ]
        )
    ] ;
    rdfs:label "Trío" ;
    rdfs:comment "Mano formada por tres cartas del mismo rango y otras dos cartas distintas." .

# Definición de la clase Escalera.
# Mano que contiene cinco cartas con rangos consecutivos, puede ser de palos distintos.
# Se enumeran todas las ventanas posibles de cinco rangos consecutivos.
# No hay forma de expresar «consecutivos» en OWL DL 2 sin esta enumeración.
poker:Escalera a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Escalera Uno-Dos-Tres-Cuatro-Cinco.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeUno ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                    )]
                    # Escalera Dos-Tres-Cuatro-Cinco-Seis.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                    )]
                    # Escalera Tres-Cuatro-Cinco-Seis-Siete.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                    )]
                    # Escalera Cuatro-Cinco-Seis-Siete-Ocho.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                    )]
                    # Escalera Cinco-Seis-Siete-Ocho-Nueve.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                    )]
                    # Escalera Seis-Siete-Ocho-Nueve-Diez.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                    )]
                    # Escalera Siete-Ocho-Nueve-Diez-Once.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOnce ]
                    )]
                    # Escalera Ocho-Nueve-Diez-Once-Doce.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDoce ]
                    )]
                    # Escalera Nueve-Diez-Once-Doce-Trece.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTrece ]
                    )]
                )
            ]
        )
    ] ;
    rdfs:label "Escalera" ;
    rdfs:comment "Mano formada por cinco cartas de rangos consecutivos, no necesariamente del mismo palo." .

# Definición de la clase Color.
# Mano que contiene cinco cartas del mismo palo, con rangos distintos.
# Se usa allValuesFrom porque la condición exige que todas las cartas sean del mismo palo.
poker:Color a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeFuego ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeAgua ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDePlanta ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeElectrico ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeNormal ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeVolador ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeBicho ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeVeneno ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeTierra ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeRoca ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeLucha ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDePsiquico ]
                )
            ]
        )
    ] ;
    rdfs:label "Color" ;
    rdfs:comment "Mano formada por cinco cartas del mismo palo, no necesariamente consecutivas entre sí." .

# Definición de la clase Full.
# Mano que contiene un trío más un par de rangos distintos. Al no declarar las manos
# como clases disjuntas, Full puede definirse como la intersección de Trio y DoblePar,
# lo que es conceptualmente correcto y evita duplicar restricciones.
poker:Full a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Trio
            poker:DoblePar
        )
    ] ;
    rdfs:label "Full" ;
    rdfs:comment "Mano formada por tres cartas del mismo rango y dos cartas de otro mismo rango." .

# Definición de la clase Poker.
# Mano que contiene cuatro cartas del mismo rango. Se usa unionOf sobre las subclases
# de rango porque OWL DL 2 no puede expresar «mismo rango» de forma genérica.
poker:Poker a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeUno ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOnce ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDoce ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTrece ]
                )
            ]
        )
    ] ;
    rdfs:label "Póker" ;
    rdfs:comment "Mano formada por cuatro cartas del mismo rango y una carta cualquiera." .

# Definición de la clase EscaleraColor.
# Mano que contiene cinco cartas consecutivas del mismo palo. Se define como la
# intersección de Escalera y Color, lo que es conceptualmente correcto y evita
# enumerar todas las combinaciones posibles de secuencia y palo.
poker:EscaleraColor a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Escalera
            poker:Color
        )
    ] ;
    rdfs:label "Escalera de Color" ;
    rdfs:comment "Mano formada por cinco cartas consecutivas del mismo palo." .

# Definición de la clase EscaleraReal.
# Caso especial de EscaleraColor con los cinco rangos más altos (Nueve-Diez-Once-Doce-Trece).
# Se define como la intersección de EscaleraColor con la presencia obligatoria
# de cada uno de esos cinco rangos.
poker:EscaleraReal a owl:Class ;
    rdfs:subClassOf poker:EscaleraColor ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:EscaleraColor
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOnce ]
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDoce ]
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTrece ]
        )
    ] ;
    rdfs:label "Escalera Real" ;
    rdfs:comment "Mano formada por los cinco rangos más altos consecutivos (Nueve-Diez-Once-Doce-Trece) del mismo palo." .

 
# =============================================================================
# Propiedades de Objeto
# =============================================================================
 
# Definición de la propiedad tienePalo.
# Propiedad que indica que cada carta tiene exactamente un palo.
poker:tienePalo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Carta ;
    rdfs:range  poker:Palo ;
    rdfs:label  "Tiene Palo" ;
    rdfs:comment "Propiedad que asocia una carta con su palo. Funcional: cada carta tiene exactamente un palo." .
 
# Definición de la propiedad tieneRango.
# Propiedad que indica que cada carta tiene exactamente un rango.
poker:tieneRango a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Carta ;
    rdfs:range  poker:Rango ;
    rdfs:label  "Tiene Rango" ;
    rdfs:comment "Propiedad que asocia una carta con su rango. Funcional: cada carta tiene exactamente un rango." .
 
# Definición de la propiedad contieneCarta.
# Propiedad que indica que una mano contiene cierta carta.
poker:contieneCarta a owl:ObjectProperty ;
    rdfs:domain poker:Mano ;
    rdfs:range  poker:Carta ;
    rdfs:label  "Contiene Carta" ;
    rdfs:comment "Propiedad que relaciona una mano con cada una de las cartas que la componen." .
 
# Definición de la propiedad manoTienePar.
# manoTienePar es una propiedad auxiliar para el clasificador de DoblePar.
# OWL DL 2 no puede contar cuántos rangos distintos tienen cardinalidad mayor o igual a 2,
# así que esta propiedad se agrega manualmente en la ABox al instanciar cada mano.
# La explicación está detallada en la definición de la clase DoblePar.
poker:manoTienePar a owl:ObjectProperty ;
    rdfs:domain poker:Mano ;
    rdfs:range  poker:Rango ;
    rdfs:label  "Mano tiene Par" ;
    rdfs:comment "Indica qué rangos están presentes con al menos 2 cartas en la mano. Se agrega manualmente en la ABox; usado por el clasificador de DoblePar." .

