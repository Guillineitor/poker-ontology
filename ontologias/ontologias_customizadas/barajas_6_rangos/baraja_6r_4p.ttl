# --- Unicidad de individuos ---
# AllDifferent es necesario porque OWL DL 2 no asume distinción entre individuos
# por defecto (Unique Name Assumption no aplica en OWL). Aplica para palos, rangos y cartas.
 
# 4 palos distintos.
[] a owl:AllDifferent ;
    owl:distinctMembers ( poker:Fuego poker:Agua poker:Planta poker:Electrico ) .
 
# 6 rangos distintos.
[] a owl:AllDifferent ;
    owl:distinctMembers ( poker:Uno poker:Dos poker:Tres poker:Cuatro poker:Cinco poker:Seis ) .
 
# 24 cartas distintas.
[] a owl:AllDifferent ;
    owl:distinctMembers (
        poker:UnoDeFuego poker:DosDeFuego poker:TresDeFuego poker:CuatroDeFuego poker:CincoDeFuego poker:SeisDeFuego
        poker:UnoDeAgua poker:DosDeAgua poker:TresDeAgua poker:CuatroDeAgua poker:CincoDeAgua poker:SeisDeAgua
        poker:UnoDePlanta poker:DosDePlanta poker:TresDePlanta poker:CuatroDePlanta poker:CincoDePlanta poker:SeisDePlanta
        poker:UnoDeElectrico poker:DosDeElectrico poker:TresDeElectrico poker:CuatroDeElectrico poker:CincoDeElectrico poker:SeisDeElectrico
    ) .
