poker:CartaDeVeinte a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Veinte ] ;
    rdfs:label "Carta de Veinte" .

poker:CartaDeVeintiuno a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Veintiuno ] ;
    rdfs:label "Carta de Veintiuno" .

poker:CartaDeVeintidos a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Veintidos ] ;
