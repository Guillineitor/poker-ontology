poker:CartaDeDieciseis a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Dieciseis ] ;
    rdfs:label "Carta de Dieciseis" .

poker:CartaDeDiecisiete a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Diecisiete ] ;
