# =============================================================================
# Ontología de baraja: baraja_31r_16p
# Generada automáticamente por generador_ontologias.py
# =============================================================================
#
# Esta ontología modela la estructura de una baraja de cartas de tipo 'baraja_31r_16p'
# en OWL 2 DL. El dominio cubre palos, rangos, cartas y la clasificación de
# manos de cinco cartas. Otros aspectos del juego quedan fuera del alcance.
#
# =============================================================================
 
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
 
# -----------------------------------------------------------------------------
# OWL trabaja bajo Open World Assumption (OWA): lo que no está afirmado es
# desconocido, no necesariamente falso. Sin intervención explícita, el razonador
# podría asumir la existencia de palos o rangos adicionales no declarados.
#
# Para evitarlo, Palo, Rango y Carta se cierran con owl:oneOf, fijando
# exactamente los individuos posibles. Los 496 individuos de cartas se
# declaran además AllDifferent para que el razonador los trate como entidades
# distintas y no intente unificarlas.
# -----------------------------------------------------------------------------
 
<http://www.ontologia-baraja.org/baraja_31r_16p>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de baraja baraja_31r_16p" ;
    rdfs:comment "Ontología OWL 2 DL que modela la baraja 'baraja_31r_16p' (16 palos x 31 rangos = 496 cartas)." ;
    owl:versionInfo "2.0.0" .


# =============================================================================
# Palos y Rangos
# =============================================================================

# Definición de la clase Palo.
# Palo se cierra con owl:oneOf para que el razonador no asuma palos adicionales.
poker:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Fuego poker:Agua poker:Planta poker:Electrico poker:Normal poker:Volador poker:Bicho poker:Veneno poker:Tierra poker:Roca poker:Lucha poker:Psiquico poker:Fantasma poker:Hielo poker:Dragon poker:Siniestro )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Fuego, Agua, Planta, Electrico, Normal, Volador, Bicho, Veneno, Tierra, Roca, Lucha, Psiquico, Fantasma, Hielo, Dragon, Siniestro." .

# Definición de la clase Rango.
# Rango se cierra con owl:oneOf para que el razonador no asuma rangos adicionales.
poker:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Uno poker:Dos poker:Tres poker:Cuatro poker:Cinco poker:Seis poker:Siete poker:Ocho poker:Nueve poker:Diez poker:Once poker:Doce poker:Trece poker:Catorce poker:Quince poker:Dieciseis poker:Diecisiete poker:Dieciocho poker:Diecinueve poker:Veinte poker:Veintiuno poker:Veintidos poker:Veintitres poker:Veinticuatro poker:Veinticinco poker:Veintiseis poker:Veintisiete poker:Veintiocho poker:Veintinueve poker:Treinta poker:Treintayuno )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Uno, Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Once, Doce, Trece, Catorce, Quince, Dieciseis, Diecisiete, Dieciocho, Diecinueve, Veinte, Veintiuno, Veintidos, Veintitres, Veinticuatro, Veinticinco, Veintiseis, Veintisiete, Veintiocho, Veintinueve, Treinta, Treintayuno." .

