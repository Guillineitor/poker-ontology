# =============================================================================
# Ontología de baraja: baraja_37r_4p
# Generada automáticamente por generador_ontologias.py
# =============================================================================
#
# Esta ontología modela la estructura de una baraja de cartas de tipo 'baraja_37r_4p'
# en OWL 2 DL. El dominio cubre palos, rangos, cartas y la clasificación de
# manos de cinco cartas. Otros aspectos del juego quedan fuera del alcance.
#
# =============================================================================
 
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_4p#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
 
# -----------------------------------------------------------------------------
# OWL trabaja bajo Open World Assumption (OWA): lo que no está afirmado es
# desconocido, no necesariamente falso. Sin intervención explícita, el razonador
# podría asumir la existencia de palos o rangos adicionales no declarados.
#
# Para evitarlo, Palo y Rango se cierran con owl:oneOf, fijando exactamente
# los individuos posibles. Los 148 individuos de cartas se declaran
# además AllDifferent para que el razonador los trate como entidades distintas
# y no intente unificarlas.
# -----------------------------------------------------------------------------
 
<http://www.ontologia-baraja.org/baraja_37r_4p>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de baraja baraja_37r_4p" ;
    rdfs:comment "Ontología OWL 2 DL que modela la baraja 'baraja_37r_4p' (4 palos x 37 rangos = 148 cartas)." ;
    owl:versionInfo "2.0.0" .


# =============================================================================
# Palos y Rangos
# =============================================================================

# Definición de la clase Palo.
# Palo se cierra con owl:oneOf para que el razonador no asuma palos adicionales.
poker:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Fuego poker:Agua poker:Planta poker:Electrico )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Fuego, Agua, Planta, Electrico." .

# Definición de la clase Rango.
# Rango se cierra con owl:oneOf para que el razonador no asuma rangos adicionales.
poker:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Uno poker:Dos poker:Tres poker:Cuatro poker:Cinco poker:Seis poker:Siete poker:Ocho poker:Nueve poker:Diez poker:Once poker:Doce poker:Trece poker:Catorce poker:Quince poker:Dieciseis poker:Diecisiete poker:Dieciocho poker:Diecinueve poker:Veinte poker:Veintiuno poker:Veintidos poker:Veintitres poker:Veinticuatro poker:Veinticinco poker:Veintiseis poker:Veintisiete poker:Veintiocho poker:Veintinueve poker:Treinta poker:Treintayuno poker:Treintaydos poker:Treintaytres poker:Treintaycuatro poker:Treintaycinco poker:Treintayseis poker:Treintaysiete )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Uno, Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Once, Doce, Trece, Catorce, Quince, Dieciseis, Diecisiete, Dieciocho, Diecinueve, Veinte, Veintiuno, Veintidos, Veintitres, Veinticuatro, Veinticinco, Veintiseis, Veintisiete, Veintiocho, Veintinueve, Treinta, Treintayuno, Treintaydos, Treintaytres, Treintaycuatro, Treintaycinco, Treintayseis, Treintaysiete." .

# Definición de la clase Carta.
# Cada carta tiene exactamente un palo y un rango, garantizado por las FunctionalProperty definidas más adelante.
poker:Carta a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:someValuesFrom poker:Palo
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:tieneRango ;
        owl:someValuesFrom poker:Rango
    ] ;
    rdfs:label "Carta" ;
    rdfs:comment "Una carta de la baraja, caracterizada por un palo y un rango únicos." .

# Subclases de Carta por palo.
# Se usan en los clasificadores de Color y Escalera de Color.
poker:CartaDeFuego a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Fuego
    ] ;
    rdfs:label "Carta de Fuego" ;
    rdfs:comment "Una carta de la baraja del palo de Fuego." .

poker:CartaDeAgua a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Agua
    ] ;
    rdfs:label "Carta de Agua" ;
    rdfs:comment "Una carta de la baraja del palo de Agua." .

poker:CartaDePlanta a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Planta
    ] ;
    rdfs:label "Carta de Planta" ;
    rdfs:comment "Una carta de la baraja del palo de Planta." .

poker:CartaDeElectrico a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Electrico
    ] ;
    rdfs:label "Carta de Electrico" ;
    rdfs:comment "Una carta de la baraja del palo de Electrico." .

# Subclases de Carta por rango.
# Se usan en los clasificadores de Par, Trío y Póker.
poker:CartaDeUno a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Uno ] ;
    rdfs:label "Carta de Uno" .

