# =============================================================================
# Ontología Base de Póker Texas Hold'em 
# =============================================================================
#
# Esta ontología modela la estructura del juego Póker Texas Hold'em en OWL 2 DL.
# El dominio de la ontología es la baraja de cartas que se usa en este popular juego, y 
# la clasificación de manos que se forman en las jugadas. Otros aspectos del juego, como las
# apuestas, rondas y posiciones no son el objetivo de esta ontología. 
#
# =============================================================================

@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# -----------------------------------------------------------------------------
# OWL trabaja bajo Open World Assumption (OWA), es decir, lo que no está afirmado es
# desconocido, no necesariamente falso. Eso significa que sin intervención externa,
# el razonador admitiría la existencia de un quinto palo o un decimocuarto
# rango que simplemente no se ha definido todavía.
#
# Para evitarlo, Palo, Rango y Carta se cierran con owl:oneOf, fijando
# exactamente los individuos posibles. Los 52 individuos de cartas se
# declaran además AllDifferent para que el razonador los trate como
# entidades distintas y no intente unificarlas como una misma carta.
# -----------------------------------------------------------------------------

<http://www.poker-ontology.org/poker>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de Póker" ;
    rdfs:comment "Ontología escrita en OWL 2 DL que modela el juego de Texas Hold'em Poker." ;
    owl:versionInfo "2.0.0" .


# =============================================================================
# Palos y Rangos
# =============================================================================

# Definición de la clase Palo.
# Palo se cierra con owl:oneOf para que el razonador no asuma palos adicionales.
poker:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Picas poker:Corazones poker:Diamantes poker:Treboles )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Picas, Corazones, Diamantes y Tréboles." .

# Definición de la clase Rango.
# Rango se cierra con owl:oneOf para que el razonador no asuma rangos adicionales.
poker:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Dos poker:Tres poker:Cuatro poker:Cinco poker:Seis poker:Siete poker:Ocho poker:Nueve poker:Diez poker:Jota poker:Reina poker:Rey poker:As )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Jota, Reina, Rey y As." .

# Definición de la clase Carta.
# Cada carta tiene exactamente un palo y un rango, garantizado por las FunctionalProperty definidas más adelante.
poker:Carta a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:someValuesFrom poker:Palo
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:tieneRango ;
        owl:someValuesFrom poker:Rango
    ] ;
    rdfs:label "Carta" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas." .


# Subclases de Carta por palo. Estas se usan más adelante en la ontología para el clasificador de manos de Color y
# Escalera de Color, para así restringir que todas las cartas sean del mismo palo.
poker:CartaDeCorazones a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Corazones
    ] ;
    rdfs:label "Carta de Corazones" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas, del palo de corazones." .

poker:CartaDeDiamantes a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Diamantes
    ] ;
    rdfs:label "Carta de Diamantes" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas, del palo de diamantes." .

poker:CartaDePicas a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Picas
    ] ;
    rdfs:label "Carta de Picas" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas, del palo de picas." .

poker:CartaDeTreboles a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Treboles
    ] ;
    rdfs:label "Carta de Tréboles" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas, del palo de tréboles." .


# Subclases de Carta por rango. Estas se usan más adelante en la ontología para los clasificadores de manos de Par,
# Trío y Póker, donde la condición es tener N cartas del mismo rango (dependiendo de la mano).
poker:CartaDeDos a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Dos ] ;
    rdfs:label "Carta de Dos" .

poker:CartaDeTres a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Tres ] ;
    rdfs:label "Carta de Tres" .

poker:CartaDeCuatro a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cuatro ] ;
    rdfs:label "Carta de Cuatro" .

poker:CartaDeCinco a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cinco ] ;
    rdfs:label "Carta de Cinco" .

poker:CartaDeSeis a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Seis ] ;
    rdfs:label "Carta de Seis" .

poker:CartaDeSiete a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Siete ] ;
    rdfs:label "Carta de Siete" .

poker:CartaDeOcho a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Ocho ] ;
    rdfs:label "Carta de Ocho" .

poker:CartaDeNueve a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Nueve ] ;
    rdfs:label "Carta de Nueve" .

poker:CartaDeDiez a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Diez ] ;
    rdfs:label "Carta de Diez" .

poker:CartaDeJota a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Jota ] ;
    rdfs:label "Carta de Jota" .

poker:CartaDeReina a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Reina ] ;
    rdfs:label "Carta de Reina" .

poker:CartaDeRey a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Rey ] ;
    rdfs:label "Carta de Rey" .

poker:CartaDeAs a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:As ] ;
    rdfs:label "Carta de As" .

# Disjunción explícita de subclases de Carta
# De por si ya son mutuamente disjuntas como consecuencia
# lógica de que tieneRango (que es FunctionalProperty) y los individuos de Rango son
# AllDifferent, pero esta disjunción ayuda a evitar que el razonador tenga que rehacer esa derivación en cada
# rama de los clasificadores que usan estas subclases en un owl:unionOf
# (como por ejemplo más adelante con las manos de tipos Par, Trío, Póker, Escalera), 
# lo cual importa a medida que crece la complejidad de la ontología.

[] a owl:AllDisjointClasses ;
    owl:members ( poker:CartaDePicas poker:CartaDeCorazones poker:CartaDeDiamantes poker:CartaDeTreboles ) .

[] a owl:AllDisjointClasses ;
    owl:members (
        poker:CartaDeDos poker:CartaDeTres poker:CartaDeCuatro poker:CartaDeCinco
        poker:CartaDeSeis poker:CartaDeSiete poker:CartaDeOcho poker:CartaDeNueve
        poker:CartaDeDiez poker:CartaDeJota poker:CartaDeReina poker:CartaDeRey poker:CartaDeAs
    ) .


# =============================================================================
# Tipos de Mano
# =============================================================================
#
# Jerarquía de menor a mayor valor de las manos a partir del juego de Póker Texas Hold'em:
#
#   Mano: La mejor combinación de 5 cartas seleccionada entre las cartas del jugador y las comunitarias del juego real.
#   ├── Carta Alta: Sin combinación; gana la carta más alta.
#   ├── Par: Contiene dos cartas del mismo rango.
#   ├── Doble Par: Contiene dos pares de cartas de distintos rangos.
#   ├── Trío: Contiene tres cartas del mismo rango.
#   ├── Escalera: Contiene cinco cartas con rangos consecutivos, puede ser con palos distintos.
#   ├── Color: Contiene cinco cartas del mismo palo, con rangos distintos.
#   ├── Full: Contiene un trío + par, de distintos rangos. 
#   ├── Poker: Contiene cuatro cartas del mismo rango.
#   └── Escalera de Color: Es una escalera pero con todas sus cartas del mismo palo.  
#         └── Escalera Real: Caso especial de la escalera de color, una mano de 10-J-Q-K-A del mismo palo.
#
# Decisión de Diseño: los tipos de mano no se declaran disjuntos entre sí
# en esta versión. Si bien en el juego real esto es así, la idea de la ontología es comprobar
# qué tan efectivos son los razonadores OWL frente a ontologías lo suficientemente complejas como 
# para obtener resultados en un plazo razonable. Una versión más compleja de esta ontología en donde 
# se declaren las manos como clases disjuntas queda para un trabajo futuro.
# =============================================================================

# Definición de la clase Mano.
poker:Mano a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:contieneCarta ;
        owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass poker:Carta
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:contieneCarta ;
        owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass poker:Carta
    ] ;
    rdfs:label "Mano" ;
    rdfs:comment "La mejor combinación de 5 cartas seleccionada entre las cartas del jugador y las comunitarias del juego Póker Texas Hold'em." .

# Definición de la clase CartaAlta.
# Mano sin una combinación específica; gana la carta más alta. La definición es simple a propósito, pues al no definir 
# las manos como clases disjuntas, técnicamente cualquier tipo de mano podría clasificarse como Carta Alta, 
# suficiente para esta ontología.
poker:CartaAlta a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Restriction ;
                owl:onProperty poker:contieneCarta ;
                owl:someValuesFrom poker:Carta
            ]
        )
    ] ;
    rdfs:subClassOf poker:Mano ;
    rdfs:label "Carta Alta" ;
    rdfs:comment "Mano formada sin combinación; la carta más alta decide el ganador." .

# Definición de la clase Par. 
# Mano que contiene dos cartas del mismo rango. Se usa unionOf sobre las 13
# subclases de rango porque OWL DL 2 no puede expresar "mismo rango" de forma genérica. 
poker:Par a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeJota ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeReina ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeRey ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeAs ]
                )
            ]
        )
    ] ;
    rdfs:label "Par" ;
    rdfs:comment "Mano formada por dos cartas del mismo rango más tres cartas adicionales de rango distinto de la pareja y distintas entre sí." .

# Definición de la clase DoblePar. 
# Mano que contiene dos pares de cartas de distintos rangos. Usa la propiedad auxiliar manoTienePar, 
# (definido más adelante) que se agrega manualmente en la ABox. Esto se debe a que OWL DL 2 no puede 
# contar pares "distintos" de forma nativa, así que se delega parte del trabajo al momento de
# instanciar la mano. De lo contrario, se tendría que definir un unionOf de todas las combinaciones posibles de pares distintos, 
# lo que vuelve más complejo la ontología de lo que se necesita para este trabajo.
poker:DoblePar a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [ a owl:Restriction ;
              owl:onProperty poker:manoTienePar ;
              owl:minCardinality "2"^^xsd:nonNegativeInteger ]
        )
    ] ;
    rdfs:label "Doble Par" ;
    rdfs:comment "Mano formada por dos pares de rangos distintos, independientemente del palo." .

# Definición de la clase Trio. 
# Mano que contiene tres cartas del mismo rango. Se usa unionOf sobre las 13
# subclases de rango porque OWL DL 2 no puede expresar "mismo rango" de forma genérica. 
poker:Trio a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeJota ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeReina ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeRey ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeAs ]
                )
            ]
        )
    ] ;
    rdfs:label "Trío" ;
    rdfs:comment "Mano formada por tres cartas del mismo rango y otras dos cartas distintas al trío y distintas entre sí." .

# Definición de la clase Escalera.
# Mano que contiene cinco cartas con rangos consecutivos, puede ser con palos distintos.
# En este caso, se enumeraron las 10 combinaciones posibles de rangos consecutivos.
# No hay forma de expresar "consecutivos" sin enumerar en OWL DL 2 sin especificar directamente qué cartas específicas están en la mano.
poker:Escalera a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # A-2-3-4-5 
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeAs ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                    )]
                    # 2-3-4-5-6
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                    )]
                    # 3-4-5-6-7
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                    )]
                    # 4-5-6-7-8
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                    )]
                    # 5-6-7-8-9
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                    )]
                    # 6-7-8-9-10
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                    )]
                    # 7-8-9-10-J
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
                    )]
                    # 8-9-10-J-Q
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeReina ]
                    )]
                    # 9-10-J-Q-K
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeReina ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeRey ]
                    )]
                    # 10-J-Q-K-A 
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeReina ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeRey ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeAs ]
                    )]
                )
            ]
        )
    ] ;
    rdfs:label "Escalera" ;
    rdfs:comment "Mano formada por cinco cartas de rangos consecutivos, no necesariamente del mismo palo." .

# Definición de la clase Color.
# Mano que contiene cinco cartas del mismo palo, con rangos distintos. Se usa unionOf sobre las 4 subclases de palo 
# porque OWL DL 2 no puede expresar "mismo palo" de forma genérica.
poker:Color a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCorazones ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiamantes ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDePicas ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTreboles ]
                )
            ]
        )
    ] ;
    rdfs:label "Color" ;
    rdfs:comment "Mano formada por cinco cartas del mismo palo, no necesariamente consecutivas entre sí." .

# Definición de la clase Full.
# Mano que contiene un trío + par, de distintos rangos. Al no ser las manos como clases disjuntas, se puede definir Full como 
# la intersección de Trío y DoblePar, lo que conceptualmente es correcto (pues se asegura un trío y un par de distintos rangos en la misma mano).
poker:Full a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Trio
            poker:DoblePar
        )
    ] ;
    rdfs:label "Full" ;
    rdfs:comment "Mano formada por tres cartas del mismo rango y dos cartas de otro mismo rango." .

# Definición de la clase Poker.
# Mano que contiene cuatro cartas del mismo rango. Se usa unionOf sobre las 13
# subclases de rango porque OWL DL 2 no puede expresar "mismo rango" de forma genérica.
poker:Poker a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeJota ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeReina ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeRey ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeAs ]
                )
            ]
        )
    ] ;
    rdfs:label "Póker" ;
    rdfs:comment "Mano formada por cuatro cartas del mismo rango y una carta cualquiera." .

# Definición de la clase EscaleraColor.
# Mano que contiene cinco cartas consecutivas del mismo palo. Se define como la intersección de Escalera y Color, 
# lo que conceptualmente es correcto (pues se asegura una escalera y un color en la misma mano).
poker:EscaleraColor a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Escalera
            poker:Color
        )
    ] ;
    rdfs:label "Escalera de Color" ;
    rdfs:comment "Mano formada por cinco cartas consecutivas del mismo palo." .

# Definición de la clase EscaleraReal.
# Mano que contiene cinco cartas consecutivas del mismo palo, siendo estas 10-J-Q-K-A. 
# Es un caso particular de la escalera de color. Se define como la intersección de EscaleraColor y 
# la presencia de las cinco cartas de más alto valor.
poker:EscaleraReal a owl:Class ;
    rdfs:subClassOf poker:EscaleraColor ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:EscaleraColor
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeReina ]
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeRey ]
            [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeAs ]
        )
    ] ;
    rdfs:label "Escalera Real" ;
    rdfs:comment "Mano formada por las cinco cartas de mayor rango consecutivas (10-J-Q-K-A)." .


# =============================================================================
# Propiedades de Objeto
# =============================================================================

# tienePalo y tieneRango son FunctionalProperty porque una carta no puede
# tener dos palos ni dos rangos simultáneamente. Esto, junto con owl:oneOf
# en Palo y Rango, garantiza que cada carta sea única en la ontología.

# Definición de la propiedad tienePalo.
# Propiedad que indica que cada carta tiene exactamente un palo.
poker:tienePalo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Carta ;
    rdfs:range poker:Palo ;
    rdfs:label "Tiene Palo" ;
    rdfs:comment "Propiedad que asocia una carta con su palo." .

# Definición de la propiedad tieneRango.
# Propiedad que indica que cada carta tiene exactamente un rango.
poker:tieneRango a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Carta ;
    rdfs:range poker:Rango ;
    rdfs:label "Tiene Rango" ;
    rdfs:comment "Propiedad que asocia una carta con su rango." .

# Definición de la propiedad tieneCarta.
# Propiedad que indica que una mano contiene cierta carta.
poker:contieneCarta a owl:ObjectProperty ;
    rdfs:domain poker:Mano ;
    rdfs:range poker:Carta ;
    rdfs:label "Contiene Carta" ;
    rdfs:comment "Propiedad que relaciona una mano con cada una de las cartas que la componen." .

# Definición de la propiedad manoTienePar.
# manoTienePar es una propiedad auxiliar para el clasificador de DoblePar.
# OWL DL 2 no puede contar cuántos rangos distintos tienen cardinalidad mayor o igual a 2 (u otro valor),
# así que esta propiedad se agrega manualmente en la ABox al instanciar
# cada mano. La explicación está detallada en la definición de la clase DoblePar.
poker:manoTienePar a owl:ObjectProperty ;
    rdfs:domain poker:Mano ;
    rdfs:range  poker:Rango ;
    rdfs:label  "Mano tiene Par" ;
    rdfs:comment "Indica qué rangos están presentes con al menos 2 cartas en la mano. Se agrega manualmente en la ABox; usado por el clasificador de DoblePar." .


# =============================================================================
# ABox - Individuos
# =============================================================================
#
# 69 individuos en total: 4 palos, 13 rangos, y 52 cartas.
#
# Convención de nombres: {Rango}De{Palo}. Ejemplos:  AsDePicas, ReyDeCorazones, etc.
# Los acentos se omiten en los IRI (Treboles, no Tréboles) para evitar
# problemas de codificación de los nombres.
# =============================================================================

# --- Palos ---
poker:Picas a poker:Palo ; rdfs:label "Picas" .
poker:Corazones a poker:Palo ; rdfs:label "Corazones" .
poker:Diamantes a poker:Palo ; rdfs:label "Diamantes" .
poker:Treboles a poker:Palo ; rdfs:label "Tréboles" .

# --- Rangos ---
poker:Dos a poker:Rango ; rdfs:label "Dos" .
poker:Tres a poker:Rango ; rdfs:label "Tres" .
poker:Cuatro a poker:Rango ; rdfs:label "Cuatro" .
poker:Cinco a poker:Rango ; rdfs:label "Cinco" .
poker:Seis a poker:Rango ; rdfs:label "Seis" .
poker:Siete a poker:Rango ; rdfs:label "Siete" .
poker:Ocho a poker:Rango ; rdfs:label "Ocho" .
poker:Nueve a poker:Rango ; rdfs:label "Nueve" .
poker:Diez a poker:Rango ; rdfs:label "Diez" .
poker:Jota a poker:Rango ; rdfs:label "Jota" .
poker:Reina a poker:Rango ; rdfs:label "Reina" .
poker:Rey a poker:Rango ; rdfs:label "Rey" .
poker:As a poker:Rango ; rdfs:label "As" .

# --- Cartas de Picas ---
poker:DosDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Dos ; rdfs:label "Dos de Picas" .
poker:TresDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Tres ; rdfs:label "Tres de Picas" .
poker:CuatroDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Cuatro ; rdfs:label "Cuatro de Picas" .
poker:CincoDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Cinco ; rdfs:label "Cinco de Picas" .
poker:SeisDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Seis ; rdfs:label "Seis de Picas" .
poker:SieteDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Siete ; rdfs:label "Siete de Picas" .
poker:OchoDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Ocho ; rdfs:label "Ocho de Picas" .
poker:NueveDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Nueve ; rdfs:label "Nueve de Picas" .
poker:DiezDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Diez ; rdfs:label "Diez de Picas" .
poker:JotaDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Jota ; rdfs:label "Jota de Picas" .
poker:ReinaDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Reina ; rdfs:label "Reina de Picas" .
poker:ReyDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:Rey ; rdfs:label "Rey de Picas" .
poker:AsDePicas a poker:Carta ; poker:tienePalo poker:Picas ; poker:tieneRango poker:As ; rdfs:label "As de Picas" .

# --- Cartas de Corazones ---
poker:DosDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Dos ; rdfs:label "Dos de Corazones" .
poker:TresDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Tres ; rdfs:label "Tres de Corazones" .
poker:CuatroDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Cuatro ; rdfs:label "Cuatro de Corazones" .
poker:CincoDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Cinco ; rdfs:label "Cinco de Corazones" .
poker:SeisDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Seis ; rdfs:label "Seis de Corazones" .
poker:SieteDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Siete ; rdfs:label "Siete de Corazones" .
poker:OchoDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Ocho ; rdfs:label "Ocho de Corazones" .
poker:NueveDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Nueve ; rdfs:label "Nueve de Corazones" .
poker:DiezDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Diez ; rdfs:label "Diez de Corazones" .
poker:JotaDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Jota ; rdfs:label "Jota de Corazones" .
poker:ReinaDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Reina ; rdfs:label "Reina de Corazones" .
poker:ReyDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:Rey ; rdfs:label "Rey de Corazones" .
poker:AsDeCorazones a poker:Carta ; poker:tienePalo poker:Corazones ; poker:tieneRango poker:As ; rdfs:label "As de Corazones" .

# --- Cartas de Diamantes ---
poker:DosDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Dos ; rdfs:label "Dos de Diamantes" .
poker:TresDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Tres ; rdfs:label "Tres de Diamantes" .
poker:CuatroDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Cuatro ; rdfs:label "Cuatro de Diamantes" .
poker:CincoDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Cinco ; rdfs:label "Cinco de Diamantes" .
poker:SeisDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Seis ; rdfs:label "Seis de Diamantes" .
poker:SieteDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Siete ; rdfs:label "Siete de Diamantes" .
poker:OchoDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Ocho ; rdfs:label "Ocho de Diamantes" .
poker:NueveDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Nueve ; rdfs:label "Nueve de Diamantes" .
poker:DiezDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Diez ; rdfs:label "Diez de Diamantes" .
poker:JotaDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Jota ; rdfs:label "Jota de Diamantes" .
poker:ReinaDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Reina ; rdfs:label "Reina de Diamantes" .
poker:ReyDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:Rey ; rdfs:label "Rey de Diamantes" .
poker:AsDeDiamantes a poker:Carta ; poker:tienePalo poker:Diamantes ; poker:tieneRango poker:As ; rdfs:label "As de Diamantes" .

# --- Cartas de Tréboles ---
poker:DosDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Dos ; rdfs:label "Dos de Tréboles" .
poker:TresDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Tres ; rdfs:label "Tres de Tréboles" .
poker:CuatroDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Cuatro ; rdfs:label "Cuatro de Tréboles" .
poker:CincoDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Cinco ; rdfs:label "Cinco de Tréboles" .
poker:SeisDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Seis ; rdfs:label "Seis de Tréboles" .
poker:SieteDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Siete ; rdfs:label "Siete de Tréboles" .
poker:OchoDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Ocho ; rdfs:label "Ocho de Tréboles" .
poker:NueveDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Nueve ; rdfs:label "Nueve de Tréboles" .
poker:DiezDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Diez ; rdfs:label "Diez de Tréboles" .
poker:JotaDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Jota ; rdfs:label "Jota de Tréboles" .
poker:ReinaDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Reina ; rdfs:label "Reina de Tréboles" .
poker:ReyDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:Rey ; rdfs:label "Rey de Tréboles" .
poker:AsDeTreboles a poker:Carta ; poker:tienePalo poker:Treboles ; poker:tieneRango poker:As ; rdfs:label "As de Tréboles" .


# --- Unicidad de individuos ---
# AllDifferent es necesario porque OWL DL 2 no asume distinción entre individuos
# por defecto (Unique Name Assumption no aplica en OWL). Sin estas
# declaraciones, el razonador podría unificar, por ejemplo, DosDePicas
# con TresDeCorazones si no hay nada que los contradiga explícitamente como cartas distintas.
# Aplica para palos, rangos y cartas.

# 4 palos distintos.
[] a owl:AllDifferent ;
    owl:distinctMembers ( poker:Picas poker:Corazones poker:Diamantes poker:Treboles ) .

# 13 rangos distintos.
[] a owl:AllDifferent ;
    owl:distinctMembers ( poker:Dos poker:Tres poker:Cuatro poker:Cinco poker:Seis
                          poker:Siete poker:Ocho poker:Nueve poker:Diez poker:Jota
                          poker:Reina poker:Rey poker:As ) .

# 52 cartas distintas.
[] a owl:AllDifferent ;
    owl:distinctMembers (
        poker:DosDePicas poker:TresDePicas poker:CuatroDePicas poker:CincoDePicas
        poker:SeisDePicas poker:SieteDePicas poker:OchoDePicas poker:NueveDePicas
        poker:DiezDePicas poker:JotaDePicas poker:ReinaDePicas poker:ReyDePicas poker:AsDePicas
        poker:DosDeCorazones poker:TresDeCorazones poker:CuatroDeCorazones poker:CincoDeCorazones
        poker:SeisDeCorazones poker:SieteDeCorazones poker:OchoDeCorazones poker:NueveDeCorazones
        poker:DiezDeCorazones poker:JotaDeCorazones poker:ReinaDeCorazones poker:ReyDeCorazones poker:AsDeCorazones
        poker:DosDeDiamantes poker:TresDeDiamantes poker:CuatroDeDiamantes poker:CincoDeDiamantes
        poker:SeisDeDiamantes poker:SieteDeDiamantes poker:OchoDeDiamantes poker:NueveDeDiamantes
        poker:DiezDeDiamantes poker:JotaDeDiamantes poker:ReinaDeDiamantes poker:ReyDeDiamantes poker:AsDeDiamantes
        poker:DosDeTreboles poker:TresDeTreboles poker:CuatroDeTreboles poker:CincoDeTreboles
        poker:SeisDeTreboles poker:SieteDeTreboles poker:OchoDeTreboles poker:NueveDeTreboles
        poker:DiezDeTreboles poker:JotaDeTreboles poker:ReinaDeTreboles poker:ReyDeTreboles poker:AsDeTreboles
    ) .
