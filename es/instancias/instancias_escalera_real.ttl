# =============================================================================
# Instancias de prueba — Manos de tipo Escalera Real
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_real>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Escalera Real" ;
    rdfs:comment "ABox con 4 manos de tipo EscaleraReal, una por cada palo posible (10-J-Q-K-A). Cubre la totalidad de las Escaleras Reales existentes en la baraja. Para verificar el clasificador poker:EscaleraReal." .


# =============================================================================
# Manos de Escalera Real 
# =============================================================================

ex:TJQKAs a poker:Mano ;
    rdfs:label "Escalera Real de Picas" ;
    poker:contieneCarta poker:DiezDePicas, poker:JotaDePicas,
                        poker:ReinaDePicas, poker:ReyDePicas,
                        poker:AsDePicas .

ex:TJQKAh a poker:Mano ;
    rdfs:label "Escalera Real de Corazones" ;
    poker:contieneCarta poker:DiezDeCorazones, poker:JotaDeCorazones,
                        poker:ReinaDeCorazones, poker:ReyDeCorazones,
                        poker:AsDeCorazones .

ex:TJQKAd a poker:Mano ;
    rdfs:label "Escalera Real de Diamantes" ;
    poker:contieneCarta poker:DiezDeDiamantes, poker:JotaDeDiamantes,
                        poker:ReinaDeDiamantes, poker:ReyDeDiamantes,
                        poker:AsDeDiamantes .

ex:TJQKAc a poker:Mano ;
    rdfs:label "Escalera Real de Tréboles" ;
    poker:contieneCarta poker:DiezDeTreboles, poker:JotaDeTreboles,
                        poker:ReinaDeTreboles, poker:ReyDeTreboles,
                        poker:AsDeTreboles .

# =============================================================================
# Unicidad de instancias
# =============================================================================

[] a owl:AllDifferent ;
    owl:distinctMembers (
        ex:TJQKAs
        ex:TJQKAh
        ex:TJQKAd
        ex:TJQKAc
    ) .
