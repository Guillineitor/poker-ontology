# =============================================================================
# Instancias de prueba — Manos de tipo Color
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Color" ;
    rdfs:comment "ABox con 20 manos de tipo Color, 5 por palo. Para verificar el clasificador poker:Color." .


# =============================================================================
# Manos de Color 
# =============================================================================

ex:AHKH8H6H3H a poker:Mano ;
    rdfs:label "As Rey Ocho Seis Tres de Corazones" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeCorazones,
                        poker:OchoDeCorazones, poker:SeisDeCorazones,
                        poker:TresDeCorazones .

ex:JD9D7D4D2D a poker:Mano ;
    rdfs:label "Jota Nueve Siete Cuatro Dos de Diamantes" ;
    poker:contieneCarta poker:JotaDeDiamantes, poker:NueveDeDiamantes,
                        poker:SieteDeDiamantes, poker:CuatroDeDiamantes,
                        poker:DosDeDiamantes .

ex:KS10S7S5S2S a poker:Mano ;
    rdfs:label "Rey Diez Siete Cinco Dos de Picas" ;
    poker:contieneCarta poker:ReyDePicas, poker:DiezDePicas,
                        poker:SieteDePicas, poker:CincoDePicas,
                        poker:DosDePicas .

ex:QC9C6C4C2C a poker:Mano ;
    rdfs:label "Reina Nueve Seis Cuatro Dos de Tréboles" ;
    poker:contieneCarta poker:ReinaDeTreboles, poker:NueveDeTreboles,
                        poker:SeisDeTreboles, poker:CuatroDeTreboles,
                        poker:DosDeTreboles .

# =============================================================================
# Unicidad de instancias
# =============================================================================

[] a owl:AllDifferent ;
    owl:distinctMembers (
        ex:AHKH8H6H3H   ex:QH10H7H5H3H  ex:JH9H6H4H2H
        ex:KH10H8H5H2H  ex:AH9H7H4H2H
        ex:JD9D7D4D2D   ex:ADKD8D5D3D   ex:QD10D6D4D2D
        ex:KD9D7D5D3D   ex:JD8D6D4D2D
        ex:KS10S7S5S2S  ex:ASJS8S6S3S   ex:QS9S7S4S2S
        ex:KS8S6S4S2S   ex:JS10S9S5S3S
        ex:QC9C6C4C2C   ex:ACKC7C5C3C   ex:JC10C8C6C2C
        ex:KC9C7C4C2C   ex:QC8C6C5C3C
    ) .