# =============================================================================
# Instancias de prueba — Manos de tipo Color
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Color" ;
    rdfs:comment "ABox con 20 manos de tipo Color, 5 por palo. Para verificar el clasificador poker:Color." .


# =============================================================================
# Manos de Color — Corazones (5 manos)
# =============================================================================

ex:AHKH8H6H3H a poker:Mano ;
    rdfs:label "As Rey Ocho Seis Tres de Corazones" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeCorazones,
                        poker:OchoDeCorazones, poker:SeisDeCorazones,
                        poker:TresDeCorazones .

ex:QH10H7H5H3H a poker:Mano ;
    rdfs:label "Reina Diez Siete Cinco Tres de Corazones" ;
    poker:contieneCarta poker:ReinaDeCorazones, poker:DiezDeCorazones,
                        poker:SieteDeCorazones, poker:CincoDeCorazones,
                        poker:TresDeCorazones .

ex:JH9H6H4H2H a poker:Mano ;
    rdfs:label "Jota Nueve Seis Cuatro Dos de Corazones" ;
    poker:contieneCarta poker:JotaDeCorazones, poker:NueveDeCorazones,
                        poker:SeisDeCorazones, poker:CuatroDeCorazones,
                        poker:DosDeCorazones .

ex:KH10H8H5H2H a poker:Mano ;
    rdfs:label "Rey Diez Ocho Cinco Dos de Corazones" ;
    poker:contieneCarta poker:ReyDeCorazones, poker:DiezDeCorazones,
                        poker:OchoDeCorazones, poker:CincoDeCorazones,
                        poker:DosDeCorazones .

ex:AH9H7H4H2H a poker:Mano ;
    rdfs:label "As Nueve Siete Cuatro Dos de Corazones" ;
    poker:contieneCarta poker:AsDeCorazones, poker:NueveDeCorazones,
                        poker:SieteDeCorazones, poker:CuatroDeCorazones,
                        poker:DosDeCorazones .


