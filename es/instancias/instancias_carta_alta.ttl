# =============================================================================
# Instancias de prueba — Manos de tipo Carta Alta
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Carta Alta" ;
    rdfs:comment "ABox con 20 manos de tipo Carta Alta. Para verificar el clasificador poker:CartaAlta." .


# =============================================================================
# Manos de Carta Alta — Carta más alta: As (5 manos)
# =============================================================================

ex:AKJ83 a poker:Mano ;
    rdfs:label "Carta Alta: As con Rey Jota Ocho Tres" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeDiamantes,
                        poker:JotaDePicas, poker:OchoDeTreboles,
                        poker:TresDePicas .

ex:AQT72 a poker:Mano ;
    rdfs:label "Carta Alta: As con Reina Diez Siete Dos" ;
    poker:contieneCarta poker:AsDePicas, poker:ReinaDeCorazones,
                        poker:DiezDeDiamantes, poker:SieteDeTreboles,
                        poker:DosDeCorazones .

ex:AJ964 a poker:Mano ;
    rdfs:label "Carta Alta: As con Jota Nueve Seis Cuatro" ;
    poker:contieneCarta poker:AsDeDiamantes, poker:JotaDeCorazones,
                        poker:NueveDePicas, poker:SeisDeDiamantes,
                        poker:CuatroDeTreboles .

ex:AK853 a poker:Mano ;
    rdfs:label "Carta Alta: As con Rey Ocho Cinco Tres" ;
    poker:contieneCarta poker:AsDeTreboles, poker:ReyDeCorazones,
                        poker:OchoDeDiamantes, poker:CincoDePicas,
                        poker:TresDeCorazones .

ex:AQ742 a poker:Mano ;
    rdfs:label "Carta Alta: As con Reina Siete Cuatro Dos" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReinaDePicas,
                        poker:SieteDeCorazones, poker:CuatroDeDiamantes,
                        poker:DosDeTreboles .


