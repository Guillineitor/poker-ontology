# =============================================================================
# Instancias de prueba — Manos de tipo Carta Alta
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Carta Alta" ;
    rdfs:comment "ABox con 20 manos de tipo Carta Alta. Para verificar el clasificador poker:CartaAlta." .


# =============================================================================
# Manos de Carta Alta 
# =============================================================================

ex:AKJ83 a poker:Mano ;
    rdfs:label "Carta Alta: As con Rey Jota Ocho Tres" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeDiamantes,
                        poker:JotaDePicas, poker:OchoDeTreboles,
                        poker:TresDePicas .

ex:KQ853 a poker:Mano ;
    rdfs:label "Carta Alta: Rey con Reina Ocho Cinco Tres" ;
    poker:contieneCarta poker:ReyDePicas, poker:ReinaDeDiamantes,
                        poker:OchoDeCorazones, poker:CincoDeTreboles,
                        poker:TresDeDiamantes .

ex:QJ852 a poker:Mano ;
    rdfs:label "Carta Alta: Reina con Jota Ocho Cinco Dos" ;
    poker:contieneCarta poker:ReinaDeTreboles, poker:JotaDePicas,
                        poker:OchoDeCorazones, poker:CincoDeDiamantes,
                        poker:DosDeTreboles .

ex:JT742 a poker:Mano ;
    rdfs:label "Carta Alta: Jota con Diez Siete Cuatro Dos" ;
    poker:contieneCarta poker:JotaDePicas, poker:DiezDeCorazones,
                        poker:SieteDeDiamantes, poker:CuatroDePicas,
                        poker:DosDeTreboles .

# =============================================================================
# Unicidad de instancias
# =============================================================================

[] a owl:AllDifferent ;
    owl:distinctMembers (
        ex:AKJ83     ex:AQT72     ex:AJ964
        ex:AK853     ex:AQ742
        ex:KQ853     ex:KJ742     ex:KT964
        ex:KQ752     ex:KJ843
        ex:QJ852     ex:QT943     ex:QJ752
        ex:QT863     ex:QJ642
        ex:JT742     ex:J9853     ex:JT642
        ex:J9753     ex:JT852
    ) .
