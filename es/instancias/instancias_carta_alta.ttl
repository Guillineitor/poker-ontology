# Manos de Carta Alta — Carta más alta: Jota (5 manos)
# =============================================================================

ex:JT742 a poker:Mano ;
    rdfs:label "Carta Alta: Jota con Diez Siete Cuatro Dos" ;
    poker:contieneCarta poker:JotaDePicas, poker:DiezDeCorazones,
                        poker:SieteDeDiamantes, poker:CuatroDePicas,
                        poker:DosDeTreboles .

ex:J9853 a poker:Mano ;
    rdfs:label "Carta Alta: Jota con Nueve Ocho Cinco Tres" ;
    poker:contieneCarta poker:JotaDeCorazones, poker:NueveDePicas,
                        poker:OchoDeTreboles, poker:CincoDeCorazones,
                        poker:TresDeDiamantes .

ex:JT642 a poker:Mano ;
    rdfs:label "Carta Alta: Jota con Diez Seis Cuatro Dos" ;
    poker:contieneCarta poker:JotaDeDiamantes, poker:DiezDePicas,
                        poker:SeisDeCorazones, poker:CuatroDeDiamantes,
