ex:KJ843 a poker:Mano ;
    rdfs:label "Carta Alta: Rey con Jota Ocho Cuatro Tres" ;
    poker:contieneCarta poker:ReyDeCorazones, poker:JotaDeTreboles,
                        poker:OchoDePicas, poker:CuatroDeTreboles,
                        poker:TresDeDiamantes .


