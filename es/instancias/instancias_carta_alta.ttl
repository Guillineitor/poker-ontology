    poker:contieneCarta poker:ReyDeCorazones, poker:JotaDeDiamantes,
                        poker:SieteDePicas, poker:CuatroDeCorazones,
                        poker:DosDeDiamantes .

ex:KT964 a poker:Mano ;
    rdfs:label "Carta Alta: Rey con Diez Nueve Seis Cuatro" ;
    poker:contieneCarta poker:ReyDeDiamantes, poker:DiezDeCorazones,
                        poker:NueveDeTreboles, poker:SeisDePicas,
                        poker:CuatroDeDiamantes .

ex:KQ752 a poker:Mano ;
    rdfs:label "Carta Alta: Rey con Reina Siete Cinco Dos" ;
    poker:contieneCarta poker:ReyDeTreboles, poker:ReinaDeCorazones,
                        poker:SieteDeDiamantes, poker:CincoDePicas,
