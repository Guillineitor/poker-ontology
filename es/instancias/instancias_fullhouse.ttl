# Trío fijo: ReyDePicas, ReyDeCorazones, ReyDeDiamantes
# =============================================================================

ex:KKKFAAch a poker:Mano ;
    rdfs:label "Full House — Trío de Reyes con Par de Ases" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:AsDeTreboles,
                        poker:AsDeCorazones .

ex:KKKFQQsd a poker:Mano ;
    rdfs:label "Full House — Trío de Reyes con Par de Reinas" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:ReinaDePicas,
                        poker:ReinaDeDiamantes .

ex:KKKFJJhc a poker:Mano ;
    rdfs:label "Full House — Trío de Reyes con Par de Jotas" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:JotaDeCorazones,
                        poker:JotaDeTreboles .

ex:KKKF99sh a poker:Mano ;
    rdfs:label "Full House — Trío de Reyes con Par de Nueves" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:NueveDePicas,
                        poker:NueveDeCorazones .

ex:KKKF33dc a poker:Mano ;
    rdfs:label "Full House — Trío de Reyes con Par de Treses" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:TresDeDiamantes,
                        poker:TresDeTreboles .


# =============================================================================
