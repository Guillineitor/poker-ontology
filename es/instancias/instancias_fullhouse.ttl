# =============================================================================
# Instancias de prueba — Manos de tipo Full House
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/fullhouse#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/fullhouse>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Full House" ;
    rdfs:comment "ABox con 20 manos de tipo Full House, agrupadas en 4 grupos de 5 por rango del trío. Para verificar el clasificador poker:FullHouse." .


# =============================================================================
# Manos de Full House 
# =============================================================================

ex:AAAFKKsh a poker:Mano ;
    rdfs:label "Full House — Trío de Ases con Par de Reyes" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:ReyDePicas,
                        poker:ReyDeCorazones ;
    poker:manoTienePar poker:As, poker:Rey .

ex:KKKFAAch a poker:Mano ;
    rdfs:label "Full House — Trío de Reyes con Par de Ases" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:AsDeTreboles,
                        poker:AsDeCorazones ;
    poker:manoTienePar poker:Rey, poker:As .

ex:JJJFAAsc a poker:Mano ;
    rdfs:label "Full House — Trío de Jotas con Par de Ases" ;
    poker:contieneCarta poker:JotaDePicas,
                        poker:JotaDeCorazones,
                        poker:JotaDeDiamantes,
                        poker:AsDePicas,
                        poker:AsDeTreboles ;
    poker:manoTienePar poker:Jota, poker:As .

ex:222FAAcs a poker:Mano ;
    rdfs:label "Full House — Trío de Doses con Par de Ases" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:AsDeTreboles,
                        poker:AsDePicas ;
    poker:manoTienePar poker:Dos, poker:As .

# =============================================================================
# Unicidad de instancias
# =============================================================================

[] a owl:AllDifferent ;
    owl:distinctMembers (
        ex:AAAFKKsh   ex:AAAFQQdc   ex:AAAFJJsc
        ex:AAAFTThd   ex:AAAF22cs
        ex:KKKFAAch   ex:KKKFQQsd   ex:KKKFJJhc
        ex:KKKF99sh   ex:KKKF33dc
        ex:JJJFAAsc   ex:JJJFKKhc   ex:JJJFQQdh
        ex:JJJF77sc   ex:JJJF55hd
        ex:222FAAcs   ex:222FKKhc   ex:222FQQsd
        ex:222F88ch   ex:222F66sd
    ) .
