# =============================================================================
# Instancias de prueba — Manos de tipo Full House
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/fullhouse#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/fullhouse>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Full House" ;
    rdfs:comment "ABox con 20 manos de tipo Full House, agrupadas en 4 grupos de 5 por rango del trío. Para verificar el clasificador poker:FullHouse." .


# =============================================================================
# Full House — Trío de Ases (5 manos)
# Trío fijo: AsDePicas, AsDeCorazones, AsDeDiamantes
# =============================================================================

ex:AAAFKKsh a poker:Mano ;
    rdfs:label "Full House — Trío de Ases con Par de Reyes" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:ReyDePicas,
                        poker:ReyDeCorazones .

ex:AAAFQQdc a poker:Mano ;
    rdfs:label "Full House — Trío de Ases con Par de Reinas" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:ReinaDeDiamantes,
                        poker:ReinaDeTreboles .

ex:AAAFJJsc a poker:Mano ;
    rdfs:label "Full House — Trío de Ases con Par de Jotas" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:JotaDePicas,
                        poker:JotaDeTreboles .

ex:AAAFTThd a poker:Mano ;
    rdfs:label "Full House — Trío de Ases con Par de Dieces" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:DiezDeCorazones,
                        poker:DiezDeDiamantes .

ex:AAAF22cs a poker:Mano ;
    rdfs:label "Full House — Trío de Ases con Par de Doses" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:DosDeTreboles,
                        poker:DosDePicas .


# =============================================================================
