    poker:contieneCarta poker:JotaDePicas,
                        poker:JotaDeCorazones,
                        poker:JotaDeDiamantes,
                        poker:CincoDeCorazones,
                        poker:CincoDeDiamantes .


# =============================================================================
# Full House — Trío de Doses (5 manos)
# Trío fijo: DosDePicas, DosDeCorazones, DosDeDiamantes
# =============================================================================

ex:222FAAcs a poker:Mano ;
    rdfs:label "Full House — Trío de Doses con Par de Ases" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:AsDeTreboles,
                        poker:AsDePicas .

ex:222FKKhc a poker:Mano ;
    rdfs:label "Full House — Trío de Doses con Par de Reyes" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:ReyDeCorazones,
                        poker:ReyDeTreboles .

ex:222FQQsd a poker:Mano ;
    rdfs:label "Full House — Trío de Doses con Par de Reinas" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:ReinaDePicas,
                        poker:ReinaDeDiamantes .

ex:222F88ch a poker:Mano ;
    rdfs:label "Full House — Trío de Doses con Par de Ochos" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:OchoDeTreboles,
                        poker:OchoDeCorazones .

ex:222F66sd a poker:Mano ;
    rdfs:label "Full House — Trío de Doses con Par de Seises" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:SeisDePicas,
                        poker:SeisDeDiamantes .


# =============================================================================
# Unicidad de instancias
# =============================================================================

[] a owl:AllDifferent ;
    owl:distinctMembers (
        ex:AAAFKKsh   ex:AAAFQQdc   ex:AAAFJJsc
        ex:AAAFTThd   ex:AAAF22cs
        ex:KKKFAAch   ex:KKKFQQsd   ex:KKKFJJhc
        ex:KKKF99sh   ex:KKKF33dc
        ex:JJJFAAsc   ex:JJJFKKhc   ex:JJJFQQdh
        ex:JJJF77sc   ex:JJJF55hd
        ex:222FAAcs   ex:222FKKhc   ex:222FQQsd
        ex:222F88ch   ex:222F66sd
    ) .
