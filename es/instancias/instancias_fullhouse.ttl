# Trío fijo: JotaDePicas, JotaDeCorazones, JotaDeDiamantes
# =============================================================================

ex:JJJFAAsc a poker:Mano ;
    rdfs:label "Full House — Trío de Jotas con Par de Ases" ;
    poker:contieneCarta poker:JotaDePicas,
                        poker:JotaDeCorazones,
                        poker:JotaDeDiamantes,
                        poker:AsDePicas,
                        poker:AsDeTreboles .

ex:JJJFKKhc a poker:Mano ;
    rdfs:label "Full House — Trío de Jotas con Par de Reyes" ;
    poker:contieneCarta poker:JotaDePicas,
                        poker:JotaDeCorazones,
                        poker:JotaDeDiamantes,
                        poker:ReyDeCorazones,
                        poker:ReyDeTreboles .

ex:JJJFQQdh a poker:Mano ;
    rdfs:label "Full House — Trío de Jotas con Par de Reinas" ;
    poker:contieneCarta poker:JotaDePicas,
                        poker:JotaDeCorazones,
                        poker:JotaDeDiamantes,
                        poker:ReinaDeDiamantes,
