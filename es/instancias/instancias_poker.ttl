# =============================================================================
# Instancias de prueba — Manos de tipo Póker
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/poker#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/poker>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Póker" ;
    rdfs:comment "ABox con 20 manos de tipo Póker, agrupadas en 4 grupos de 5 por rango del cuarteto. Para verificar el clasificador poker:Poker." .


# =============================================================================
# Manos de Póker
# =============================================================================

ex:AAAAKh a poker:Mano ;
    rdfs:label "Póker de Ases con Rey de Corazones" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:AsDeTreboles,
                        poker:ReyDeCorazones .

ex:KKKKAd a poker:Mano ;
    rdfs:label "Póker de Reyes con As de Diamantes" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:ReyDeTreboles,
                        poker:AsDeDiamantes .

ex:JJJJAs a poker:Mano ;
    rdfs:label "Póker de Jotas con As de Picas" ;
    poker:contieneCarta poker:JotaDePicas,
                        poker:JotaDeCorazones,
                        poker:JotaDeDiamantes,
                        poker:JotaDeTreboles,
                        poker:AsDePicas .


ex:2222Ah a poker:Mano ;
    rdfs:label "Póker de Doses con As de Corazones" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:DosDeTreboles,
                        poker:AsDeCorazones .

# =============================================================================
# Unicidad de instancias
# =============================================================================

[] a owl:AllDifferent ;
    owl:distinctMembers (
        ex:AAAAKh    ex:AAAAQd    ex:AAAAJs
        ex:AAAA10c   ex:AAAA2h
        ex:KKKKAd    ex:KKKKQs    ex:KKKKJc
        ex:KKKK9h    ex:KKKK3d
        ex:JJJJAs    ex:JJJJKh    ex:JJJJQd
        ex:JJJJ8c    ex:JJJJ4s
        ex:2222Ah    ex:2222Ks    ex:2222Qd
        ex:22227c    ex:22225h
    ) .
