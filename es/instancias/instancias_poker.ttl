# =============================================================================
# Instancias de prueba — Manos de tipo Póker
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/poker#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/poker>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Póker" ;
    rdfs:comment "ABox con 20 manos de tipo Póker, agrupadas en 4 grupos de 5 por rango del cuarteto. Para verificar el clasificador poker:Poker." .


# =============================================================================
# Póker de Ases (5 manos)
# =============================================================================

ex:AAAAKh a poker:Mano ;
    rdfs:label "Póker de Ases con Rey de Corazones" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:AsDeTreboles,
                        poker:ReyDeCorazones .

ex:AAAAQd a poker:Mano ;
    rdfs:label "Póker de Ases con Reina de Diamantes" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:AsDeTreboles,
                        poker:ReinaDeDiamantes .

ex:AAAAJs a poker:Mano ;
    rdfs:label "Póker de Ases con Jota de Picas" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:AsDeTreboles,
                        poker:JotaDePicas .

ex:AAAA10c a poker:Mano ;
    rdfs:label "Póker de Ases con Diez de Tréboles" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:AsDeTreboles,
                        poker:DiezDeTreboles .

ex:AAAA2h a poker:Mano ;
    rdfs:label "Póker de Ases con Dos de Corazones" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:AsDeTreboles,
                        poker:DosDeCorazones .


