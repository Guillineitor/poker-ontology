# =============================================================================
# Póker de Doses (5 manos)
# =============================================================================

ex:2222Ah a poker:Mano ;
    rdfs:label "Póker de Doses con As de Corazones" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:DosDeTreboles,
                        poker:AsDeCorazones .

ex:2222Ks a poker:Mano ;
    rdfs:label "Póker de Doses con Rey de Picas" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:DosDeTreboles,
                        poker:ReyDePicas .

ex:2222Qd a poker:Mano ;
    rdfs:label "Póker de Doses con Reina de Diamantes" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:DosDeTreboles,
                        poker:ReinaDeDiamantes .

ex:22227c a poker:Mano ;
    rdfs:label "Póker de Doses con Siete de Tréboles" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:DosDeTreboles,
                        poker:SieteDeTreboles .

ex:22225h a poker:Mano ;
    rdfs:label "Póker de Doses con Cinco de Corazones" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:DosDeTreboles,
                        poker:CincoDeCorazones .


# =============================================================================
# Unicidad de instancias
# =============================================================================

[] a owl:AllDifferent ;
    owl:distinctMembers (
        ex:AAAAKh    ex:AAAAQd    ex:AAAAJs
        ex:AAAA10c   ex:AAAA2h
        ex:KKKKAd    ex:KKKKQs    ex:KKKKJc
        ex:KKKK9h    ex:KKKK3d
        ex:JJJJAs    ex:JJJJKh    ex:JJJJQd
        ex:JJJJ8c    ex:JJJJ4s
        ex:2222Ah    ex:2222Ks    ex:2222Qd
        ex:22227c    ex:22225h
    ) .
