                        poker:ReyDeTreboles,
                        poker:ReinaDePicas .

ex:KKKKJc a poker:Mano ;
    rdfs:label "Póker de Reyes con Jota de Tréboles" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
