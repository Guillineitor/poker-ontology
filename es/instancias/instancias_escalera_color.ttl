# =============================================================================
# Instancias de prueba — Manos de tipo Escalera de Color
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_color>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Escalera de Color" ;
    rdfs:comment "ABox con 20 manos de tipo EscaleraColor, 5 por palo. Para verificar el clasificador poker:EscaleraColor." .


# =============================================================================
# Manos de Escalera de Color — Picas (5 manos)
# =============================================================================

ex:A2345s a poker:Mano ;
    rdfs:label "Escalera de Color A-2-3-4-5 de Picas" ;
    poker:contieneCarta poker:AsDePicas, poker:DosDePicas,
                        poker:TresDePicas, poker:CuatroDePicas,
                        poker:CincoDePicas .

ex:34567s a poker:Mano ;
    rdfs:label "Escalera de Color 3-4-5-6-7 de Picas" ;
    poker:contieneCarta poker:TresDePicas, poker:CuatroDePicas,
                        poker:CincoDePicas, poker:SeisDePicas,
                        poker:SieteDePicas .

ex:56789s a poker:Mano ;
    rdfs:label "Escalera de Color 5-6-7-8-9 de Picas" ;
    poker:contieneCarta poker:CincoDePicas, poker:SeisDePicas,
                        poker:SieteDePicas, poker:OchoDePicas,
                        poker:NueveDePicas .

ex:789TJs a poker:Mano ;
    rdfs:label "Escalera de Color 7-8-9-10-J de Picas" ;
    poker:contieneCarta poker:SieteDePicas, poker:OchoDePicas,
                        poker:NueveDePicas, poker:DiezDePicas,
                        poker:JotaDePicas .

ex:9TJQKs a poker:Mano ;
    rdfs:label "Escalera de Color 9-10-J-Q-K de Picas" ;
    poker:contieneCarta poker:NueveDePicas, poker:DiezDePicas,
                        poker:JotaDePicas, poker:ReinaDePicas,
                        poker:ReyDePicas .


