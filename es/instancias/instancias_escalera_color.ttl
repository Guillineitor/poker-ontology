# =============================================================================
# Instancias de prueba — Manos de tipo Escalera de Color
# =============================================================================

@prefix ex:    <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_color>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Escalera de Color" ;
    rdfs:comment "ABox con 20 manos de tipo EscaleraColor, 5 por palo. Para verificar el clasificador poker:EscaleraColor." .


# =============================================================================
# Manos de Escalera de Color 
# =============================================================================

ex:A2345s a poker:Mano ;
    rdfs:label "Escalera de Color A-2-3-4-5 de Picas" ;
    poker:contieneCarta poker:AsDePicas, poker:DosDePicas,
                        poker:TresDePicas, poker:CuatroDePicas,
                        poker:CincoDePicas .

ex:23456h a poker:Mano ;
    rdfs:label "Escalera de Color 2-3-4-5-6 de Corazones" ;
    poker:contieneCarta poker:DosDeCorazones, poker:TresDeCorazones,
                        poker:CuatroDeCorazones, poker:CincoDeCorazones,
                        poker:SeisDeCorazones .

ex:A2345d a poker:Mano ;
    rdfs:label "Escalera de Color A-2-3-4-5 de Diamantes" ;
    poker:contieneCarta poker:AsDeDiamantes, poker:DosDeDiamantes,
                        poker:TresDeDiamantes, poker:CuatroDeDiamantes,
                        poker:CincoDeDiamantes .

ex:34567c a poker:Mano ;
    rdfs:label "Escalera de Color 3-4-5-6-7 de Tréboles" ;
    poker:contieneCarta poker:TresDeTreboles, poker:CuatroDeTreboles,
                        poker:CincoDeTreboles, poker:SeisDeTreboles,
                        poker:SieteDeTreboles .

# =============================================================================
# Unicidad de instancias
# =============================================================================

[] a owl:AllDifferent ;
    owl:distinctMembers (
        ex:A2345s   ex:34567s   ex:56789s   ex:789TJs  ex:9TJQKs
        ex:23456h   ex:45678h   ex:678910h  ex:89TJQh  ex:9TJQKh
        ex:A2345d   ex:23456d   ex:56789d   ex:789TJd  ex:89TJQd
        ex:34567c   ex:45678c   ex:678910c  ex:89TJQc  ex:9TJQKc
    ) .
