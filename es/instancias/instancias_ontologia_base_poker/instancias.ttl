# =============================================================================
# Instancias de prueba — Todas las manos de Póker
# =============================================================================

@prefix carta_alta:    <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par:           <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar:      <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio:          <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera:      <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color:         <http://www.poker-ontology.org/instancias/color#> .
@prefix fullhouse:     <http://www.poker-ontology.org/instancias/fullhouse#> .
@prefix pokerh:        <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker:         <http://www.poker-ontology.org/poker#> .
@prefix owl:           <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:          <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de prueba — Todas las manos de Póker" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos: Carta Alta, Par, Doble Par, Trío, Escalera, Color, Full House, Póker, Escalera de Color y Escalera Real." .


# =============================================================================
# 1. Carta Alta (4 manos)
# =============================================================================

carta_alta:AKJ83 a poker:Mano ;
    rdfs:label "Carta Alta: As con Rey Jota Ocho Tres" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeDiamantes,
                        poker:JotaDePicas, poker:OchoDeTreboles,
                        poker:TresDePicas .

carta_alta:KQ853 a poker:Mano ;
    rdfs:label "Carta Alta: Rey con Reina Ocho Cinco Tres" ;
    poker:contieneCarta poker:ReyDePicas, poker:ReinaDeDiamantes,
                        poker:OchoDeCorazones, poker:CincoDeTreboles,
                        poker:TresDeDiamantes .

carta_alta:QJ852 a poker:Mano ;
    rdfs:label "Carta Alta: Reina con Jota Ocho Cinco Dos" ;
    poker:contieneCarta poker:ReinaDeTreboles, poker:JotaDePicas,
                        poker:OchoDeCorazones, poker:CincoDeDiamantes,
                        poker:DosDeTreboles .

carta_alta:JT742 a poker:Mano ;
    rdfs:label "Carta Alta: Jota con Diez Siete Cuatro Dos" ;
    poker:contieneCarta poker:JotaDePicas, poker:DiezDeCorazones,
                        poker:SieteDeDiamantes, poker:CuatroDePicas,
                        poker:DosDeTreboles .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        carta_alta:AKJ83
        carta_alta:KQ853
        carta_alta:QJ852
        carta_alta:JT742
    ) .


# =============================================================================
# 2. Par (4 manos)
# =============================================================================

par:AAHKQ2 a poker:Mano ;
    rdfs:label "Par de Ases con Rey Reina Dos" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeDiamantes,
                        poker:AsDePicas, poker:ReinaDeTreboles,
                        poker:DosDePicas .

par:KKAQJ a poker:Mano ;
    rdfs:label "Par de Reyes con As Reina Jota" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeCorazones,
                        poker:ReinaDeDiamantes, poker:ReyDePicas,
                        poker:JotaDeTreboles .

par:JJAKQ a poker:Mano ;
    rdfs:label "Par de Jotas con As Rey Reina" ;
    poker:contieneCarta poker:AsDeCorazones, poker:JotaDeCorazones,
                        poker:ReyDeDiamantes, poker:ReinaDeTreboles,
                        poker:JotaDePicas .

par:22AKQ a poker:Mano ;
    rdfs:label "Par de Doses con As Rey Reina" ;
    poker:contieneCarta poker:AsDeCorazones, poker:DosDeCorazones,
                        poker:ReyDeDiamantes, poker:ReinaDeTreboles,
                        poker:DosDePicas .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        par:AAHKQ2
        par:KKAQJ
        par:JJAKQ
        par:22AKQ
    ) .


# =============================================================================
# 3. Doble Par (4 manos)
# =============================================================================

doblepar:AAKKHQ a poker:Mano ;
    rdfs:label "Doble Par de Ases y Reyes con Reina" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDePicas,
                        poker:ReinaDeTreboles, poker:AsDePicas,
                        poker:ReyDeCorazones ;
    poker:manoTienePar poker:As, poker:Rey .

doblepar:QQJJHA a poker:Mano ;
    rdfs:label "Doble Par de Reinas y Jotas con As" ;
    poker:contieneCarta poker:ReinaDeCorazones, poker:JotaDePicas,
                        poker:AsDeTreboles, poker:ReinaDePicas,
                        poker:JotaDeCorazones ;
    poker:manoTienePar poker:Reina, poker:Jota .

doblepar:2233HA a poker:Mano ;
    rdfs:label "Doble Par de Doses y Treses con As" ;
    poker:contieneCarta poker:DosDeCorazones, poker:TresDePicas,
                        poker:AsDeCorazones, poker:DosDePicas,
                        poker:TresDeCorazones ;
    poker:manoTienePar poker:Dos, poker:Tres .

doblepar:8855HA a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Cincos con As" ;
    poker:contieneCarta poker:OchoDeCorazones, poker:CincoDePicas,
                        poker:AsDeTreboles, poker:OchoDePicas,
                        poker:CincoDeCorazones ;
    poker:manoTienePar poker:Ocho, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        doblepar:AAKKHQ
        doblepar:QQJJHA
        doblepar:2233HA
        doblepar:8855HA
    ) .


# =============================================================================
# 4. Trío(4 manos)
# =============================================================================

trio:AAAHKQ a poker:Mano ;
    rdfs:label "Trío de Ases con Rey Reina" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeTreboles,
                        poker:AsDePicas, poker:ReinaDePicas,
                        poker:AsDeDiamantes .

trio:KKKHAQ a poker:Mano ;
    rdfs:label "Trío de Reyes con As Reina" ;
    poker:contieneCarta poker:ReyDeCorazones, poker:AsDeTreboles,
                        poker:ReyDePicas, poker:ReinaDeCorazones,
                        poker:ReyDeDiamantes .

trio:JJJHAK a poker:Mano ;
    rdfs:label "Trío de Jotas con As Rey" ;
    poker:contieneCarta poker:JotaDeCorazones, poker:AsDeTreboles,
                        poker:JotaDePicas, poker:ReyDeCorazones,
                        poker:JotaDeDiamantes .

trio:222HAK a poker:Mano ;
    rdfs:label "Trío de Doses con As Rey" ;
    poker:contieneCarta poker:DosDeCorazones, poker:AsDeTreboles,
                        poker:DosDePicas, poker:ReyDeCorazones,
                        poker:DosDeDiamantes .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        trio:AAAHKQ
        trio:KKKHAQ
        trio:JJJHAK
        trio:222HAK
    ) .


# =============================================================================
# 5. Escalera (4 manos)
# =============================================================================

escalera:A2345 a poker:Mano ;
    rdfs:label "Escalera A-2-3-4-5" ;
    poker:contieneCarta poker:AsDePicas, poker:DosDeCorazones,
                        poker:TresDeDiamantes, poker:CuatroDeTreboles,
                        poker:CincoDePicas .

escalera:45678 a poker:Mano ;
    rdfs:label "Escalera 4-5-6-7-8" ;
    poker:contieneCarta poker:CuatroDeCorazones, poker:CincoDeTreboles,
                        poker:SeisDePicas, poker:SieteDeDiamantes,
                        poker:OchoDeCorazones .

escalera:789TJ a poker:Mano ;
    rdfs:label "Escalera 7-8-9-10-J" ;
    poker:contieneCarta poker:SieteDeCorazones, poker:OchoDeDiamantes,
                        poker:NueveDeTreboles, poker:DiezDePicas,
                        poker:JotaDeCorazones .

escalera:TJQKA a poker:Mano ;
    rdfs:label "Escalera 10-J-Q-K-A" ;
    poker:contieneCarta poker:DiezDeDiamantes, poker:JotaDeTreboles,
                        poker:ReinaDePicas, poker:ReyDeCorazones,
                        poker:AsDeDiamantes .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        escalera:A2345
        escalera:45678
        escalera:789TJ
        escalera:TJQKA
    ) .


# =============================================================================
# 6. Color (4 manos)
# =============================================================================

color:AHKH8H6H3H a poker:Mano ;
    rdfs:label "As Rey Ocho Seis Tres de Corazones" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeCorazones,
                        poker:OchoDeCorazones, poker:SeisDeCorazones,
                        poker:TresDeCorazones .

color:JD9D7D4D2D a poker:Mano ;
    rdfs:label "Jota Nueve Siete Cuatro Dos de Diamantes" ;
    poker:contieneCarta poker:JotaDeDiamantes, poker:NueveDeDiamantes,
                        poker:SieteDeDiamantes, poker:CuatroDeDiamantes,
                        poker:DosDeDiamantes .

color:KS10S7S5S2S a poker:Mano ;
    rdfs:label "Rey Diez Siete Cinco Dos de Picas" ;
    poker:contieneCarta poker:ReyDePicas, poker:DiezDePicas,
                        poker:SieteDePicas, poker:CincoDePicas,
                        poker:DosDePicas .

color:QC9C6C4C2C a poker:Mano ;
    rdfs:label "Reina Nueve Seis Cuatro Dos de Tréboles" ;
    poker:contieneCarta poker:ReinaDeTreboles, poker:NueveDeTreboles,
                        poker:SeisDeTreboles, poker:CuatroDeTreboles,
                        poker:DosDeTreboles .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        color:AHKH8H6H3H
        color:JD9D7D4D2D
        color:KS10S7S5S2S
        color:QC9C6C4C2C
    ) .


# =============================================================================
# 7. Full (4 manos)
# =============================================================================

fullhouse:AAAFKKsh a poker:Mano ;
    rdfs:label "Full House — Trío de Ases con Par de Reyes" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:ReyDePicas,
                        poker:ReyDeCorazones ;
    poker:manoTienePar poker:As, poker:Rey .

fullhouse:KKKFAAch a poker:Mano ;
    rdfs:label "Full House — Trío de Reyes con Par de Ases" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:AsDeTreboles,
                        poker:AsDeCorazones ;
    poker:manoTienePar poker:Rey, poker:As .

fullhouse:JJJFAAsc a poker:Mano ;
    rdfs:label "Full House — Trío de Jotas con Par de Ases" ;
    poker:contieneCarta poker:JotaDePicas,
                        poker:JotaDeCorazones,
                        poker:JotaDeDiamantes,
                        poker:AsDePicas,
                        poker:AsDeTreboles ;
    poker:manoTienePar poker:Jota, poker:As .

fullhouse:222FAAcs a poker:Mano ;
    rdfs:label "Full House — Trío de Doses con Par de Ases" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:AsDeTreboles,
                        poker:AsDePicas ;
    poker:manoTienePar poker:Dos, poker:As .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        fullhouse:AAAFKKsh
        fullhouse:KKKFAAch
        fullhouse:JJJFAAsc
        fullhouse:222FAAcs
    ) .


# =============================================================================
# 8. Póker (4 manos)
# =============================================================================

pokerh:AAAAKh a poker:Mano ;
    rdfs:label "Póker de Ases con Rey de Corazones" ;
    poker:contieneCarta poker:AsDePicas,
                        poker:AsDeCorazones,
                        poker:AsDeDiamantes,
                        poker:AsDeTreboles,
                        poker:ReyDeCorazones .

pokerh:KKKKAd a poker:Mano ;
    rdfs:label "Póker de Reyes con As de Diamantes" ;
    poker:contieneCarta poker:ReyDePicas,
                        poker:ReyDeCorazones,
                        poker:ReyDeDiamantes,
                        poker:ReyDeTreboles,
                        poker:AsDeDiamantes .

pokerh:JJJJAs a poker:Mano ;
    rdfs:label "Póker de Jotas con As de Picas" ;
    poker:contieneCarta poker:JotaDePicas,
                        poker:JotaDeCorazones,
                        poker:JotaDeDiamantes,
                        poker:JotaDeTreboles,
                        poker:AsDePicas .

pokerh:2222Ah a poker:Mano ;
    rdfs:label "Póker de Doses con As de Corazones" ;
    poker:contieneCarta poker:DosDePicas,
                        poker:DosDeCorazones,
                        poker:DosDeDiamantes,
                        poker:DosDeTreboles,
                        poker:AsDeCorazones .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        pokerh:AAAAKh
        pokerh:KKKKAd
        pokerh:JJJJAs
        pokerh:2222Ah
    ) .


# =============================================================================
# 9. Escalera de Color (4 manos)
# =============================================================================

escalera_color:A2345s a poker:Mano ;
    rdfs:label "Escalera de Color A-2-3-4-5 de Picas" ;
    poker:contieneCarta poker:AsDePicas, poker:DosDePicas,
                        poker:TresDePicas, poker:CuatroDePicas,
                        poker:CincoDePicas .

escalera_color:23456h a poker:Mano ;
    rdfs:label "Escalera de Color 2-3-4-5-6 de Corazones" ;
    poker:contieneCarta poker:DosDeCorazones, poker:TresDeCorazones,
                        poker:CuatroDeCorazones, poker:CincoDeCorazones,
                        poker:SeisDeCorazones .

escalera_color:A2345d a poker:Mano ;
    rdfs:label "Escalera de Color A-2-3-4-5 de Diamantes" ;
    poker:contieneCarta poker:AsDeDiamantes, poker:DosDeDiamantes,
                        poker:TresDeDiamantes, poker:CuatroDeDiamantes,
                        poker:CincoDeDiamantes .

escalera_color:34567c a poker:Mano ;
    rdfs:label "Escalera de Color 3-4-5-6-7 de Tréboles" ;
    poker:contieneCarta poker:TresDeTreboles, poker:CuatroDeTreboles,
                        poker:CincoDeTreboles, poker:SeisDeTreboles,
                        poker:SieteDeTreboles .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        escalera_color:A2345s
        escalera_color:23456h
        escalera_color:A2345d
        escalera_color:34567c
    ) .


# =============================================================================
# 10. Escalera Real (4 manos)
# =============================================================================

escalera_real:TJQKAs a poker:Mano ;
    rdfs:label "Escalera Real de Picas" ;
    poker:contieneCarta poker:DiezDePicas, poker:JotaDePicas,
                        poker:ReinaDePicas, poker:ReyDePicas,
                        poker:AsDePicas .

escalera_real:TJQKAh a poker:Mano ;
    rdfs:label "Escalera Real de Corazones" ;
    poker:contieneCarta poker:DiezDeCorazones, poker:JotaDeCorazones,
                        poker:ReinaDeCorazones, poker:ReyDeCorazones,
                        poker:AsDeCorazones .

escalera_real:TJQKAd a poker:Mano ;
    rdfs:label "Escalera Real de Diamantes" ;
    poker:contieneCarta poker:DiezDeDiamantes, poker:JotaDeDiamantes,
                        poker:ReinaDeDiamantes, poker:ReyDeDiamantes,
                        poker:AsDeDiamantes .

escalera_real:TJQKAc a poker:Mano ;
    rdfs:label "Escalera Real de Tréboles" ;
    poker:contieneCarta poker:DiezDeTreboles, poker:JotaDeTreboles,
                        poker:ReinaDeTreboles, poker:ReyDeTreboles,
                        poker:AsDeTreboles .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers (
        escalera_real:TJQKAs
        escalera_real:TJQKAh
        escalera_real:TJQKAd
        escalera_real:TJQKAc
    ) .
