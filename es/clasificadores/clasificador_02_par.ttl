@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<http://www.poker-ontology.org/clasificadores/par>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Clasificador de Par" ;
    owl:versionInfo "2.0.0" .

# =============================================================================
# Clasificador: Par (One Pair)
# =============================================================================
# Una Mano es un Par si y solo si existe algún rango R tal que la mano
# contiene exactamente 2 cartas de rango R, independientemente del palo.
#
# OWL DL no puede cuantificar "existe un R" genérico, así que se expresa
# como la unión de 13 ramas, una por por cada rango. En cada rama:
#   - min 2 cartas de rango R  → hay un par
#   - max 2 cartas de rango R  → no es trío ni póker
#   - tieneClasificacion = ClasificacionPar
#
# La disjunción de ClasificacionMano en la base impide que una misma mano
# tenga simultáneamente ClasificacionPar y cualquier clasificación superior.
# =============================================================================

poker:ManoPar a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    rdfs:label "Mano Par" ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [ a owl:Restriction ;
              owl:onProperty poker:tieneClasificacion ;
              owl:hasValue poker:ClasificacionPar ]
            [ a owl:Class ;
              owl:unionOf (
                # Par de Doses
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Dos ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Dos ] ) ] ] ) ]
                # Par de Treses
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Tres ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Tres ] ) ] ] ) ]
                # Par de Cuatros
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cuatro ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cuatro ] ) ] ] ) ]
                # Par de Cincos
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cinco ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cinco ] ) ] ] ) ]
                # Par de Seises
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Seis ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Seis ] ) ] ] ) ]
                # Par de Sietes
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Siete ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Siete ] ) ] ] ) ]
                # Par de Ochos
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Ocho ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Ocho ] ) ] ] ) ]
                # Par de Nueves
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Nueve ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Nueve ] ) ] ] ) ]
                # Par de Dieces
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Diez ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Diez ] ) ] ] ) ]
                # Par de Jotas
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Jota ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Jota ] ) ] ] ) ]
                # Par de Reinas
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Reina ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Reina ] ) ] ] ) ]
                # Par de Reyes
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Rey ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Rey ] ) ] ] ) ]
                # Par de Ases
                [ a owl:Class ; owl:intersectionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:As ] ) ] ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ;
                      owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                      owl:onClass [ a owl:Class ; owl:intersectionOf ( poker:Carta
                          [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:As ] ) ] ] ) ]
              )
            ]
        )
    ] .
