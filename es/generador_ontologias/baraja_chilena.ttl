                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ] ) ]
                    # Nueve + Catorce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ] ) ]
                    # Nueve + Quince, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ] ) ]
                    # Nueve + As, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ] ) ]
                    # Diez + Once, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ] ) ]
                    # Diez + Doce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ] ) ]
                    # Diez + Trece, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ] ) ]
                    # Diez + Catorce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ] ) ]
                    # Diez + Quince, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ] ) ]
                    # Diez + As, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ] ) ]
                    # Once + Doce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ] ) ]
                    # Once + Trece, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ] ) ]
                    # Once + Catorce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ] ) ]
                    # Once + Quince, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ] ) ]
                    # Once + As, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ] ) ]
                    # Doce + Trece, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ] ) ]
                    # Doce + Catorce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ] ) ]
                    # Doce + Quince, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ] ) ]
                    # Doce + As, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ] ) ]
                    # Trece + Catorce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ] ) ]
                    # Trece + Quince, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ] ) ]
                    # Trece + As, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ] ) ]
                    # Catorce + Quince, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ] ) ]
                    # Catorce + As, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ] ) ]
                    # Quince + As, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ] ) ]
                )
            ]
        )
    ] ;
    rdfs:label "Doble Par" ;
    rdfs:comment "Dos pares de rangos distintos, independientemente del palo." .

# Definición de la clase Trio.
deck:Trio a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Trío de Dos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                    # Trío de Tres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                    # Trío de Cuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                    # Trío de Cinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                    # Trío de Seis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                    # Trío de Siete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                    # Trío de Ocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                    # Trío de Nueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                    # Trío de Diez de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                    # Trío de Once de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                    # Trío de Doce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                    # Trío de Trece de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                    # Trío de Catorce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                    # Trío de Quince de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                    # Trío de As de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ]
                )
            ]
        )
    ] ;
    rdfs:label "Trío" ;
    rdfs:comment "Mano formada por tres cartas del mismo rango." .

# Definición de la clase Escalera.
deck:Escalera a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Escalera Dos-Tres-Cuatro-Cinco-Seis.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                    )]
                    # Escalera Tres-Cuatro-Cinco-Seis-Siete.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                    )]
                    # Escalera Cuatro-Cinco-Seis-Siete-Ocho.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                    )]
                    # Escalera Cinco-Seis-Siete-Ocho-Nueve.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                    )]
                    # Escalera Seis-Siete-Ocho-Nueve-Diez.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                    )]
                    # Escalera Siete-Ocho-Nueve-Diez-Once.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                    )]
                    # Escalera Ocho-Nueve-Diez-Once-Doce.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                    )]
                    # Escalera Nueve-Diez-Once-Doce-Trece.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                    )]
                    # Escalera Diez-Once-Doce-Trece-Catorce.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
                    )]
                    # Escalera Once-Doce-Trece-Catorce-Quince.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeQuince ]
                    )]
                    # Escalera Doce-Trece-Catorce-Quince-As.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeQuince ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeAs ]
                    )]
                )
            ]
        )
    ] ;
    rdfs:label "Escalera" ;
    rdfs:comment "Mano formada por cinco cartas de rangos consecutivos, no necesariamente del mismo palo." .

# Definición de la clase Color.
deck:Color a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Color de Corazones.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeCorazones ]
                    # Color de Tréboles.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeTreboles ]
                    # Color de Picas.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDePicas ]
                    # Color de Diamantes.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeDiamantes ]
                    # Color de Copihues.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeCopihues ]
                )
            ]
        )
    ] ;
    rdfs:label "Color" ;
    rdfs:comment "Mano formada por cinco cartas del mismo palo, no necesariamente consecutivas." .

# Definición de la clase FullHouse.
# Truco por exclusión: cada rango tiene 0, 2 ó 3 cartas (nunca 1, nunca 4).
# La única partición de 5 en {0,2,3} es 3+2 → Full House.
deck:FullHouse a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            # 0, 2 ó 3 cartas de Dos.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                )]
            )]
            # 0, 2 ó 3 cartas de Tres.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                )]
            )]
            # 0, 2 ó 3 cartas de Cuatro.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                )]
            )]
            # 0, 2 ó 3 cartas de Cinco.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                )]
            )]
            # 0, 2 ó 3 cartas de Seis.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                )]
            )]
            # 0, 2 ó 3 cartas de Siete.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                )]
            )]
            # 0, 2 ó 3 cartas de Ocho.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                )]
            )]
            # 0, 2 ó 3 cartas de Nueve.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                )]
            )]
            # 0, 2 ó 3 cartas de Diez.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                )]
            )]
            # 0, 2 ó 3 cartas de Once.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                )]
            )]
            # 0, 2 ó 3 cartas de Doce.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                )]
            )]
            # 0, 2 ó 3 cartas de Trece.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                )]
            )]
            # 0, 2 ó 3 cartas de Catorce.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                )]
            )]
            # 0, 2 ó 3 cartas de Quince.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                )]
            )]
            # 0, 2 ó 3 cartas de As.
            [ a owl:Class ; owl:intersectionOf (
                [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ]
                [ a owl:Class ; owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ]
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ]
                )]
            )]
        )
    ] ;
    rdfs:label "Full House" ;
    rdfs:comment "Un trío más un par. Clasificado por exclusión: cada rango aporta 0, 2 ó 3 cartas; la única partición de 5 en {0,2,3} es 3+2." .

# Definición de la clase Poker.
deck:Poker a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Póker de Dos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                    # Póker de Tres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                    # Póker de Cuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                    # Póker de Cinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                    # Póker de Seis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                    # Póker de Siete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                    # Póker de Ocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                    # Póker de Nueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                    # Póker de Diez de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                    # Póker de Once de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                    # Póker de Doce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                    # Póker de Trece de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                    # Póker de Catorce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                    # Póker de Quince de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                    # Póker de As de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ]
                )
            ]
        )
    ] ;
    rdfs:label "Póker" ;
    rdfs:comment "Mano formada por cuatro cartas del mismo rango y una carta cualquiera." .

# Definición de la clase EscaleraColor.
# Truco: intersección de Escalera y Color → no hay que enumerar combinaciones de palo.
deck:EscaleraColor a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Escalera
            deck:Color
        )
    ] ;
    rdfs:label "Escalera de Color" ;
    rdfs:comment "Mano formada por cinco cartas consecutivas del mismo palo." .

# Definición de la clase EscaleraReal.
# Subclase de EscaleraColor con los 5 rangos más altos (Doce-Trece-Catorce-Quince-As).
deck:EscaleraReal a owl:Class ;
    rdfs:subClassOf deck:EscaleraColor ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:EscaleraColor
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeQuince ]
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeAs ]
        )
    ] ;
    rdfs:label "Escalera Real" ;
    rdfs:comment "Mano formada por los cinco rangos más altos consecutivos (Doce-Trece-Catorce-Quince-As) del mismo palo." .

# Las 9 clases base de mano son mutuamente disjuntas entre sí.
[] a owl:AllDisjointClasses ;
    owl:members ( deck:CartaAlta deck:Par deck:DoblePar deck:Trio deck:Escalera deck:Color deck:FullHouse deck:Poker deck:EscaleraColor ) .


# =============================================================================
# Propiedades de Objeto
# =============================================================================

deck:tienePalo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain deck:Carta ;
    rdfs:range deck:Palo ;
    rdfs:label "Tiene Palo" ;
    rdfs:comment "Asocia una carta con su palo. Funcional: cada carta tiene exactamente un palo." .

deck:tieneRango a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain deck:Carta ;
    rdfs:range deck:Rango ;
    rdfs:label "Tiene Rango" ;
    rdfs:comment "Asocia una carta con su rango. Funcional: cada carta tiene exactamente un rango." .

deck:contieneCarta a owl:ObjectProperty ;
    rdfs:domain deck:Mano ;
    rdfs:range deck:Carta ;
    rdfs:label "Contiene Carta" ;
    rdfs:comment "Relaciona una mano con cada una de las cartas que la componen." .

# =============================================================================
# Propiedades de Datos
# =============================================================================

deck:tieneValorRango a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain deck:Rango ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Tiene Valor De Rango" ;
    rdfs:comment "Valor numérico del rango. Usado por evaluadores externos." .

# =============================================================================
# Instancias (ABox)
# =============================================================================

# Palos (5 individuos) -------------------------------------------

deck:Corazones a deck:Palo ;
    rdfs:label "Corazones" .
deck:Treboles a deck:Palo ;
    rdfs:label "Tréboles" .
deck:Picas a deck:Palo ;
    rdfs:label "Picas" .
deck:Diamantes a deck:Palo ;
    rdfs:label "Diamantes" .
deck:Copihues a deck:Palo ;
    rdfs:label "Copihues" .

# Rangos (15 individuos) -------------------------------------------
# Los valores van de 1 (primer rango) a {len(rangos)} (último rango).

deck:Dos a deck:Rango ;
    deck:tieneValorRango "1"^^xsd:nonNegativeInteger ;
    rdfs:label "Dos" .

deck:Tres a deck:Rango ;
    deck:tieneValorRango "2"^^xsd:nonNegativeInteger ;
    rdfs:label "Tres" .

deck:Cuatro a deck:Rango ;
    deck:tieneValorRango "3"^^xsd:nonNegativeInteger ;
    rdfs:label "Cuatro" .

deck:Cinco a deck:Rango ;
    deck:tieneValorRango "4"^^xsd:nonNegativeInteger ;
    rdfs:label "Cinco" .

deck:Seis a deck:Rango ;
    deck:tieneValorRango "5"^^xsd:nonNegativeInteger ;
    rdfs:label "Seis" .

deck:Siete a deck:Rango ;
    deck:tieneValorRango "6"^^xsd:nonNegativeInteger ;
    rdfs:label "Siete" .

deck:Ocho a deck:Rango ;
    deck:tieneValorRango "7"^^xsd:nonNegativeInteger ;
    rdfs:label "Ocho" .

deck:Nueve a deck:Rango ;
    deck:tieneValorRango "8"^^xsd:nonNegativeInteger ;
    rdfs:label "Nueve" .

deck:Diez a deck:Rango ;
    deck:tieneValorRango "9"^^xsd:nonNegativeInteger ;
    rdfs:label "Diez" .

deck:Once a deck:Rango ;
    deck:tieneValorRango "10"^^xsd:nonNegativeInteger ;
    rdfs:label "Once" .

deck:Doce a deck:Rango ;
    deck:tieneValorRango "11"^^xsd:nonNegativeInteger ;
    rdfs:label "Doce" .

deck:Trece a deck:Rango ;
    deck:tieneValorRango "12"^^xsd:nonNegativeInteger ;
    rdfs:label "Trece" .

deck:Catorce a deck:Rango ;
    deck:tieneValorRango "13"^^xsd:nonNegativeInteger ;
    rdfs:label "Catorce" .

deck:Quince a deck:Rango ;
    deck:tieneValorRango "14"^^xsd:nonNegativeInteger ;
    rdfs:label "Quince" .

deck:As a deck:Rango ;
    deck:tieneValorRango "15"^^xsd:nonNegativeInteger ;
    rdfs:label "As" .


