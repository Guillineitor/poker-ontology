# =============================================================================
# Ontología de baraja: Baraja Chilena
# Generada automáticamente por generar_ontologia_baraja.py
# =============================================================================

@prefix deck: <http://www.ontologia-baraja.org/baraja_chilena#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
#
# Propósito
# ---------
# Ontología OWL 2 DL que modela la estructura de una baraja de tipo 'Baraja Chilena'.
# Palos  : 5
# Rangos : 15
# Cartas : 75
#
# Open World Assumption (OWA)
# ---------------------------
# Palo y Rango se cierran con owl:oneOf para evitar que el razonador asuma
# palos o rangos adicionales no declarados.
# Los 75 individuos de cartas se declaran AllDifferent.
# =============================================================================

<http://www.ontologia-baraja.org/baraja_chilena>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de baraja Baraja Chilena" ;
    rdfs:comment "Ontología OWL 2 DL que modela la baraja 'Baraja Chilena' (5 palos × 15 rangos = 75 cartas)." ;
    owl:versionInfo "1.0.0" .


# =============================================================================
# Palos y Rangos de las Cartas
# =============================================================================
#
# Palo  ≡ { Corazones, Treboles, Picas, Diamantes, Copihues }  (5 palos)
#

# Definición de la clase Palo.
deck:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( deck:Corazones deck:Treboles deck:Picas deck:Diamantes deck:Copihues )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Corazones, Treboles, Picas, Diamantes, Copihues." .

# Definición de la clase Rango.
deck:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( deck:Dos deck:Tres deck:Cuatro deck:Cinco deck:Seis deck:Siete deck:Ocho deck:Nueve deck:Diez deck:Once deck:Doce deck:Trece deck:Catorce deck:Quince deck:As )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Once, Doce, Trece, Catorce, Quince, As." .

# Definición de la clase Carta.
deck:Carta a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:someValuesFrom deck:Palo
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:tieneRango ;
        owl:someValuesFrom deck:Rango
    ] ;
    rdfs:label "Carta" ;
    rdfs:comment "Una carta de la baraja." .

# Subclases de Carta por Palo.

deck:CartaDeCorazones a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:hasValue deck:Corazones
    ] ;
    rdfs:label "Carta de Corazones" ;
    rdfs:comment "Una carta del palo de Corazones." .

deck:CartaDeTreboles a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:hasValue deck:Treboles
    ] ;
    rdfs:label "Carta de Tréboles" ;
    rdfs:comment "Una carta del palo de Tréboles." .

deck:CartaDePicas a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:hasValue deck:Picas
    ] ;
    rdfs:label "Carta de Picas" ;
    rdfs:comment "Una carta del palo de Picas." .

deck:CartaDeDiamantes a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:hasValue deck:Diamantes
    ] ;
    rdfs:label "Carta de Diamantes" ;
    rdfs:comment "Una carta del palo de Diamantes." .

deck:CartaDeCopihues a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:hasValue deck:Copihues
    ] ;
    rdfs:label "Carta de Copihues" ;
    rdfs:comment "Una carta del palo de Copihues." .

# Subclases de Carta por Rango.

deck:CartaDeDos a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Dos ] ;
    rdfs:label "Carta de Dos" .

deck:CartaDeTres a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Tres ] ;
    rdfs:label "Carta de Tres" .

deck:CartaDeCuatro a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Cuatro ] ;
    rdfs:label "Carta de Cuatro" .

deck:CartaDeCinco a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Cinco ] ;
    rdfs:label "Carta de Cinco" .

deck:CartaDeSeis a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Seis ] ;
    rdfs:label "Carta de Seis" .

deck:CartaDeSiete a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Siete ] ;
    rdfs:label "Carta de Siete" .

deck:CartaDeOcho a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Ocho ] ;
    rdfs:label "Carta de Ocho" .

deck:CartaDeNueve a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Nueve ] ;
    rdfs:label "Carta de Nueve" .

deck:CartaDeDiez a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Diez ] ;
    rdfs:label "Carta de Diez" .

deck:CartaDeOnce a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Once ] ;
    rdfs:label "Carta de Once" .

deck:CartaDeDoce a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Doce ] ;
    rdfs:label "Carta de Doce" .

deck:CartaDeTrece a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Trece ] ;
    rdfs:label "Carta de Trece" .

deck:CartaDeCatorce a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Catorce ] ;
    rdfs:label "Carta de Catorce" .

deck:CartaDeQuince a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Quince ] ;
    rdfs:label "Carta de Quince" .

deck:CartaDeAs a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:As ] ;
    rdfs:label "Carta de As" .


# =============================================================================
# Grupos de Cartas
# =============================================================================

# Definición de la clase Mano.
deck:Mano a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:contieneCarta ;
        owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass deck:Carta
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:contieneCarta ;
        owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass deck:Carta
    ] ;
    rdfs:label "Mano" ;
    rdfs:comment "La mejor combinación de 5 cartas de un jugador." .

# =============================================================================
# Clasificadores de Manos
# =============================================================================
#
# Jerarquía de tipos de mano, de menor a mayor fortaleza:
#   Mano
#   ├── CartaAlta      (1) Sin combinación; gana la carta más alta
#   ├── Par            (2) Dos cartas del mismo rango
#   ├── DoblePar       (3) Dos pares distintos
#   ├── Trio           (4) Tres cartas del mismo rango
#   ├── Escalera       (5) Cinco cartas consecutivas de distintos palos
#   ├── Color          (6) Cinco cartas del mismo palo
#   ├── FullHouse      (7) Un trío más un par
#   ├── Poker          (8) Cuatro cartas del mismo rango
#   └── EscaleraColor  (9) Cinco cartas consecutivas del mismo palo
#         └── EscaleraReal  Escalera Real: rangos más altos del mismo palo
#

# Definición de la clase CartaAlta.
deck:CartaAlta a owl:Class ;
    rdfs:subClassOf deck:Mano ;
    rdfs:label "Carta Alta" ;
    rdfs:comment "Sin combinación; la carta más alta decide el ganador." .

# Definición de la clase Par.
deck:Par a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Par de Dos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                    # Par de Tres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                    # Par de Cuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                    # Par de Cinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                    # Par de Seis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                    # Par de Siete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                    # Par de Ocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                    # Par de Nueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                    # Par de Diez de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                    # Par de Once de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                    # Par de Doce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                    # Par de Trece de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                    # Par de Catorce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                    # Par de Quince de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                    # Par de As de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ]
                )
            ]
        )
    ] ;
    rdfs:label "Par" ;
    rdfs:comment "Mano formada por dos cartas del mismo rango." .

# Definición de la clase DoblePar.
# Nota: En OWL DL puro es necesario enumerar las C(n,2) combinaciones de pares.
deck:DoblePar a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Dos + Tres, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] ) ]
                    # Dos + Cuatro, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ] ) ]
                    # Dos + Cinco, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ] ) ]
                    # Dos + Seis, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ] ) ]
                    # Dos + Siete, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ] ) ]
                    # Dos + Ocho, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ] ) ]
                    # Dos + Nueve, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ] ) ]
                    # Dos + Diez, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ] ) ]
                    # Dos + Once, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ] ) ]
                    # Dos + Doce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ] ) ]
                    # Dos + Trece, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ] ) ]
                    # Dos + Catorce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ] ) ]
                    # Dos + Quince, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ] ) ]
                    # Dos + As, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeAs ] ) ]
                    # Tres + Cuatro, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ] ) ]
                    # Tres + Cinco, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ] ) ]
                    # Tres + Seis, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ] ) ]
                    # Tres + Siete, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ] ) ]
                    # Tres + Ocho, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ] ) ]
                    # Tres + Nueve, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ] ) ]
                    # Tres + Diez, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ] ) ]
                    # Tres + Once, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ] ) ]
                    # Tres + Doce, de cualquier palo.
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ] [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ] ) ]
                    # Tres + Trece, de cualquier palo.
