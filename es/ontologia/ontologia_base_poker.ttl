# Definición de la clase Trio
poker:Trio a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Dos de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ]
                    # Tres de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ]
                    # Cuatro de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ]
                    # Cinco de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ]
                    # Seis de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ]
                    # Siete de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ]
                    # Ocho de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ]
                    # Nueve de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ]
                    # Diez de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ]
                    # Jota de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeJota ]
                    # Reina de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeReina ]
                    # Rey de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeRey ]
                    # As de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeAs ]
                )
            ]
        )
    ] ;
    rdfs:label "Trío" ;
    rdfs:comment "Tres cartas del mismo rango, independientemente del palo." .

# Definición de la clase Escalera
poker:Escalera a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # A-2-3-4-5 
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeAs ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                    )]
                    # 2-3-4-5-6
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                    )]
                    # 3-4-5-6-7
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                    )]
                    # 4-5-6-7-8
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                    )]
                    # 5-6-7-8-9
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                    )]
                    # 6-7-8-9-10
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                    )]
                    # 7-8-9-10-J
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
                    )]
                    # 8-9-10-J-Q
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeReina ]
                    )]
                    # 9-10-J-Q-K
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeReina ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeRey ]
                    )]
                    # 10-J-Q-K-A 
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeJota ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeReina ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeRey ]
                        [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:someValuesFrom poker:CartaDeAs ]
                    )]
                )
            ]
        )
    ] ;
    rdfs:label "Escalera" ;
    rdfs:comment "Cinco cartas de rangos consecutivos, independientemente del palo." .
    
# Definición de la clase Color
poker:Color a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeCorazones ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeDiamantes ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDePicas ]
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:allValuesFrom poker:CartaDeTreboles ]
                )
            ]
        )
    ] ;
    rdfs:label "Color" ;
    rdfs:comment "Cinco cartas del mismo palo." .

# Definición de la clase FullHouse
poker:FullHouse a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    rdfs:label "Full House" ;
    rdfs:comment "Un trío más un par." .

# Definición de la clase Poker
poker:Poker a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    rdfs:label "Póker" ;
    rdfs:comment "Cuatro cartas del mismo rango." .

# Definición de la clase EscaleraColor
poker:EscaleraColor a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    rdfs:label "Escalera de Color" ;
    rdfs:comment "Cinco cartas consecutivas del mismo palo." .

# Definición de la clase EscaleraReal
poker:EscaleraReal a owl:Class ;
    rdfs:subClassOf poker:EscaleraColor ;
    rdfs:label "Escalera Real" ;
    rdfs:comment "Escalera de color de Diez a As (10-J-Q-K-A del mismo palo). Subclase de EscaleraColor." .


# =============================================================================
# Propiedades de Objeto
# =============================================================================

# --- Propiedades de Carta (Carta → Palo / Rango) ----------------------------
#
# tienePalo y tieneRango son FunctionalProperty: cada carta tiene exactamente
# un palo y un rango. Esto, combinado con owl:oneOf en Palo y Rango,
# garantiza la unicidad de cada carta.
# contieneCarta relaciona cualquier mano con las cartas que contiene.

# Definición de la propiedad tienePalo.
poker:tienePalo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Carta ;
    rdfs:range poker:Palo ;
    rdfs:label "Tiene Palo" ;
    rdfs:comment "Asocia una carta con su palo. Funcional: cada carta tiene exactamente un palo." .

# Definición de la propiedad tieneRango.
poker:tieneRango a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Carta ;
    rdfs:range poker:Rango ;
    rdfs:label "Tiene Rango" ;
    rdfs:comment "Asocia una carta con su rango. Funcional: cada carta tiene exactamente un rango." .

# Definición de la propiedad contieneCarta.
poker:contieneCarta a owl:ObjectProperty ;
    rdfs:domain poker:GrupoDeCartas ;
    rdfs:range poker:Carta ;
    rdfs:label "Contiene Carta" ;
    rdfs:comment "Relaciona una mano con cada una de las cartas que la componen." .

# Definición de la propiedad tieneRangoSiguiente.
poker:tieneRangoSiguiente a owl:ObjectProperty ;
    rdfs:domain poker:Rango ;
    rdfs:range poker:Rango ;
    rdfs:label "Tiene Rango Siguiente" ;
    rdfs:comment "Indica qué rango le sigue inmediatamente en la secuencia. Forma un ciclo cerrado (Rey → As → Dos) para representar la naturaleza circular de la baraja. No es una propiedad transitiva ya que colapsaría todos los rangos en uno solo." .

# =============================================================================
# Propiedades de datos
# =============================================================================

# Las propiedades de datos registran valores escalares asociados a los
# individuos del dominio. OWL no realiza cálculos: los valores se registran
# como hechos y la lógica de evaluación (sumas, comparaciones) se implementa
# externamente, por ejemplo con SPARQL o Python.
#
# Las propiedades marcadas como FunctionalProperty garantizan que cada
# individuo tiene como máximo un valor para esa propiedad.

# Definición de la propiedad tieneValorRango.
poker:tieneValorRango a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain poker:Rango ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Tiene Valor De Rango" ;
    rdfs:comment "Valor numérico del rango (2 para Dos, 14 para As). Usado por evaluadores externos." .

# Definición de la propiedad tieneValorRangoBajo.
poker:tieneValorRangoBajo a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:oneOf ( poker:As )
    ] ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Tiene Valor De Rango Bajo" ;
    rdfs:comment "Valor alternativo bajo del As (= 1) para la escalera baja A-2-3-4-5 (Wheel). Restringido exclusivamente al As." .


# =============================================================================
# Axiomas Estructurales y Restricciones de Disyunción
# =============================================================================

# Estos axiomas garantizan la consistencia global de la ontología.
# Si se viola alguno, por ejemplo, clasificando algo como BotePrincipal y BoteSecundario
# a la vez, un razonador como HermiT o Pellet detectará la inconsistencia.

# =============================================================================
# Descartado para más adelante
# =============================================================================
# Las 9 clases base de Mano son mutuamente disjuntas (descartado por ahora)
# EscaleraReal queda excluido porque es subclase de EscaleraColor, no independiente.
#[] a owl:AllDisjointClasses ;
#    owl:members ( poker:CartaAlta poker:Par poker:DoblePar poker:Trio
#                  poker:Escalera poker:Color poker:FullHouse poker:Poker
#                  poker:EscaleraColor ) .


# =============================================================================
# Instancias (ABox)
# =============================================================================

# La ABox define los individuos concretos del dominio.
# Total: 69 individuos
#    4  palos (Palo)                       cerrados por owl:oneOf en la TBox
#   13  rangos (Rango)                     el As tiene valor dual: 14 (alto) y 1 (bajo)
#   52  cartas (Carta)                     13 rangos × 4 palos

# Palos (4 individuos) -------------------------------------------------------

poker:Picas a poker:Palo ;
    rdfs:label "Picas" .
poker:Corazones a poker:Palo ;
    rdfs:label "Corazones" .
poker:Diamantes a poker:Palo ;
    rdfs:label "Diamantes" .
poker:Treboles a poker:Palo ;
    rdfs:label "Tréboles" .

# Rangos (13 individuos) -----------------------------------------------------
# Los valores de tieneValorRango van de 2 (Dos) a 14 (As).
# El As tiene además tieneValorRangoBajo = 1 para la escalera baja A-2-3-4-5
# (conocida como 'rueda'). OWL no realiza aritmética; estos valores los
# consume la lógica externa (SPARQL, Python) para evaluar manos.

poker:Dos a poker:Rango ;
    poker:tieneValorRango "2"^^xsd:nonNegativeInteger ;
    rdfs:label "Dos" .
poker:Tres a poker:Rango ;
    poker:tieneValorRango "3"^^xsd:nonNegativeInteger ;
    rdfs:label "Tres" .
poker:Cuatro a poker:Rango ;
    poker:tieneValorRango "4"^^xsd:nonNegativeInteger ;
    rdfs:label "Cuatro" .
poker:Cinco a poker:Rango ;
    poker:tieneValorRango "5"^^xsd:nonNegativeInteger ;
    rdfs:label "Cinco" .
poker:Seis a poker:Rango ;
    poker:tieneValorRango "6"^^xsd:nonNegativeInteger ;
    rdfs:label "Seis" .
poker:Siete a poker:Rango ;
    poker:tieneValorRango "7"^^xsd:nonNegativeInteger ;
    rdfs:label "Siete" .
poker:Ocho a poker:Rango ;
    poker:tieneValorRango "8"^^xsd:nonNegativeInteger ;
    rdfs:label "Ocho" .
poker:Nueve a poker:Rango ;
    poker:tieneValorRango "9"^^xsd:nonNegativeInteger ;
    rdfs:label "Nueve" .
poker:Diez a poker:Rango ;
    poker:tieneValorRango "10"^^xsd:nonNegativeInteger ;
    rdfs:label "Diez" .
poker:Jota a poker:Rango ;
    poker:tieneValorRango "11"^^xsd:nonNegativeInteger ;
    rdfs:label "Jota" .
poker:Reina a poker:Rango ;
    poker:tieneValorRango "12"^^xsd:nonNegativeInteger ;
    rdfs:label "Reina" .
poker:Rey a poker:Rango ;
    poker:tieneValorRango "13"^^xsd:nonNegativeInteger ;
    rdfs:label "Rey" .
poker:As a poker:Rango ;
    poker:tieneValorRango "14"^^xsd:nonNegativeInteger ;
    poker:tieneValorRangoBajo "1"^^xsd:nonNegativeInteger ;
    rdfs:label "As" .

# Cadena estática de rangos para inferencia semántica en cuanto a orden de posición (el siguiente en valor)
# Ej: Dos → Tres → ... → Rey → As → Dos. Esto es usado sobretodo en las manos de Escalera de Color y Escalera Real. 
poker:As poker:tieneRangoSiguiente poker:Dos .
poker:Dos poker:tieneRangoSiguiente poker:Tres .
poker:Tres poker:tieneRangoSiguiente poker:Cuatro .
poker:Cuatro poker:tieneRangoSiguiente poker:Cinco .
poker:Cinco poker:tieneRangoSiguiente poker:Seis .
poker:Seis poker:tieneRangoSiguiente poker:Siete .
poker:Siete poker:tieneRangoSiguiente poker:Ocho .
poker:Ocho poker:tieneRangoSiguiente poker:Nueve .
poker:Nueve poker:tieneRangoSiguiente poker:Diez .
poker:Diez poker:tieneRangoSiguiente poker:Jota .
poker:Jota poker:tieneRangoSiguiente poker:Reina .
poker:Reina poker:tieneRangoSiguiente poker:Rey .
poker:Rey poker:tieneRangoSiguiente poker:As .

# Cartas (52 individuos) -----------------------------------------------------
# Convención de nombres: {Rango}De{Palo}  (ej. AsDePicas, ReyDeCorazones).
# Cada carta declara explícitamente tienePalo y tieneRango. Esto permite consultas
# SPARQL precisas y habilita el axioma AllDifferent del final del módulo.

# Carta con el Palo de Picas.

poker:DosDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Dos ;
    rdfs:label "Dos de Picas" .
poker:TresDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Tres ;
    rdfs:label "Tres de Picas" .
poker:CuatroDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Cuatro ;
    rdfs:label "Cuatro de Picas" .
poker:CincoDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Cinco ;
    rdfs:label "Cinco de Picas" .
poker:SeisDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Seis ;
    rdfs:label "Seis de Picas" .
poker:SieteDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Siete ;
    rdfs:label "Siete de Picas" .
poker:OchoDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Ocho ;
    rdfs:label "Ocho de Picas" .
poker:NueveDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Nueve ;
    rdfs:label "Nueve de Picas" .
poker:DiezDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Diez ;
    rdfs:label "Diez de Picas" .
poker:JotaDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Jota ;
    rdfs:label "Jota de Picas" .
poker:ReinaDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Reina ;
    rdfs:label "Reina de Picas" .
poker:ReyDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:Rey ;
    rdfs:label "Rey de Picas" .
poker:AsDePicas a poker:Carta ;
    poker:tienePalo poker:Picas ; poker:tieneRango poker:As ;
    rdfs:label "As de Picas" .

# Carta con el Palo de Corazones.

poker:DosDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Dos ;
    rdfs:label "Dos de Corazones" .
poker:TresDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Tres ;
    rdfs:label "Tres de Corazones" .
poker:CuatroDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Cuatro ;
    rdfs:label "Cuatro de Corazones" .
poker:CincoDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Cinco ;
    rdfs:label "Cinco de Corazones" .
poker:SeisDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Seis ;
    rdfs:label "Seis de Corazones" .
poker:SieteDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Siete ;
    rdfs:label "Siete de Corazones" .
poker:OchoDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Ocho ;
    rdfs:label "Ocho de Corazones" .
poker:NueveDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Nueve ;
    rdfs:label "Nueve de Corazones" .
poker:DiezDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Diez ;
    rdfs:label "Diez de Corazones" .
poker:JotaDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Jota ;
