# =============================================================================
# Ontología de Póker Texas Hold'em (Español)
# =============================================================================

@prefix : <http://www.poker-ontology.org/poker#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
#
# Propósito
# ---------
# Ontología escrita en Ontology Web Language (OWL) para modelar la estructura y
# las componentes que conforman las partidas de Póker, en particular la variante Texas Hold'em Poker.
# Esta es la ontología base que define sus clases, propiedades e individuos
# fundamentales. No contiene clasificadores para la inferencia de manos. Esos clasificadores se implementan
# como componentes separados que se le pueden agregar a esta ontología base y añaden sus propias
# restricciones owl:equivalentClass.
#
# Open World Assumption (OWA)
# ----------------------------------
# OWL asume que lo que no está afirmado es desconocido, no falso necesariamente.
# Para compensarlo, Palo y Rango se cierran con owl:oneOf (exactamente
# 4 palos y 13 rangos), y los 52 individuos de cartas se declaran
# AllDifferent para que el razonador los trate como entidades distintas (porque
# claramente son cartas distintas entre sí).
# =============================================================================

<http://www.poker-ontology.org/poker>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de Póker" ;
    rdfs:comment "Ontología OWL 2 DL que modela el juego de Texas Hold'em Poker." ;
    owl:versionInfo "2.0.0" .


# =============================================================================
# Palos y Rangos de las Cartas
# =============================================================================

# Palo y Rango se definen como clases cerradas usando owl:equivalentClass +
# owl:oneOf. Esto es necesario porque, bajo la Suposición de Mundo Abierto,
# OWL admitiría la existencia de un quinto palo no declarado (y evidentemente no existe, 
# pues el póker se juega con baraja inglesa). Con oneOf
# establecemos explícitamente los únicos individuos posibles:
#
#   Palo ≡ { Picas, Corazones, Diamantes, Tréboles }         (exactamente 4 palos)
#   Rango ≡ { Dos, Tres, Cuatro, Cinco, Seis, Siete, 
#           Ocho, Nueve, Diez, Jota, Reina, Rey, As }        (exactamente 13 rangos)

# Definición de la clase Palo.
poker:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Picas poker:Corazones poker:Diamantes poker:Treboles )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Picas, Corazones, Diamantes y Tréboles." .

# Definición de la clase Rango.
poker:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( poker:Dos poker:Tres poker:Cuatro poker:Cinco poker:Seis poker:Siete poker:Ocho poker:Nueve poker:Diez poker:Jota poker:Reina poker:Rey poker:As )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Jota, Reina, Rey y As ." .

# Carta es cualquier carta de la baraja inglesa estándar. Cada carta debe tener
# un palo (tienePalo) y un rango (tieneRango). Las cardinalidades
# exactas se garantizan marcando esas propiedades como FunctionalProperty

# Definición de la clase Carta, con restricciones sobre sus propiedades.
poker:Carta a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:someValuesFrom poker:Palo
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:tieneRango ;
        owl:someValuesFrom poker:Rango
    ] ;
    rdfs:label "Carta" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas." .

# Subclases de Carta por Palo, usadas por los clasificadores de manos.
# Cada clase agrupa todas las cartas de un palo específico (corazones, diamantes, picas, tréboles) mediante owl:hasValue.

poker:CartaDeCorazones a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Corazones
    ] ;
    rdfs:label "Carta de Corazones" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas, del palo de corazones." .

poker:CartaDeDiamantes a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Diamantes
    ] ;
    rdfs:label "Carta de Diamantes" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas, del palo de diamantes." .

poker:CartaDePicas a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Picas
    ] ;
    rdfs:label "Carta de Picas" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas, del palo de picas." .

poker:CartaDeTreboles a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty poker:tienePalo ;
        owl:hasValue poker:Treboles
    ] ;
    rdfs:label "Carta de Tréboles" ;
    rdfs:comment "Una carta de la baraja inglesa estándar de 52 cartas, del palo de tréboles." .

# Subclases de Carta por Rango, usadas por los clasificadores de ciertos tipos de manos.
# Cada clase agrupa las 4 cartas de un rango específico mediante owl:hasValue.

poker:CartaDeDos a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Dos ] ;
    rdfs:label "Carta de Dos" .

poker:CartaDeTres a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Tres ] ;
    rdfs:label "Carta de Tres" .

poker:CartaDeCuatro a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cuatro ] ;
    rdfs:label "Carta de Cuatro" .

poker:CartaDeCinco a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Cinco ] ;
    rdfs:label "Carta de Cinco" .

poker:CartaDeSeis a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Seis ] ;
    rdfs:label "Carta de Seis" .

poker:CartaDeSiete a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Siete ] ;
    rdfs:label "Carta de Siete" .

poker:CartaDeOcho a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Ocho ] ;
    rdfs:label "Carta de Ocho" .

poker:CartaDeNueve a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Nueve ] ;
    rdfs:label "Carta de Nueve" .

poker:CartaDeDiez a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Diez ] ;
    rdfs:label "Carta de Diez" .

poker:CartaDeJota a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Jota ] ;
    rdfs:label "Carta de Jota" .

poker:CartaDeReina a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Reina ] ;
    rdfs:label "Carta de Reina" .

poker:CartaDeRey a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:Rey ] ;
    rdfs:label "Carta de Rey" .

poker:CartaDeAs a owl:Class ;
    rdfs:subClassOf poker:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty poker:tieneRango ; owl:hasValue poker:As ] ;
    rdfs:label "Carta de As" .


# =============================================================================
# Grupos de Cartas
# =============================================================================

# Jerarquía de grupos de cartas:
#
#   GrupoDeCartas
#   └── Mano           La mejor combinación de 5 cartas del jugador

# Definición de la clase GrupoDeCartas
poker:GrupoDeCartas a owl:Class ;
    rdfs:label "Grupo de Cartas" ;
    rdfs:comment "Agrupación de cartas en el juego: la mejor mano formada por un jugador." .

# Definición de la clase Mano
poker:Mano a owl:Class ;
    rdfs:subClassOf poker:GrupoDeCartas ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:contieneCarta ;
        owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass poker:Carta
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty poker:contieneCarta ;
        owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass poker:Carta
    ] ;
    rdfs:label "Mano" ;
    rdfs:comment "La mejor combinación de 5 cartas de un jugador." .

# Jerarquía de tipos de mano, de menor a mayor fortaleza:
#
#   Mano
#   ├── CartaAlta      (1) Carta Alta: Sin combinación; gana la carta más alta
#   ├── Par            (2) Par: Dos cartas del mismo rango
#   ├── DoblePar       (3) Doble Par: Dos pares distintos
#   ├── Trío           (4) Trío: Tres cartas del mismo rango
#   ├── Escalera       (5) Escalera: Cinco cartas consecutivas de distintos palos
#   ├── Color          (6) Color: Cinco cartas del mismo palo
#   ├── FullHouse      (7) FullHouse: Un trío más un par
#   ├── Poker          (8) Póker: Cuatro cartas del mismo rango
#   └── EscaleraColor  (9) Escalera de Color: Cinco cartas consecutivas del mismo palo
#         └── EscaleraReal    Escalera Real: 10-J-Q-K-A del mismo palo (subclase de EscaleraColor)
#
# EscaleraReal es una subclase de EscaleraColor, no una clase independiente, pues es un 
# caso particular de la Escalera de Color. Las 9 clases base son mutuamente disjuntas. 
# Inferencialmente, alguna clasificación puede estar contenida dentro de otra 
# (por ejemplo, un FullHouse es la combinación entre un trío y un par), pero no son subclases 
# entre sí, sino clases disjuntas bajo Mano.
#
# Definición de la clase CartaAlta
poker:CartaAlta a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    rdfs:label "Carta Alta" ;
    rdfs:comment "Sin combinación; la carta más alta decide el ganador." .

# Definición de la clase Par
poker:Par a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Dos de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ]
                    # Tres de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ]
                    # Cuatro de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ]
                    # Cinco de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ]
                    # Seis de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ]
                    # Siete de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ]
                    # Ocho de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ]
                    # Nueve de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ]
                    # Diez de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ]
                    # Jota de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeJota ]
                    # Reina de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeReina ]
                    # Rey de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeRey ]
                    # As de cualquier rango
                    [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeAs ]
                )
            ]
        )
    ] ;
    rdfs:label "Par" ;
    rdfs:comment "Dos cartas del mismo rango, independientemente del palo." .

# Definición de la clase DoblePar
poker:DoblePar a owl:Class ;
    rdfs:subClassOf poker:Mano ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            poker:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Dos + Tres, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] ) ]
                    # Dos + Cuatro, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ] ) ]
                    # Dos + Cinco, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ] ) ]
                    # Dos + Seis, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ] ) ]
                    # Dos + Siete, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ] ) ]
                    # Dos + Ocho, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ] ) ]
                    # Dos + Nueve, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ] ) ]
                    # Dos + Diez, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ] ) ]
                    # Dos + Jota, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeJota ] ) ]
                    # Dos + Reina, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeReina ] ) ]
                    # Dos + Rey, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeRey ] ) ]
                    # Dos + As, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDos ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeAs ] ) ]
                    # Tres + Cuatro, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCuatro ] ) ]
                    # Tres + Cinco, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeCinco ] ) ]
                    # Tres + Seis, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSeis ] ) ]
                    # Tres + Siete, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeSiete ] ) ]
                    # Tres + Ocho, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeOcho ] ) ]
                    # Tres + Nueve, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeNueve ] ) ]
                    # Tres + Diez, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeDiez ] ) ]
                    # Tres + Jota, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeJota ] ) ]
                    # Tres + Reina, de cualquier rango
                    [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeTres ] [ a owl:Restriction ; owl:onProperty poker:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass poker:CartaDeReina ] ) ]
                    # Tres + Rey, de cualquier rango
