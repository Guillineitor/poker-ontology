poker:SeisDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Seis ;
    rdfs:label "Seis de Corazones" .
poker:SieteDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Siete ;
