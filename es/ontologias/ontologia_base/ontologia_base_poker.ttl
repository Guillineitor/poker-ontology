poker:DiezDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Diez ;
    rdfs:label "Diez de Corazones" .
poker:JotaDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Jota ;
    rdfs:label "Jota de Corazones" .
poker:ReinaDeCorazones a poker:Carta ;
    poker:tienePalo poker:Corazones ; poker:tieneRango poker:Reina ;
