# =============================================================================
# Ontología de baraja: baraja_31r_4p
# Generada automáticamente por generar_ontologia_baraja.py
# =============================================================================

@prefix deck: <http://www.ontologia-baraja.org/baraja_31r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
#
# Propósito
# ---------
# Ontología OWL 2 DL que modela la estructura de una baraja de tipo 'baraja_31r_4p'.
# Palos  : 4
# Rangos : 31
# Cartas : 124
#
# Open World Assumption (OWA)
# ---------------------------
# Palo, Rango y Carta se cierran con owl:oneOf para evitar que el razonador
# asuma palos, rangos o cartas adicionales no declaradas.
# Los 124 individuos de cartas se declaran AllDifferent.
# =============================================================================

<http://www.ontologia-baraja.org/baraja_31r_4p>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de baraja baraja_31r_4p" ;
    rdfs:comment "Ontología OWL 2 DL que modela la baraja 'baraja_31r_4p' (4 palos × 31 rangos = 124 cartas)." ;
    owl:versionInfo "1.0.0" .


# =============================================================================
# Palos y Rangos de las Cartas
# =============================================================================
#
# Palo  ≡ { Fuego, Agua, Planta, Electrico }  (4 palos)
#

# Definición de la clase Palo.
deck:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( deck:Fuego deck:Agua deck:Planta deck:Electrico )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Fuego, Agua, Planta, Electrico." .

# Definición de la clase Rango.
deck:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( deck:Uno deck:Dos deck:Tres deck:Cuatro deck:Cinco deck:Seis deck:Siete deck:Ocho deck:Nueve deck:Diez deck:Once deck:Doce deck:Trece deck:Catorce deck:Quince deck:Dieciseis deck:Diecisiete deck:Dieciocho deck:Diecinueve deck:Veinte deck:Veintiuno deck:Veintidos deck:Veintitres deck:Veinticuatro deck:Veinticinco deck:Veintiseis deck:Veintisiete deck:Veintiocho deck:Veintinueve deck:Treinta deck:Treintayuno )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Uno, Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Once, Doce, Trece, Catorce, Quince, Dieciseis, Diecisiete, Dieciocho, Diecinueve, Veinte, Veintiuno, Veintidos, Veintitres, Veinticuatro, Veinticinco, Veintiseis, Veintisiete, Veintiocho, Veintinueve, Treinta, Treintayuno." .

# Definición de la clase Carta.
deck:Carta a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            deck:UnoDeFuego deck:DosDeFuego deck:TresDeFuego deck:CuatroDeFuego deck:CincoDeFuego deck:SeisDeFuego deck:SieteDeFuego deck:OchoDeFuego deck:NueveDeFuego deck:DiezDeFuego deck:OnceDeFuego deck:DoceDeFuego deck:TreceDeFuego deck:CatorceDeFuego deck:QuinceDeFuego deck:DieciseisDeFuego deck:DiecisieteDeFuego deck:DieciochoDeFuego deck:DiecinueveDeFuego deck:VeinteDeFuego deck:VeintiunoDeFuego deck:VeintidosDeFuego deck:VeintitresDeFuego deck:VeinticuatroDeFuego deck:VeinticincoDeFuego deck:VeintiseisDeFuego deck:VeintisieteDeFuego deck:VeintiochoDeFuego deck:VeintinueveDeFuego deck:TreintaDeFuego deck:TreintayunoDeFuego
            deck:UnoDeAgua deck:DosDeAgua deck:TresDeAgua deck:CuatroDeAgua deck:CincoDeAgua deck:SeisDeAgua deck:SieteDeAgua deck:OchoDeAgua deck:NueveDeAgua deck:DiezDeAgua deck:OnceDeAgua deck:DoceDeAgua deck:TreceDeAgua deck:CatorceDeAgua deck:QuinceDeAgua deck:DieciseisDeAgua deck:DiecisieteDeAgua deck:DieciochoDeAgua deck:DiecinueveDeAgua deck:VeinteDeAgua deck:VeintiunoDeAgua deck:VeintidosDeAgua deck:VeintitresDeAgua deck:VeinticuatroDeAgua deck:VeinticincoDeAgua deck:VeintiseisDeAgua deck:VeintisieteDeAgua deck:VeintiochoDeAgua deck:VeintinueveDeAgua deck:TreintaDeAgua deck:TreintayunoDeAgua
            deck:UnoDePlanta deck:DosDePlanta deck:TresDePlanta deck:CuatroDePlanta deck:CincoDePlanta deck:SeisDePlanta deck:SieteDePlanta deck:OchoDePlanta deck:NueveDePlanta deck:DiezDePlanta deck:OnceDePlanta deck:DoceDePlanta deck:TreceDePlanta deck:CatorceDePlanta deck:QuinceDePlanta deck:DieciseisDePlanta deck:DiecisieteDePlanta deck:DieciochoDePlanta deck:DiecinueveDePlanta deck:VeinteDePlanta deck:VeintiunoDePlanta deck:VeintidosDePlanta deck:VeintitresDePlanta deck:VeinticuatroDePlanta deck:VeinticincoDePlanta deck:VeintiseisDePlanta deck:VeintisieteDePlanta deck:VeintiochoDePlanta deck:VeintinueveDePlanta deck:TreintaDePlanta deck:TreintayunoDePlanta
            deck:UnoDeElectrico deck:DosDeElectrico deck:TresDeElectrico deck:CuatroDeElectrico deck:CincoDeElectrico deck:SeisDeElectrico deck:SieteDeElectrico deck:OchoDeElectrico deck:NueveDeElectrico deck:DiezDeElectrico deck:OnceDeElectrico deck:DoceDeElectrico deck:TreceDeElectrico deck:CatorceDeElectrico deck:QuinceDeElectrico deck:DieciseisDeElectrico deck:DiecisieteDeElectrico deck:DieciochoDeElectrico deck:DiecinueveDeElectrico deck:VeinteDeElectrico deck:VeintiunoDeElectrico deck:VeintidosDeElectrico deck:VeintitresDeElectrico deck:VeinticuatroDeElectrico deck:VeinticincoDeElectrico deck:VeintiseisDeElectrico deck:VeintisieteDeElectrico deck:VeintiochoDeElectrico deck:VeintinueveDeElectrico deck:TreintaDeElectrico deck:TreintayunoDeElectrico
        )
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:someValuesFrom deck:Palo
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:tieneRango ;
        owl:someValuesFrom deck:Rango
    ] ;
    rdfs:label "Carta" ;
    rdfs:comment "Una carta de la baraja." .

# Subclases de Carta por Palo.

deck:CartaDeFuego a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:hasValue deck:Fuego
    ] ;
    rdfs:label "Carta de Fuego" ;
    rdfs:comment "Una carta del palo de Fuego." .

deck:CartaDeAgua a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
