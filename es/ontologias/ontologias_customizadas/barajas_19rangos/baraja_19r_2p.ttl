# 2 palos distintos
[] a owl:AllDifferent ;
    owl:distinctMembers ( deck:Fuego deck:Agua ) .

# 19 rangos distintos
[] a owl:AllDifferent ;
    owl:distinctMembers ( deck:Uno deck:Dos deck:Tres deck:Cuatro deck:Cinco deck:Seis deck:Siete deck:Ocho deck:Nueve deck:Diez deck:Once deck:Doce deck:Trece deck:Catorce deck:Quince deck:Dieciseis deck:Diecisiete deck:Dieciocho deck:Diecinueve ) .

# 38 cartas distintas
[] a owl:AllDifferent ;
    owl:distinctMembers (
        deck:UnoDeFuego deck:DosDeFuego deck:TresDeFuego deck:CuatroDeFuego deck:CincoDeFuego deck:SeisDeFuego deck:SieteDeFuego deck:OchoDeFuego deck:NueveDeFuego deck:DiezDeFuego deck:OnceDeFuego deck:DoceDeFuego deck:TreceDeFuego deck:CatorceDeFuego deck:QuinceDeFuego deck:DieciseisDeFuego deck:DiecisieteDeFuego deck:DieciochoDeFuego deck:DiecinueveDeFuego
        deck:UnoDeAgua deck:DosDeAgua deck:TresDeAgua deck:CuatroDeAgua deck:CincoDeAgua deck:SeisDeAgua deck:SieteDeAgua deck:OchoDeAgua deck:NueveDeAgua deck:DiezDeAgua deck:OnceDeAgua deck:DoceDeAgua deck:TreceDeAgua deck:CatorceDeAgua deck:QuinceDeAgua deck:DieciseisDeAgua deck:DiecisieteDeAgua deck:DieciochoDeAgua deck:DiecinueveDeAgua
    ) .
