    rdfs:label "Doce" .

deck:Trece a deck:Rango ;
    deck:tieneValorRango "13"^^xsd:nonNegativeInteger ;
    rdfs:label "Trece" .

deck:Catorce a deck:Rango ;
    deck:tieneValorRango "14"^^xsd:nonNegativeInteger ;
    rdfs:label "Catorce" .

deck:Quince a deck:Rango ;
    deck:tieneValorRango "15"^^xsd:nonNegativeInteger ;
    rdfs:label "Quince" .

deck:Dieciseis a deck:Rango ;
