# =============================================================================
#
# Propósito
# ---------
# Ontología OWL 2 DL que modela la estructura de una baraja de tipo 'baraja_37r_16p'.
# Palos  : 16
# Rangos : 37
# Cartas : 592
#
# Open World Assumption (OWA)
# ---------------------------
# Palo, Rango y Carta se cierran con owl:oneOf para evitar que el razonador
# asuma palos, rangos o cartas adicionales no declaradas.
# Los 592 individuos de cartas se declaran AllDifferent.
# =============================================================================

<http://www.ontologia-baraja.org/baraja_37r_16p>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de baraja baraja_37r_16p" ;
    rdfs:comment "Ontología OWL 2 DL que modela la baraja 'baraja_37r_16p' (16 palos × 37 rangos = 592 cartas)." ;
    owl:versionInfo "1.0.0" .


# =============================================================================
# Palos y Rangos de las Cartas
# =============================================================================
#
# Palo  ≡ { Fuego, Agua, Planta, Electrico, Normal, Volador, Bicho, Veneno, Tierra, Roca, Lucha, Psiquico, Fantasma, Hielo, Dragon, Siniestro }  (16 palos)
#

# Definición de la clase Palo.
deck:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( deck:Fuego deck:Agua deck:Planta deck:Electrico deck:Normal deck:Volador deck:Bicho deck:Veneno deck:Tierra deck:Roca deck:Lucha deck:Psiquico deck:Fantasma deck:Hielo deck:Dragon deck:Siniestro )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Fuego, Agua, Planta, Electrico, Normal, Volador, Bicho, Veneno, Tierra, Roca, Lucha, Psiquico, Fantasma, Hielo, Dragon, Siniestro." .

# Definición de la clase Rango.
deck:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( deck:Uno deck:Dos deck:Tres deck:Cuatro deck:Cinco deck:Seis deck:Siete deck:Ocho deck:Nueve deck:Diez deck:Once deck:Doce deck:Trece deck:Catorce deck:Quince deck:Dieciseis deck:Diecisiete deck:Dieciocho deck:Diecinueve deck:Veinte deck:Veintiuno deck:Veintidos deck:Veintitres deck:Veinticuatro deck:Veinticinco deck:Veintiseis deck:Veintisiete deck:Veintiocho deck:Veintinueve deck:Treinta deck:Treintayuno deck:Treintaydos deck:Treintaytres deck:Treintaycuatro deck:Treintaycinco deck:Treintayseis deck:Treintaysiete )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Uno, Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Once, Doce, Trece, Catorce, Quince, Dieciseis, Diecisiete, Dieciocho, Diecinueve, Veinte, Veintiuno, Veintidos, Veintitres, Veinticuatro, Veinticinco, Veintiseis, Veintisiete, Veintiocho, Veintinueve, Treinta, Treintayuno, Treintaydos, Treintaytres, Treintaycuatro, Treintaycinco, Treintayseis, Treintaysiete." .

