# =============================================================================
# Grupos de Cartas
# =============================================================================

# Definición de la clase Mano.
deck:Mano a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:contieneCarta ;
        owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass deck:Carta
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:contieneCarta ;
        owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
        owl:onClass deck:Carta
    ] ;
    rdfs:label "Mano" ;
    rdfs:comment "La mejor combinación de 5 cartas de un jugador." .

# =============================================================================
# Clasificadores de Manos
# =============================================================================
#
# Jerarquía de tipos de mano generados para esta baraja:
#   Mano
#   ├── CartaAlta      (1) Sin combinación; gana la carta más alta
#   ├── Par            (2) Dos cartas del mismo rango
#   ├── DoblePar       (3) Dos pares distintos
#   ├── Trio           (4) Tres cartas del mismo rango
#   ├── Escalera       (5) Cinco cartas consecutivas
#   ├── Color          (6) Cinco cartas del mismo palo
#   ├── Full           (7) Un trío más un par
#   ├── Poker          (8) Cuatro cartas del mismo rango
#   ├── EscaleraColor  (9) Cinco cartas consecutivas del mismo palo
#   ├── EscaleraReal   (10) Rangos más altos del mismo palo
#

# Definición de la clase CartaAlta.
deck:CartaAlta a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Restriction ;
                owl:onProperty deck:contieneCarta ;
                owl:someValuesFrom deck:Carta
            ]
        )
    ] ;
    rdfs:subClassOf deck:Mano ;
    rdfs:label "Carta Alta" ;
    rdfs:comment "Mano formada sin combinación; la carta más alta decide el ganador." .

# Definición de la clase Par.
deck:Par a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Par de Uno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeUno ]
                    # Par de Dos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                    # Par de Tres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                    # Par de Cuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                    # Par de Cinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                    # Par de Seis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                    # Par de Siete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                    # Par de Ocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                    # Par de Nueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                    # Par de Diez de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                    # Par de Once de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                    # Par de Doce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                    # Par de Trece de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                    # Par de Catorce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                    # Par de Quince de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                    # Par de Dieciseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDieciseis ]
                    # Par de Diecisiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiecisiete ]
                    # Par de Dieciocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDieciocho ]
                    # Par de Diecinueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiecinueve ]
                    # Par de Veinte de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinte ]
                    # Par de Veintiuno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiuno ]
                    # Par de Veintidos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintidos ]
                    # Par de Veintitres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintitres ]
                    # Par de Veinticuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinticuatro ]
                    # Par de Veinticinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinticinco ]
                    # Par de Veintiseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiseis ]
                    # Par de Veintisiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintisiete ]
                    # Par de Veintiocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiocho ]
                    # Par de Veintinueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintinueve ]
                    # Par de Treinta de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreinta ]
                    # Par de Treintayuno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintayuno ]
                    # Par de Treintaydos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaydos ]
                    # Par de Treintaytres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaytres ]
                    # Par de Treintaycuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaycuatro ]
                    # Par de Treintaycinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaycinco ]
                    # Par de Treintayseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintayseis ]
                    # Par de Treintaysiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaysiete ]
                )
            ]
        )
    ] ;
    rdfs:label "Par" ;
    rdfs:comment "Mano formada por dos cartas del mismo rango." .

# Definición de la clase DoblePar.
# Usa el atajo manoTienePar: la mano tiene al menos 2 rangos con par.
deck:DoblePar a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [ a owl:Restriction ;
              owl:onProperty deck:manoTienePar ;
              owl:minCardinality "2"^^xsd:nonNegativeInteger ]
        )
    ] ;
    rdfs:label "Doble Par" ;
    rdfs:comment "Mano formada por dos pares de rangos distintos, independientemente del palo." .

# Definición de la clase Trio.
deck:Trio a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Trío de Uno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeUno ]
                    # Trío de Dos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                    # Trío de Tres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                    # Trío de Cuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                    # Trío de Cinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                    # Trío de Seis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                    # Trío de Siete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                    # Trío de Ocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                    # Trío de Nueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                    # Trío de Diez de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                    # Trío de Once de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                    # Trío de Doce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                    # Trío de Trece de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                    # Trío de Catorce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                    # Trío de Quince de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                    # Trío de Dieciseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDieciseis ]
                    # Trío de Diecisiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiecisiete ]
                    # Trío de Dieciocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDieciocho ]
                    # Trío de Diecinueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiecinueve ]
                    # Trío de Veinte de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinte ]
                    # Trío de Veintiuno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiuno ]
                    # Trío de Veintidos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintidos ]
                    # Trío de Veintitres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintitres ]
                    # Trío de Veinticuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinticuatro ]
                    # Trío de Veinticinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinticinco ]
                    # Trío de Veintiseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiseis ]
                    # Trío de Veintisiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintisiete ]
                    # Trío de Veintiocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiocho ]
                    # Trío de Veintinueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintinueve ]
                    # Trío de Treinta de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreinta ]
                    # Trío de Treintayuno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintayuno ]
                    # Trío de Treintaydos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaydos ]
                    # Trío de Treintaytres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaytres ]
                    # Trío de Treintaycuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaycuatro ]
                    # Trío de Treintaycinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaycinco ]
                    # Trío de Treintayseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintayseis ]
                    # Trío de Treintaysiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaysiete ]
                )
            ]
        )
    ] ;
    rdfs:label "Trío" ;
    rdfs:comment "Mano formada por tres cartas del mismo rango." .

# Definición de la clase Escalera.
deck:Escalera a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Escalera Uno-Dos-Tres-Cuatro-Cinco.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeUno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                    )]
                    # Escalera Dos-Tres-Cuatro-Cinco-Seis.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                    )]
                    # Escalera Tres-Cuatro-Cinco-Seis-Siete.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                    )]
                    # Escalera Cuatro-Cinco-Seis-Siete-Ocho.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                    )]
                    # Escalera Cinco-Seis-Siete-Ocho-Nueve.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                    )]
                    # Escalera Seis-Siete-Ocho-Nueve-Diez.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSeis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                    )]
                    # Escalera Siete-Ocho-Nueve-Diez-Once.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeSiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                    )]
                    # Escalera Ocho-Nueve-Diez-Once-Doce.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOcho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                    )]
                    # Escalera Nueve-Diez-Once-Doce-Trece.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeNueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                    )]
                    # Escalera Diez-Once-Doce-Trece-Catorce.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiez ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
                    )]
                    # Escalera Once-Doce-Trece-Catorce-Quince.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeOnce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeQuince ]
                    )]
                    # Escalera Doce-Trece-Catorce-Quince-Dieciseis.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDoce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeQuince ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciseis ]
                    )]
                    # Escalera Trece-Catorce-Quince-Dieciseis-Diecisiete.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTrece ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeQuince ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecisiete ]
                    )]
                    # Escalera Catorce-Quince-Dieciseis-Diecisiete-Dieciocho.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeCatorce ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeQuince ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecisiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciocho ]
                    )]
                    # Escalera Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeQuince ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecisiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciocho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecinueve ]
                    )]
                    # Escalera Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecisiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciocho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecinueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinte ]
                    )]
                    # Escalera Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecisiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciocho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecinueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinte ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiuno ]
                    )]
                    # Escalera Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDieciocho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecinueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinte ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiuno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintidos ]
                    )]
                    # Escalera Diecinueve-Veinte-Veintiuno-Veintidos-Veintitres.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeDiecinueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinte ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiuno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintidos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintitres ]
                    )]
                    # Escalera Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinte ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiuno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintidos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintitres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticuatro ]
                    )]
                    # Escalera Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiuno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintidos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintitres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticinco ]
                    )]
                    # Escalera Veintidos-Veintitres-Veinticuatro-Veinticinco-Veintiseis.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintidos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintitres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiseis ]
                    )]
                    # Escalera Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintitres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintisiete ]
                    )]
                    # Escalera Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintisiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiocho ]
                    )]
                    # Escalera Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeinticinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintisiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiocho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintinueve ]
                    )]
                    # Escalera Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintisiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiocho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintinueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreinta ]
                    )]
                    # Escalera Veintisiete-Veintiocho-Veintinueve-Treinta-Treintayuno.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintisiete ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiocho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintinueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreinta ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintayuno ]
                    )]
                    # Escalera Veintiocho-Veintinueve-Treinta-Treintayuno-Treintaydos.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintiocho ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintinueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreinta ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintayuno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaydos ]
                    )]
                    # Escalera Veintinueve-Treinta-Treintayuno-Treintaydos-Treintaytres.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeVeintinueve ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreinta ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintayuno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaydos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaytres ]
                    )]
                    # Escalera Treinta-Treintayuno-Treintaydos-Treintaytres-Treintaycuatro.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreinta ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintayuno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaydos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaytres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycuatro ]
                    )]
                    # Escalera Treintayuno-Treintaydos-Treintaytres-Treintaycuatro-Treintaycinco.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintayuno ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaydos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaytres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycinco ]
                    )]
                    # Escalera Treintaydos-Treintaytres-Treintaycuatro-Treintaycinco-Treintayseis.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaydos ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaytres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintayseis ]
                    )]
                    # Escalera Treintaytres-Treintaycuatro-Treintaycinco-Treintayseis-Treintaysiete.
                    [ a owl:Class ; owl:intersectionOf (
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaytres ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycuatro ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycinco ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintayseis ]
                        [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaysiete ]
                    )]
                )
            ]
        )
    ] ;
    rdfs:label "Escalera" ;
    rdfs:comment "Mano formada por cinco cartas de rangos consecutivos, no necesariamente del mismo palo." .

# Definición de la clase Color.
deck:Color a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Color de Fuego.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeFuego ]
                    # Color de Agua.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeAgua ]
                    # Color de Planta.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDePlanta ]
                    # Color de Eléctrico.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeElectrico ]
                    # Color de Normal.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeNormal ]
                    # Color de Volador.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeVolador ]
                    # Color de Bicho.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeBicho ]
                    # Color de Veneno.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeVeneno ]
                    # Color de Tierra.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeTierra ]
                    # Color de Roca.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeRoca ]
                    # Color de Lucha.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeLucha ]
                    # Color de Psíquico.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDePsiquico ]
                    # Color de Fantasma.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeFantasma ]
                    # Color de Hielo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeHielo ]
                    # Color de Dragón.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeDragon ]
                    # Color de Siniestro.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:allValuesFrom deck:CartaDeSiniestro ]
                )
            ]
        )
    ] ;
    rdfs:label "Color" ;
    rdfs:comment "Mano formada por cinco cartas del mismo palo, no necesariamente consecutivas." .

# Definición de la clase Full.
# Observación: El Full es la intersección de Trio y DoblePar.
deck:Full a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Trio
            deck:DoblePar
        )
    ] ;
    rdfs:label "Full" ;
    rdfs:comment "Mano formada por tres cartas del mismo rango y dos cartas de otro mismo rango." .

# Definición de la clase Poker.
deck:Poker a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Mano
            [
                a owl:Class ;
                owl:unionOf (
                    # Póker de Uno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeUno ]
                    # Póker de Dos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDos ]
                    # Póker de Tres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTres ]
                    # Póker de Cuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCuatro ]
                    # Póker de Cinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCinco ]
                    # Póker de Seis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSeis ]
                    # Póker de Siete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeSiete ]
                    # Póker de Ocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOcho ]
                    # Póker de Nueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeNueve ]
                    # Póker de Diez de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiez ]
                    # Póker de Once de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeOnce ]
                    # Póker de Doce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDoce ]
                    # Póker de Trece de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTrece ]
                    # Póker de Catorce de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeCatorce ]
                    # Póker de Quince de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeQuince ]
                    # Póker de Dieciseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDieciseis ]
                    # Póker de Diecisiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiecisiete ]
                    # Póker de Dieciocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDieciocho ]
                    # Póker de Diecinueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeDiecinueve ]
                    # Póker de Veinte de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinte ]
                    # Póker de Veintiuno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiuno ]
                    # Póker de Veintidos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintidos ]
                    # Póker de Veintitres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintitres ]
                    # Póker de Veinticuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinticuatro ]
                    # Póker de Veinticinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeinticinco ]
                    # Póker de Veintiseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiseis ]
                    # Póker de Veintisiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintisiete ]
                    # Póker de Veintiocho de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintiocho ]
                    # Póker de Veintinueve de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeVeintinueve ]
                    # Póker de Treinta de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreinta ]
                    # Póker de Treintayuno de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintayuno ]
                    # Póker de Treintaydos de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaydos ]
                    # Póker de Treintaytres de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaytres ]
                    # Póker de Treintaycuatro de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaycuatro ]
                    # Póker de Treintaycinco de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaycinco ]
                    # Póker de Treintayseis de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintayseis ]
                    # Póker de Treintaysiete de cualquier palo.
                    [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:minQualifiedCardinality "4"^^xsd:nonNegativeInteger ; owl:onClass deck:CartaDeTreintaysiete ]
                )
            ]
        )
    ] ;
    rdfs:label "Póker" ;
    rdfs:comment "Mano formada por cuatro cartas del mismo rango y una carta cualquiera." .

# Definición de la clase EscaleraColor.
# Truco: intersección de Escalera y Color → no hay que enumerar combinaciones de palo.
deck:EscaleraColor a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:Escalera
            deck:Color
        )
    ] ;
    rdfs:label "Escalera de Color" ;
    rdfs:comment "Mano formada por cinco cartas consecutivas del mismo palo." .

# Definición de la clase EscaleraReal.
# Subclase de EscaleraColor con los 5 rangos más altos (Treintaytres-Treintaycuatro-Treintaycinco-Treintayseis-Treintaysiete).
deck:EscaleraReal a owl:Class ;
    rdfs:subClassOf deck:EscaleraColor ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            deck:EscaleraColor
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaytres ]
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycuatro ]
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaycinco ]
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintayseis ]
            [ a owl:Restriction ; owl:onProperty deck:contieneCarta ; owl:someValuesFrom deck:CartaDeTreintaysiete ]
        )
    ] ;
    rdfs:label "Escalera Real" ;
    rdfs:comment "Mano formada por los cinco rangos más altos consecutivos (Treintaytres-Treintaycuatro-Treintaycinco-Treintayseis-Treintaysiete) del mismo palo." .


# =============================================================================
# Propiedades de Objeto
# =============================================================================

deck:tienePalo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain deck:Carta ;
    rdfs:range deck:Palo ;
    rdfs:label "Tiene Palo" ;
    rdfs:comment "Asocia una carta con su palo. Funcional: cada carta tiene exactamente un palo." .

deck:tieneRango a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain deck:Carta ;
    rdfs:range deck:Rango ;
    rdfs:label "Tiene Rango" ;
    rdfs:comment "Asocia una carta con su rango. Funcional: cada carta tiene exactamente un rango." .

deck:contieneCarta a owl:ObjectProperty ;
    rdfs:domain deck:Mano ;
    rdfs:range deck:Carta ;
    rdfs:label "Contiene Carta" ;
    rdfs:comment "Relaciona una mano con cada una de las cartas que la componen." .

deck:manoTienePar a owl:ObjectProperty ;
    rdfs:domain deck:Mano ;
    rdfs:range  deck:Rango ;
    rdfs:label  "Mano tiene Par" ;
    rdfs:comment "Atajo que indica qué rangos están presentes con al menos 2 cartas en la mano. Se agrega manualmente en el ABox. Usado por el clasificador de DoblePar." .

# =============================================================================
# Propiedades de Datos
# =============================================================================

deck:tieneValorRango a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain deck:Rango ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Tiene Valor De Rango" ;
    rdfs:comment "Valor numérico del rango. Usado por evaluadores externos." .

# =============================================================================
# Instancias (ABox)
# =============================================================================

# Palos (16 individuos) -------------------------------------------

deck:Fuego a deck:Palo ;
    rdfs:label "Fuego" .
deck:Agua a deck:Palo ;
    rdfs:label "Agua" .
deck:Planta a deck:Palo ;
    rdfs:label "Planta" .
deck:Electrico a deck:Palo ;
    rdfs:label "Eléctrico" .
deck:Normal a deck:Palo ;
    rdfs:label "Normal" .
deck:Volador a deck:Palo ;
    rdfs:label "Volador" .
deck:Bicho a deck:Palo ;
    rdfs:label "Bicho" .
deck:Veneno a deck:Palo ;
    rdfs:label "Veneno" .
deck:Tierra a deck:Palo ;
    rdfs:label "Tierra" .
deck:Roca a deck:Palo ;
    rdfs:label "Roca" .
deck:Lucha a deck:Palo ;
    rdfs:label "Lucha" .
deck:Psiquico a deck:Palo ;
    rdfs:label "Psíquico" .
deck:Fantasma a deck:Palo ;
    rdfs:label "Fantasma" .
deck:Hielo a deck:Palo ;
    rdfs:label "Hielo" .
deck:Dragon a deck:Palo ;
    rdfs:label "Dragón" .
deck:Siniestro a deck:Palo ;
    rdfs:label "Siniestro" .

# Rangos (37 individuos) -------------------------------------------
# Los valores van de 1 (primer rango) a 37 (último rango).

deck:Uno a deck:Rango ;
    deck:tieneValorRango "1"^^xsd:nonNegativeInteger ;
    rdfs:label "Uno" .

deck:Dos a deck:Rango ;
    deck:tieneValorRango "2"^^xsd:nonNegativeInteger ;
    rdfs:label "Dos" .

deck:Tres a deck:Rango ;
    deck:tieneValorRango "3"^^xsd:nonNegativeInteger ;
    rdfs:label "Tres" .

deck:Cuatro a deck:Rango ;
    deck:tieneValorRango "4"^^xsd:nonNegativeInteger ;
    rdfs:label "Cuatro" .

deck:Cinco a deck:Rango ;
    deck:tieneValorRango "5"^^xsd:nonNegativeInteger ;
    rdfs:label "Cinco" .

deck:Seis a deck:Rango ;
    deck:tieneValorRango "6"^^xsd:nonNegativeInteger ;
    rdfs:label "Seis" .

deck:Siete a deck:Rango ;
    deck:tieneValorRango "7"^^xsd:nonNegativeInteger ;
    rdfs:label "Siete" .

deck:Ocho a deck:Rango ;
    deck:tieneValorRango "8"^^xsd:nonNegativeInteger ;
    rdfs:label "Ocho" .

deck:Nueve a deck:Rango ;
    deck:tieneValorRango "9"^^xsd:nonNegativeInteger ;
    rdfs:label "Nueve" .

deck:Diez a deck:Rango ;
    deck:tieneValorRango "10"^^xsd:nonNegativeInteger ;
    rdfs:label "Diez" .

deck:Once a deck:Rango ;
    deck:tieneValorRango "11"^^xsd:nonNegativeInteger ;
    rdfs:label "Once" .

deck:Doce a deck:Rango ;
    deck:tieneValorRango "12"^^xsd:nonNegativeInteger ;
    rdfs:label "Doce" .

