        owl:onProperty deck:tienePalo ;
        owl:hasValue deck:Bicho
    ] ;
    rdfs:label "Carta de Bicho" ;
    rdfs:comment "Una carta del palo de Bicho." .

deck:CartaDeVeneno a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
