deck:CartaDeVeintiuno a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty deck:tieneRango ; owl:hasValue deck:Veintiuno ] ;
    rdfs:label "Carta de Veintiuno" .

deck:CartaDeVeintidos a owl:Class ;
