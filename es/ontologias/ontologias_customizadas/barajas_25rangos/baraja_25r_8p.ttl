# =============================================================================
# Ontología de baraja: baraja_25r_8p
# Generada automáticamente por generar_ontologia_baraja.py
# =============================================================================

@prefix deck: <http://www.ontologia-baraja.org/baraja_25r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
#
# Propósito
# ---------
# Ontología OWL 2 DL que modela la estructura de una baraja de tipo 'baraja_25r_8p'.
# Palos  : 8
# Rangos : 25
# Cartas : 200
#
# Open World Assumption (OWA)
# ---------------------------
# Palo, Rango y Carta se cierran con owl:oneOf para evitar que el razonador
# asuma palos, rangos o cartas adicionales no declaradas.
# Los 200 individuos de cartas se declaran AllDifferent.
# =============================================================================

<http://www.ontologia-baraja.org/baraja_25r_8p>
    rdf:type owl:Ontology ;
    rdfs:label "Ontología de baraja baraja_25r_8p" ;
    rdfs:comment "Ontología OWL 2 DL que modela la baraja 'baraja_25r_8p' (8 palos × 25 rangos = 200 cartas)." ;
    owl:versionInfo "1.0.0" .


# =============================================================================
# Palos y Rangos de las Cartas
# =============================================================================
#
# Palo  ≡ { Fuego, Agua, Planta, Electrico, Normal, Volador, Bicho, Veneno }  (8 palos)
#

# Definición de la clase Palo.
deck:Palo a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( deck:Fuego deck:Agua deck:Planta deck:Electrico deck:Normal deck:Volador deck:Bicho deck:Veneno )
    ] ;
    rdfs:label "Palo" ;
    rdfs:comment "Palo de una carta. Clase cerrada: exactamente Fuego, Agua, Planta, Electrico, Normal, Volador, Bicho, Veneno." .

# Definición de la clase Rango.
deck:Rango a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( deck:Uno deck:Dos deck:Tres deck:Cuatro deck:Cinco deck:Seis deck:Siete deck:Ocho deck:Nueve deck:Diez deck:Once deck:Doce deck:Trece deck:Catorce deck:Quince deck:Dieciseis deck:Diecisiete deck:Dieciocho deck:Diecinueve deck:Veinte deck:Veintiuno deck:Veintidos deck:Veintitres deck:Veinticuatro deck:Veinticinco )
    ] ;
    rdfs:label "Rango" ;
    rdfs:comment "Rango de una carta. Clase cerrada: exactamente Uno, Dos, Tres, Cuatro, Cinco, Seis, Siete, Ocho, Nueve, Diez, Once, Doce, Trece, Catorce, Quince, Dieciseis, Diecisiete, Dieciocho, Diecinueve, Veinte, Veintiuno, Veintidos, Veintitres, Veinticuatro, Veinticinco." .

# Definición de la clase Carta.
deck:Carta a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf (
            deck:UnoDeFuego deck:DosDeFuego deck:TresDeFuego deck:CuatroDeFuego deck:CincoDeFuego deck:SeisDeFuego deck:SieteDeFuego deck:OchoDeFuego deck:NueveDeFuego deck:DiezDeFuego deck:OnceDeFuego deck:DoceDeFuego deck:TreceDeFuego deck:CatorceDeFuego deck:QuinceDeFuego deck:DieciseisDeFuego deck:DiecisieteDeFuego deck:DieciochoDeFuego deck:DiecinueveDeFuego deck:VeinteDeFuego deck:VeintiunoDeFuego deck:VeintidosDeFuego deck:VeintitresDeFuego deck:VeinticuatroDeFuego deck:VeinticincoDeFuego
            deck:UnoDeAgua deck:DosDeAgua deck:TresDeAgua deck:CuatroDeAgua deck:CincoDeAgua deck:SeisDeAgua deck:SieteDeAgua deck:OchoDeAgua deck:NueveDeAgua deck:DiezDeAgua deck:OnceDeAgua deck:DoceDeAgua deck:TreceDeAgua deck:CatorceDeAgua deck:QuinceDeAgua deck:DieciseisDeAgua deck:DiecisieteDeAgua deck:DieciochoDeAgua deck:DiecinueveDeAgua deck:VeinteDeAgua deck:VeintiunoDeAgua deck:VeintidosDeAgua deck:VeintitresDeAgua deck:VeinticuatroDeAgua deck:VeinticincoDeAgua
            deck:UnoDePlanta deck:DosDePlanta deck:TresDePlanta deck:CuatroDePlanta deck:CincoDePlanta deck:SeisDePlanta deck:SieteDePlanta deck:OchoDePlanta deck:NueveDePlanta deck:DiezDePlanta deck:OnceDePlanta deck:DoceDePlanta deck:TreceDePlanta deck:CatorceDePlanta deck:QuinceDePlanta deck:DieciseisDePlanta deck:DiecisieteDePlanta deck:DieciochoDePlanta deck:DiecinueveDePlanta deck:VeinteDePlanta deck:VeintiunoDePlanta deck:VeintidosDePlanta deck:VeintitresDePlanta deck:VeinticuatroDePlanta deck:VeinticincoDePlanta
            deck:UnoDeElectrico deck:DosDeElectrico deck:TresDeElectrico deck:CuatroDeElectrico deck:CincoDeElectrico deck:SeisDeElectrico deck:SieteDeElectrico deck:OchoDeElectrico deck:NueveDeElectrico deck:DiezDeElectrico deck:OnceDeElectrico deck:DoceDeElectrico deck:TreceDeElectrico deck:CatorceDeElectrico deck:QuinceDeElectrico deck:DieciseisDeElectrico deck:DiecisieteDeElectrico deck:DieciochoDeElectrico deck:DiecinueveDeElectrico deck:VeinteDeElectrico deck:VeintiunoDeElectrico deck:VeintidosDeElectrico deck:VeintitresDeElectrico deck:VeinticuatroDeElectrico deck:VeinticincoDeElectrico
            deck:UnoDeNormal deck:DosDeNormal deck:TresDeNormal deck:CuatroDeNormal deck:CincoDeNormal deck:SeisDeNormal deck:SieteDeNormal deck:OchoDeNormal deck:NueveDeNormal deck:DiezDeNormal deck:OnceDeNormal deck:DoceDeNormal deck:TreceDeNormal deck:CatorceDeNormal deck:QuinceDeNormal deck:DieciseisDeNormal deck:DiecisieteDeNormal deck:DieciochoDeNormal deck:DiecinueveDeNormal deck:VeinteDeNormal deck:VeintiunoDeNormal deck:VeintidosDeNormal deck:VeintitresDeNormal deck:VeinticuatroDeNormal deck:VeinticincoDeNormal
            deck:UnoDeVolador deck:DosDeVolador deck:TresDeVolador deck:CuatroDeVolador deck:CincoDeVolador deck:SeisDeVolador deck:SieteDeVolador deck:OchoDeVolador deck:NueveDeVolador deck:DiezDeVolador deck:OnceDeVolador deck:DoceDeVolador deck:TreceDeVolador deck:CatorceDeVolador deck:QuinceDeVolador deck:DieciseisDeVolador deck:DiecisieteDeVolador deck:DieciochoDeVolador deck:DiecinueveDeVolador deck:VeinteDeVolador deck:VeintiunoDeVolador deck:VeintidosDeVolador deck:VeintitresDeVolador deck:VeinticuatroDeVolador deck:VeinticincoDeVolador
            deck:UnoDeBicho deck:DosDeBicho deck:TresDeBicho deck:CuatroDeBicho deck:CincoDeBicho deck:SeisDeBicho deck:SieteDeBicho deck:OchoDeBicho deck:NueveDeBicho deck:DiezDeBicho deck:OnceDeBicho deck:DoceDeBicho deck:TreceDeBicho deck:CatorceDeBicho deck:QuinceDeBicho deck:DieciseisDeBicho deck:DiecisieteDeBicho deck:DieciochoDeBicho deck:DiecinueveDeBicho deck:VeinteDeBicho deck:VeintiunoDeBicho deck:VeintidosDeBicho deck:VeintitresDeBicho deck:VeinticuatroDeBicho deck:VeinticincoDeBicho
            deck:UnoDeVeneno deck:DosDeVeneno deck:TresDeVeneno deck:CuatroDeVeneno deck:CincoDeVeneno deck:SeisDeVeneno deck:SieteDeVeneno deck:OchoDeVeneno deck:NueveDeVeneno deck:DiezDeVeneno deck:OnceDeVeneno deck:DoceDeVeneno deck:TreceDeVeneno deck:CatorceDeVeneno deck:QuinceDeVeneno deck:DieciseisDeVeneno deck:DiecisieteDeVeneno deck:DieciochoDeVeneno deck:DiecinueveDeVeneno deck:VeinteDeVeneno deck:VeintiunoDeVeneno deck:VeintidosDeVeneno deck:VeintitresDeVeneno deck:VeinticuatroDeVeneno deck:VeinticincoDeVeneno
        )
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:someValuesFrom deck:Palo
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deck:tieneRango ;
        owl:someValuesFrom deck:Rango
    ] ;
    rdfs:label "Carta" ;
    rdfs:comment "Una carta de la baraja." .

# Subclases de Carta por Palo.

deck:CartaDeFuego a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
        owl:hasValue deck:Fuego
    ] ;
    rdfs:label "Carta de Fuego" ;
    rdfs:comment "Una carta del palo de Fuego." .

deck:CartaDeAgua a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty deck:tienePalo ;
