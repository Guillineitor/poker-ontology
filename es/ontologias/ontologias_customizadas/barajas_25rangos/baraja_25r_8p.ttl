    ] ;
    rdfs:label "Carta de Volador" ;
    rdfs:comment "Una carta del palo de Volador." .

deck:CartaDeBicho a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
