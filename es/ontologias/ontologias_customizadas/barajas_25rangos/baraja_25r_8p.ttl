    ] ;
    rdfs:label "Carta de Normal" ;
    rdfs:comment "Una carta del palo de Normal." .

deck:CartaDeVolador a owl:Class ;
    rdfs:subClassOf deck:Carta ;
    owl:equivalentClass [
