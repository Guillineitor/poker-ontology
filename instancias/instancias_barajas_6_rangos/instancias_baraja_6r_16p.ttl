# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:TresDeVeneno, poker:SeisDeBicho, poker:UnoDeVeneno, poker:DosDeAgua, poker:CuatroDeLucha .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:SeisDeBicho, poker:DosDeElectrico, poker:CuatroDeVolador, poker:UnoDeLucha, poker:TresDeFuego .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:DosDeBicho, poker:SeisDeFuego, poker:TresDeFuego, poker:UnoDeTierra, poker:CuatroDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:CincoDeHielo, poker:UnoDeVeneno, poker:CuatroDeHielo, poker:SeisDePlanta, poker:TresDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cincos con Seis Tres Uno" ;
    poker:contieneCarta poker:CincoDeFantasma, poker:CincoDeDragon, poker:UnoDeLucha, poker:SeisDeDragon, poker:TresDeVolador .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Unos con Seis Tres Dos" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeRoca, poker:DosDeVeneno, poker:SeisDeVeneno, poker:TresDeElectrico .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Seises con Cuatro Dos Uno" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeFuego, poker:DosDeVolador, poker:UnoDeElectrico, poker:CuatroDeHielo .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treses con Cinco Dos Uno" ;
    poker:contieneCarta poker:TresDeVolador, poker:TresDeSiniestro, poker:CincoDeVolador, poker:DosDeRoca, poker:UnoDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Treses con Cinco" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeFantasma, poker:TresDeAgua, poker:TresDeVolador, poker:CincoDeNormal ;
    poker:manoTienePar poker:Cuatro, poker:Tres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Cinco" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeLucha, poker:UnoDeTierra, poker:UnoDeBicho, poker:CincoDeFuego ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Unos con Cuatro" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeHielo, poker:TresDeBicho, poker:TresDeDragon, poker:CuatroDeTierra ;
    poker:manoTienePar poker:Uno, poker:Tres .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Treses con Seis" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:CuatroDeLucha, poker:TresDeDragon, poker:TresDeAgua, poker:SeisDeNormal ;
    poker:manoTienePar poker:Cuatro, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Seises con Cuatro Uno" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDeNormal, poker:SeisDeAgua, poker:UnoDeLucha, poker:CuatroDeRoca .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Unos con Cuatro Tres" ;
    poker:contieneCarta poker:UnoDeBicho, poker:UnoDeTierra, poker:UnoDeFantasma, poker:TresDeSiniestro, poker:CuatroDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cincos con Tres Dos" ;
    poker:contieneCarta poker:CincoDePsiquico, poker:CincoDeFuego, poker:CincoDeVolador, poker:DosDeFantasma, poker:TresDeLucha .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Seis Cinco" ;
    poker:contieneCarta poker:CuatroDeDragon, poker:CuatroDeFantasma, poker:CuatroDeSiniestro, poker:CincoDeLucha, poker:SeisDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeDragon, poker:TresDeElectrico, poker:CuatroDeVeneno, poker:CincoDeNormal, poker:SeisDeFantasma .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeNormal, poker:DosDePsiquico, poker:TresDeHielo, poker:CuatroDeVeneno, poker:CincoDeRoca .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeBicho, poker:DosDeLucha, poker:TresDeVolador, poker:CuatroDeAgua, poker:CincoDeLucha .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeVeneno, poker:TresDeAgua, poker:CuatroDeLucha, poker:CincoDeFuego, poker:SeisDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:UnoDeFuego, poker:CincoDeFuego, poker:CuatroDeFuego, poker:SeisDeFuego .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Eléctrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:UnoDeElectrico, poker:SeisDeElectrico, poker:CincoDeElectrico, poker:DosDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Hielo" ;
    poker:contieneCarta poker:UnoDeHielo, poker:SeisDeHielo, poker:DosDeHielo, poker:CincoDeHielo, poker:TresDeHielo .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeFuego, poker:UnoDeFuego, poker:CincoDeFuego, poker:SeisDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Cincos" ;
    poker:contieneCarta poker:SeisDeRoca, poker:SeisDeHielo, poker:SeisDeBicho, poker:CincoDeAgua, poker:CincoDeSiniestro ;
    poker:manoTienePar poker:Seis, poker:Cinco .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Seises" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDePsiquico, poker:CuatroDePlanta, poker:SeisDeVeneno, poker:SeisDeSiniestro ;
    poker:manoTienePar poker:Cuatro, poker:Seis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Doses" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDePlanta, poker:CincoDeSiniestro, poker:DosDeDragon, poker:DosDeLucha ;
    poker:manoTienePar poker:Cinco, poker:Dos .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Seises" ;
    poker:contieneCarta poker:UnoDeLucha, poker:UnoDePsiquico, poker:UnoDeBicho, poker:SeisDeTierra, poker:SeisDeFuego ;
    poker:manoTienePar poker:Uno, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doses con Cuatro de Planta" ;
    poker:contieneCarta poker:DosDeDragon, poker:DosDeHielo, poker:DosDeLucha, poker:DosDeElectrico, poker:CuatroDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Cinco de Bicho" ;
    poker:contieneCarta poker:CuatroDeFantasma, poker:CuatroDeNormal, poker:CuatroDeAgua, poker:CuatroDeVeneno, poker:CincoDeBicho .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cincos con Dos de Volador" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeBicho, poker:CincoDeHielo, poker:CincoDeFantasma, poker:DosDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Doses con Uno de Fantasma" ;
    poker:contieneCarta poker:DosDeLucha, poker:DosDeFuego, poker:DosDePlanta, poker:DosDeRoca, poker:UnoDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Dragón" ;
    poker:contieneCarta poker:UnoDeDragon, poker:DosDeDragon, poker:TresDeDragon, poker:CuatroDeDragon, poker:CincoDeDragon .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Psíquico" ;
    poker:contieneCarta poker:DosDePsiquico, poker:TresDePsiquico, poker:CuatroDePsiquico, poker:CincoDePsiquico, poker:SeisDePsiquico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:DosDeLucha, poker:TresDeLucha, poker:CuatroDeLucha, poker:CincoDeLucha, poker:SeisDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
