# =============================================================================
# Instancias reducidas de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias reducidas de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox con solo 4 manos de tipo Full, para experimentos de viabilidad de los razonadores OWL" .


# =============================================================================
# 1. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Reyes" ;
    poker:contieneCarta poker:CincoDeCorazones, poker:CincoDePicas, poker:CincoDeDiamantes, poker:ReyDeCorazones, poker:ReyDePicas ;
    poker:manoTienePar poker:Cinco, poker:Rey .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Jotas" ;
    poker:contieneCarta poker:OchoDeCorazones, poker:OchoDePicas, poker:OchoDeDiamantes, poker:JotaDeCorazones, poker:JotaDePicas ;
    poker:manoTienePar poker:Ocho, poker:Jota .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Ases" ;
    poker:contieneCarta poker:DosDeCorazones, poker:DosDePicas, poker:DosDeDiamantes, poker:AsDeCorazones, poker:AsDePicas ;
    poker:manoTienePar poker:Dos, poker:As .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Reinas con Par de Sietes" ;
    poker:contieneCarta poker:ReinaDeCorazones, poker:ReinaDePicas, poker:ReinaDeDiamantes, poker:SieteDeCorazones, poker:SieteDePicas ;
    poker:manoTienePar poker:Reina, poker:Siete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

