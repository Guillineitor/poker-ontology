# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox con 4 manos de Carta Alta de prueba." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de As con Jota Nueve Seis Cuatro" ;
    poker:contieneCarta poker:AsDeCorazones, poker:JotaDeDiamantes, poker:NueveDePicas, poker:SeisDeTreboles, poker:CuatroDeDiamantes .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Rey con Diez Ocho Cinco Tres" ;
    poker:contieneCarta poker:ReyDeTreboles, poker:DiezDeCorazones, poker:OchoDeDiamantes, poker:CincoDeTreboles, poker:TresDeCorazones .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Reina con Nueve Siete Cuatro Dos" ;
    poker:contieneCarta poker:ReinaDeCorazones, poker:NueveDeDiamantes, poker:SieteDeTreboles, poker:CuatroDeCorazones, poker:DosDePicas .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Jota con Ocho Seis Cuatro Dos" ;
    poker:contieneCarta poker:JotaDeTreboles, poker:OchoDeCorazones, poker:SeisDePicas, poker:CuatroDePicas, poker:DosDeTreboles .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
