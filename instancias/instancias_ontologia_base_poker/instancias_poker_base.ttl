# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.poker-ontology.org/poker#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.poker-ontology.org/poker> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .


# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de As con Jota Nueve Seis Cuatro" ;
    poker:contieneCarta poker:AsDeCorazones, poker:JotaDeDiamantes, poker:NueveDePicas, poker:SeisDeTreboles, poker:CuatroDeDiamantes .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Rey con Diez Ocho Cinco Tres" ;
    poker:contieneCarta poker:ReyDeTreboles, poker:DiezDeCorazones, poker:OchoDeDiamantes, poker:CincoDeTreboles, poker:TresDeCorazones .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Reina con Nueve Siete Cuatro Dos" ;
    poker:contieneCarta poker:ReinaDeCorazones, poker:NueveDeDiamantes, poker:SieteDeTreboles, poker:CuatroDeCorazones, poker:DosDePicas .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Jota con Ocho Seis Cuatro Dos" ;
    poker:contieneCarta poker:JotaDeTreboles, poker:OchoDeCorazones, poker:SeisDePicas, poker:CuatroDePicas, poker:DosDeTreboles .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Seises con As Reina Jota" ;
    poker:contieneCarta poker:SeisDeCorazones, poker:SeisDeDiamantes, poker:AsDePicas, poker:ReinaDePicas, poker:JotaDeCorazones .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieces con Rey Nueve Cinco" ;
    poker:contieneCarta poker:DiezDePicas, poker:DiezDeTreboles, poker:ReyDeCorazones, poker:NueveDeTreboles, poker:CincoDePicas .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Ochos con As Jota Cuatro" ;
    poker:contieneCarta poker:OchoDePicas, poker:OchoDeTreboles, poker:AsDeDiamantes, poker:JotaDeDiamantes, poker:CuatroDeDiamantes .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treses con Reina Siete Dos" ;
    poker:contieneCarta poker:TresDePicas, poker:TresDeDiamantes, poker:ReinaDeDiamantes, poker:SieteDePicas, poker:DosDeCorazones .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Jotas y Cuatros con Rey" ;
    poker:contieneCarta poker:JotaDeCorazones, poker:JotaDePicas, poker:CuatroDeTreboles, poker:CuatroDeDiamantes, poker:ReyDePicas ;
    poker:manoTienePar poker:Jota, poker:Cuatro .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Doses con As" ;
    poker:contieneCarta poker:SieteDeCorazones, poker:SieteDeDiamantes, poker:DosDeCorazones, poker:DosDeDiamantes, poker:AsDeTreboles ;
    poker:manoTienePar poker:Siete, poker:Dos .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Reyes y Nueves con Jota" ;
    poker:contieneCarta poker:ReyDeDiamantes, poker:ReyDeTreboles, poker:NueveDeCorazones, poker:NueveDePicas, poker:JotaDeDiamantes ;
    poker:manoTienePar poker:Rey, poker:Nueve .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Ases y Cincos con Ocho" ;
    poker:contieneCarta poker:AsDeCorazones, poker:AsDePicas, poker:CincoDeCorazones, poker:CincoDeDiamantes, poker:OchoDeCorazones ;
    poker:manoTienePar poker:As, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con As Jota" ;
    poker:contieneCarta poker:CuatroDeCorazones, poker:CuatroDePicas, poker:CuatroDeTreboles, poker:AsDeCorazones, poker:JotaDePicas .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Ochos con Rey Seis" ;
    poker:contieneCarta poker:OchoDeCorazones, poker:OchoDePicas, poker:OchoDeDiamantes, poker:ReyDeCorazones, poker:SeisDeTreboles .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Jotas con As Tres" ;
    poker:contieneCarta poker:JotaDeCorazones, poker:JotaDePicas, poker:JotaDeTreboles, poker:AsDeTreboles, poker:TresDeCorazones .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Sietes con Reina Dos" ;
    poker:contieneCarta poker:SieteDeCorazones, poker:SieteDePicas, poker:SieteDeDiamantes, poker:ReinaDeTreboles, poker:DosDeCorazones .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de A-2-3-4-5" ;
    poker:contieneCarta poker:AsDePicas, poker:DosDeCorazones, poker:TresDeDiamantes, poker:CuatroDeTreboles, poker:CincoDePicas .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de 3-4-5-6-7" ;
    poker:contieneCarta poker:TresDeCorazones, poker:CuatroDeDiamantes, poker:CincoDeTreboles, poker:SeisDePicas, poker:SieteDeCorazones .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de 6-7-8-9-10" ;
    poker:contieneCarta poker:SeisDeDiamantes, poker:SieteDeTreboles, poker:OchoDePicas, poker:NueveDeDiamantes, poker:DiezDeCorazones .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de 8-9-10-J-Q" ;
    poker:contieneCarta poker:OchoDeDiamantes, poker:NueveDeTreboles, poker:DiezDeDiamantes, poker:JotaDeDiamantes, poker:ReinaDePicas .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Rey Nueve Siete Cuatro Dos de Diamantes" ;
    poker:contieneCarta poker:ReyDeDiamantes, poker:NueveDeDiamantes, poker:SieteDeDiamantes, poker:CuatroDeDiamantes, poker:DosDeDiamantes .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de As Diez Ocho Cinco Tres de Tréboles" ;
    poker:contieneCarta poker:AsDeTreboles, poker:DiezDeTreboles, poker:OchoDeTreboles, poker:CincoDeTreboles, poker:TresDeTreboles .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Reina Jota Siete Cuatro Dos de Picas" ;
    poker:contieneCarta poker:ReinaDePicas, poker:JotaDePicas, poker:SieteDePicas, poker:CuatroDePicas, poker:DosDePicas .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de As Rey Nueve Seis Cuatro de Corazones" ;
    poker:contieneCarta poker:AsDeCorazones, poker:ReyDeCorazones, poker:NueveDeCorazones, poker:SeisDeCorazones, poker:CuatroDeCorazones .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Reyes" ;
    poker:contieneCarta poker:CincoDeCorazones, poker:CincoDePicas, poker:CincoDeDiamantes, poker:ReyDeCorazones, poker:ReyDePicas ;
    poker:manoTienePar poker:Cinco, poker:Rey .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Jotas" ;
    poker:contieneCarta poker:OchoDeCorazones, poker:OchoDePicas, poker:OchoDeDiamantes, poker:JotaDeCorazones, poker:JotaDePicas ;
    poker:manoTienePar poker:Ocho, poker:Jota .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Ases" ;
    poker:contieneCarta poker:DosDeCorazones, poker:DosDePicas, poker:DosDeDiamantes, poker:AsDeCorazones, poker:AsDePicas ;
    poker:manoTienePar poker:Dos, poker:As .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Reinas con Par de Sietes" ;
    poker:contieneCarta poker:ReinaDeCorazones, poker:ReinaDePicas, poker:ReinaDeDiamantes, poker:SieteDeCorazones, poker:SieteDePicas ;
    poker:manoTienePar poker:Reina, poker:Siete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Rey de Tréboles" ;
    poker:contieneCarta poker:CincoDeCorazones, poker:CincoDePicas, poker:CincoDeDiamantes, poker:CincoDeTreboles, poker:ReyDeTreboles .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Nueves con As de Corazones" ;
    poker:contieneCarta poker:NueveDeCorazones, poker:NueveDePicas, poker:NueveDeDiamantes, poker:NueveDeTreboles, poker:AsDeCorazones .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Reinas con Diez de Diamantes" ;
    poker:contieneCarta poker:ReinaDeCorazones, poker:ReinaDePicas, poker:ReinaDeDiamantes, poker:ReinaDeTreboles, poker:DiezDeDiamantes .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treses con As de Picas" ;
    poker:contieneCarta poker:TresDeCorazones, poker:TresDePicas, poker:TresDeDiamantes, poker:TresDeTreboles, poker:AsDePicas .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color 3-4-5-6-7 de Diamantes" ;
    poker:contieneCarta poker:TresDeDiamantes, poker:CuatroDeDiamantes, poker:CincoDeDiamantes, poker:SeisDeDiamantes, poker:SieteDeDiamantes .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color 5-6-7-8-9 de Picas" ;
    poker:contieneCarta poker:CincoDePicas, poker:SeisDePicas, poker:SieteDePicas, poker:OchoDePicas, poker:NueveDePicas .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color 6-7-8-9-10 de Tréboles" ;
    poker:contieneCarta poker:SeisDeTreboles, poker:SieteDeTreboles, poker:OchoDeTreboles, poker:NueveDeTreboles, poker:DiezDeTreboles .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color 8-9-10-J-Q de Corazones" ;
    poker:contieneCarta poker:OchoDeCorazones, poker:NueveDeCorazones, poker:DiezDeCorazones, poker:JotaDeCorazones, poker:ReinaDeCorazones .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Picas" ;
    poker:contieneCarta poker:DiezDePicas, poker:JotaDePicas, poker:ReinaDePicas, poker:ReyDePicas, poker:AsDePicas .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Corazones" ;
    poker:contieneCarta poker:DiezDeCorazones, poker:JotaDeCorazones, poker:ReinaDeCorazones, poker:ReyDeCorazones, poker:AsDeCorazones .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Diamantes" ;
    poker:contieneCarta poker:DiezDeDiamantes, poker:JotaDeDiamantes, poker:ReinaDeDiamantes, poker:ReyDeDiamantes, poker:AsDeDiamantes .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Tréboles" ;
    poker:contieneCarta poker:DiezDeTreboles, poker:JotaDeTreboles, poker:ReinaDeTreboles, poker:ReyDeTreboles, poker:AsDeTreboles .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
