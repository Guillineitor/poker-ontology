# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Dieciseis Catorce Dos Uno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDePlanta, poker:DieciseisDeElectrico, poker:CatorceDeFuego, poker:VeintidosDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Veinte Diecinueve Catorce Cinco" ;
    poker:contieneCarta poker:VeintitresDeNormal, poker:CatorceDeElectrico, poker:CincoDePlanta, poker:VeinteDeVeneno, poker:DiecinueveDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Dieciocho Diecisiete Dieciseis Nueve" ;
    poker:contieneCarta poker:VeinticuatroDeBicho, poker:NueveDeBicho, poker:DiecisieteDeBicho, poker:DieciochoDeVolador, poker:DieciseisDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Quince con Catorce Ocho Seis Cuatro" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CatorceDeVeneno, poker:SeisDePlanta, poker:OchoDePlanta, poker:QuinceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Diecinueves con Once Seis Dos" ;
    poker:contieneCarta poker:DiecinueveDeVeneno, poker:DiecinueveDePlanta, poker:DosDeVeneno, poker:OnceDeElectrico, poker:SeisDeVolador .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doces con Veinticinco Veintitres Diecisiete" ;
    poker:contieneCarta poker:DoceDeNormal, poker:DoceDeElectrico, poker:VeinticincoDeElectrico, poker:VeintitresDeVolador, poker:DiecisieteDeNormal .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Quinces con Veinte Catorce Ocho" ;
    poker:contieneCarta poker:QuinceDeVeneno, poker:QuinceDeAgua, poker:OchoDeBicho, poker:CatorceDeVeneno, poker:VeinteDeNormal .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Nueves con Diez Dos Uno" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:NueveDeAgua, poker:UnoDeFuego, poker:DiezDeVeneno, poker:DosDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Onces con Siete" ;
    poker:contieneCarta poker:VeinteDeBicho, poker:VeinteDeElectrico, poker:OnceDeFuego, poker:OnceDeAgua, poker:SieteDeVeneno ;
    poker:manoTienePar poker:Veinte, poker:Once .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Dieces con Dieciseis" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeVeneno, poker:DieciochoDeVolador, poker:DieciochoDeBicho, poker:DieciseisDePlanta ;
    poker:manoTienePar poker:Diez, poker:Dieciocho .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintitreses y Catorces con Doce" ;
    poker:contieneCarta poker:CatorceDeNormal, poker:CatorceDeElectrico, poker:VeintitresDeFuego, poker:VeintitresDeVolador, poker:DoceDeFuego ;
    poker:manoTienePar poker:Catorce, poker:Veintitres .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintitreses y Treces con Veintiuno" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDeVolador, poker:VeintitresDeVeneno, poker:VeintitresDeElectrico, poker:VeintiunoDeAgua ;
    poker:manoTienePar poker:Trece, poker:Veintitres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Ochos con Quince Cinco" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDePlanta, poker:OchoDeVolador, poker:CincoDeBicho, poker:QuinceDeVeneno .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Dieces con Veinticinco Trece" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:DiezDeFuego, poker:DiezDePlanta, poker:VeinticincoDeNormal, poker:TreceDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doces con Trece Cuatro" ;
    poker:contieneCarta poker:DoceDeVeneno, poker:DoceDeElectrico, poker:DoceDeNormal, poker:CuatroDeNormal, poker:TreceDeVeneno .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Veinticinco Uno" ;
    poker:contieneCarta poker:DieciochoDeVolador, poker:DieciochoDeElectrico, poker:DieciochoDeVeneno, poker:VeinticincoDePlanta, poker:UnoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SieteDeAgua, poker:OchoDeFuego, poker:NueveDeVolador, poker:DiezDeNormal .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeVeneno, poker:DieciochoDeVeneno, poker:DiecinueveDeVeneno, poker:VeinteDePlanta, poker:VeintiunoDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro" ;
    poker:contieneCarta poker:VeinteDeAgua, poker:VeintiunoDeNormal, poker:VeintidosDePlanta, poker:VeintitresDeFuego, poker:VeinticuatroDeNormal .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diecinueve-Veinte-Veintiuno-Veintidos-Veintitres" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:VeinteDeBicho, poker:VeintiunoDeElectrico, poker:VeintidosDeVolador, poker:VeintitresDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintiuno Veinte Quince Diez Ocho de Agua" ;
    poker:contieneCarta poker:OchoDeAgua, poker:DiezDeAgua, poker:QuinceDeAgua, poker:VeintiunoDeAgua, poker:VeinteDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciocho Dieciseis Quince Cinco Uno de Planta" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:QuinceDePlanta, poker:UnoDePlanta, poker:DieciseisDePlanta, poker:CincoDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecinueve Quince Nueve Cuatro Tres de Electrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:DiecinueveDeElectrico, poker:CuatroDeElectrico, poker:NueveDeElectrico, poker:QuinceDeElectrico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veinticinco Seis Cuatro Tres Dos de Volador" ;
    poker:contieneCarta poker:TresDeVolador, poker:DosDeVolador, poker:VeinticincoDeVolador, poker:SeisDeVolador, poker:CuatroDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Dieciseises" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDeElectrico, poker:CuatroDeBicho, poker:DieciseisDeAgua, poker:DieciseisDeVolador ;
    poker:manoTienePar poker:Cuatro, poker:Dieciseis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Treses" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDeAgua, poker:OchoDeBicho, poker:TresDePlanta, poker:TresDeVeneno ;
    poker:manoTienePar poker:Ocho, poker:Tres .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Unos" ;
    poker:contieneCarta poker:DieciseisDeNormal, poker:DieciseisDeElectrico, poker:DieciseisDePlanta, poker:UnoDePlanta, poker:UnoDeElectrico ;
    poker:manoTienePar poker:Dieciseis, poker:Uno .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Dieces" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeBicho, poker:NueveDeVolador, poker:DiezDeAgua, poker:DiezDeFuego ;
    poker:manoTienePar poker:Nueve, poker:Diez .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treces con Veinticinco de Veneno" ;
    poker:contieneCarta poker:TreceDeVeneno, poker:TreceDeElectrico, poker:TreceDeFuego, poker:TreceDeBicho, poker:VeinticincoDeVeneno .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veintes con Dieciseis de Fuego" ;
    poker:contieneCarta poker:VeinteDeElectrico, poker:VeinteDeNormal, poker:VeinteDePlanta, poker:VeinteDeVeneno, poker:DieciseisDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Dieces con Cinco de Volador" ;
    poker:contieneCarta poker:DiezDeVolador, poker:DiezDeNormal, poker:DiezDeVeneno, poker:DiezDeFuego, poker:CincoDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Doses con Dieciseis de Planta" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDePlanta, poker:DosDeElectrico, poker:DosDeNormal, poker:DieciseisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno de Planta" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta, poker:VeinteDePlanta, poker:VeintiunoDePlanta .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte de Volador" ;
    poker:contieneCarta poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador, poker:VeinteDeVolador .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Volador" ;
    poker:contieneCarta poker:DiezDeVolador, poker:OnceDeVolador, poker:DoceDeVolador, poker:TreceDeVolador, poker:CatorceDeVolador .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Diecinueve-Veinte-Veintiuno-Veintidos-Veintitres de Normal" ;
    poker:contieneCarta poker:DiecinueveDeNormal, poker:VeinteDeNormal, poker:VeintiunoDeNormal, poker:VeintidosDeNormal, poker:VeintitresDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:VeintiunoDeNormal, poker:VeintidosDeNormal, poker:VeintitresDeNormal, poker:VeinticuatroDeNormal, poker:VeinticincoDeNormal .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:VeintiunoDeBicho, poker:VeintidosDeBicho, poker:VeintitresDeBicho, poker:VeinticuatroDeBicho, poker:VeinticincoDeBicho .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta, poker:VeinticincoDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:VeintiunoDeVeneno, poker:VeintidosDeVeneno, poker:VeintitresDeVeneno, poker:VeinticuatroDeVeneno, poker:VeinticincoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
