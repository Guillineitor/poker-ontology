# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiuno con Veinte Diez Ocho Cuatro" ;
    poker:contieneCarta poker:OchoDeBicho, poker:CuatroDeVolador, poker:DiezDePlanta, poker:VeintiunoDePsiquico, poker:VeinteDeTierra .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Veinte Quince Cinco Uno" ;
    poker:contieneCarta poker:CincoDePlanta, poker:VeinteDePlanta, poker:UnoDePsiquico, poker:VeintidosDeLucha, poker:QuinceDeLucha .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Veintiuno Dieciseis Doce Diez" ;
    poker:contieneCarta poker:DieciseisDeNormal, poker:VeintiunoDeTierra, poker:DoceDeAgua, poker:VeintitresDeBicho, poker:DiezDeRoca .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Trece Siete Seis Dos" ;
    poker:contieneCarta poker:DosDeVeneno, poker:TreceDeVeneno, poker:SeisDePsiquico, poker:SieteDeLucha, poker:VeinticincoDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treces con Diecisiete Nueve Tres" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDeVeneno, poker:DiecisieteDeLucha, poker:TresDeNormal, poker:NueveDePlanta .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doces con Veintiuno Diecisiete Trece" ;
    poker:contieneCarta poker:DoceDeBicho, poker:DoceDePsiquico, poker:DiecisieteDeLucha, poker:TreceDeVolador, poker:VeintiunoDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Ochos con Diecinueve Catorce Uno" ;
    poker:contieneCarta poker:OchoDeTierra, poker:OchoDeNormal, poker:UnoDeVolador, poker:DiecinueveDeLucha, poker:CatorceDeTierra .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Doces con Veinticinco Veintiuno Tres" ;
    poker:contieneCarta poker:DoceDeTierra, poker:DoceDeNormal, poker:TresDeNormal, poker:VeinticincoDePlanta, poker:VeintiunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Catorces con Cinco" ;
    poker:contieneCarta poker:CatorceDeRoca, poker:CatorceDeFuego, poker:DiecisieteDeLucha, poker:DiecisieteDeVeneno, poker:CincoDeRoca ;
    poker:manoTienePar poker:Catorce, poker:Diecisiete .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintitreses y Onces con Trece" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:OnceDeVolador, poker:VeintitresDePlanta, poker:VeintitresDeLucha, poker:TreceDeAgua ;
    poker:manoTienePar poker:Once, poker:Veintitres .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Veintiunos con Dieciseis" ;
    poker:contieneCarta poker:VeintiunoDeBicho, poker:VeintiunoDeLucha, poker:VeintidosDeFuego, poker:VeintidosDeNormal, poker:DieciseisDeBicho ;
    poker:manoTienePar poker:Veintiuno, poker:Veintidos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veinticincos y Onces con Seis" ;
    poker:contieneCarta poker:VeinticincoDeElectrico, poker:VeinticincoDeVeneno, poker:OnceDeVolador, poker:OnceDeRoca, poker:SeisDeNormal ;
    poker:manoTienePar poker:Veinticinco, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treces con Dieciseis Nueve" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDePlanta, poker:TreceDeBicho, poker:NueveDeBicho, poker:DieciseisDeLucha .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Treses con Diez Seis" ;
    poker:contieneCarta poker:TresDeTierra, poker:TresDeLucha, poker:TresDeAgua, poker:SeisDePsiquico, poker:DiezDeVeneno .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veinticuatros con Ocho Uno" ;
    poker:contieneCarta poker:VeinticuatroDeVolador, poker:VeinticuatroDeLucha, poker:VeinticuatroDeTierra, poker:UnoDeAgua, poker:OchoDeLucha .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Sietes con Seis Uno" ;
    poker:contieneCarta poker:SieteDeRoca, poker:SieteDeVolador, poker:SieteDeAgua, poker:SeisDePsiquico, poker:UnoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDePlanta, poker:SeisDeRoca, poker:SieteDeElectrico, poker:OchoDeTierra, poker:NueveDeAgua .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeVolador, poker:TreceDeTierra, poker:CatorceDeElectrico, poker:QuinceDePlanta, poker:DieciseisDeFuego .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeTierra, poker:OchoDeVolador, poker:NueveDeAgua, poker:DiezDeVolador, poker:OnceDeFuego .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeNormal, poker:DieciochoDeElectrico, poker:DiecinueveDeBicho, poker:VeinteDeRoca, poker:VeintiunoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintiuno Diecisiete Siete Cuatro de Psiquico" ;
    poker:contieneCarta poker:VeintiunoDePsiquico, poker:CuatroDePsiquico, poker:VeinticuatroDePsiquico, poker:SieteDePsiquico, poker:DiecisieteDePsiquico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veintidos Diecisiete Quince Trece Tres de Electrico" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:QuinceDeElectrico, poker:DiecisieteDeElectrico, poker:TresDeElectrico, poker:VeintidosDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintidos Veintiuno Dieciocho Catorce Ocho de Planta" ;
    poker:contieneCarta poker:VeintidosDePlanta, poker:OchoDePlanta, poker:DieciochoDePlanta, poker:VeintiunoDePlanta, poker:CatorceDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Quince Trece Diez Nueve Tres de Volador" ;
    poker:contieneCarta poker:TresDeVolador, poker:NueveDeVolador, poker:TreceDeVolador, poker:DiezDeVolador, poker:QuinceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Sietes" ;
    poker:contieneCarta poker:CatorceDeBicho, poker:CatorceDeNormal, poker:CatorceDeVolador, poker:SieteDePlanta, poker:SieteDeVeneno ;
    poker:manoTienePar poker:Catorce, poker:Siete .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Dieciseises" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeTierra, poker:UnoDeBicho, poker:DieciseisDeVeneno, poker:DieciseisDePsiquico ;
    poker:manoTienePar poker:Uno, poker:Dieciseis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Nueves" ;
    poker:contieneCarta poker:DosDeTierra, poker:DosDeRoca, poker:DosDePlanta, poker:NueveDeElectrico, poker:NueveDeBicho ;
    poker:manoTienePar poker:Dos, poker:Nueve .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Ochos" ;
    poker:contieneCarta poker:DieciseisDeTierra, poker:DieciseisDeAgua, poker:DieciseisDeElectrico, poker:OchoDeLucha, poker:OchoDeAgua ;
    poker:manoTienePar poker:Dieciseis, poker:Ocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Catorces con Cuatro de Normal" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:CatorceDeLucha, poker:CatorceDeFuego, poker:CatorceDeAgua, poker:CuatroDeNormal .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Veinticuatro de Fuego" ;
    poker:contieneCarta poker:VeinticincoDeBicho, poker:VeinticincoDeNormal, poker:VeinticincoDeTierra, poker:VeinticincoDeRoca, poker:VeinticuatroDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Diecinueves con Trece de Electrico" ;
    poker:contieneCarta poker:DiecinueveDeVolador, poker:DiecinueveDeRoca, poker:DiecinueveDeNormal, poker:DiecinueveDeBicho, poker:TreceDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Nueve de Normal" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DiecisieteDeVolador, poker:DiecisieteDeVeneno, poker:DiecisieteDeElectrico, poker:NueveDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Catorce-Quince-Dieciseis-Diecisiete-Dieciocho de Normal" ;
    poker:contieneCarta poker:CatorceDeNormal, poker:QuinceDeNormal, poker:DieciseisDeNormal, poker:DiecisieteDeNormal, poker:DieciochoDeNormal .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Trece-Catorce-Quince-Dieciseis-Diecisiete de Planta" ;
    poker:contieneCarta poker:TreceDePlanta, poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Roca" ;
    poker:contieneCarta poker:UnoDeRoca, poker:DosDeRoca, poker:TresDeRoca, poker:CuatroDeRoca, poker:CincoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:VeintiunoDeVolador, poker:VeintidosDeVolador, poker:VeintitresDeVolador, poker:VeinticuatroDeVolador, poker:VeinticincoDeVolador .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:VeintiunoDeLucha, poker:VeintidosDeLucha, poker:VeintitresDeLucha, poker:VeinticuatroDeLucha, poker:VeinticincoDeLucha .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:VeintiunoDeTierra, poker:VeintidosDeTierra, poker:VeintitresDeTierra, poker:VeinticuatroDeTierra, poker:VeinticincoDeTierra .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta, poker:VeinticincoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
