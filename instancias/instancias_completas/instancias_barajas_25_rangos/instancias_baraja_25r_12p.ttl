# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Trece Once Siete Uno" ;
    poker:contieneCarta poker:VeinticincoDeLucha, poker:OnceDeRoca, poker:UnoDeNormal, poker:TreceDeVeneno, poker:SieteDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Dieciocho Dieciseis Quince Cinco" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:VeintitresDeVolador, poker:DieciseisDeRoca, poker:QuinceDePlanta, poker:CincoDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciseis Quince Doce Nueve" ;
    poker:contieneCarta poker:DieciseisDeRoca, poker:DoceDeAgua, poker:DiecinueveDePlanta, poker:QuinceDeVolador, poker:NueveDeLucha .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Once Nueve Tres Uno" ;
    poker:contieneCarta poker:NueveDePlanta, poker:UnoDeVeneno, poker:VeinticincoDeTierra, poker:TresDeTierra, poker:OnceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cincos con Veinte Dieciocho Quince" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDeTierra, poker:QuinceDeElectrico, poker:VeinteDeTierra, poker:DieciochoDeLucha .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Quinces con Dieciseis Nueve Ocho" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDePsiquico, poker:OchoDeNormal, poker:NueveDeLucha, poker:DieciseisDeBicho .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Dieciochos con Dieciseis Once Uno" ;
    poker:contieneCarta poker:DieciochoDeNormal, poker:DieciochoDeAgua, poker:UnoDeElectrico, poker:DieciseisDeVeneno, poker:OnceDeVolador .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veinticincos con Veinte Seis Tres" ;
    poker:contieneCarta poker:VeinticincoDeTierra, poker:VeinticincoDeElectrico, poker:SeisDeRoca, poker:VeinteDePlanta, poker:TresDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Cincos con Siete" ;
    poker:contieneCarta poker:CincoDeTierra, poker:CincoDePlanta, poker:VeintidosDeRoca, poker:VeintidosDeVeneno, poker:SieteDeBicho ;
    poker:manoTienePar poker:Cinco, poker:Veintidos .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Treses con Cuatro" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeFuego, poker:TresDePsiquico, poker:TresDeAgua, poker:CuatroDeBicho ;
    poker:manoTienePar poker:Trece, poker:Tres .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Dieciseises con Siete" ;
    poker:contieneCarta poker:DiecisieteDeLucha, poker:DiecisieteDePsiquico, poker:DieciseisDeLucha, poker:DieciseisDePsiquico, poker:SieteDeTierra ;
    poker:manoTienePar poker:Diecisiete, poker:Dieciseis .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veinticincos y Dieciochos con Cinco" ;
    poker:contieneCarta poker:VeinticincoDeTierra, poker:VeinticincoDeRoca, poker:DieciochoDeAgua, poker:DieciochoDeElectrico, poker:CincoDeVolador ;
    poker:manoTienePar poker:Veinticinco, poker:Dieciocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieces con Veintitres Veintidos" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:DiezDeLucha, poker:DiezDePsiquico, poker:VeintitresDeTierra, poker:VeintidosDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Onces con Doce Nueve" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:OnceDeTierra, poker:OnceDeRoca, poker:DoceDeLucha, poker:NueveDeElectrico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintes con Veinticuatro Veintiuno" ;
    poker:contieneCarta poker:VeinteDeAgua, poker:VeinteDeBicho, poker:VeinteDeTierra, poker:VeintiunoDeLucha, poker:VeinticuatroDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Doces con Veintitres Veintidos" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDePlanta, poker:DoceDeLucha, poker:VeintidosDeAgua, poker:VeintitresDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeLucha, poker:NueveDeLucha, poker:DiezDeTierra, poker:OnceDeBicho, poker:DoceDeVolador .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePsiquico, poker:VeintitresDeAgua, poker:VeinticuatroDeTierra, poker:VeinticincoDePsiquico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintidosDeNormal, poker:VeintitresDeAgua, poker:VeinticuatroDeRoca, poker:VeinticincoDeVeneno .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diecinueve-Veinte-Veintiuno-Veintidos-Veintitres" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:VeinteDeAgua, poker:VeintiunoDeVeneno, poker:VeintidosDeRoca, poker:VeintitresDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintiuno Diecinueve Dieciseis Doce de Planta" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DiecinueveDePlanta, poker:DieciseisDePlanta, poker:VeintiunoDePlanta, poker:VeinticuatroDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Diecisiete Diez Nueve Cuatro de Normal" ;
    poker:contieneCarta poker:DiezDeNormal, poker:VeinticuatroDeNormal, poker:NueveDeNormal, poker:CuatroDeNormal, poker:DiecisieteDeNormal .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintidos Once Siete Cuatro de Psiquico" ;
    poker:contieneCarta poker:VeinticuatroDePsiquico, poker:VeintidosDePsiquico, poker:OnceDePsiquico, poker:CuatroDePsiquico, poker:SieteDePsiquico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintitres Veintidos Quince Cinco de Fuego" ;
    poker:contieneCarta poker:VeintitresDeFuego, poker:CincoDeFuego, poker:QuinceDeFuego, poker:VeinticuatroDeFuego, poker:VeintidosDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Treses" ;
    poker:contieneCarta poker:VeintidosDeNormal, poker:VeintidosDeBicho, poker:VeintidosDeAgua, poker:TresDeElectrico, poker:TresDeTierra ;
    poker:manoTienePar poker:Veintidos, poker:Tres .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Veintes" ;
    poker:contieneCarta poker:OchoDeFuego, poker:OchoDeTierra, poker:OchoDeVolador, poker:VeinteDePlanta, poker:VeinteDeVolador ;
    poker:manoTienePar poker:Ocho, poker:Veinte .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciochos con Par de Unos" ;
    poker:contieneCarta poker:DieciochoDeTierra, poker:DieciochoDeElectrico, poker:DieciochoDePsiquico, poker:UnoDeAgua, poker:UnoDeVeneno ;
    poker:manoTienePar poker:Dieciocho, poker:Uno .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Diecinueves" ;
    poker:contieneCarta poker:VeintidosDeNormal, poker:VeintidosDePsiquico, poker:VeintidosDeLucha, poker:DiecinueveDeFuego, poker:DiecinueveDeBicho ;
    poker:manoTienePar poker:Veintidos, poker:Diecinueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Diecinueve de Volador" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeRoca, poker:CincoDeFuego, poker:CincoDePlanta, poker:DiecinueveDeVolador .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Dieces con Uno de Veneno" ;
    poker:contieneCarta poker:DiezDeRoca, poker:DiezDeNormal, poker:DiezDeFuego, poker:DiezDeVeneno, poker:UnoDeVeneno .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Seises con Veinte de Veneno" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDeLucha, poker:SeisDeVolador, poker:SeisDePsiquico, poker:VeinteDeVeneno .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Sietes con Diecisiete de Tierra" ;
    poker:contieneCarta poker:SieteDeRoca, poker:SieteDeVolador, poker:SieteDeFuego, poker:SieteDePlanta, poker:DiecisieteDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Planta" ;
    poker:contieneCarta poker:OchoDePlanta, poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Fuego" ;
    poker:contieneCarta poker:DoceDeFuego, poker:TreceDeFuego, poker:CatorceDeFuego, poker:QuinceDeFuego, poker:DieciseisDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Normal" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal, poker:SeisDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:VeintiunoDeVolador, poker:VeintidosDeVolador, poker:VeintitresDeVolador, poker:VeinticuatroDeVolador, poker:VeinticincoDeVolador .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta, poker:VeinticincoDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:VeintiunoDeNormal, poker:VeintidosDeNormal, poker:VeintitresDeNormal, poker:VeinticuatroDeNormal, poker:VeinticincoDeNormal .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
