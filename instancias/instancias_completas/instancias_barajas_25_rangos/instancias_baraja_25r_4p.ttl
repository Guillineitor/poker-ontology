# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Quince Once Siete Seis" ;
    poker:contieneCarta poker:OnceDeAgua, poker:DiecisieteDeElectrico, poker:QuinceDeAgua, poker:SieteDeElectrico, poker:SeisDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Catorce con Nueve Ocho Cuatro Uno" ;
    poker:contieneCarta poker:UnoDeAgua, poker:CuatroDePlanta, poker:OchoDePlanta, poker:NueveDePlanta, poker:CatorceDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinte con Quince Doce Once Nueve" ;
    poker:contieneCarta poker:OnceDeFuego, poker:NueveDePlanta, poker:DoceDeElectrico, poker:QuinceDeFuego, poker:VeinteDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veinte con Dieciocho Quince Ocho Seis" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:OchoDeElectrico, poker:VeinteDeAgua, poker:SeisDeAgua, poker:QuinceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Veinticuatros con Diecinueve Ocho Uno" ;
    poker:contieneCarta poker:VeinticuatroDePlanta, poker:VeinticuatroDeAgua, poker:UnoDeAgua, poker:OchoDeFuego, poker:DiecinueveDePlanta .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Veintitres Diecinueve Catorce" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeElectrico, poker:CatorceDePlanta, poker:VeintitresDeFuego, poker:DiecinueveDeElectrico .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintidoses con Veinticinco Quince Tres" ;
    poker:contieneCarta poker:VeintidosDeElectrico, poker:VeintidosDeAgua, poker:TresDePlanta, poker:VeinticincoDeFuego, poker:QuinceDeAgua .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Doses con Diecinueve Nueve Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDePlanta, poker:NueveDeAgua, poker:SeisDePlanta, poker:DiecinueveDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Treses con Diecinueve" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeElectrico, poker:TresDeElectrico, poker:TresDeAgua, poker:DiecinueveDeAgua ;
    poker:manoTienePar poker:Doce, poker:Tres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Unos con Dos" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeElectrico, poker:DoceDeElectrico, poker:DoceDeFuego, poker:DosDePlanta ;
    poker:manoTienePar poker:Uno, poker:Doce .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Sietes con Veinticinco" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDeAgua, poker:VeinteDeElectrico, poker:VeinteDeFuego, poker:VeinticincoDeElectrico ;
    poker:manoTienePar poker:Siete, poker:Veinte .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Treses con Dos" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDeAgua, poker:DiecinueveDeAgua, poker:DiecinueveDePlanta, poker:DosDeElectrico ;
    poker:manoTienePar poker:Tres, poker:Diecinueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieces con Trece Doce" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeFuego, poker:DiezDeAgua, poker:TreceDeAgua, poker:DoceDeAgua .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Unos con Catorce Cinco" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeAgua, poker:UnoDeElectrico, poker:CincoDeAgua, poker:CatorceDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Quinces con Trece Cinco" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:QuinceDeFuego, poker:QuinceDePlanta, poker:CincoDeElectrico, poker:TreceDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Doce Ocho" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDeFuego, poker:CuatroDePlanta, poker:OchoDeAgua, poker:DoceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeAgua, poker:DiezDeAgua .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeFuego .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDePlanta, poker:TreceDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:QuinceDeFuego, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintitres Veintidos Diecisiete Once Uno de Agua" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:OnceDeAgua, poker:UnoDeAgua, poker:DiecisieteDeAgua, poker:VeintitresDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Diecinueve Diecisiete Quince Uno de Electrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:VeinticuatroDeElectrico, poker:DiecinueveDeElectrico, poker:DiecisieteDeElectrico, poker:QuinceDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Doce Nueve Cuatro Dos Uno de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:CuatroDePlanta, poker:UnoDePlanta, poker:NueveDePlanta, poker:DoceDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veinticinco Dieciocho Diecisiete Trece Cuatro de Fuego" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:VeinticincoDeFuego, poker:TreceDeFuego, poker:DieciochoDeFuego, poker:DiecisieteDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veintiunos con Par de Dieciseises" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:VeintiunoDeFuego, poker:VeintiunoDePlanta, poker:DieciseisDeFuego, poker:DieciseisDePlanta ;
    poker:manoTienePar poker:Veintiuno, poker:Dieciseis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Veinticuatros" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDePlanta, poker:OchoDeElectrico, poker:VeinticuatroDeAgua, poker:VeinticuatroDeFuego ;
    poker:manoTienePar poker:Ocho, poker:Veinticuatro .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Dieciochos" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDePlanta, poker:CuatroDeAgua, poker:DieciochoDePlanta, poker:DieciochoDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Dieciocho .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Veintes" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDeElectrico, poker:TreceDePlanta, poker:VeinteDeElectrico, poker:VeinteDeAgua ;
    poker:manoTienePar poker:Trece, poker:Veinte .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Veintiunos con Catorce de Electrico" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintiunoDeAgua, poker:VeintiunoDePlanta, poker:VeintiunoDeElectrico, poker:CatorceDeElectrico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Unos con Veinticuatro de Electrico" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeAgua, poker:UnoDeElectrico, poker:UnoDeFuego, poker:VeinticuatroDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cincos con Trece de Fuego" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDePlanta, poker:CincoDeFuego, poker:CincoDeAgua, poker:TreceDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Diecinueves con Quince de Electrico" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:DiecinueveDeFuego, poker:DiecinueveDeAgua, poker:DiecinueveDeElectrico, poker:QuinceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Agua" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro de Planta" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Agua" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Electrico" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta, poker:VeinticincoDePlanta .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintidosDeFuego, poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintidosDeElectrico, poker:VeintitresDeElectrico, poker:VeinticuatroDeElectrico, poker:VeinticincoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
