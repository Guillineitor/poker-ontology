# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Diecisiete Doce Tres Uno" ;
    poker:contieneCarta poker:VeintitresDePlanta, poker:DiecisieteDePlanta, poker:DoceDeAgua, poker:UnoDeFuego, poker:TresDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Dieciocho Quince Trece Cinco" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:CincoDeAgua, poker:TreceDeElectrico, poker:VeintitresDeElectrico, poker:DieciochoDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Dieciseis Catorce Trece Seis" ;
    poker:contieneCarta poker:TreceDeAgua, poker:SeisDeAgua, poker:CatorceDePlanta, poker:VeinticuatroDeAgua, poker:DieciseisDeFuego .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Dieciocho Dieciseis Ocho Seis" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:OchoDeFuego, poker:SeisDeElectrico, poker:DieciochoDeFuego, poker:DieciseisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Veintitreses con Diecinueve Catorce Tres" ;
    poker:contieneCarta poker:VeintitresDePlanta, poker:VeintitresDeAgua, poker:DiecinueveDeFuego, poker:TresDeFuego, poker:CatorceDePlanta .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Onces con Veinte Trece Cuatro" ;
    poker:contieneCarta poker:OnceDeFuego, poker:OnceDeAgua, poker:CuatroDeFuego, poker:VeinteDeFuego, poker:TreceDeElectrico .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Treses con Veinticinco Dieciseis Dos" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeFuego, poker:DieciseisDeAgua, poker:DosDeElectrico, poker:VeinticincoDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Catorces con Veintitres Veintidos Siete" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:CatorceDeAgua, poker:SieteDeElectrico, poker:VeintidosDePlanta, poker:VeintitresDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Ochos con Quince" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeAgua, poker:DieciseisDePlanta, poker:DieciseisDeFuego, poker:QuinceDeAgua ;
    poker:manoTienePar poker:Ocho, poker:Dieciseis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Dieciseises con Once" ;
    poker:contieneCarta poker:DieciseisDeFuego, poker:DieciseisDeAgua, poker:VeintiunoDePlanta, poker:VeintiunoDeElectrico, poker:OnceDeElectrico ;
    poker:manoTienePar poker:Dieciseis, poker:Veintiuno .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Doces con Cinco" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeAgua, poker:QuinceDeFuego, poker:QuinceDeElectrico, poker:CincoDeElectrico ;
    poker:manoTienePar poker:Doce, poker:Quince .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Seises con Cuatro" ;
    poker:contieneCarta poker:VeintidosDeFuego, poker:VeintidosDeElectrico, poker:SeisDeAgua, poker:SeisDeFuego, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Veintidos, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Seises con Quince Ocho" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDeFuego, poker:SeisDeAgua, poker:QuinceDePlanta, poker:OchoDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Catorces con Veinticinco Nueve" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:CatorceDeElectrico, poker:CatorceDeAgua, poker:VeinticincoDePlanta, poker:NueveDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintes con Dieciocho Cinco" ;
    poker:contieneCarta poker:VeinteDeElectrico, poker:VeinteDeAgua, poker:VeinteDePlanta, poker:CincoDeAgua, poker:DieciochoDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cincos con Veinticinco Dieciseis" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeElectrico, poker:CincoDeFuego, poker:VeinticincoDePlanta, poker:DieciseisDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Once-Doce-Trece-Catorce-Quince" ;
    poker:contieneCarta poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua, poker:CatorceDeFuego, poker:QuinceDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:QuinceDeAgua, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDePlanta, poker:TreceDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeAgua, poker:DiecinueveDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintitres Veinte Dieciocho Nueve de Electrico" ;
    poker:contieneCarta poker:VeinteDeElectrico, poker:VeinticuatroDeElectrico, poker:VeintitresDeElectrico, poker:DieciochoDeElectrico, poker:NueveDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintidos Catorce Doce Tres de Planta" ;
    poker:contieneCarta poker:VeinticuatroDePlanta, poker:VeintidosDePlanta, poker:TresDePlanta, poker:DoceDePlanta, poker:CatorceDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintidos Veinte Trece Ocho Cinco de Electrico" ;
    poker:contieneCarta poker:VeintidosDeElectrico, poker:VeinteDeElectrico, poker:OchoDeElectrico, poker:CincoDeElectrico, poker:TreceDeElectrico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Diecisiete Dieciseis Quince Doce Once de Agua" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DoceDeAgua, poker:QuinceDeAgua, poker:OnceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Diecinueves con Par de Quinces" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:DiecinueveDeAgua, poker:DiecinueveDePlanta, poker:QuinceDeAgua, poker:QuinceDePlanta ;
    poker:manoTienePar poker:Diecinueve, poker:Quince .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Nueves" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDeElectrico, poker:OchoDePlanta, poker:NueveDePlanta, poker:NueveDeAgua ;
    poker:manoTienePar poker:Ocho, poker:Nueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Veintidoses" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeFuego, poker:UnoDePlanta, poker:VeintidosDeAgua, poker:VeintidosDeElectrico ;
    poker:manoTienePar poker:Uno, poker:Veintidos .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Cincos" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeElectrico, poker:OchoDeAgua, poker:CincoDeElectrico, poker:CincoDePlanta ;
    poker:manoTienePar poker:Ocho, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Dieciseis de Fuego" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeElectrico, poker:CincoDeAgua, poker:CincoDePlanta, poker:DieciseisDeFuego .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veintidoses con Ocho de Fuego" ;
    poker:contieneCarta poker:VeintidosDeFuego, poker:VeintidosDePlanta, poker:VeintidosDeAgua, poker:VeintidosDeElectrico, poker:OchoDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veintiunos con Quince de Fuego" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintiunoDePlanta, poker:VeintiunoDeFuego, poker:VeintiunoDeAgua, poker:QuinceDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Onces con Dieciocho de Electrico" ;
    poker:contieneCarta poker:OnceDePlanta, poker:OnceDeFuego, poker:OnceDeElectrico, poker:OnceDeAgua, poker:DieciochoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Planta" ;
    poker:contieneCarta poker:CincoDePlanta, poker:SeisDePlanta, poker:SieteDePlanta, poker:OchoDePlanta, poker:NueveDePlanta .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte de Electrico" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico, poker:VeinteDeElectrico .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos de Fuego" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:DiecinueveDeFuego, poker:VeinteDeFuego, poker:VeintiunoDeFuego, poker:VeintidosDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Diecinueve-Veinte-Veintiuno-Veintidos-Veintitres de Planta" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:VeinteDePlanta, poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintidosDeFuego, poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta, poker:VeinticincoDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintidosDeElectrico, poker:VeintitresDeElectrico, poker:VeinticuatroDeElectrico, poker:VeinticincoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
