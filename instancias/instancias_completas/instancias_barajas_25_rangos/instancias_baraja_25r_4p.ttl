# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Dieciseis Quince Tres Uno" ;
    poker:contieneCarta poker:UnoDeAgua, poker:QuinceDeAgua, poker:VeinticincoDeElectrico, poker:TresDeAgua, poker:DieciseisDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Diecinueve Dieciseis Trece Doce" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:VeintidosDeFuego, poker:DiecinueveDePlanta, poker:DoceDeFuego, poker:TreceDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Dieciseis Quince Trece Siete" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:VeinticincoDeAgua, poker:QuinceDePlanta, poker:TreceDeFuego, poker:SieteDeFuego .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiuno con Veinte Dieciseis Once Cinco" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:VeinteDePlanta, poker:VeintiunoDeAgua, poker:OnceDePlanta, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Quince Ocho Tres" ;
    poker:contieneCarta poker:DieciseisDeFuego, poker:DieciseisDeElectrico, poker:QuinceDePlanta, poker:TresDePlanta, poker:OchoDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Catorces con Trece Once Nueve" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:CatorceDeFuego, poker:OnceDeElectrico, poker:TreceDeAgua, poker:NueveDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Sietes con Once Ocho Tres" ;
    poker:contieneCarta poker:SieteDePlanta, poker:SieteDeElectrico, poker:TresDePlanta, poker:OchoDeFuego, poker:OnceDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cincos con Veinte Doce Nueve" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDePlanta, poker:DoceDeAgua, poker:NueveDePlanta, poker:VeinteDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Cuatros con Diez" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintiunoDeElectrico, poker:CuatroDeAgua, poker:CuatroDePlanta, poker:DiezDeFuego ;
    poker:manoTienePar poker:Veintiuno, poker:Cuatro .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Cuatros con Dieciseis" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:SieteDeAgua, poker:SieteDeElectrico, poker:DieciseisDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Siete .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Ochos con Nueve" ;
    poker:contieneCarta poker:OchoDeFuego, poker:OchoDeElectrico, poker:DiecisieteDeAgua, poker:DiecisieteDePlanta, poker:NueveDeFuego ;
    poker:manoTienePar poker:Ocho, poker:Diecisiete .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veinticuatros y Ochos con Diecinueve" ;
    poker:contieneCarta poker:VeinticuatroDePlanta, poker:VeinticuatroDeElectrico, poker:OchoDeAgua, poker:OchoDePlanta, poker:DiecinueveDePlanta ;
    poker:manoTienePar poker:Veinticuatro, poker:Ocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Veintidoses con Veintiuno Quince" ;
    poker:contieneCarta poker:VeintidosDeFuego, poker:VeintidosDePlanta, poker:VeintidosDeElectrico, poker:VeintiunoDePlanta, poker:QuinceDeAgua .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Quinces con Veintitres Cinco" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:QuinceDeElectrico, poker:QuinceDePlanta, poker:VeintitresDePlanta, poker:CincoDeElectrico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Unos con Veinte Seis" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDePlanta, poker:UnoDeFuego, poker:SeisDeFuego, poker:VeinteDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Diecinueves con Veinticuatro Veintidos" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:DiecinueveDeFuego, poker:DiecinueveDeElectrico, poker:VeintidosDeElectrico, poker:VeinticuatroDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintidosDeElectrico, poker:VeintitresDeElectrico, poker:VeinticuatroDePlanta, poker:VeinticincoDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro" ;
    poker:contieneCarta poker:VeinteDeFuego, poker:VeintiunoDePlanta, poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeFuego .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SieteDeAgua, poker:OchoDeFuego, poker:NueveDeAgua, poker:DiezDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Catorce Doce Ocho Siete de Electrico" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:DoceDeElectrico, poker:OchoDeElectrico, poker:CatorceDeElectrico, poker:VeinticuatroDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veinte Dieciocho Diecisiete Doce Diez de Planta" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DoceDePlanta, poker:DiezDePlanta, poker:DiecisieteDePlanta, poker:VeinteDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintitres Veintidos Dieciocho Dieciseis de Agua" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:DieciochoDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeintidosDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Dieciseis Siete Cinco Tres Dos de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:DieciseisDeAgua, poker:SieteDeAgua, poker:TresDeAgua, poker:DosDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticincos con Par de Sietes" ;
    poker:contieneCarta poker:VeinticincoDeElectrico, poker:VeinticincoDeFuego, poker:VeinticincoDePlanta, poker:SieteDeAgua, poker:SieteDeFuego ;
    poker:manoTienePar poker:Veinticinco, poker:Siete .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintes con Par de Dieciochos" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeinteDeFuego, poker:VeinteDeElectrico, poker:DieciochoDeElectrico, poker:DieciochoDeAgua ;
    poker:manoTienePar poker:Veinte, poker:Dieciocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Seises" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDePlanta, poker:OchoDeElectrico, poker:SeisDeFuego, poker:SeisDeElectrico ;
    poker:manoTienePar poker:Ocho, poker:Seis .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Veintitreses" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:DieciseisDeFuego, poker:DieciseisDeElectrico, poker:VeintitresDeElectrico, poker:VeintitresDePlanta ;
    poker:manoTienePar poker:Dieciseis, poker:Veintitres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Diecinueves con Tres de Planta" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:DiecinueveDeElectrico, poker:DiecinueveDeAgua, poker:DiecinueveDeFuego, poker:TresDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Doses con Ocho de Electrico" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeAgua, poker:DosDePlanta, poker:DosDeElectrico, poker:OchoDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Dieciochos con Quince de Fuego" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DieciochoDeAgua, poker:DieciochoDeElectrico, poker:DieciochoDeFuego, poker:QuinceDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Sietes con Trece de Planta" ;
    poker:contieneCarta poker:SieteDePlanta, poker:SieteDeFuego, poker:SieteDeElectrico, poker:SieteDeAgua, poker:TreceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Trece-Catorce-Quince-Dieciseis-Diecisiete de Fuego" ;
    poker:contieneCarta poker:TreceDeFuego, poker:CatorceDeFuego, poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeFuego .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Planta" ;
    poker:contieneCarta poker:CincoDePlanta, poker:SeisDePlanta, poker:SieteDePlanta, poker:OchoDePlanta, poker:NueveDePlanta .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte de Fuego" ;
    poker:contieneCarta poker:DieciseisDeFuego, poker:DiecisieteDeFuego, poker:DieciochoDeFuego, poker:DiecinueveDeFuego, poker:VeinteDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos de Planta" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DiecinueveDePlanta, poker:VeinteDePlanta, poker:VeintiunoDePlanta, poker:VeintidosDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta, poker:VeinticincoDePlanta .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintidosDeElectrico, poker:VeintitresDeElectrico, poker:VeinticuatroDeElectrico, poker:VeinticincoDeElectrico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintidosDeFuego, poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
