# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Veintiuno Veinte Dieciocho Quince" ;
    poker:contieneCarta poker:DieciochoDeVolador, poker:VeintiunoDeTierra, poker:VeinteDeBicho, poker:VeinticincoDeFantasma, poker:QuinceDeRoca .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Catorce Once Tres Uno" ;
    poker:contieneCarta poker:TresDeLucha, poker:OnceDeSiniestro, poker:VeinticuatroDeHielo, poker:CatorceDeAgua, poker:UnoDeTierra .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Veinte Dieciseis Ocho Dos" ;
    poker:contieneCarta poker:VeintidosDeDragon, poker:OchoDeFantasma, poker:VeinteDeVolador, poker:DosDeNormal, poker:DieciseisDeVolador .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Veintiuno Dieciocho Trece Ocho" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:VeintiunoDeBicho, poker:VeintitresDeAgua, poker:OchoDePsiquico, poker:TreceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Veinticinco Ocho Tres" ;
    poker:contieneCarta poker:DiecisieteDeSiniestro, poker:DiecisieteDeDragon, poker:TresDeRoca, poker:VeinticincoDeFantasma, poker:OchoDeNormal .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Veintiunos con Diecinueve Diecisiete Cinco" ;
    poker:contieneCarta poker:VeintiunoDeDragon, poker:VeintiunoDeBicho, poker:DiecisieteDeAgua, poker:CincoDeNormal, poker:DiecinueveDeVeneno .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintidoses con Catorce Once Cinco" ;
    poker:contieneCarta poker:VeintidosDeRoca, poker:VeintidosDeFuego, poker:CatorceDeSiniestro, poker:CincoDePlanta, poker:OnceDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veinticuatros con Dieciseis Quince Cuatro" ;
    poker:contieneCarta poker:VeinticuatroDeElectrico, poker:VeinticuatroDeRoca, poker:QuinceDeTierra, poker:DieciseisDeSiniestro, poker:CuatroDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veinticuatros y Doses con Uno" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeHielo, poker:VeinticuatroDeBicho, poker:VeinticuatroDeLucha, poker:UnoDeFantasma ;
    poker:manoTienePar poker:Dos, poker:Veinticuatro .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veinticuatros y Dieciseises con Catorce" ;
    poker:contieneCarta poker:DieciseisDeDragon, poker:DieciseisDeTierra, poker:VeinticuatroDeVeneno, poker:VeinticuatroDePlanta, poker:CatorceDeLucha ;
    poker:manoTienePar poker:Dieciseis, poker:Veinticuatro .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Diecisietes con Diez" ;
    poker:contieneCarta poker:DiecisieteDeRoca, poker:DiecisieteDeVolador, poker:VeinteDeBicho, poker:VeinteDeDragon, poker:DiezDeElectrico ;
    poker:manoTienePar poker:Diecisiete, poker:Veinte .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Nueves con Trece" ;
    poker:contieneCarta poker:NueveDeTierra, poker:NueveDePsiquico, poker:OnceDeFuego, poker:OnceDeElectrico, poker:TreceDeSiniestro ;
    poker:manoTienePar poker:Nueve, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieces con Doce Seis" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:DiezDeLucha, poker:DiezDeSiniestro, poker:DoceDeVolador, poker:SeisDeBicho .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Seises con Veinticinco Siete" ;
    poker:contieneCarta poker:SeisDeHielo, poker:SeisDeFantasma, poker:SeisDeFuego, poker:SieteDeVolador, poker:VeinticincoDeTierra .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieciseises con Veinte Siete" ;
    poker:contieneCarta poker:DieciseisDeDragon, poker:DieciseisDeElectrico, poker:DieciseisDeFuego, poker:VeinteDeRoca, poker:SieteDeNormal .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Onces con Dieciseis Ocho" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDeTierra, poker:OnceDeAgua, poker:OchoDeVolador, poker:DieciseisDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDeTierra, poker:QuinceDeTierra, poker:DieciseisDeNormal, poker:DiecisieteDeTierra, poker:DieciochoDeHielo .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco" ;
    poker:contieneCarta poker:VeintiunoDeBicho, poker:VeintidosDeLucha, poker:VeintitresDeVolador, poker:VeinticuatroDeRoca, poker:VeinticincoDeHielo .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDePsiquico, poker:SeisDeLucha, poker:SieteDeTierra, poker:OchoDeNormal, poker:NueveDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeTierra, poker:DiezDeAgua, poker:OnceDeVolador, poker:DoceDeHielo, poker:TreceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veinticinco Diecisiete Trece Nueve Tres de Normal" ;
    poker:contieneCarta poker:TresDeNormal, poker:NueveDeNormal, poker:VeinticincoDeNormal, poker:DiecisieteDeNormal, poker:TreceDeNormal .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veintidos Veinte Dieciseis Tres Uno de Normal" ;
    poker:contieneCarta poker:DieciseisDeNormal, poker:VeinteDeNormal, poker:VeintidosDeNormal, poker:UnoDeNormal, poker:TresDeNormal .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintidos Veinte Diecisiete Catorce Seis de Hielo" ;
    poker:contieneCarta poker:CatorceDeHielo, poker:VeintidosDeHielo, poker:VeinteDeHielo, poker:DiecisieteDeHielo, poker:SeisDeHielo .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintitres Veintidos Diecinueve Ocho Dos de Dragon" ;
    poker:contieneCarta poker:VeintitresDeDragon, poker:DiecinueveDeDragon, poker:OchoDeDragon, poker:VeintidosDeDragon, poker:DosDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticuatros con Par de Nueves" ;
    poker:contieneCarta poker:VeinticuatroDeBicho, poker:VeinticuatroDeHielo, poker:VeinticuatroDeVeneno, poker:NueveDeAgua, poker:NueveDeElectrico ;
    poker:manoTienePar poker:Veinticuatro, poker:Nueve .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Diecisietes" ;
    poker:contieneCarta poker:DoceDeSiniestro, poker:DoceDeRoca, poker:DoceDePsiquico, poker:DiecisieteDeLucha, poker:DiecisieteDeFantasma ;
    poker:manoTienePar poker:Doce, poker:Diecisiete .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Quinces" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDeVolador, poker:OnceDeLucha, poker:QuinceDeAgua, poker:QuinceDeNormal ;
    poker:manoTienePar poker:Once, poker:Quince .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Veinticuatros" ;
    poker:contieneCarta poker:DoceDeDragon, poker:DoceDeAgua, poker:DoceDeTierra, poker:VeinticuatroDeSiniestro, poker:VeinticuatroDeNormal ;
    poker:manoTienePar poker:Doce, poker:Veinticuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doces con Siete de Agua" ;
    poker:contieneCarta poker:DoceDeVolador, poker:DoceDeBicho, poker:DoceDeLucha, poker:DoceDeSiniestro, poker:SieteDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Seises con Veinticinco de Electrico" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDePlanta, poker:SeisDeVolador, poker:SeisDeTierra, poker:VeinticincoDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Dieces con Once de Fantasma" ;
    poker:contieneCarta poker:DiezDeNormal, poker:DiezDeDragon, poker:DiezDeRoca, poker:DiezDeTierra, poker:OnceDeFantasma .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Nueves con Dos de Hielo" ;
    poker:contieneCarta poker:NueveDeSiniestro, poker:NueveDeNormal, poker:NueveDeTierra, poker:NueveDePlanta, poker:DosDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve de Fuego" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeFuego, poker:DieciochoDeFuego, poker:DiecinueveDeFuego .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Siniestro" ;
    poker:contieneCarta poker:CincoDeSiniestro, poker:SeisDeSiniestro, poker:SieteDeSiniestro, poker:OchoDeSiniestro, poker:NueveDeSiniestro .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Trece-Catorce-Quince-Dieciseis-Diecisiete de Psiquico" ;
    poker:contieneCarta poker:TreceDePsiquico, poker:CatorceDePsiquico, poker:QuinceDePsiquico, poker:DieciseisDePsiquico, poker:DiecisieteDePsiquico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Lucha" ;
    poker:contieneCarta poker:SeisDeLucha, poker:SieteDeLucha, poker:OchoDeLucha, poker:NueveDeLucha, poker:DiezDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintidosDeFuego, poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:VeintiunoDeTierra, poker:VeintidosDeTierra, poker:VeintitresDeTierra, poker:VeinticuatroDeTierra, poker:VeinticincoDeTierra .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Hielo" ;
    poker:contieneCarta poker:VeintiunoDeHielo, poker:VeintidosDeHielo, poker:VeintitresDeHielo, poker:VeinticuatroDeHielo, poker:VeinticincoDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
