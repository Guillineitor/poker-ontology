# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiuno con Diecisiete Trece Once Diez" ;
    poker:contieneCarta poker:VeintiunoDeFantasma, poker:DiezDePlanta, poker:OnceDeNormal, poker:TreceDeSiniestro, poker:DiecisieteDeTierra .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Once Diez Seis Tres" ;
    poker:contieneCarta poker:OnceDePsiquico, poker:DiezDeVeneno, poker:SeisDePlanta, poker:TresDeAgua, poker:DieciseisDeLucha .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinte con Siete Seis Tres Uno" ;
    poker:contieneCarta poker:SeisDeFuego, poker:TresDeFantasma, poker:UnoDeFantasma, poker:VeinteDePlanta, poker:SieteDeFantasma .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Diecisiete Catorce Once Dos" ;
    poker:contieneCarta poker:OnceDeHielo, poker:DiecisieteDeSiniestro, poker:CatorceDeFuego, poker:DosDeFuego, poker:DiecinueveDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treces con Veintidos Diecinueve Diez" ;
    poker:contieneCarta poker:TreceDeBicho, poker:TreceDeAgua, poker:VeintidosDeElectrico, poker:DiezDeElectrico, poker:DiecinueveDeSiniestro .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Quinces con Veintiuno Once Diez" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDeFantasma, poker:OnceDeTierra, poker:DiezDeNormal, poker:VeintiunoDeLucha .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Seises con Once Nueve Siete" ;
    poker:contieneCarta poker:SeisDeTierra, poker:SeisDePsiquico, poker:SieteDeNormal, poker:NueveDeFantasma, poker:OnceDeLucha .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cuatros con Catorce Ocho Cinco" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDeLucha, poker:CatorceDeFuego, poker:CincoDeLucha, poker:OchoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintitreses y Diecinueves con Cuatro" ;
    poker:contieneCarta poker:DiecinueveDePsiquico, poker:DiecinueveDeBicho, poker:VeintitresDeFuego, poker:VeintitresDeNormal, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Diecinueve, poker:Veintitres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Quinces con Once" ;
    poker:contieneCarta poker:DieciochoDeFantasma, poker:DieciochoDePlanta, poker:QuinceDeHielo, poker:QuinceDeDragon, poker:OnceDeElectrico ;
    poker:manoTienePar poker:Dieciocho, poker:Quince .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Cincos con Diez" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeRoca, poker:VeintiunoDeVeneno, poker:VeintiunoDeNormal, poker:DiezDeDragon ;
    poker:manoTienePar poker:Cinco, poker:Veintiuno .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Catorces y Doces con Veintiuno" ;
    poker:contieneCarta poker:DoceDeVolador, poker:DoceDeHielo, poker:CatorceDeLucha, poker:CatorceDeTierra, poker:VeintiunoDeFuego ;
    poker:manoTienePar poker:Doce, poker:Catorce .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Veintidoses con Diecinueve Diez" ;
    poker:contieneCarta poker:VeintidosDeFantasma, poker:VeintidosDeRoca, poker:VeintidosDeSiniestro, poker:DiecinueveDeFuego, poker:DiezDeDragon .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Veintiuno Tres" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeLucha, poker:DoceDeElectrico, poker:VeintiunoDeNormal, poker:TresDeHielo .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieces con Veintidos Uno" ;
    poker:contieneCarta poker:DiezDeRoca, poker:DiezDePlanta, poker:DiezDeVeneno, poker:UnoDePlanta, poker:VeintidosDeDragon .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Doces con Ocho Seis" ;
    poker:contieneCarta poker:DoceDeHielo, poker:DoceDeSiniestro, poker:DoceDeBicho, poker:OchoDePlanta, poker:SeisDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeSiniestro, poker:NueveDeDragon, poker:DiezDePsiquico, poker:OnceDeAgua, poker:DoceDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeTierra, poker:TreceDeAgua, poker:CatorceDeBicho, poker:QuinceDeVolador, poker:DieciseisDeNormal .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeDragon, poker:DieciochoDeDragon, poker:DiecinueveDePlanta, poker:VeinteDeBicho, poker:VeintiunoDeLucha .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeBicho, poker:CuatroDePsiquico, poker:CincoDeFuego, poker:SeisDeFantasma, poker:SieteDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintiuno Catorce Diez Cinco Cuatro de Hielo" ;
    poker:contieneCarta poker:CuatroDeHielo, poker:VeintiunoDeHielo, poker:CincoDeHielo, poker:CatorceDeHielo, poker:DiezDeHielo .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veinte Dieciocho Dieciseis Quince Cinco de Normal" ;
    poker:contieneCarta poker:CincoDeNormal, poker:DieciochoDeNormal, poker:QuinceDeNormal, poker:DieciseisDeNormal, poker:VeinteDeNormal .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintitres Veinte Quince Catorce Tres de Volador" ;
    poker:contieneCarta poker:QuinceDeVolador, poker:TresDeVolador, poker:VeintitresDeVolador, poker:CatorceDeVolador, poker:VeinteDeVolador .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintitres Dieciocho Diecisiete Quince Cuatro de Veneno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:VeintitresDeVeneno, poker:QuinceDeVeneno, poker:DiecisieteDeVeneno, poker:DieciochoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Diecisietes" ;
    poker:contieneCarta poker:DieciseisDeRoca, poker:DieciseisDeLucha, poker:DieciseisDeVeneno, poker:DiecisieteDeVolador, poker:DiecisieteDeElectrico ;
    poker:manoTienePar poker:Dieciseis, poker:Diecisiete .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Veintitreses" ;
    poker:contieneCarta poker:VeintidosDeDragon, poker:VeintidosDeVolador, poker:VeintidosDeHielo, poker:VeintitresDeDragon, poker:VeintitresDeHielo ;
    poker:manoTienePar poker:Veintidos, poker:Veintitres .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Onces" ;
    poker:contieneCarta poker:DieciseisDeHielo, poker:DieciseisDeVolador, poker:DieciseisDePlanta, poker:OnceDeTierra, poker:OnceDeVolador ;
    poker:manoTienePar poker:Dieciseis, poker:Once .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Doces" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeAgua, poker:UnoDeBicho, poker:DoceDeVeneno, poker:DoceDeNormal ;
    poker:manoTienePar poker:Uno, poker:Doce .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Dieciocho de Fuego" ;
    poker:contieneCarta poker:CuatroDeHielo, poker:CuatroDeDragon, poker:CuatroDeSiniestro, poker:CuatroDeBicho, poker:DieciochoDeFuego .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treses con Dieciocho de Dragon" ;
    poker:contieneCarta poker:TresDeSiniestro, poker:TresDeRoca, poker:TresDeAgua, poker:TresDeDragon, poker:DieciochoDeDragon .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Nueves con Seis de Siniestro" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeBicho, poker:NueveDeVeneno, poker:NueveDeTierra, poker:SeisDeSiniestro .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Dieciochos con Tres de Normal" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DieciochoDeNormal, poker:DieciochoDeElectrico, poker:DieciochoDeBicho, poker:TresDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve de Tierra" ;
    poker:contieneCarta poker:QuinceDeTierra, poker:DieciseisDeTierra, poker:DiecisieteDeTierra, poker:DieciochoDeTierra, poker:DiecinueveDeTierra .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Trece-Catorce-Quince-Dieciseis-Diecisiete de Tierra" ;
    poker:contieneCarta poker:TreceDeTierra, poker:CatorceDeTierra, poker:QuinceDeTierra, poker:DieciseisDeTierra, poker:DiecisieteDeTierra .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro de Bicho" ;
    poker:contieneCarta poker:VeinteDeBicho, poker:VeintiunoDeBicho, poker:VeintidosDeBicho, poker:VeintitresDeBicho, poker:VeinticuatroDeBicho .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte de Veneno" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DiecisieteDeVeneno, poker:DieciochoDeVeneno, poker:DiecinueveDeVeneno, poker:VeinteDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Siniestro" ;
    poker:contieneCarta poker:VeintiunoDeSiniestro, poker:VeintidosDeSiniestro, poker:VeintitresDeSiniestro, poker:VeinticuatroDeSiniestro, poker:VeinticincoDeSiniestro .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:VeintiunoDeTierra, poker:VeintidosDeTierra, poker:VeintitresDeTierra, poker:VeinticuatroDeTierra, poker:VeinticincoDeTierra .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:VeintiunoDeNormal, poker:VeintidosDeNormal, poker:VeintitresDeNormal, poker:VeinticuatroDeNormal, poker:VeinticincoDeNormal .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Roca" ;
    poker:contieneCarta poker:VeintiunoDeRoca, poker:VeintidosDeRoca, poker:VeintitresDeRoca, poker:VeinticuatroDeRoca, poker:VeinticincoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
