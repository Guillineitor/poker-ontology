# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:UnoDeAgua, poker:SeisDeFuego, poker:TresDeAgua, poker:CincoDeFuego, poker:CuatroDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDeElectrico, poker:CincoDeFuego, poker:SeisDeAgua, poker:TresDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:DosDeAgua, poker:UnoDeAgua, poker:TresDePlanta, poker:SeisDePlanta, poker:CuatroDeFuego .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:DosDeElectrico, poker:UnoDeElectrico, poker:SeisDeAgua, poker:CuatroDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Seises con Cinco Cuatro Uno" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:UnoDeFuego, poker:CuatroDeAgua, poker:CincoDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Seis Tres Uno" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDePlanta, poker:UnoDeElectrico, poker:TresDeElectrico, poker:SeisDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Cuatros con Cinco Tres Dos" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDePlanta, poker:DosDeElectrico, poker:CincoDeAgua, poker:TresDeFuego .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cincos con Seis Cuatro Dos" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeFuego, poker:CuatroDePlanta, poker:DosDePlanta, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cincos con Cuatro" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDePlanta, poker:CincoDeFuego, poker:CincoDePlanta, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Seis, poker:Cinco .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cuatros con Dos" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeElectrico, poker:CuatroDePlanta, poker:CuatroDeAgua, poker:DosDeAgua ;
    poker:manoTienePar poker:Seis, poker:Cuatro .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Doses con Tres" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeAgua, poker:SeisDeElectrico, poker:SeisDePlanta, poker:TresDeFuego ;
    poker:manoTienePar poker:Dos, poker:Seis .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Treses con Seis" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeFuego, poker:CuatroDeElectrico, poker:CuatroDeAgua, poker:SeisDeElectrico ;
    poker:manoTienePar poker:Tres, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treses con Cinco Uno" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeFuego, poker:TresDeElectrico, poker:CincoDePlanta, poker:UnoDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doses con Seis Tres" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeFuego, poker:DosDeElectrico, poker:SeisDeElectrico, poker:TresDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cincos con Seis Uno" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeAgua, poker:CincoDeElectrico, poker:UnoDePlanta, poker:SeisDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Unos con Seis Tres" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeFuego, poker:UnoDeAgua, poker:TresDePlanta, poker:SeisDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDePlanta, poker:TresDeFuego, poker:CuatroDeAgua, poker:CincoDeFuego .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDePlanta, poker:SeisDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeAgua, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeFuego .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDePlanta, poker:SeisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:UnoDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:SeisDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:SeisDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:DosDeFuego .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Fuego" ;
    poker:contieneCarta poker:SeisDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:UnoDeFuego, poker:CuatroDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Electrico" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeElectrico, poker:UnoDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Unos" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:UnoDePlanta, poker:UnoDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Treses" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDePlanta, poker:UnoDeFuego, poker:TresDeAgua, poker:TresDeElectrico ;
    poker:manoTienePar poker:Uno, poker:Tres .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Cincos" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:SeisDeAgua, poker:CincoDePlanta, poker:CincoDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Cinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Treses" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeFuego, poker:DosDePlanta, poker:TresDePlanta, poker:TresDeElectrico ;
    poker:manoTienePar poker:Dos, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Tres de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeElectrico, poker:CincoDePlanta, poker:CincoDeFuego, poker:TresDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Seises con Cuatro de Electrico" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeElectrico, poker:SeisDeFuego, poker:SeisDePlanta, poker:CuatroDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Seis de Electrico" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeElectrico, poker:TresDePlanta, poker:TresDeFuego, poker:SeisDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treses con Uno de Electrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDeAgua, poker:TresDeFuego, poker:TresDePlanta, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Electrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Agua" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Electrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Agua" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
