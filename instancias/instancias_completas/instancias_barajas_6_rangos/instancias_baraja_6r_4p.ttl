# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeFuego, poker:UnoDePlanta, poker:CuatroDePlanta, poker:SeisDeFuego .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:DosDeElectrico, poker:CuatroDeFuego, poker:CincoDeFuego, poker:UnoDeFuego, poker:SeisDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:CincoDeElectrico, poker:CuatroDeElectrico, poker:SeisDeAgua, poker:TresDeFuego .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDePlanta, poker:UnoDeFuego, poker:SeisDeAgua, poker:CuatroDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Seis Cuatro Uno" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeAgua, poker:UnoDePlanta, poker:CuatroDeElectrico, poker:SeisDeElectrico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doses con Seis Cuatro Uno" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeElectrico, poker:CuatroDeAgua, poker:UnoDeFuego, poker:SeisDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Seises con Cuatro Tres Dos" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDeElectrico, poker:CuatroDePlanta, poker:DosDePlanta, poker:TresDeElectrico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Unos con Seis Cinco Cuatro" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeAgua, poker:SeisDeAgua, poker:CincoDeAgua, poker:CuatroDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Doses con Seis" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDePlanta, poker:DosDeAgua, poker:DosDeElectrico, poker:SeisDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Dos .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Treses con Dos" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CuatroDeAgua, poker:DosDeFuego ;
    poker:manoTienePar poker:Tres, poker:Cuatro .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Doses y Unos con Cinco" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeFuego, poker:UnoDePlanta, poker:UnoDeElectrico, poker:CincoDeFuego ;
    poker:manoTienePar poker:Dos, poker:Uno .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Doses con Cuatro" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDePlanta, poker:DosDeFuego, poker:DosDeAgua, poker:CuatroDeFuego ;
    poker:manoTienePar poker:Cinco, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Unos con Cuatro Dos" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeElectrico, poker:UnoDePlanta, poker:CuatroDeFuego, poker:DosDeAgua .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Seises con Cinco Cuatro" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDePlanta, poker:SeisDeFuego, poker:CincoDePlanta, poker:CuatroDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cincos con Seis Uno" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeFuego, poker:CincoDeAgua, poker:UnoDePlanta, poker:SeisDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Seises con Tres Uno" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:SeisDeAgua, poker:TresDeFuego, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDePlanta, poker:TresDeAgua, poker:CuatroDeElectrico, poker:CincoDeAgua .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDeAgua, poker:CuatroDeElectrico, poker:CincoDeFuego, poker:SeisDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDePlanta, poker:CuatroDeAgua, poker:CincoDeElectrico, poker:SeisDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeAgua, poker:CuatroDeElectrico, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Eléctrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:UnoDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:CuatroDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Eléctrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:SeisDeElectrico, poker:CincoDeElectrico, poker:DosDeElectrico, poker:UnoDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:SeisDeFuego, poker:TresDeFuego, poker:CincoDeFuego, poker:DosDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:UnoDeFuego, poker:CincoDeFuego, poker:CuatroDeFuego, poker:SeisDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Cuatros" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDeAgua, poker:TresDeFuego, poker:CuatroDeFuego, poker:CuatroDeElectrico ;
    poker:manoTienePar poker:Tres, poker:Cuatro .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Seises" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeAgua, poker:DosDeElectrico, poker:SeisDeFuego, poker:SeisDeElectrico ;
    poker:manoTienePar poker:Dos, poker:Seis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Cuatros" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeElectrico, poker:DosDePlanta, poker:CuatroDeFuego, poker:CuatroDeElectrico ;
    poker:manoTienePar poker:Dos, poker:Cuatro .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Cincos" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeFuego, poker:DosDeAgua, poker:CincoDeFuego, poker:CincoDeAgua ;
    poker:manoTienePar poker:Dos, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doses con Cinco de Fuego" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeElectrico, poker:DosDeFuego, poker:DosDePlanta, poker:CincoDeFuego .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Unos con Cinco de Agua" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeElectrico, poker:UnoDeAgua, poker:UnoDeFuego, poker:CincoDeAgua .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cincos con Tres de Agua" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeFuego, poker:CincoDeElectrico, poker:CincoDeAgua, poker:TresDeAgua .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Cincos con Cuatro de Planta" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeElectrico, poker:CincoDePlanta, poker:CincoDeFuego, poker:CuatroDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Eléctrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
