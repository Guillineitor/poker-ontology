# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:CincoDeFuego, poker:UnoDeElectrico, poker:SeisDePlanta, poker:TresDePlanta, poker:DosDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:CuatroDeFuego, poker:TresDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:CincoDePlanta, poker:SeisDeFuego, poker:UnoDeAgua, poker:CuatroDePlanta, poker:DosDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:UnoDeFuego, poker:SeisDeElectrico, poker:TresDePlanta, poker:DosDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Unos con Seis Cinco Dos" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeAgua, poker:CincoDeFuego, poker:SeisDeAgua, poker:DosDeElectrico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Tres Dos Uno" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDePlanta, poker:UnoDeFuego, poker:DosDeAgua, poker:TresDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Cuatros con Tres Dos Uno" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeFuego, poker:DosDePlanta, poker:TresDeAgua, poker:UnoDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Seises con Tres Dos Uno" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:TresDeElectrico, poker:UnoDeAgua, poker:DosDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Cuatros con Tres" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeAgua, poker:CuatroDeFuego, poker:CuatroDeAgua, poker:TresDeFuego ;
    poker:manoTienePar poker:Cinco, poker:Cuatro .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Unos con Tres" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeFuego, poker:UnoDeElectrico, poker:UnoDeFuego, poker:TresDePlanta ;
    poker:manoTienePar poker:Cinco, poker:Uno .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Treses con Dos" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDeFuego, poker:TresDePlanta, poker:TresDeFuego, poker:DosDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Tres .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Unos con Cuatro" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeAgua, poker:UnoDeAgua, poker:UnoDeFuego, poker:CuatroDeFuego ;
    poker:manoTienePar poker:Cinco, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Seises con Cinco Uno" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDePlanta, poker:SeisDeAgua, poker:CincoDeElectrico, poker:UnoDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Unos con Cinco Dos" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeFuego, poker:UnoDePlanta, poker:CincoDePlanta, poker:DosDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cincos con Seis Cuatro" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeAgua, poker:CincoDeFuego, poker:SeisDeFuego, poker:CuatroDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Seis Cinco" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:SeisDeElectrico, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeFuego, poker:TresDePlanta, poker:CuatroDeAgua, poker:CincoDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDePlanta, poker:CuatroDeElectrico, poker:CincoDeAgua, poker:SeisDeFuego .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeFuego, poker:CuatroDeAgua, poker:CincoDeFuego, poker:SeisDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDePlanta, poker:TresDeAgua, poker:CuatroDePlanta, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CuatroDeAgua, poker:SeisDeAgua, poker:DosDeAgua, poker:UnoDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Electrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:CuatroDeElectrico, poker:SeisDeElectrico, poker:UnoDeElectrico, poker:CincoDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Planta" ;
    poker:contieneCarta poker:SeisDePlanta, poker:DosDePlanta, poker:CuatroDePlanta, poker:TresDePlanta, poker:UnoDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Electrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:DosDeElectrico, poker:CincoDeElectrico, poker:UnoDeElectrico, poker:SeisDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Seises" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:SeisDePlanta, poker:SeisDeFuego ;
    poker:manoTienePar poker:Cuatro, poker:Seis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Unos" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:UnoDeElectrico, poker:UnoDeAgua ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Doses" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeAgua, poker:UnoDePlanta, poker:DosDePlanta, poker:DosDeElectrico ;
    poker:manoTienePar poker:Uno, poker:Dos .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Cincos" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:SeisDeElectrico, poker:CincoDeAgua, poker:CincoDePlanta ;
    poker:manoTienePar poker:Seis, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Cinco de Planta" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeFuego, poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CincoDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Seises con Cuatro de Agua" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeFuego, poker:SeisDePlanta, poker:SeisDeElectrico, poker:CuatroDeAgua .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Cuatro de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDePlanta, poker:TresDeAgua, poker:TresDeElectrico, poker:CuatroDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treses con Dos de Agua" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDeFuego, poker:TresDePlanta, poker:TresDeAgua, poker:DosDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Agua" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Electrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
