# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:UnoDeFuego, poker:CincoDeBicho, poker:SeisDeElectrico, poker:TresDeBicho .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:UnoDeAgua, poker:SeisDeVeneno, poker:TresDePlanta, poker:CincoDePlanta, poker:DosDeFuego .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:TresDeBicho, poker:UnoDeVolador, poker:CincoDeFuego, poker:SeisDeVolador, poker:DosDeVolador .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:CincoDeBicho, poker:DosDeNormal, poker:TresDePlanta, poker:UnoDeNormal, poker:SeisDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Cinco Cuatro Uno" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeAgua, poker:UnoDeFuego, poker:CuatroDeBicho, poker:CincoDeVeneno .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doses con Seis Cinco Cuatro" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeVolador, poker:CuatroDeBicho, poker:SeisDeVeneno, poker:CincoDeVeneno .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doses con Cinco Tres Uno" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeFuego, poker:UnoDeBicho, poker:CincoDeBicho, poker:TresDeBicho .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Unos con Seis Cinco Dos" ;
    poker:contieneCarta poker:UnoDeVolador, poker:UnoDeBicho, poker:CincoDeElectrico, poker:SeisDeFuego, poker:DosDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Seis" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeVeneno, poker:CuatroDeVolador, poker:CuatroDeFuego, poker:SeisDeVolador ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Cuatros con Dos" ;
    poker:contieneCarta poker:CincoDeBicho, poker:CincoDeElectrico, poker:CuatroDeVolador, poker:CuatroDeVeneno, poker:DosDeVolador ;
    poker:manoTienePar poker:Cinco, poker:Cuatro .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Doses con Seis" ;
    poker:contieneCarta poker:DosDeVolador, poker:DosDeNormal, poker:CincoDeFuego, poker:CincoDeVeneno, poker:SeisDeElectrico ;
    poker:manoTienePar poker:Dos, poker:Cinco .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Cuatros con Uno" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeNormal, poker:CincoDeFuego, poker:CincoDeVeneno, poker:UnoDeVeneno ;
    poker:manoTienePar poker:Cuatro, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Cinco Dos" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDeVolador, poker:CuatroDePlanta, poker:CincoDeVolador, poker:DosDeElectrico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doses con Seis Uno" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeElectrico, poker:DosDeAgua, poker:SeisDeFuego, poker:UnoDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doses con Cinco Cuatro" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDePlanta, poker:DosDeNormal, poker:CincoDeElectrico, poker:CuatroDeVolador .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cincos con Cuatro Uno" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeBicho, poker:CincoDeVolador, poker:CuatroDeNormal, poker:UnoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDeNormal, poker:CuatroDeVolador, poker:CincoDeFuego, poker:SeisDeVolador .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDePlanta, poker:CuatroDeElectrico, poker:CincoDeFuego, poker:SeisDeVeneno .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeVeneno, poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeBicho, poker:SeisDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDeAgua, poker:TresDeNormal, poker:CuatroDeElectrico, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Volador" ;
    poker:contieneCarta poker:TresDeVolador, poker:CuatroDeVolador, poker:DosDeVolador, poker:SeisDeVolador, poker:UnoDeVolador .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Electrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:DosDeElectrico, poker:SeisDeElectrico, poker:CincoDeElectrico, poker:UnoDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Veneno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:UnoDeVeneno, poker:SeisDeVeneno, poker:CincoDeVeneno, poker:DosDeVeneno .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Normal" ;
    poker:contieneCarta poker:SeisDeNormal, poker:CuatroDeNormal, poker:DosDeNormal, poker:TresDeNormal, poker:UnoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Doses" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDeNormal, poker:SeisDeElectrico, poker:DosDeBicho, poker:DosDePlanta ;
    poker:manoTienePar poker:Seis, poker:Dos .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Seises" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeVeneno, poker:DosDeElectrico, poker:SeisDeNormal, poker:SeisDeBicho ;
    poker:manoTienePar poker:Dos, poker:Seis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Cuatros" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDeFuego, poker:CincoDeNormal, poker:CuatroDeElectrico, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Cuatro .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Cuatros" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeBicho, poker:DosDeNormal, poker:CuatroDeNormal, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Dos, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Uno de Bicho" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDeAgua, poker:CuatroDeVeneno, poker:CuatroDeElectrico, poker:UnoDeBicho .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cincos con Dos de Fuego" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeBicho, poker:CincoDeNormal, poker:CincoDeVolador, poker:DosDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Uno de Planta" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeVeneno, poker:TresDeFuego, poker:TresDeBicho, poker:UnoDePlanta .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Dos de Electrico" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeVolador, poker:CuatroDeBicho, poker:CuatroDeElectrico, poker:DosDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Bicho" ;
    poker:contieneCarta poker:UnoDeBicho, poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Normal" ;
    poker:contieneCarta poker:UnoDeNormal, poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal, poker:SeisDeNormal .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
