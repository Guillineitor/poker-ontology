# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:UnoDeNormal, poker:DosDeBicho, poker:TresDeFuego, poker:CincoDeAgua, poker:SeisDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:DosDeBicho, poker:SeisDeBicho, poker:TresDeVeneno, poker:UnoDeBicho .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:SeisDeVeneno, poker:CincoDeBicho, poker:DosDeVeneno, poker:CuatroDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:DosDeElectrico, poker:CincoDePlanta, poker:CuatroDeAgua, poker:UnoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Cuatro Tres Uno" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeNormal, poker:CuatroDeVolador, poker:TresDeBicho, poker:UnoDeElectrico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Cuatro Dos Uno" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDeFuego, poker:UnoDeFuego, poker:CuatroDeBicho, poker:DosDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Seises con Cinco Cuatro Tres" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDePlanta, poker:TresDeVolador, poker:CuatroDeVeneno, poker:CincoDeNormal .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Unos con Seis Cinco Cuatro" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:UnoDeAgua, poker:CuatroDeVolador, poker:CincoDeAgua, poker:SeisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Unos con Dos" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeVolador, poker:SeisDeNormal, poker:SeisDePlanta, poker:DosDeVeneno ;
    poker:manoTienePar poker:Uno, poker:Seis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Treses con Uno" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeElectrico, poker:CincoDeVolador, poker:CincoDeVeneno, poker:UnoDeFuego ;
    poker:manoTienePar poker:Tres, poker:Cinco .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Unos con Dos" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeBicho, poker:CincoDeVeneno, poker:CincoDeElectrico, poker:DosDeVolador ;
    poker:manoTienePar poker:Uno, poker:Cinco .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Doses con Cuatro" ;
    poker:contieneCarta poker:DosDeVolador, poker:DosDeFuego, poker:CincoDeBicho, poker:CincoDeVolador, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Dos, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Seises con Tres Uno" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDeVolador, poker:SeisDeAgua, poker:TresDeBicho, poker:UnoDeAgua .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Treses con Cinco Uno" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeAgua, poker:TresDeVeneno, poker:UnoDePlanta, poker:CincoDeVeneno .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doses con Cinco Uno" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDeElectrico, poker:DosDePlanta, poker:CincoDeVolador, poker:UnoDeVeneno .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Dos Uno" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CuatroDeElectrico, poker:CuatroDeVeneno, poker:DosDeBicho, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDeVeneno, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeVolador, poker:TresDeAgua, poker:CuatroDePlanta, poker:CincoDeVeneno, poker:SeisDeVolador .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeVeneno, poker:TresDeFuego, poker:CuatroDeVeneno, poker:CincoDePlanta, poker:SeisDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeFuego, poker:TresDePlanta, poker:CuatroDeElectrico, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Normal" ;
    poker:contieneCarta poker:TresDeNormal, poker:UnoDeNormal, poker:SeisDeNormal, poker:CincoDeNormal, poker:DosDeNormal .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Bicho" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:UnoDeBicho, poker:SeisDeBicho, poker:DosDeBicho, poker:CincoDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Veneno" ;
    poker:contieneCarta poker:TresDeVeneno, poker:UnoDeVeneno, poker:DosDeVeneno, poker:SeisDeVeneno, poker:CincoDeVeneno .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Electrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:SeisDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Unos" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeNormal, poker:CincoDeFuego, poker:UnoDeVolador, poker:UnoDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Uno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Unos" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDeAgua, poker:CincoDePlanta, poker:UnoDeBicho, poker:UnoDeFuego ;
    poker:manoTienePar poker:Cinco, poker:Uno .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Doses" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDeBicho, poker:SeisDePlanta, poker:DosDeAgua, poker:DosDeBicho ;
    poker:manoTienePar poker:Seis, poker:Dos .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Cuatros" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeFuego, poker:UnoDeVeneno, poker:CuatroDeFuego, poker:CuatroDeNormal ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Cuatro de Volador" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDeVolador, poker:CincoDeFuego, poker:CincoDeAgua, poker:CuatroDeVolador .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Dos de Volador" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDePlanta, poker:CuatroDeAgua, poker:CuatroDeNormal, poker:DosDeVolador .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Unos con Cuatro de Normal" ;
    poker:contieneCarta poker:UnoDeBicho, poker:UnoDeFuego, poker:UnoDeVolador, poker:UnoDePlanta, poker:CuatroDeNormal .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Seises con Dos de Electrico" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeBicho, poker:SeisDeAgua, poker:SeisDeNormal, poker:DosDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Agua" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Volador" ;
    poker:contieneCarta poker:UnoDeVolador, poker:DosDeVolador, poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:DosDeVolador, poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador, poker:SeisDeVolador .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
