# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:SeisDeAgua, poker:CincoDePsiquico, poker:UnoDePsiquico, poker:DosDeRoca .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:SeisDePsiquico, poker:CuatroDeRoca, poker:UnoDeElectrico, poker:CincoDeTierra .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:UnoDeLucha, poker:DosDeLucha, poker:CuatroDeAgua, poker:SeisDeRoca, poker:TresDeLucha .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:UnoDeLucha, poker:CuatroDeElectrico, poker:SeisDeVeneno, poker:CincoDePlanta, poker:TresDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Cuatro Tres Uno" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeRoca, poker:UnoDeVolador, poker:TresDeLucha, poker:CuatroDePsiquico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treses con Cinco Cuatro Dos" ;
    poker:contieneCarta poker:TresDeRoca, poker:TresDeElectrico, poker:DosDeVeneno, poker:CuatroDePsiquico, poker:CincoDeNormal .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Unos con Cinco Cuatro Dos" ;
    poker:contieneCarta poker:UnoDeVolador, poker:UnoDePsiquico, poker:CincoDeLucha, poker:CuatroDeVolador, poker:DosDeTierra .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cuatros con Seis Cinco Dos" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDeVeneno, poker:DosDeTierra, poker:SeisDePsiquico, poker:CincoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Doses con Seis" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDeFuego, poker:DosDePsiquico, poker:DosDeFuego, poker:SeisDeAgua ;
    poker:manoTienePar poker:Tres, poker:Dos .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Treses con Cinco" ;
    poker:contieneCarta poker:TresDePsiquico, poker:TresDeLucha, poker:CuatroDeAgua, poker:CuatroDeBicho, poker:CincoDePsiquico ;
    poker:manoTienePar poker:Tres, poker:Cuatro .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Doses con Uno" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDePsiquico, poker:TresDeAgua, poker:TresDeVeneno, poker:UnoDePsiquico ;
    poker:manoTienePar poker:Dos, poker:Tres .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Tres" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDePlanta, poker:UnoDeAgua, poker:UnoDeFuego, poker:TresDeLucha ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Seises con Cinco Cuatro" ;
    poker:contieneCarta poker:SeisDeTierra, poker:SeisDePsiquico, poker:SeisDePlanta, poker:CincoDeTierra, poker:CuatroDeRoca .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Unos con Seis Cinco" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeVolador, poker:UnoDeLucha, poker:SeisDeElectrico, poker:CincoDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Seises con Tres Uno" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDeLucha, poker:SeisDeRoca, poker:UnoDeRoca, poker:TresDeTierra .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Seis Tres" ;
    poker:contieneCarta poker:CuatroDeRoca, poker:CuatroDeFuego, poker:CuatroDeLucha, poker:SeisDeTierra, poker:TresDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeAgua, poker:SeisDeVeneno .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeRoca, poker:TresDeVeneno, poker:CuatroDeFuego, poker:CincoDeVolador, poker:SeisDeNormal .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDePsiquico, poker:SeisDeLucha .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeTierra, poker:DosDePsiquico, poker:TresDePsiquico, poker:CuatroDeBicho, poker:CincoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:TresDePlanta, poker:DosDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Roca" ;
    poker:contieneCarta poker:UnoDeRoca, poker:DosDeRoca, poker:SeisDeRoca, poker:CuatroDeRoca, poker:CincoDeRoca .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Veneno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CincoDeVeneno, poker:SeisDeVeneno, poker:TresDeVeneno, poker:UnoDeVeneno .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:CincoDeAgua, poker:UnoDeAgua, poker:CuatroDeAgua, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Treses" ;
    poker:contieneCarta poker:UnoDeVolador, poker:UnoDeTierra, poker:UnoDeVeneno, poker:TresDeVolador, poker:TresDePsiquico ;
    poker:manoTienePar poker:Uno, poker:Tres .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Seises" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDePsiquico, poker:DosDePlanta, poker:SeisDeRoca, poker:SeisDeTierra ;
    poker:manoTienePar poker:Dos, poker:Seis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Cuatros" ;
    poker:contieneCarta poker:UnoDeTierra, poker:UnoDePsiquico, poker:UnoDePlanta, poker:CuatroDeNormal, poker:CuatroDeVolador ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Doses" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDeVolador, poker:CuatroDeAgua, poker:DosDeNormal, poker:DosDeTierra ;
    poker:manoTienePar poker:Cuatro, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doses con Seis de Volador" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeVolador, poker:DosDePsiquico, poker:DosDeBicho, poker:SeisDeVolador .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Dos de Fuego" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDeAgua, poker:CuatroDeVolador, poker:CuatroDeFuego, poker:DosDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Uno de Electrico" ;
    poker:contieneCarta poker:CuatroDeRoca, poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:CuatroDeAgua, poker:UnoDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Seises con Dos de Fuego" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDeAgua, poker:SeisDeVeneno, poker:SeisDeBicho, poker:DosDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Volador" ;
    poker:contieneCarta poker:UnoDeVolador, poker:DosDeVolador, poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Bicho" ;
    poker:contieneCarta poker:UnoDeBicho, poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Psiquico" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:DosDePsiquico, poker:TresDePsiquico, poker:CuatroDePsiquico, poker:CincoDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho, poker:SeisDeBicho .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:DosDePsiquico, poker:TresDePsiquico, poker:CuatroDePsiquico, poker:CincoDePsiquico, poker:SeisDePsiquico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:DosDeVolador, poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador, poker:SeisDeVolador .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
