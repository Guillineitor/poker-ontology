# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:TresDeTierra, poker:CincoDePsiquico, poker:DosDeFuego, poker:SeisDeVeneno, poker:UnoDeRoca .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:UnoDeBicho, poker:TresDeVolador, poker:DosDeElectrico, poker:CuatroDeBicho, poker:SeisDeVolador .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:CuatroDeRoca, poker:TresDeElectrico, poker:SeisDeElectrico, poker:UnoDeBicho, poker:CincoDeRoca .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:SeisDeFuego, poker:UnoDeTierra, poker:DosDePlanta, poker:CincoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cuatros con Cinco Tres Uno" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeVeneno, poker:UnoDeRoca, poker:TresDeFuego, poker:CincoDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doses con Cinco Cuatro Uno" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeBicho, poker:CuatroDeFuego, poker:CincoDeTierra, poker:UnoDeBicho .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Cincos con Seis Tres Dos" ;
    poker:contieneCarta poker:CincoDePsiquico, poker:CincoDeBicho, poker:TresDeBicho, poker:SeisDePlanta, poker:DosDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treses con Cinco Dos Uno" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDeTierra, poker:CincoDePlanta, poker:DosDeAgua, poker:UnoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cuatros con Tres" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeVeneno, poker:SeisDePsiquico, poker:SeisDeVeneno, poker:TresDeVeneno ;
    poker:manoTienePar poker:Cuatro, poker:Seis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Seis" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:CuatroDeBicho, poker:UnoDeElectrico, poker:UnoDeVolador, poker:SeisDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cuatros con Dos" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeLucha, poker:CuatroDeRoca, poker:CuatroDeFuego, poker:DosDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Cinco" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:CuatroDeNormal, poker:UnoDeVeneno, poker:UnoDeVolador, poker:CincoDeNormal ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Dos Uno" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeRoca, poker:CuatroDeTierra, poker:UnoDeRoca, poker:DosDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Seises con Tres Uno" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDeRoca, poker:SeisDeAgua, poker:UnoDeAgua, poker:TresDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Seises con Cinco Tres" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDePsiquico, poker:SeisDeTierra, poker:CincoDePsiquico, poker:TresDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Doses con Seis Uno" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeLucha, poker:DosDeVeneno, poker:SeisDePlanta, poker:UnoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeRoca, poker:DosDeVolador, poker:TresDePlanta, poker:CuatroDeLucha, poker:CincoDeElectrico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeRoca, poker:TresDeLucha, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeRoca .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeVeneno, poker:CuatroDeFuego, poker:CincoDePsiquico, poker:SeisDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDePlanta, poker:CuatroDeTierra, poker:CincoDePsiquico, poker:SeisDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Roca" ;
    poker:contieneCarta poker:CincoDeRoca, poker:TresDeRoca, poker:SeisDeRoca, poker:CuatroDeRoca, poker:UnoDeRoca .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:TresDePlanta, poker:CincoDePlanta, poker:DosDePlanta, poker:SeisDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Bicho" ;
    poker:contieneCarta poker:UnoDeBicho, poker:SeisDeBicho, poker:CuatroDeBicho, poker:DosDeBicho, poker:TresDeBicho .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:SeisDeAgua, poker:CuatroDeAgua, poker:UnoDeAgua, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Cuatros" ;
    poker:contieneCarta poker:CincoDeRoca, poker:CincoDePlanta, poker:CincoDePsiquico, poker:CuatroDePsiquico, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Cuatro .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Treses" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeLucha, poker:DosDeBicho, poker:TresDeBicho, poker:TresDeAgua ;
    poker:manoTienePar poker:Dos, poker:Tres .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Cincos" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:CuatroDeTierra, poker:CuatroDeVolador, poker:CincoDeVolador, poker:CincoDeRoca ;
    poker:manoTienePar poker:Cuatro, poker:Cinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Unos" ;
    poker:contieneCarta poker:TresDeBicho, poker:TresDeFuego, poker:TresDePlanta, poker:UnoDePlanta, poker:UnoDeBicho ;
    poker:manoTienePar poker:Tres, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Tres de Veneno" ;
    poker:contieneCarta poker:CincoDeLucha, poker:CincoDeAgua, poker:CincoDeBicho, poker:CincoDeElectrico, poker:TresDeVeneno .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Seises con Cinco de Planta" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDePlanta, poker:SeisDeFuego, poker:SeisDeTierra, poker:CincoDePlanta .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Seises con Tres de Volador" ;
    poker:contieneCarta poker:SeisDeTierra, poker:SeisDePsiquico, poker:SeisDeElectrico, poker:SeisDeBicho, poker:TresDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Doses con Cuatro de Planta" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeVeneno, poker:DosDeNormal, poker:DosDePsiquico, poker:CuatroDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Bicho" ;
    poker:contieneCarta poker:UnoDeBicho, poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Lucha" ;
    poker:contieneCarta poker:UnoDeLucha, poker:DosDeLucha, poker:TresDeLucha, poker:CuatroDeLucha, poker:CincoDeLucha .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Psiquico" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:DosDePsiquico, poker:TresDePsiquico, poker:CuatroDePsiquico, poker:CincoDePsiquico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Normal" ;
    poker:contieneCarta poker:UnoDeNormal, poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno, poker:SeisDeVeneno .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal, poker:SeisDeNormal .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:DosDeLucha, poker:TresDeLucha, poker:CuatroDeLucha, poker:CincoDeLucha, poker:SeisDeLucha .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho, poker:SeisDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
