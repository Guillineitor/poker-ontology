# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:CincoDeRoca, poker:UnoDeTierra, poker:SeisDeVolador, poker:DosDeBicho, poker:CuatroDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:UnoDeLucha, poker:SeisDeFuego, poker:TresDeFuego, poker:DosDeVolador .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:CincoDeLucha, poker:DosDePlanta, poker:SeisDeVeneno, poker:CuatroDeVolador, poker:UnoDeTierra .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:UnoDeTierra, poker:DosDeAgua, poker:SeisDePlanta, poker:CincoDeTierra, poker:TresDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cuatros con Cinco Tres Uno" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeVolador, poker:TresDeVeneno, poker:CincoDePlanta, poker:UnoDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treses con Seis Cinco Uno" ;
    poker:contieneCarta poker:TresDePsiquico, poker:TresDeBicho, poker:CincoDeElectrico, poker:UnoDeTierra, poker:SeisDeRoca .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Cuatros con Seis Cinco Tres" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDeLucha, poker:TresDeLucha, poker:CincoDeFuego, poker:SeisDeFuego .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cincos con Tres Dos Uno" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeNormal, poker:DosDeVolador, poker:UnoDeAgua, poker:TresDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cincos con Dos" ;
    poker:contieneCarta poker:CincoDeLucha, poker:CincoDeVolador, poker:SeisDeFuego, poker:SeisDeNormal, poker:DosDeBicho ;
    poker:manoTienePar poker:Cinco, poker:Seis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Unos con Cinco" ;
    poker:contieneCarta poker:UnoDeRoca, poker:UnoDeVolador, poker:SeisDePlanta, poker:SeisDeTierra, poker:CincoDeVolador ;
    poker:manoTienePar poker:Uno, poker:Seis .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Treses con Seis" ;
    poker:contieneCarta poker:TresDePsiquico, poker:TresDeVeneno, poker:CuatroDeRoca, poker:CuatroDeVolador, poker:SeisDePlanta ;
    poker:manoTienePar poker:Tres, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Tres" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDePlanta, poker:UnoDePsiquico, poker:UnoDeBicho, poker:TresDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Unos con Seis Dos" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeLucha, poker:UnoDeFuego, poker:DosDeLucha, poker:SeisDeRoca .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Unos con Seis Cuatro" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeNormal, poker:UnoDeTierra, poker:CuatroDeFuego, poker:SeisDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doses con Tres Uno" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeBicho, poker:DosDeLucha, poker:TresDeTierra, poker:UnoDeBicho .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Seises con Cinco Tres" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeNormal, poker:SeisDePlanta, poker:CincoDeElectrico, poker:TresDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDeNormal, poker:TresDePlanta, poker:CuatroDeLucha, poker:CincoDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeLucha, poker:CuatroDeAgua, poker:CincoDeLucha, poker:SeisDePsiquico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeFuego, poker:TresDeVeneno, poker:CuatroDeLucha, poker:CincoDeVolador .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeBicho, poker:DosDeTierra, poker:TresDePlanta, poker:CuatroDeVolador, poker:CincoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:SeisDeFuego, poker:CincoDeFuego .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Normal" ;
    poker:contieneCarta poker:SeisDeNormal, poker:CincoDeNormal, poker:TresDeNormal, poker:UnoDeNormal, poker:CuatroDeNormal .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:CuatroDePlanta, poker:SeisDePlanta, poker:TresDePlanta, poker:DosDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Veneno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:UnoDeVeneno, poker:DosDeVeneno, poker:CincoDeVeneno, poker:SeisDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Unos" ;
    poker:contieneCarta poker:CincoDeVolador, poker:CincoDeVeneno, poker:CincoDeTierra, poker:UnoDeVolador, poker:UnoDeFuego ;
    poker:manoTienePar poker:Cinco, poker:Uno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Cuatros" ;
    poker:contieneCarta poker:UnoDeTierra, poker:UnoDeElectrico, poker:UnoDeAgua, poker:CuatroDePlanta, poker:CuatroDeLucha ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Seises" ;
    poker:contieneCarta poker:TresDeRoca, poker:TresDeNormal, poker:TresDeTierra, poker:SeisDeVolador, poker:SeisDeAgua ;
    poker:manoTienePar poker:Tres, poker:Seis .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Treses" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeNormal, poker:DosDeVolador, poker:TresDeAgua, poker:TresDePlanta ;
    poker:manoTienePar poker:Dos, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doses con Cinco de Tierra" ;
    poker:contieneCarta poker:DosDeLucha, poker:DosDeRoca, poker:DosDeVeneno, poker:DosDeAgua, poker:CincoDeTierra .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Seises con Cuatro de Volador" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDeLucha, poker:SeisDeNormal, poker:SeisDeAgua, poker:CuatroDeVolador .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Unos con Dos de Volador" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeLucha, poker:UnoDePlanta, poker:UnoDeTierra, poker:DosDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treses con Cinco de Bicho" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDePlanta, poker:TresDeVeneno, poker:TresDeBicho, poker:CincoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Normal" ;
    poker:contieneCarta poker:UnoDeNormal, poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Tierra" ;
    poker:contieneCarta poker:UnoDeTierra, poker:DosDeTierra, poker:TresDeTierra, poker:CuatroDeTierra, poker:CincoDeTierra .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho, poker:SeisDeBicho .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Roca" ;
    poker:contieneCarta poker:DosDeRoca, poker:TresDeRoca, poker:CuatroDeRoca, poker:CincoDeRoca, poker:SeisDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
