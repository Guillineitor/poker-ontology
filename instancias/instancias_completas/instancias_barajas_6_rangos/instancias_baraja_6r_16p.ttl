# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:SeisDeHielo, poker:CincoDeRoca, poker:DosDeDragon, poker:UnoDePsiquico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:TresDeBicho, poker:CincoDeNormal, poker:UnoDeFantasma, poker:SeisDeTierra, poker:CuatroDeBicho .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:DosDeElectrico, poker:UnoDePlanta, poker:SeisDePlanta, poker:TresDeLucha, poker:CincoDeRoca .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:SeisDeNormal, poker:DosDeDragon, poker:UnoDeBicho, poker:TresDeTierra, poker:CincoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treses con Seis Cuatro Uno" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDePsiquico, poker:CuatroDeFantasma, poker:UnoDeDragon, poker:SeisDeRoca .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Unos con Cinco Tres Dos" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeTierra, poker:CincoDeAgua, poker:TresDeLucha, poker:DosDeBicho .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Cincos con Seis Tres Dos" ;
    poker:contieneCarta poker:CincoDeRoca, poker:CincoDeHielo, poker:TresDeSiniestro, poker:SeisDeHielo, poker:DosDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cincos con Cuatro Dos Uno" ;
    poker:contieneCarta poker:CincoDeSiniestro, poker:CincoDeLucha, poker:DosDePsiquico, poker:UnoDeNormal, poker:CuatroDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cincos con Cuatro" ;
    poker:contieneCarta poker:CincoDeDragon, poker:CincoDeNormal, poker:SeisDeNormal, poker:SeisDeRoca, poker:CuatroDeRoca ;
    poker:manoTienePar poker:Cinco, poker:Seis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Treses con Cinco" ;
    poker:contieneCarta poker:TresDeTierra, poker:TresDeNormal, poker:SeisDeSiniestro, poker:SeisDeLucha, poker:CincoDeVolador ;
    poker:manoTienePar poker:Tres, poker:Seis .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Tres" ;
    poker:contieneCarta poker:UnoDeRoca, poker:UnoDeLucha, poker:CuatroDeDragon, poker:CuatroDePlanta, poker:TresDeHielo ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Doses con Cinco" ;
    poker:contieneCarta poker:DosDeLucha, poker:DosDeVeneno, poker:SeisDeDragon, poker:SeisDeNormal, poker:CincoDeBicho ;
    poker:manoTienePar poker:Dos, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treses con Seis Uno" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDePsiquico, poker:TresDeBicho, poker:UnoDeSiniestro, poker:SeisDeFantasma .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Cinco Dos" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDeTierra, poker:CuatroDeElectrico, poker:DosDeFuego, poker:CincoDeBicho .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Treses con Cuatro Dos" ;
    poker:contieneCarta poker:TresDeVeneno, poker:TresDeAgua, poker:TresDePlanta, poker:DosDeAgua, poker:CuatroDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cincos con Seis Cuatro" ;
    poker:contieneCarta poker:CincoDeLucha, poker:CincoDeSiniestro, poker:CincoDeElectrico, poker:CuatroDeVolador, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeTierra, poker:TresDeFuego, poker:CuatroDeElectrico, poker:CincoDeRoca, poker:SeisDeVolador .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDePsiquico, poker:TresDeDragon, poker:CuatroDeFuego, poker:CincoDeFantasma, poker:SeisDeSiniestro .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeHielo, poker:DosDeNormal, poker:TresDeHielo, poker:CuatroDeVeneno, poker:CincoDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDeElectrico, poker:CuatroDeVeneno, poker:CincoDeHielo, poker:SeisDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Tierra" ;
    poker:contieneCarta poker:DosDeTierra, poker:CuatroDeTierra, poker:SeisDeTierra, poker:UnoDeTierra, poker:TresDeTierra .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Agua" ;
    poker:contieneCarta poker:SeisDeAgua, poker:CincoDeAgua, poker:UnoDeAgua, poker:TresDeAgua, poker:CuatroDeAgua .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Normal" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeNormal, poker:UnoDeNormal, poker:SeisDeNormal, poker:CincoDeNormal .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Roca" ;
    poker:contieneCarta poker:SeisDeRoca, poker:UnoDeRoca, poker:DosDeRoca, poker:TresDeRoca, poker:CuatroDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Seises" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeBicho, poker:CincoDeRoca, poker:SeisDeHielo, poker:SeisDeTierra ;
    poker:manoTienePar poker:Cinco, poker:Seis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Unos" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeHielo, poker:CuatroDeFantasma, poker:UnoDeSiniestro, poker:UnoDeVeneno ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Cincos" ;
    poker:contieneCarta poker:CuatroDeDragon, poker:CuatroDeBicho, poker:CuatroDeAgua, poker:CincoDeHielo, poker:CincoDeSiniestro ;
    poker:manoTienePar poker:Cuatro, poker:Cinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Doses" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:UnoDeVeneno, poker:UnoDePlanta, poker:DosDeFuego, poker:DosDeElectrico ;
    poker:manoTienePar poker:Uno, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doses con Uno de Tierra" ;
    poker:contieneCarta poker:DosDeDragon, poker:DosDeVolador, poker:DosDeFuego, poker:DosDeVeneno, poker:UnoDeTierra .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treses con Uno de Siniestro" ;
    poker:contieneCarta poker:TresDeNormal, poker:TresDeSiniestro, poker:TresDeLucha, poker:TresDeFantasma, poker:UnoDeSiniestro .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Dos de Fantasma" ;
    poker:contieneCarta poker:TresDeRoca, poker:TresDeVeneno, poker:TresDeDragon, poker:TresDeNormal, poker:DosDeFantasma .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Doses con Uno de Electrico" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDeBicho, poker:DosDeVeneno, poker:DosDePsiquico, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Agua" ;
    poker:contieneCarta poker:UnoDeAgua, poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Roca" ;
    poker:contieneCarta poker:UnoDeRoca, poker:DosDeRoca, poker:TresDeRoca, poker:CuatroDeRoca, poker:CincoDeRoca .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Roca" ;
    poker:contieneCarta poker:UnoDeRoca, poker:DosDeRoca, poker:TresDeRoca, poker:CuatroDeRoca, poker:CincoDeRoca .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal, poker:SeisDeNormal .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fantasma" ;
    poker:contieneCarta poker:DosDeFantasma, poker:TresDeFantasma, poker:CuatroDeFantasma, poker:CincoDeFantasma, poker:SeisDeFantasma .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:DosDeTierra, poker:TresDeTierra, poker:CuatroDeTierra, poker:CincoDeTierra, poker:SeisDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
