# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:TresDeRoca, poker:UnoDeAgua, poker:DosDePsiquico, poker:CincoDeLucha .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Tres Uno" ;
    poker:contieneCarta poker:CuatroDeSiniestro, poker:UnoDeNormal, poker:SeisDeFantasma, poker:TresDeLucha, poker:CincoDeTierra .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cinco Cuatro Dos Uno" ;
    poker:contieneCarta poker:CuatroDeSiniestro, poker:SeisDePlanta, poker:UnoDeSiniestro, poker:CincoDeLucha, poker:DosDeHielo .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Seis con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:SeisDeDragon, poker:CuatroDeFuego, poker:DosDeNormal, poker:TresDeTierra, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Seises con Cinco Cuatro Uno" ;
    poker:contieneCarta poker:SeisDeLucha, poker:SeisDeDragon, poker:CuatroDeSiniestro, poker:UnoDeTierra, poker:CincoDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Seises con Cuatro Tres Uno" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeNormal, poker:TresDeDragon, poker:UnoDeVolador, poker:CuatroDeFantasma .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Treses con Seis Cinco Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeRoca, poker:CincoDeSiniestro, poker:UnoDeLucha, poker:SeisDeTierra .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treses con Seis Cinco Cuatro" ;
    poker:contieneCarta poker:TresDeVeneno, poker:TresDeFantasma, poker:SeisDeTierra, poker:CuatroDePlanta, poker:CincoDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Unos con Seis" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDePsiquico, poker:UnoDeFantasma, poker:UnoDeDragon, poker:SeisDeLucha ;
    poker:manoTienePar poker:Cinco, poker:Uno .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Treses con Cinco" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeLucha, poker:TresDeElectrico, poker:TresDePlanta, poker:CincoDeAgua ;
    poker:manoTienePar poker:Seis, poker:Tres .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Doses con Cinco" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeDragon, poker:CuatroDeElectrico, poker:CuatroDeTierra, poker:CincoDeHielo ;
    poker:manoTienePar poker:Dos, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cuatros con Tres" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CuatroDeVolador, poker:SeisDeVolador, poker:SeisDeFuego, poker:TresDeVolador ;
    poker:manoTienePar poker:Cuatro, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Dos Uno" ;
    poker:contieneCarta poker:CuatroDeTierra, poker:CuatroDeBicho, poker:CuatroDeHielo, poker:UnoDePlanta, poker:DosDeNormal .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Seises con Cuatro Tres" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeFuego, poker:SeisDeBicho, poker:TresDeLucha, poker:CuatroDeVeneno .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cincos con Dos Uno" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDeSiniestro, poker:CincoDePlanta, poker:UnoDeElectrico, poker:DosDeFantasma .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Cinco Tres" ;
    poker:contieneCarta poker:CuatroDeSiniestro, poker:CuatroDeBicho, poker:CuatroDeVeneno, poker:CincoDeNormal, poker:TresDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeLucha, poker:DosDeAgua, poker:TresDeDragon, poker:CuatroDeHielo, poker:CincoDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeDragon, poker:CuatroDeVolador, poker:CincoDePsiquico, poker:SeisDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeVeneno, poker:TresDeLucha, poker:CuatroDeTierra, poker:CincoDeHielo, poker:SeisDeNormal .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeLucha, poker:TresDeFuego, poker:CuatroDeAgua, poker:CincoDeFuego, poker:SeisDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Fuego" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:SeisDeFuego, poker:UnoDeFuego, poker:CincoDeFuego, poker:TresDeFuego .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Roca" ;
    poker:contieneCarta poker:UnoDeRoca, poker:CincoDeRoca, poker:DosDeRoca, poker:SeisDeRoca, poker:TresDeRoca .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Psiquico" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:CincoDePsiquico, poker:UnoDePsiquico, poker:DosDePsiquico, poker:SeisDePsiquico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Planta" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:UnoDePlanta, poker:TresDePlanta, poker:SeisDePlanta, poker:DosDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Seises" ;
    poker:contieneCarta poker:TresDeFantasma, poker:TresDeElectrico, poker:TresDeFuego, poker:SeisDeTierra, poker:SeisDeVeneno ;
    poker:manoTienePar poker:Tres, poker:Seis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Cuatros" ;
    poker:contieneCarta poker:TresDePsiquico, poker:TresDeVeneno, poker:TresDeLucha, poker:CuatroDeLucha, poker:CuatroDeVolador ;
    poker:manoTienePar poker:Tres, poker:Cuatro .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Treses" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeHielo, poker:CuatroDeVolador, poker:TresDeHielo, poker:TresDeTierra ;
    poker:manoTienePar poker:Cuatro, poker:Tres .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Unos" ;
    poker:contieneCarta poker:CincoDeRoca, poker:CincoDeLucha, poker:CincoDeElectrico, poker:UnoDeElectrico, poker:UnoDeTierra ;
    poker:manoTienePar poker:Cinco, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Tres de Volador" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDePsiquico, poker:CuatroDeRoca, poker:CuatroDeElectrico, poker:TresDeVolador .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treses con Dos de Veneno" ;
    poker:contieneCarta poker:TresDeSiniestro, poker:TresDeFantasma, poker:TresDeDragon, poker:TresDeAgua, poker:DosDeVeneno .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Unos con Tres de Lucha" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeLucha, poker:UnoDeVolador, poker:UnoDeHielo, poker:TresDeLucha .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Seises con Uno de Tierra" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:SeisDeSiniestro, poker:SeisDeFuego, poker:SeisDeDragon, poker:UnoDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Dragon" ;
    poker:contieneCarta poker:UnoDeDragon, poker:DosDeDragon, poker:TresDeDragon, poker:CuatroDeDragon, poker:CincoDeDragon .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Siniestro" ;
    poker:contieneCarta poker:UnoDeSiniestro, poker:DosDeSiniestro, poker:TresDeSiniestro, poker:CuatroDeSiniestro, poker:CincoDeSiniestro .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fantasma" ;
    poker:contieneCarta poker:UnoDeFantasma, poker:DosDeFantasma, poker:TresDeFantasma, poker:CuatroDeFantasma, poker:CincoDeFantasma .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Bicho" ;
    poker:contieneCarta poker:UnoDeBicho, poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:DosDeVolador, poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador, poker:SeisDeVolador .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Dragon" ;
    poker:contieneCarta poker:DosDeDragon, poker:TresDeDragon, poker:CuatroDeDragon, poker:CincoDeDragon, poker:SeisDeDragon .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:DosDeLucha, poker:TresDeLucha, poker:CuatroDeLucha, poker:CincoDeLucha, poker:SeisDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
