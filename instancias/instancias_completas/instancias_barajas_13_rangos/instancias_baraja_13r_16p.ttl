# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Ocho con Siete Seis Cinco Dos" ;
    poker:contieneCarta poker:SieteDeAgua, poker:DosDePlanta, poker:OchoDeBicho, poker:SeisDePlanta, poker:CincoDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Nueve Cinco Cuatro Tres" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:TresDeNormal, poker:CincoDeElectrico, poker:NueveDeRoca, poker:TreceDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Nueve Ocho Seis Cuatro" ;
    poker:contieneCarta poker:NueveDeRoca, poker:DiezDeAgua, poker:OchoDeVeneno, poker:CuatroDeFuego, poker:SeisDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Nueve con Ocho Tres Dos Uno" ;
    poker:contieneCarta poker:UnoDeAgua, poker:NueveDeFantasma, poker:DosDeElectrico, poker:TresDeRoca, poker:OchoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Once Nueve Tres" ;
    poker:contieneCarta poker:DosDeDragon, poker:DosDeFuego, poker:NueveDeFantasma, poker:TresDeLucha, poker:OnceDeSiniestro .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treses con Diez Seis Cinco" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDePsiquico, poker:CincoDeFantasma, poker:SeisDeNormal, poker:DiezDeVeneno .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Sietes con Diez Seis Cinco" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:SieteDeSiniestro, poker:SeisDeFuego, poker:DiezDeFuego, poker:CincoDeVolador .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Doses con Seis Cinco Tres" ;
    poker:contieneCarta poker:DosDeSiniestro, poker:DosDeTierra, poker:TresDeRoca, poker:CincoDeAgua, poker:SeisDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Doces con Dos" ;
    poker:contieneCarta poker:DoceDeRoca, poker:DoceDeBicho, poker:TreceDeFuego, poker:TreceDePlanta, poker:DosDeFantasma ;
    poker:manoTienePar poker:Doce, poker:Trece .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Treses con Doce" ;
    poker:contieneCarta poker:TresDeFantasma, poker:TresDeFuego, poker:OnceDeVeneno, poker:OnceDeElectrico, poker:DoceDeFantasma ;
    poker:manoTienePar poker:Tres, poker:Once .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Doses con Ocho" ;
    poker:contieneCarta poker:DosDeDragon, poker:DosDeElectrico, poker:DoceDeFuego, poker:DoceDeHielo, poker:OchoDeFuego ;
    poker:manoTienePar poker:Dos, poker:Doce .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Treses con Once" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeHielo, poker:TresDeFuego, poker:TresDeFantasma, poker:OnceDeFantasma ;
    poker:manoTienePar poker:Seis, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treses con Once Cuatro" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeTierra, poker:TresDeRoca, poker:OnceDeAgua, poker:CuatroDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Seis Dos" ;
    poker:contieneCarta poker:DoceDeSiniestro, poker:DoceDeDragon, poker:DoceDePlanta, poker:SeisDePsiquico, poker:DosDeTierra .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Diez Cinco" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeSiniestro, poker:CuatroDeVeneno, poker:CincoDeAgua, poker:DiezDeFantasma .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Unos con Doce Diez" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:UnoDeBicho, poker:UnoDeAgua, poker:DoceDeElectrico, poker:DiezDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeFantasma, poker:TresDeAgua, poker:CuatroDeVeneno, poker:CincoDeVeneno, poker:SeisDeSiniestro .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeFantasma, poker:TresDeVolador, poker:CuatroDeVeneno, poker:CincoDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:NueveDeNormal, poker:DiezDeTierra, poker:OnceDeTierra, poker:DoceDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeLucha, poker:CuatroDeLucha, poker:CincoDeVolador, poker:SeisDeVeneno, poker:SieteDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Trece Seis Cinco Tres Dos de Siniestro" ;
    poker:contieneCarta poker:SeisDeSiniestro, poker:TresDeSiniestro, poker:DosDeSiniestro, poker:TreceDeSiniestro, poker:CincoDeSiniestro .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Once Ocho Seis Cuatro Dos de Veneno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:OchoDeVeneno, poker:OnceDeVeneno, poker:DosDeVeneno, poker:SeisDeVeneno .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Doce Once Seis Cuatro Tres de Normal" ;
    poker:contieneCarta poker:SeisDeNormal, poker:CuatroDeNormal, poker:TresDeNormal, poker:DoceDeNormal, poker:OnceDeNormal .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Doce Siete Seis Cuatro Uno de Siniestro" ;
    poker:contieneCarta poker:SieteDeSiniestro, poker:SeisDeSiniestro, poker:CuatroDeSiniestro, poker:DoceDeSiniestro, poker:UnoDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Onces" ;
    poker:contieneCarta poker:CuatroDeDragon, poker:CuatroDeFantasma, poker:CuatroDeFuego, poker:OnceDeRoca, poker:OnceDeSiniestro ;
    poker:manoTienePar poker:Cuatro, poker:Once .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Doses" ;
    poker:contieneCarta poker:TresDeVolador, poker:TresDePsiquico, poker:TresDeHielo, poker:DosDeRoca, poker:DosDeNormal ;
    poker:manoTienePar poker:Tres, poker:Dos .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Doces" ;
    poker:contieneCarta poker:SieteDePlanta, poker:SieteDeBicho, poker:SieteDeSiniestro, poker:DoceDeVeneno, poker:DoceDeFuego ;
    poker:manoTienePar poker:Siete, poker:Doce .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Onces" ;
    poker:contieneCarta poker:TresDeFantasma, poker:TresDeVolador, poker:TresDePsiquico, poker:OnceDeBicho, poker:OnceDeNormal ;
    poker:manoTienePar poker:Tres, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treses con Doce de Fantasma" ;
    poker:contieneCarta poker:TresDeDragon, poker:TresDeElectrico, poker:TresDeNormal, poker:TresDeRoca, poker:DoceDeFantasma .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treses con Siete de Veneno" ;
    poker:contieneCarta poker:TresDeDragon, poker:TresDeFantasma, poker:TresDeAgua, poker:TresDeRoca, poker:SieteDeVeneno .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treces con Nueve de Bicho" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeVolador, poker:TreceDeDragon, poker:TreceDeRoca, poker:NueveDeBicho .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treses con Nueve de Hielo" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDeTierra, poker:TresDeDragon, poker:TresDeHielo, poker:NueveDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Fantasma" ;
    poker:contieneCarta poker:CincoDeFantasma, poker:SeisDeFantasma, poker:SieteDeFantasma, poker:OchoDeFantasma, poker:NueveDeFantasma .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Siniestro" ;
    poker:contieneCarta poker:SeisDeSiniestro, poker:SieteDeSiniestro, poker:OchoDeSiniestro, poker:NueveDeSiniestro, poker:DiezDeSiniestro .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Hielo" ;
    poker:contieneCarta poker:UnoDeHielo, poker:DosDeHielo, poker:TresDeHielo, poker:CuatroDeHielo, poker:CincoDeHielo .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Roca" ;
    poker:contieneCarta poker:DosDeRoca, poker:TresDeRoca, poker:CuatroDeRoca, poker:CincoDeRoca, poker:SeisDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:NueveDeLucha, poker:DiezDeLucha, poker:OnceDeLucha, poker:DoceDeLucha, poker:TreceDeLucha .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fantasma" ;
    poker:contieneCarta poker:NueveDeFantasma, poker:DiezDeFantasma, poker:OnceDeFantasma, poker:DoceDeFantasma, poker:TreceDeFantasma .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
