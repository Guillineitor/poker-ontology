# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Once Diez Seis Tres" ;
    poker:contieneCarta poker:DoceDeBicho, poker:SeisDePsiquico, poker:DiezDeAgua, poker:OnceDePlanta, poker:TresDeHielo .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Diez Nueve Seis Dos" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:NueveDePlanta, poker:DosDeNormal, poker:DoceDeVeneno, poker:DiezDeBicho .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Nueve con Siete Seis Tres Dos" ;
    poker:contieneCarta poker:SeisDeRoca, poker:NueveDeVeneno, poker:TresDeTierra, poker:DosDeFuego, poker:SieteDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Nueve Cuatro Tres Uno" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:TreceDeSiniestro, poker:TresDeVeneno, poker:UnoDeHielo, poker:NueveDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Seises con Trece Siete Dos" ;
    poker:contieneCarta poker:SeisDeLucha, poker:SeisDeFantasma, poker:TreceDeElectrico, poker:DosDeAgua, poker:SieteDeHielo .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Sietes con Cinco Cuatro Dos" ;
    poker:contieneCarta poker:SieteDeBicho, poker:SieteDePsiquico, poker:DosDeSiniestro, poker:CuatroDeTierra, poker:CincoDeFantasma .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Onces con Nueve Ocho Siete" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeVeneno, poker:OchoDeTierra, poker:NueveDeVeneno, poker:SieteDeBicho .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Sietes con Doce Tres Uno" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:SieteDeLucha, poker:TresDeAgua, poker:UnoDeNormal, poker:DoceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Treses con Uno" ;
    poker:contieneCarta poker:TresDePsiquico, poker:TresDeLucha, poker:OchoDeNormal, poker:OchoDeTierra, poker:UnoDeDragon ;
    poker:manoTienePar poker:Tres, poker:Ocho .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Dieces con Once" ;
    poker:contieneCarta poker:DiezDeFuego, poker:DiezDeElectrico, poker:DoceDePlanta, poker:DoceDeLucha, poker:OnceDeHielo ;
    poker:manoTienePar poker:Diez, poker:Doce .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Cuatros con Dos" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:CuatroDeLucha, poker:TreceDePlanta, poker:TreceDeSiniestro, poker:DosDeRoca ;
    poker:manoTienePar poker:Cuatro, poker:Trece .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Onces con Trece" ;
    poker:contieneCarta poker:OnceDeNormal, poker:OnceDeTierra, poker:DoceDeVolador, poker:DoceDeFantasma, poker:TreceDePlanta ;
    poker:manoTienePar poker:Once, poker:Doce .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Onces con Ocho Tres" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDeFantasma, poker:OnceDeLucha, poker:TresDeVeneno, poker:OchoDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Treses con Once Dos" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDePsiquico, poker:TresDeBicho, poker:DosDeFantasma, poker:OnceDeElectrico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Onces con Siete Cinco" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDeBicho, poker:OnceDeHielo, poker:CincoDeAgua, poker:SieteDeFantasma .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Doses con Trece Uno" ;
    poker:contieneCarta poker:DosDeRoca, poker:DosDePsiquico, poker:DosDeElectrico, poker:TreceDeDragon, poker:UnoDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeVolador, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDePsiquico, poker:SieteDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeRoca, poker:SeisDeFantasma, poker:SieteDePlanta, poker:OchoDePlanta, poker:NueveDeFuego .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeTierra, poker:CincoDeElectrico, poker:SeisDePsiquico, poker:SieteDeLucha, poker:OchoDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeFuego, poker:CuatroDePlanta, poker:CincoDeVolador, poker:SeisDeVeneno, poker:SieteDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diez Nueve Cuatro Tres Dos de Fantasma" ;
    poker:contieneCarta poker:CuatroDeFantasma, poker:TresDeFantasma, poker:DiezDeFantasma, poker:NueveDeFantasma, poker:DosDeFantasma .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Doce Once Nueve Tres Dos de Roca" ;
    poker:contieneCarta poker:TresDeRoca, poker:DoceDeRoca, poker:OnceDeRoca, poker:DosDeRoca, poker:NueveDeRoca .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Trece Doce Cuatro Tres Dos de Planta" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:TreceDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Doce Nueve Ocho Seis Tres de Roca" ;
    poker:contieneCarta poker:DoceDeRoca, poker:TresDeRoca, poker:OchoDeRoca, poker:SeisDeRoca, poker:NueveDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Treces" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:SeisDeNormal, poker:SeisDeAgua, poker:TreceDeFuego, poker:TreceDePlanta ;
    poker:manoTienePar poker:Seis, poker:Trece .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Doces" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeElectrico, poker:TresDePlanta, poker:DoceDeSiniestro, poker:DoceDeDragon ;
    poker:manoTienePar poker:Tres, poker:Doce .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Onces" ;
    poker:contieneCarta poker:UnoDeDragon, poker:UnoDeVolador, poker:UnoDeAgua, poker:OnceDeAgua, poker:OnceDePlanta ;
    poker:manoTienePar poker:Uno, poker:Once .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Doses" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDeFantasma, poker:CuatroDeLucha, poker:DosDeSiniestro, poker:DosDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Unos con Trece de Psiquico" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:UnoDeNormal, poker:UnoDeRoca, poker:UnoDeElectrico, poker:TreceDePsiquico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cincos con Dos de Dragon" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDeDragon, poker:CincoDeVolador, poker:CincoDeLucha, poker:DosDeDragon .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Cuatro de Fantasma" ;
    poker:contieneCarta poker:TresDeBicho, poker:TresDeVeneno, poker:TresDeDragon, poker:TresDePsiquico, poker:CuatroDeFantasma .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Dieces con Trece de Veneno" ;
    poker:contieneCarta poker:DiezDeDragon, poker:DiezDePlanta, poker:DiezDeNormal, poker:DiezDeVolador, poker:TreceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Electrico" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Hielo" ;
    poker:contieneCarta poker:UnoDeHielo, poker:DosDeHielo, poker:TresDeHielo, poker:CuatroDeHielo, poker:CincoDeHielo .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Tierra" ;
    poker:contieneCarta poker:SeisDeTierra, poker:SieteDeTierra, poker:OchoDeTierra, poker:NueveDeTierra, poker:DiezDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:NueveDeTierra, poker:DiezDeTierra, poker:OnceDeTierra, poker:DoceDeTierra, poker:TreceDeTierra .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Siniestro" ;
    poker:contieneCarta poker:NueveDeSiniestro, poker:DiezDeSiniestro, poker:OnceDeSiniestro, poker:DoceDeSiniestro, poker:TreceDeSiniestro .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:NueveDeLucha, poker:DiezDeLucha, poker:OnceDeLucha, poker:DoceDeLucha, poker:TreceDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
