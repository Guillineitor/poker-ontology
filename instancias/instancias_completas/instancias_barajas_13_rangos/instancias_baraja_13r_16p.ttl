# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Siete Tres Uno" ;
    poker:contieneCarta poker:SieteDeAgua, poker:DoceDeAgua, poker:TresDeElectrico, poker:TreceDeVeneno, poker:UnoDeVeneno .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Nueve Siete Seis Dos" ;
    poker:contieneCarta poker:SieteDeBicho, poker:DoceDePlanta, poker:NueveDeDragon, poker:SeisDeBicho, poker:DosDeLucha .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Diez Ocho Seis Tres" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:DiezDeSiniestro, poker:TresDeLucha, poker:SeisDeLucha, poker:OchoDeSiniestro .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Diez Siete Cuatro Tres" ;
    poker:contieneCarta poker:SieteDeRoca, poker:DiezDeDragon, poker:OnceDeLucha, poker:TresDeVolador, poker:CuatroDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cuatros con Siete Seis Dos" ;
    poker:contieneCarta poker:CuatroDeSiniestro, poker:CuatroDeDragon, poker:DosDePlanta, poker:SeisDeTierra, poker:SieteDeHielo .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Nueves con Seis Cuatro Dos" ;
    poker:contieneCarta poker:NueveDeAgua, poker:NueveDeHielo, poker:CuatroDeDragon, poker:DosDeVolador, poker:SeisDeNormal .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doces con Trece Once Diez" ;
    poker:contieneCarta poker:DoceDeBicho, poker:DoceDeTierra, poker:OnceDeSiniestro, poker:DiezDeBicho, poker:TreceDeLucha .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Ochos con Diez Cinco Tres" ;
    poker:contieneCarta poker:OchoDeFantasma, poker:OchoDeDragon, poker:CincoDeVolador, poker:DiezDeHielo, poker:TresDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Dieces con Uno" ;
    poker:contieneCarta poker:OnceDeLucha, poker:OnceDeElectrico, poker:DiezDeAgua, poker:DiezDeVeneno, poker:UnoDeVolador ;
    poker:manoTienePar poker:Once, poker:Diez .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Unos con Once" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeSiniestro, poker:OchoDeVeneno, poker:OchoDeHielo, poker:OnceDeVolador ;
    poker:manoTienePar poker:Uno, poker:Ocho .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Cuatros con Diez" ;
    poker:contieneCarta poker:DoceDeLucha, poker:DoceDePsiquico, poker:CuatroDeNormal, poker:CuatroDeVolador, poker:DiezDeAgua ;
    poker:manoTienePar poker:Doce, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Nueves con Cinco" ;
    poker:contieneCarta poker:NueveDeHielo, poker:NueveDeDragon, poker:OnceDeSiniestro, poker:OnceDeNormal, poker:CincoDeLucha ;
    poker:manoTienePar poker:Nueve, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieces con Seis Tres" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:DiezDeLucha, poker:DiezDeFuego, poker:SeisDeDragon, poker:TresDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Sietes con Nueve Uno" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:SieteDeAgua, poker:SieteDeDragon, poker:NueveDePsiquico, poker:UnoDeVolador .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doces con Once Uno" ;
    poker:contieneCarta poker:DoceDeLucha, poker:DoceDeSiniestro, poker:DoceDeTierra, poker:OnceDeElectrico, poker:UnoDeSiniestro .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Unos con Siete Cinco" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeBicho, poker:UnoDeVolador, poker:SieteDePsiquico, poker:CincoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDePlanta, poker:OchoDeSiniestro, poker:NueveDeFuego, poker:DiezDeSiniestro, poker:OnceDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CincoDeDragon, poker:SeisDeHielo, poker:SieteDeVolador, poker:OchoDePsiquico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeVolador, poker:SeisDeRoca, poker:SieteDeFuego, poker:OchoDeSiniestro, poker:NueveDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeTierra, poker:NueveDeTierra, poker:DiezDeSiniestro, poker:OnceDeDragon, poker:DoceDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Trece Once Diez Cinco Dos de Normal" ;
    poker:contieneCarta poker:CincoDeNormal, poker:DosDeNormal, poker:DiezDeNormal, poker:OnceDeNormal, poker:TreceDeNormal .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Once Seis Cuatro Tres Uno de Psiquico" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:SeisDePsiquico, poker:CuatroDePsiquico, poker:TresDePsiquico, poker:OnceDePsiquico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Once Ocho Cinco Cuatro Uno de Fuego" ;
    poker:contieneCarta poker:CincoDeFuego, poker:OnceDeFuego, poker:CuatroDeFuego, poker:OchoDeFuego, poker:UnoDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Trece Cinco Cuatro Tres Dos de Tierra" ;
    poker:contieneCarta poker:CuatroDeTierra, poker:DosDeTierra, poker:CincoDeTierra, poker:TresDeTierra, poker:TreceDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Seises" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDeFuego, poker:OchoDeVolador, poker:SeisDeRoca, poker:SeisDeDragon ;
    poker:manoTienePar poker:Ocho, poker:Seis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Doses" ;
    poker:contieneCarta poker:DoceDeRoca, poker:DoceDeAgua, poker:DoceDePlanta, poker:DosDeLucha, poker:DosDePsiquico ;
    poker:manoTienePar poker:Doce, poker:Dos .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Unos" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeSiniestro, poker:DoceDeHielo, poker:UnoDeNormal, poker:UnoDePlanta ;
    poker:manoTienePar poker:Doce, poker:Uno .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Treses" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeElectrico, poker:TreceDeTierra, poker:TresDeFuego, poker:TresDeAgua ;
    poker:manoTienePar poker:Trece, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treces con Doce de Planta" ;
    poker:contieneCarta poker:TreceDeVeneno, poker:TreceDeLucha, poker:TreceDePlanta, poker:TreceDePsiquico, poker:DoceDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Nueves con Ocho de Fantasma" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeAgua, poker:NueveDeHielo, poker:NueveDeFantasma, poker:OchoDeFantasma .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cincos con Siete de Bicho" ;
    poker:contieneCarta poker:CincoDeDragon, poker:CincoDePlanta, poker:CincoDeVolador, poker:CincoDeRoca, poker:SieteDeBicho .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Cincos con Doce de Dragon" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDeVeneno, poker:CincoDeTierra, poker:CincoDeAgua, poker:DoceDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Veneno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CincoDeVeneno, poker:SeisDeVeneno, poker:SieteDeVeneno, poker:OchoDeVeneno .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Lucha" ;
    poker:contieneCarta poker:UnoDeLucha, poker:DosDeLucha, poker:TresDeLucha, poker:CuatroDeLucha, poker:CincoDeLucha .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Dragon" ;
    poker:contieneCarta poker:UnoDeDragon, poker:DosDeDragon, poker:TresDeDragon, poker:CuatroDeDragon, poker:CincoDeDragon .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Fuego" ;
    poker:contieneCarta poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:NueveDeVolador, poker:DiezDeVolador, poker:OnceDeVolador, poker:DoceDeVolador, poker:TreceDeVolador .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fantasma" ;
    poker:contieneCarta poker:NueveDeFantasma, poker:DiezDeFantasma, poker:OnceDeFantasma, poker:DoceDeFantasma, poker:TreceDeFantasma .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Roca" ;
    poker:contieneCarta poker:NueveDeRoca, poker:DiezDeRoca, poker:OnceDeRoca, poker:DoceDeRoca, poker:TreceDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
