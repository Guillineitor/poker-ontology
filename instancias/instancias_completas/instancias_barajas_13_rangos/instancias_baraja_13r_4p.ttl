# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Once Nueve Seis Uno" ;
    poker:contieneCarta poker:DoceDeFuego, poker:UnoDePlanta, poker:NueveDeFuego, poker:SeisDePlanta, poker:OnceDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Diez Ocho Cinco Uno" ;
    poker:contieneCarta poker:CincoDeFuego, poker:OnceDeAgua, poker:UnoDeAgua, poker:OchoDeAgua, poker:DiezDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Siete Cinco Dos Uno" ;
    poker:contieneCarta poker:SieteDePlanta, poker:DosDeElectrico, poker:CincoDePlanta, poker:UnoDeAgua, poker:DiezDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Once Nueve Cuatro Uno" ;
    poker:contieneCarta poker:OnceDePlanta, poker:UnoDePlanta, poker:TreceDeFuego, poker:NueveDePlanta, poker:CuatroDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treces con Diez Seis Cuatro" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDeAgua, poker:SeisDePlanta, poker:DiezDeAgua, poker:CuatroDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieces con Siete Cinco Uno" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDePlanta, poker:SieteDePlanta, poker:CincoDeAgua, poker:UnoDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Ochos con Diez Seis Uno" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeElectrico, poker:SeisDeAgua, poker:DiezDePlanta, poker:UnoDeAgua .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cuatros con Doce Seis Uno" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:DoceDeAgua, poker:UnoDePlanta, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Treses con Doce" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDePlanta, poker:TresDeAgua, poker:TresDeFuego, poker:DoceDeAgua ;
    poker:manoTienePar poker:Cuatro, poker:Tres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Unos con Diez" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeElectrico, poker:TresDeElectrico, poker:TresDePlanta, poker:DiezDePlanta ;
    poker:manoTienePar poker:Uno, poker:Tres .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Seises con Ocho" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDeAgua, poker:TreceDeElectrico, poker:TreceDeAgua, poker:OchoDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Trece .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Ochos con Cuatro" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeAgua, poker:DoceDeAgua, poker:DoceDePlanta, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Ocho, poker:Doce .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Seises con Ocho Siete" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeElectrico, poker:SeisDeFuego, poker:OchoDePlanta, poker:SieteDeAgua .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Unos con Doce Ocho" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDePlanta, poker:UnoDeAgua, poker:OchoDePlanta, poker:DoceDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieces con Doce Nueve" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDeElectrico, poker:DiezDePlanta, poker:DoceDePlanta, poker:NueveDePlanta .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Onces con Trece Tres" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeFuego, poker:OnceDePlanta, poker:TresDeElectrico, poker:TreceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeElectrico, poker:NueveDeElectrico, poker:DiezDeFuego .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeElectrico, poker:CuatroDeFuego, poker:CincoDePlanta, poker:SeisDePlanta, poker:SieteDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeAgua, poker:SeisDeElectrico, poker:SieteDePlanta, poker:OchoDeFuego, poker:NueveDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeFuego, poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeAgua, poker:NueveDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Trece Nueve Ocho Siete Uno de Fuego" ;
    poker:contieneCarta poker:OchoDeFuego, poker:SieteDeFuego, poker:NueveDeFuego, poker:UnoDeFuego, poker:TreceDeFuego .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Trece Doce Once Nueve Seis de Fuego" ;
    poker:contieneCarta poker:DoceDeFuego, poker:TreceDeFuego, poker:OnceDeFuego, poker:SeisDeFuego, poker:NueveDeFuego .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Doce Nueve Ocho Seis Cuatro de Planta" ;
    poker:contieneCarta poker:OchoDePlanta, poker:DoceDePlanta, poker:SeisDePlanta, poker:CuatroDePlanta, poker:NueveDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Ocho Seis Cinco Tres Uno de Fuego" ;
    poker:contieneCarta poker:SeisDeFuego, poker:TresDeFuego, poker:CincoDeFuego, poker:OchoDeFuego, poker:UnoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Seises" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeFuego, poker:UnoDeAgua, poker:SeisDeElectrico, poker:SeisDeAgua ;
    poker:manoTienePar poker:Uno, poker:Seis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Ochos" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeAgua, poker:UnoDeElectrico, poker:OchoDeAgua, poker:OchoDeFuego ;
    poker:manoTienePar poker:Uno, poker:Ocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Unos" ;
    poker:contieneCarta poker:OnceDePlanta, poker:OnceDeElectrico, poker:OnceDeAgua, poker:UnoDeElectrico, poker:UnoDeFuego ;
    poker:manoTienePar poker:Once, poker:Uno .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Unos" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeFuego, poker:DosDeElectrico, poker:UnoDePlanta, poker:UnoDeElectrico ;
    poker:manoTienePar poker:Dos, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Dieces con Nueve de Agua" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeAgua, poker:DiezDeFuego, poker:DiezDeElectrico, poker:NueveDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Cinco de Electrico" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:CuatroDeAgua, poker:CincoDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cincos con Once de Fuego" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:CincoDeFuego, poker:CincoDeElectrico, poker:OnceDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treces con Tres de Planta" ;
    poker:contieneCarta poker:TreceDeAgua, poker:TreceDeFuego, poker:TreceDeElectrico, poker:TreceDePlanta, poker:TresDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Planta" ;
    poker:contieneCarta poker:OchoDePlanta, poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Planta" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta, poker:SieteDePlanta, poker:OchoDePlanta .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
