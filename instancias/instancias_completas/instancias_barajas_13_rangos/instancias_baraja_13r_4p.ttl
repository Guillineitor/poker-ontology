# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Ocho Siete Dos Uno" ;
    poker:contieneCarta poker:OchoDePlanta, poker:DoceDeFuego, poker:SieteDeAgua, poker:UnoDeAgua, poker:DosDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Ocho Siete Seis Cinco" ;
    poker:contieneCarta poker:OchoDePlanta, poker:SieteDePlanta, poker:TreceDeElectrico, poker:CincoDePlanta, poker:SeisDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Diez Ocho Seis Dos" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:SeisDeElectrico, poker:DiezDeElectrico, poker:OchoDePlanta, poker:DosDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Diez Seis Cuatro Dos" ;
    poker:contieneCarta poker:SeisDeAgua, poker:DosDePlanta, poker:DoceDeElectrico, poker:DiezDePlanta, poker:CuatroDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doces con Cinco Cuatro Uno" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDePlanta, poker:CincoDeFuego, poker:UnoDeAgua, poker:CuatroDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Once Diez Uno" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeFuego, poker:OnceDeAgua, poker:DiezDeAgua, poker:UnoDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Nueves con Trece Doce Cinco" ;
    poker:contieneCarta poker:NueveDeAgua, poker:NueveDeFuego, poker:CincoDeFuego, poker:DoceDeFuego, poker:TreceDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Doces con Tres Dos Uno" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeAgua, poker:DosDeFuego, poker:UnoDeAgua, poker:TresDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Ochos con Nueve" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:OnceDeFuego, poker:OchoDePlanta, poker:OchoDeAgua, poker:NueveDeFuego ;
    poker:manoTienePar poker:Once, poker:Ocho .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Onces con Ocho" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeAgua, poker:OnceDePlanta, poker:OnceDeFuego, poker:OchoDeElectrico ;
    poker:manoTienePar poker:Doce, poker:Once .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Cincos con Ocho" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:NueveDeFuego, poker:CincoDeFuego, poker:CincoDeAgua, poker:OchoDePlanta ;
    poker:manoTienePar poker:Nueve, poker:Cinco .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Ochos con Dos" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeElectrico, poker:DiezDePlanta, poker:DiezDeFuego, poker:DosDeFuego ;
    poker:manoTienePar poker:Ocho, poker:Diez .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treses con Once Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeElectrico, poker:TresDePlanta, poker:UnoDePlanta, poker:OnceDeElectrico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doses con Trece Doce" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeElectrico, poker:DosDePlanta, poker:DoceDeAgua, poker:TreceDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Nueves con Cinco Dos" ;
    poker:contieneCarta poker:NueveDeAgua, poker:NueveDePlanta, poker:NueveDeElectrico, poker:DosDeAgua, poker:CincoDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Tres Uno" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:CuatroDeAgua, poker:TresDePlanta, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeFuego, poker:CuatroDePlanta, poker:CincoDeAgua, poker:SeisDeFuego, poker:SieteDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeElectrico, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeFuego, poker:OchoDeAgua, poker:NueveDeElectrico, poker:DiezDeAgua, poker:OnceDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SieteDePlanta, poker:OchoDeElectrico, poker:NueveDeFuego, poker:DiezDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Once Ocho Seis Cuatro Tres de Agua" ;
    poker:contieneCarta poker:SeisDeAgua, poker:OnceDeAgua, poker:OchoDeAgua, poker:TresDeAgua, poker:CuatroDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Ocho Siete Tres Dos Uno de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:SieteDeAgua, poker:OchoDeAgua, poker:TresDeAgua, poker:UnoDeAgua .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Once Nueve Seis Tres Dos de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:TresDeAgua, poker:OnceDeAgua, poker:SeisDeAgua, poker:DosDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Trece Nueve Ocho Seis Cuatro de Agua" ;
    poker:contieneCarta poker:OchoDeAgua, poker:CuatroDeAgua, poker:NueveDeAgua, poker:SeisDeAgua, poker:TreceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Cincos" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeElectrico, poker:TresDeFuego, poker:CincoDePlanta, poker:CincoDeAgua ;
    poker:manoTienePar poker:Tres, poker:Cinco .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Nueves" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:OnceDeFuego, poker:OnceDePlanta, poker:NueveDeAgua, poker:NueveDeElectrico ;
    poker:manoTienePar poker:Once, poker:Nueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Ochos" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeFuego, poker:CuatroDeElectrico, poker:OchoDePlanta, poker:OchoDeFuego ;
    poker:manoTienePar poker:Cuatro, poker:Ocho .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Cuatros" ;
    poker:contieneCarta poker:OchoDeFuego, poker:OchoDeElectrico, poker:OchoDePlanta, poker:CuatroDeElectrico, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Ocho, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Diez de Planta" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:DiezDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Dieces con Nueve de Electrico" ;
    poker:contieneCarta poker:DiezDeFuego, poker:DiezDeAgua, poker:DiezDePlanta, poker:DiezDeElectrico, poker:NueveDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treces con Uno de Fuego" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDeAgua, poker:TreceDeFuego, poker:TreceDePlanta, poker:UnoDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treses con Cuatro de Planta" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeFuego, poker:TresDePlanta, poker:TresDeElectrico, poker:CuatroDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Agua" ;
    poker:contieneCarta poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Electrico" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Fuego" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Electrico" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico, poker:DiezDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
