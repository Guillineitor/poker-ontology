# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Nueve Ocho Siete Dos" ;
    poker:contieneCarta poker:OchoDeFuego, poker:DosDePlanta, poker:DiezDePlanta, poker:NueveDeFuego, poker:SieteDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeElectrico, poker:TreceDeFuego, poker:TresDeFuego, poker:CincoDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Diez Nueve Ocho Cinco" ;
    poker:contieneCarta poker:DiezDeFuego, poker:CincoDeFuego, poker:NueveDePlanta, poker:DoceDeElectrico, poker:OchoDeFuego .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Cinco Tres Dos" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:TreceDeFuego, poker:DosDeElectrico, poker:TresDeElectrico, poker:DoceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Once Siete Tres" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeElectrico, poker:TresDeFuego, poker:OnceDePlanta, poker:SieteDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treses con Trece Seis Dos" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeAgua, poker:TreceDeAgua, poker:DosDeAgua, poker:SeisDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Cincos con Ocho Tres Dos" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDePlanta, poker:OchoDePlanta, poker:DosDePlanta, poker:TresDeAgua .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Ochos con Doce Nueve Siete" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDePlanta, poker:DoceDePlanta, poker:SieteDeAgua, poker:NueveDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Onces con Nueve" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeElectrico, poker:OnceDeFuego, poker:OnceDeElectrico, poker:NueveDeFuego ;
    poker:manoTienePar poker:Doce, poker:Once .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Doses con Uno" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDePlanta, poker:SeisDePlanta, poker:SeisDeAgua, poker:UnoDeAgua ;
    poker:manoTienePar poker:Dos, poker:Seis .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Doses y Unos con Trece" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeAgua, poker:UnoDeElectrico, poker:UnoDeAgua, poker:TreceDeAgua ;
    poker:manoTienePar poker:Dos, poker:Uno .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Sietes con Cinco" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeElectrico, poker:SieteDePlanta, poker:SieteDeAgua, poker:CincoDeAgua ;
    poker:manoTienePar poker:Once, poker:Siete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Onces con Doce Diez" ;
    poker:contieneCarta poker:OnceDePlanta, poker:OnceDeElectrico, poker:OnceDeAgua, poker:DoceDeAgua, poker:DiezDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Unos con Cuatro Tres" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeElectrico, poker:UnoDeFuego, poker:TresDeAgua, poker:CuatroDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Unos con Doce Siete" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeElectrico, poker:UnoDePlanta, poker:SieteDeAgua, poker:DoceDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Doses con Once Diez" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeAgua, poker:DosDeElectrico, poker:DiezDeAgua, poker:OnceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDePlanta, poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDeAgua, poker:DoceDeFuego .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeAgua, poker:OchoDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDePlanta, poker:OnceDeElectrico, poker:DoceDePlanta, poker:TreceDeFuego .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeFuego, poker:OchoDeAgua, poker:NueveDeElectrico, poker:DiezDeAgua, poker:OnceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Once Ocho Cinco Cuatro Uno de Electrico" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:UnoDeElectrico, poker:OchoDeElectrico, poker:OnceDeElectrico, poker:CincoDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Once Diez Ocho Tres Uno de Fuego" ;
    poker:contieneCarta poker:DiezDeFuego, poker:TresDeFuego, poker:OnceDeFuego, poker:OchoDeFuego, poker:UnoDeFuego .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Doce Nueve Cuatro Tres Uno de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:CuatroDeFuego, poker:TresDeFuego, poker:DoceDeFuego, poker:NueveDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Doce Once Nueve Seis Uno de Electrico" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:NueveDeElectrico, poker:DoceDeElectrico, poker:SeisDeElectrico, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Seises" ;
    poker:contieneCarta poker:OnceDePlanta, poker:OnceDeFuego, poker:OnceDeElectrico, poker:SeisDeElectrico, poker:SeisDePlanta ;
    poker:manoTienePar poker:Once, poker:Seis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Doces" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:DoceDePlanta, poker:DoceDeAgua ;
    poker:manoTienePar poker:Cuatro, poker:Doce .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Nueves" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDeAgua, poker:CuatroDeFuego, poker:NueveDeFuego, poker:NueveDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Nueve .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Treces" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDePlanta, poker:CincoDeAgua, poker:TreceDeAgua, poker:TreceDeElectrico ;
    poker:manoTienePar poker:Cinco, poker:Trece .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doces con Trece de Agua" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeElectrico, poker:DoceDeAgua, poker:DoceDePlanta, poker:TreceDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Tres de Planta" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CuatroDeFuego, poker:TresDePlanta .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treces con Diez de Planta" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDeElectrico, poker:TreceDeAgua, poker:TreceDePlanta, poker:DiezDePlanta .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Seises con Cinco de Agua" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDePlanta, poker:SeisDeAgua, poker:SeisDeFuego, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Fuego" ;
    poker:contieneCarta poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeFuego .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Agua" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Fuego" ;
    poker:contieneCarta poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
