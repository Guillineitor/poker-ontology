# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Diez Seis Tres Uno" ;
    poker:contieneCarta poker:TresDeBicho, poker:SeisDeVeneno, poker:DiezDeFuego, poker:UnoDeElectrico, poker:DoceDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Once Diez Ocho Tres" ;
    poker:contieneCarta poker:TresDeNormal, poker:OchoDeAgua, poker:TreceDePlanta, poker:OnceDeAgua, poker:DiezDeBicho .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Ocho Seis Dos Uno" ;
    poker:contieneCarta poker:DosDeElectrico, poker:SeisDeElectrico, poker:DiezDeNormal, poker:OchoDePlanta, poker:UnoDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Cuatro Tres Dos Uno" ;
    poker:contieneCarta poker:DosDeVolador, poker:UnoDeAgua, poker:TresDeElectrico, poker:OnceDeNormal, poker:CuatroDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cuatros con Once Diez Tres" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDeVeneno, poker:TresDeNormal, poker:OnceDePlanta, poker:DiezDeVeneno .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treces con Ocho Cinco Cuatro" ;
    poker:contieneCarta poker:TreceDeNormal, poker:TreceDeElectrico, poker:CuatroDeVeneno, poker:CincoDeVolador, poker:OchoDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Seises con Trece Once Uno" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDeNormal, poker:TreceDeFuego, poker:OnceDeBicho, poker:UnoDeFuego .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cincos con Nueve Cuatro Uno" ;
    poker:contieneCarta poker:CincoDeVolador, poker:CincoDePlanta, poker:NueveDeNormal, poker:UnoDeElectrico, poker:CuatroDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Sietes con Trece" ;
    poker:contieneCarta poker:OnceDeBicho, poker:OnceDeElectrico, poker:SieteDeAgua, poker:SieteDeBicho, poker:TreceDeElectrico ;
    poker:manoTienePar poker:Once, poker:Siete .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Unos con Cinco" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDeNormal, poker:UnoDeBicho, poker:UnoDePlanta, poker:CincoDeVeneno ;
    poker:manoTienePar poker:Tres, poker:Uno .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Doses con Siete" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDeVolador, poker:OnceDeBicho, poker:OnceDeElectrico, poker:SieteDeVeneno ;
    poker:manoTienePar poker:Dos, poker:Once .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Doses con Nueve" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeVolador, poker:DosDePlanta, poker:DosDeFuego, poker:NueveDeFuego ;
    poker:manoTienePar poker:Cinco, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Nueves con Once Siete" ;
    poker:contieneCarta poker:NueveDeBicho, poker:NueveDeElectrico, poker:NueveDePlanta, poker:SieteDeFuego, poker:OnceDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Treses con Once Uno" ;
    poker:contieneCarta poker:TresDeNormal, poker:TresDeAgua, poker:TresDeVeneno, poker:OnceDeVolador, poker:UnoDeVolador .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Treces con Nueve Ocho" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeNormal, poker:TreceDeBicho, poker:NueveDePlanta, poker:OchoDeVolador .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Sietes con Diez Cinco" ;
    poker:contieneCarta poker:SieteDeBicho, poker:SieteDeElectrico, poker:SieteDeVeneno, poker:CincoDeNormal, poker:DiezDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeNormal, poker:SeisDeNormal, poker:SieteDeElectrico, poker:OchoDeVolador, poker:NueveDeVeneno .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CincoDeFuego, poker:SeisDeVeneno, poker:SieteDeElectrico, poker:OchoDeVeneno .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeBicho, poker:SeisDeBicho, poker:SieteDeVeneno, poker:OchoDeVolador, poker:NueveDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CincoDeVolador, poker:SeisDeVeneno, poker:SieteDeNormal, poker:OchoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Doce Once Nueve Siete Cinco de Veneno" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:NueveDeVeneno, poker:OnceDeVeneno, poker:CincoDeVeneno, poker:DoceDeVeneno .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Doce Nueve Ocho Cuatro Uno de Eléctrico" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:DoceDeElectrico, poker:UnoDeElectrico, poker:CuatroDeElectrico, poker:NueveDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Once Diez Ocho Cinco Tres de Fuego" ;
    poker:contieneCarta poker:DiezDeFuego, poker:OchoDeFuego, poker:OnceDeFuego, poker:CincoDeFuego, poker:TresDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Trece Ocho Cuatro Dos Uno de Normal" ;
    poker:contieneCarta poker:UnoDeNormal, poker:DosDeNormal, poker:OchoDeNormal, poker:TreceDeNormal, poker:CuatroDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Doces" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDePlanta, poker:CincoDeBicho, poker:DoceDeVolador, poker:DoceDeNormal ;
    poker:manoTienePar poker:Cinco, poker:Doce .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Dieces" ;
    poker:contieneCarta poker:OnceDeNormal, poker:OnceDeVeneno, poker:OnceDeVolador, poker:DiezDeBicho, poker:DiezDeAgua ;
    poker:manoTienePar poker:Once, poker:Diez .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Sietes" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeVolador, poker:CuatroDeElectrico, poker:SieteDeBicho, poker:SieteDeVolador ;
    poker:manoTienePar poker:Cuatro, poker:Siete .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Dieces" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeFuego, poker:NueveDeVeneno, poker:DiezDeVeneno, poker:DiezDeAgua ;
    poker:manoTienePar poker:Nueve, poker:Diez .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Onces con Tres de Veneno" ;
    poker:contieneCarta poker:OnceDeVeneno, poker:OnceDeBicho, poker:OnceDeElectrico, poker:OnceDePlanta, poker:TresDeVeneno .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Onces con Diez de Veneno" ;
    poker:contieneCarta poker:OnceDePlanta, poker:OnceDeAgua, poker:OnceDeNormal, poker:OnceDeVeneno, poker:DiezDeVeneno .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Siete de Eléctrico" ;
    poker:contieneCarta poker:TresDeVolador, poker:TresDeAgua, poker:TresDeVeneno, poker:TresDePlanta, poker:SieteDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Unos con Diez de Eléctrico" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeNormal, poker:UnoDeVolador, poker:UnoDeVeneno, poker:DiezDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Bicho" ;
    poker:contieneCarta poker:CincoDeBicho, poker:SeisDeBicho, poker:SieteDeBicho, poker:OchoDeBicho, poker:NueveDeBicho .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Volador" ;
    poker:contieneCarta poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador, poker:SeisDeVolador, poker:SieteDeVolador .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Planta" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta, poker:SieteDePlanta, poker:OchoDePlanta .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Veneno" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:OchoDeVeneno, poker:NueveDeVeneno, poker:DiezDeVeneno, poker:OnceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:NueveDeVolador, poker:DiezDeVolador, poker:OnceDeVolador, poker:DoceDeVolador, poker:TreceDeVolador .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:DiezDeVeneno, poker:OnceDeVeneno, poker:DoceDeVeneno, poker:TreceDeVeneno .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
