# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Once Nueve Cinco Dos" ;
    poker:contieneCarta poker:DosDeVeneno, poker:OnceDePlanta, poker:TreceDeNormal, poker:CincoDeBicho, poker:NueveDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Nueve Ocho Tres Dos" ;
    poker:contieneCarta poker:NueveDeNormal, poker:DosDeVeneno, poker:TresDeFuego, poker:OchoDeElectrico, poker:DiezDeBicho .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Nueve Cinco Cuatro Uno" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CincoDeAgua, poker:UnoDeBicho, poker:NueveDePlanta, poker:OnceDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Diez Ocho Siete Seis" ;
    poker:contieneCarta poker:DoceDePlanta, poker:SieteDeFuego, poker:SeisDeBicho, poker:DiezDeVeneno, poker:OchoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cincos con Doce Ocho Dos" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeAgua, poker:DosDeVolador, poker:DoceDeElectrico, poker:OchoDeBicho .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doses con Siete Cuatro Tres" ;
    poker:contieneCarta poker:DosDeVolador, poker:DosDeVeneno, poker:CuatroDeAgua, poker:SieteDeElectrico, poker:TresDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Ochos con Seis Tres Dos" ;
    poker:contieneCarta poker:OchoDeVolador, poker:OchoDeVeneno, poker:SeisDeAgua, poker:TresDePlanta, poker:DosDeNormal .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Seises con Trece Once Tres" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDeElectrico, poker:TresDeVolador, poker:TreceDeFuego, poker:OnceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Doses con Once" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDeBicho, poker:TresDeAgua, poker:TresDeVeneno, poker:OnceDePlanta ;
    poker:manoTienePar poker:Dos, poker:Tres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cincos con Dos" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeBicho, poker:SeisDeVeneno, poker:SeisDeNormal, poker:DosDeVolador ;
    poker:manoTienePar poker:Cinco, poker:Seis .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Unos con Cinco" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDePlanta, poker:UnoDeAgua, poker:UnoDeVolador, poker:CincoDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Uno .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Treses con Doce" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDeNormal, poker:TresDeAgua, poker:TresDeElectrico, poker:DoceDeNormal ;
    poker:manoTienePar poker:Seis, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Doce Nueve" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CuatroDeElectrico, poker:CuatroDeVolador, poker:NueveDeNormal, poker:DoceDeNormal .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Onces con Siete Cuatro" ;
    poker:contieneCarta poker:OnceDeFuego, poker:OnceDeVeneno, poker:OnceDeBicho, poker:SieteDeElectrico, poker:CuatroDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cincos con Doce Once" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeVeneno, poker:CincoDeBicho, poker:OnceDeNormal, poker:DoceDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Cinco Tres" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDeAgua, poker:CuatroDeBicho, poker:CincoDeElectrico, poker:TresDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:DiezDeVolador, poker:OnceDePlanta, poker:DoceDeAgua, poker:TreceDeFuego .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:DiezDeBicho, poker:OnceDeNormal, poker:DoceDeBicho, poker:TreceDeVeneno .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDePlanta, poker:DoceDeFuego .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SieteDeNormal, poker:OchoDeFuego, poker:NueveDeVolador, poker:DiezDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Doce Diez Nueve Cuatro Tres de Volador" ;
    poker:contieneCarta poker:TresDeVolador, poker:CuatroDeVolador, poker:DoceDeVolador, poker:DiezDeVolador, poker:NueveDeVolador .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Once Diez Nueve Seis Tres de Planta" ;
    poker:contieneCarta poker:TresDePlanta, poker:NueveDePlanta, poker:SeisDePlanta, poker:DiezDePlanta, poker:OnceDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Trece Once Diez Nueve Ocho de Fuego" ;
    poker:contieneCarta poker:OchoDeFuego, poker:TreceDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:NueveDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Trece Doce Once Seis Cuatro de Agua" ;
    poker:contieneCarta poker:OnceDeAgua, poker:TreceDeAgua, poker:SeisDeAgua, poker:CuatroDeAgua, poker:DoceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Seises" ;
    poker:contieneCarta poker:OchoDeVolador, poker:OchoDeAgua, poker:OchoDeVeneno, poker:SeisDeBicho, poker:SeisDeFuego ;
    poker:manoTienePar poker:Ocho, poker:Seis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Seises" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDePlanta, poker:CuatroDeVolador, poker:SeisDeFuego, poker:SeisDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Seis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Cincos" ;
    poker:contieneCarta poker:NueveDeVolador, poker:NueveDeAgua, poker:NueveDeNormal, poker:CincoDeBicho, poker:CincoDeFuego ;
    poker:manoTienePar poker:Nueve, poker:Cinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Nueves" ;
    poker:contieneCarta poker:OchoDeBicho, poker:OchoDeVolador, poker:OchoDeNormal, poker:NueveDeFuego, poker:NueveDeAgua ;
    poker:manoTienePar poker:Ocho, poker:Nueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Nueves con Dos de Veneno" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeFuego, poker:NueveDeBicho, poker:NueveDeVolador, poker:DosDeVeneno .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Nueves con Cuatro de Bicho" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:NueveDeElectrico, poker:NueveDeVolador, poker:NueveDeFuego, poker:CuatroDeBicho .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Nueves con Ocho de Normal" ;
    poker:contieneCarta poker:NueveDeNormal, poker:NueveDeElectrico, poker:NueveDeAgua, poker:NueveDeVolador, poker:OchoDeNormal .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Ochos con Siete de Agua" ;
    poker:contieneCarta poker:OchoDeNormal, poker:OchoDeElectrico, poker:OchoDeAgua, poker:OchoDeFuego, poker:SieteDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Bicho" ;
    poker:contieneCarta poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho, poker:SeisDeBicho .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Agua" ;
    poker:contieneCarta poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Fuego" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:NueveDeVolador, poker:DiezDeVolador, poker:OnceDeVolador, poker:DoceDeVolador, poker:TreceDeVolador .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
