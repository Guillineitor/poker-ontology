# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Diez Nueve Uno" ;
    poker:contieneCarta poker:DiezDeBicho, poker:TreceDeNormal, poker:UnoDeFuego, poker:DoceDeElectrico, poker:NueveDeVeneno .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Once Siete Cinco Uno" ;
    poker:contieneCarta poker:UnoDeNormal, poker:OnceDeFuego, poker:SieteDeBicho, poker:CincoDePlanta, poker:TreceDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Once Diez Nueve Ocho" ;
    poker:contieneCarta poker:TreceDeNormal, poker:DiezDeFuego, poker:OnceDeNormal, poker:OchoDeVeneno, poker:NueveDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Nueve Siete Cuatro" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:DoceDeFuego, poker:TreceDeBicho, poker:SieteDePlanta, poker:NueveDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Nueves con Doce Once Ocho" ;
    poker:contieneCarta poker:NueveDeNormal, poker:NueveDeVolador, poker:OchoDeBicho, poker:OnceDeBicho, poker:DoceDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieces con Trece Doce Cuatro" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDeElectrico, poker:CuatroDeAgua, poker:DoceDeVeneno, poker:TreceDeVeneno .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Cincos con Doce Ocho Dos" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDeAgua, poker:DosDeFuego, poker:DoceDeAgua, poker:OchoDeFuego .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Ochos con Trece Doce Diez" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDeBicho, poker:TreceDeElectrico, poker:DoceDeBicho, poker:DiezDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Ochos con Doce" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:OchoDeNormal, poker:NueveDeAgua, poker:NueveDeFuego, poker:DoceDeElectrico ;
    poker:manoTienePar poker:Ocho, poker:Nueve .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Doses con Diez" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeVolador, poker:OchoDeVolador, poker:OchoDeElectrico, poker:DiezDePlanta ;
    poker:manoTienePar poker:Dos, poker:Ocho .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Ochos con Cuatro" ;
    poker:contieneCarta poker:OnceDeFuego, poker:OnceDeBicho, poker:OchoDeElectrico, poker:OchoDeVeneno, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Once, poker:Ocho .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Sietes con Tres" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeAgua, poker:SieteDePlanta, poker:SieteDeElectrico, poker:TresDePlanta ;
    poker:manoTienePar poker:Nueve, poker:Siete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Nueves con Seis Cinco" ;
    poker:contieneCarta poker:NueveDeVolador, poker:NueveDeBicho, poker:NueveDeNormal, poker:SeisDeAgua, poker:CincoDeElectrico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Once Diez" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeVolador, poker:CuatroDeFuego, poker:OnceDeElectrico, poker:DiezDeBicho .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cincos con Siete Seis" ;
    poker:contieneCarta poker:CincoDeBicho, poker:CincoDeNormal, poker:CincoDePlanta, poker:SieteDeBicho, poker:SeisDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Sietes con Cinco Cuatro" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:SieteDeFuego, poker:SieteDePlanta, poker:CincoDeVolador, poker:CuatroDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:OchoDeBicho, poker:NueveDeFuego, poker:DiezDeBicho, poker:OnceDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeNormal, poker:OchoDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeAgua, poker:CuatroDeBicho, poker:CincoDeNormal, poker:SeisDeNormal, poker:SieteDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDePlanta, poker:OchoDeElectrico, poker:NueveDeNormal, poker:DiezDeAgua, poker:OnceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Doce Nueve Ocho Tres Dos de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:DoceDePlanta, poker:TresDePlanta, poker:NueveDePlanta, poker:OchoDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Trece Diez Nueve Ocho Uno de Volador" ;
    poker:contieneCarta poker:DiezDeVolador, poker:UnoDeVolador, poker:OchoDeVolador, poker:NueveDeVolador, poker:TreceDeVolador .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Nueve Siete Seis Dos Uno de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:UnoDeFuego, poker:SeisDeFuego, poker:NueveDeFuego, poker:SieteDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Once Siete Tres Dos Uno de Agua" ;
    poker:contieneCarta poker:SieteDeAgua, poker:DosDeAgua, poker:TresDeAgua, poker:OnceDeAgua, poker:UnoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Onces" ;
    poker:contieneCarta poker:TreceDeBicho, poker:TreceDeFuego, poker:TreceDeAgua, poker:OnceDeFuego, poker:OnceDePlanta ;
    poker:manoTienePar poker:Trece, poker:Once .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Onces" ;
    poker:contieneCarta poker:CincoDeVolador, poker:CincoDeAgua, poker:CincoDePlanta, poker:OnceDeAgua, poker:OnceDeNormal ;
    poker:manoTienePar poker:Cinco, poker:Once .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Doses" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeNormal, poker:TresDeVolador, poker:DosDeVolador, poker:DosDeNormal ;
    poker:manoTienePar poker:Tres, poker:Dos .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Doses" ;
    poker:contieneCarta poker:UnoDeBicho, poker:UnoDeVolador, poker:UnoDeNormal, poker:DosDeFuego, poker:DosDeVolador ;
    poker:manoTienePar poker:Uno, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doses con Tres de Bicho" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeNormal, poker:DosDeAgua, poker:DosDeBicho, poker:TresDeBicho .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Unos con Diez de Bicho" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeElectrico, poker:UnoDeNormal, poker:UnoDeVolador, poker:DiezDeBicho .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Unos con Seis de Volador" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeVeneno, poker:UnoDePlanta, poker:UnoDeVolador, poker:SeisDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treses con Seis de Fuego" ;
    poker:contieneCarta poker:TresDeBicho, poker:TresDeElectrico, poker:TresDePlanta, poker:TresDeAgua, poker:SeisDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Normal" ;
    poker:contieneCarta poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal, poker:SeisDeNormal, poker:SieteDeNormal .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Bicho" ;
    poker:contieneCarta poker:OchoDeBicho, poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Fuego" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:NueveDeNormal, poker:DiezDeNormal, poker:OnceDeNormal, poker:DoceDeNormal, poker:TreceDeNormal .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
