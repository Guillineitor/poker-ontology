# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Ocho Siete Cuatro Uno" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:UnoDeVolador, poker:OchoDeAgua, poker:DoceDeElectrico, poker:SieteDeFuego .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Ocho con Cinco Tres Dos Uno" ;
    poker:contieneCarta poker:TresDeFuego, poker:CincoDeBicho, poker:OchoDeFuego, poker:DosDeFuego, poker:UnoDeFuego .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Diez Ocho Dos Uno" ;
    poker:contieneCarta poker:TreceDeVeneno, poker:OchoDeVolador, poker:DiezDeVeneno, poker:DosDeNormal, poker:UnoDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Nueve Seis Cinco Uno" ;
    poker:contieneCarta poker:TreceDePlanta, poker:NueveDeBicho, poker:CincoDeNormal, poker:UnoDeAgua, poker:SeisDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Seises con Nueve Ocho Dos" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeElectrico, poker:OchoDePlanta, poker:DosDePlanta, poker:NueveDeBicho .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Ochos con Trece Nueve Dos" ;
    poker:contieneCarta poker:OchoDeVolador, poker:OchoDeElectrico, poker:DosDeVolador, poker:TreceDeVeneno, poker:NueveDeVeneno .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doses con Once Cinco Tres" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeBicho, poker:CincoDeVolador, poker:TresDeVeneno, poker:OnceDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Sietes con Seis Cuatro Uno" ;
    poker:contieneCarta poker:SieteDeNormal, poker:SieteDeAgua, poker:CuatroDeAgua, poker:UnoDeElectrico, poker:SeisDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cincos con Trece" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDeVolador, poker:CincoDePlanta, poker:CincoDeVeneno, poker:TreceDePlanta ;
    poker:manoTienePar poker:Seis, poker:Cinco .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Seises con Diez" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDeAgua, poker:TreceDeAgua, poker:TreceDeBicho, poker:DiezDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Trece .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Treses con Diez" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeAgua, poker:NueveDeVeneno, poker:NueveDeFuego, poker:DiezDeFuego ;
    poker:manoTienePar poker:Tres, poker:Nueve .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Unos con Ocho" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeElectrico, poker:UnoDePlanta, poker:UnoDeFuego, poker:OchoDeElectrico ;
    poker:manoTienePar poker:Cinco, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Doces con Once Dos" ;
    poker:contieneCarta poker:DoceDeVolador, poker:DoceDeElectrico, poker:DoceDeVeneno, poker:DosDeNormal, poker:OnceDeNormal .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Siete Dos" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDeNormal, poker:CuatroDeVolador, poker:DosDeElectrico, poker:SieteDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Unos con Ocho Dos" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:UnoDeBicho, poker:UnoDeFuego, poker:OchoDePlanta, poker:DosDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Seises con Doce Cinco" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDeAgua, poker:SeisDeFuego, poker:CincoDeFuego, poker:DoceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:OchoDeElectrico, poker:NueveDeNormal, poker:DiezDePlanta, poker:OnceDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeVolador, poker:TresDeElectrico, poker:CuatroDeVeneno, poker:CincoDeAgua, poker:SeisDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeNormal, poker:NueveDeBicho, poker:DiezDeAgua, poker:OnceDeVolador, poker:DoceDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeElectrico, poker:OchoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Nueve Ocho Seis Cuatro Dos de Agua" ;
    poker:contieneCarta poker:OchoDeAgua, poker:SeisDeAgua, poker:CuatroDeAgua, poker:DosDeAgua, poker:NueveDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Diez Nueve Ocho Dos Uno de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:UnoDePlanta, poker:DiezDePlanta, poker:OchoDePlanta, poker:DosDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Trece Once Ocho Siete Cinco de Normal" ;
    poker:contieneCarta poker:OnceDeNormal, poker:SieteDeNormal, poker:TreceDeNormal, poker:CincoDeNormal, poker:OchoDeNormal .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Trece Nueve Cinco Tres Dos de Fuego" ;
    poker:contieneCarta poker:CincoDeFuego, poker:DosDeFuego, poker:NueveDeFuego, poker:TreceDeFuego, poker:TresDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Unos" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeBicho, poker:TresDeElectrico, poker:UnoDeVeneno, poker:UnoDeNormal ;
    poker:manoTienePar poker:Tres, poker:Uno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Ochos" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeElectrico, poker:DosDeAgua, poker:OchoDeVolador, poker:OchoDeNormal ;
    poker:manoTienePar poker:Dos, poker:Ocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Dieces" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDeFuego, poker:CuatroDePlanta, poker:DiezDeBicho, poker:DiezDeFuego ;
    poker:manoTienePar poker:Cuatro, poker:Diez .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Cuatros" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:DiezDeVeneno, poker:DiezDeVolador, poker:CuatroDeNormal, poker:CuatroDeElectrico ;
    poker:manoTienePar poker:Diez, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treses con Seis de Normal" ;
    poker:contieneCarta poker:TresDeVeneno, poker:TresDeBicho, poker:TresDeElectrico, poker:TresDeNormal, poker:SeisDeNormal .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Onces con Seis de Volador" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeVolador, poker:OnceDeNormal, poker:OnceDeElectrico, poker:SeisDeVolador .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Onces con Cinco de Normal" ;
    poker:contieneCarta poker:OnceDeVolador, poker:OnceDePlanta, poker:OnceDeVeneno, poker:OnceDeFuego, poker:CincoDeNormal .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treces con Dos de Volador" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDePlanta, poker:TreceDeAgua, poker:TreceDeElectrico, poker:DosDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Volador" ;
    poker:contieneCarta poker:CincoDeVolador, poker:SeisDeVolador, poker:SieteDeVolador, poker:OchoDeVolador, poker:NueveDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Volador" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SieteDeVolador, poker:OchoDeVolador, poker:NueveDeVolador, poker:DiezDeVolador .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
