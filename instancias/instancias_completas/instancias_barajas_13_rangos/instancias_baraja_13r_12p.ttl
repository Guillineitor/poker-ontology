# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Diez Seis Cinco Dos" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:SeisDeVeneno, poker:DosDeTierra, poker:DoceDeVeneno, poker:DiezDeLucha .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Nueve con Siete Cuatro Dos Uno" ;
    poker:contieneCarta poker:DosDeElectrico, poker:UnoDeTierra, poker:CuatroDeVeneno, poker:SieteDeBicho, poker:NueveDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Once Seis Dos" ;
    poker:contieneCarta poker:TreceDeBicho, poker:SeisDePlanta, poker:DosDeVolador, poker:OnceDeNormal, poker:DoceDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Diez Cinco Tres Uno" ;
    poker:contieneCarta poker:OnceDeNormal, poker:DiezDePsiquico, poker:CincoDeVeneno, poker:UnoDeRoca, poker:TresDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cincos con Diez Tres Dos" ;
    poker:contieneCarta poker:CincoDeVolador, poker:CincoDePlanta, poker:DiezDeBicho, poker:DosDeVolador, poker:TresDeTierra .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doses con Nueve Siete Seis" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeElectrico, poker:NueveDeTierra, poker:SieteDeVolador, poker:SeisDeRoca .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doces con Nueve Cuatro Dos" ;
    poker:contieneCarta poker:DoceDeLucha, poker:DoceDeFuego, poker:DosDeRoca, poker:CuatroDeLucha, poker:NueveDeRoca .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Nueves con Diez Seis Uno" ;
    poker:contieneCarta poker:NueveDeFuego, poker:NueveDeBicho, poker:UnoDeElectrico, poker:DiezDeAgua, poker:SeisDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Cincos con Trece" ;
    poker:contieneCarta poker:OnceDeNormal, poker:OnceDePsiquico, poker:CincoDeBicho, poker:CincoDeElectrico, poker:TreceDeVolador ;
    poker:manoTienePar poker:Once, poker:Cinco .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Dieces con Doce" ;
    poker:contieneCarta poker:TreceDeNormal, poker:TreceDeTierra, poker:DiezDeElectrico, poker:DiezDeNormal, poker:DoceDePsiquico ;
    poker:manoTienePar poker:Trece, poker:Diez .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cuatros con Diez" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:SeisDeNormal, poker:CuatroDePlanta, poker:CuatroDeAgua, poker:DiezDeTierra ;
    poker:manoTienePar poker:Seis, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Unos con Nueve" ;
    poker:contieneCarta poker:DiezDeNormal, poker:DiezDeRoca, poker:UnoDeFuego, poker:UnoDeBicho, poker:NueveDeVolador ;
    poker:manoTienePar poker:Diez, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Onces con Nueve Cuatro" ;
    poker:contieneCarta poker:OnceDeTierra, poker:OnceDeVolador, poker:OnceDeFuego, poker:NueveDeTierra, poker:CuatroDePsiquico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doses con Siete Uno" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeLucha, poker:DosDePlanta, poker:SieteDeAgua, poker:UnoDeVeneno .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieces con Cinco Uno" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:DiezDeVeneno, poker:DiezDePlanta, poker:UnoDeAgua, poker:CincoDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Dieces con Once Dos" ;
    poker:contieneCarta poker:DiezDeVolador, poker:DiezDeVeneno, poker:DiezDeNormal, poker:OnceDePlanta, poker:DosDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeLucha, poker:NueveDeElectrico, poker:DiezDeBicho, poker:OnceDeVolador, poker:DoceDeRoca .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDePlanta, poker:CuatroDeLucha, poker:CincoDeElectrico, poker:SeisDeNormal, poker:SieteDePsiquico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeNormal, poker:TresDeRoca, poker:CuatroDeTierra, poker:CincoDeNormal .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeRoca, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Doce Once Nueve Ocho Cinco de Tierra" ;
    poker:contieneCarta poker:CincoDeTierra, poker:NueveDeTierra, poker:DoceDeTierra, poker:OchoDeTierra, poker:OnceDeTierra .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Nueve Cinco Cuatro Tres Dos de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:CuatroDeFuego, poker:TresDeFuego, poker:CincoDeFuego, poker:DosDeFuego .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Once Diez Nueve Siete Uno de Electrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:OnceDeElectrico, poker:NueveDeElectrico, poker:SieteDeElectrico, poker:DiezDeElectrico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Once Siete Seis Cinco Cuatro de Bicho" ;
    poker:contieneCarta poker:CincoDeBicho, poker:OnceDeBicho, poker:CuatroDeBicho, poker:SieteDeBicho, poker:SeisDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Treces" ;
    poker:contieneCarta poker:DiezDeLucha, poker:DiezDeVeneno, poker:DiezDeVolador, poker:TreceDeVolador, poker:TreceDeRoca ;
    poker:manoTienePar poker:Diez, poker:Trece .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Treces" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDeRoca, poker:TresDeFuego, poker:TreceDeElectrico, poker:TreceDeVeneno ;
    poker:manoTienePar poker:Tres, poker:Trece .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Cincos" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDePlanta, poker:DiezDeElectrico, poker:CincoDeVolador, poker:CincoDeRoca ;
    poker:manoTienePar poker:Diez, poker:Cinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Cuatros" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDePsiquico, poker:DosDeTierra, poker:CuatroDeNormal, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Dos, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Unos con Seis de Agua" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:UnoDeFuego, poker:UnoDeTierra, poker:UnoDeElectrico, poker:SeisDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Dieces con Siete de Tierra" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDeElectrico, poker:DiezDeLucha, poker:DiezDeVolador, poker:SieteDeTierra .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Seises con Siete de Veneno" ;
    poker:contieneCarta poker:SeisDeLucha, poker:SeisDePsiquico, poker:SeisDeNormal, poker:SeisDeAgua, poker:SieteDeVeneno .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Cincos con Trece de Veneno" ;
    poker:contieneCarta poker:CincoDeVolador, poker:CincoDeLucha, poker:CincoDeElectrico, poker:CincoDePsiquico, poker:TreceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Roca" ;
    poker:contieneCarta poker:TresDeRoca, poker:CuatroDeRoca, poker:CincoDeRoca, poker:SeisDeRoca, poker:SieteDeRoca .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Tierra" ;
    poker:contieneCarta poker:SeisDeTierra, poker:SieteDeTierra, poker:OchoDeTierra, poker:NueveDeTierra, poker:DiezDeTierra .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Bicho" ;
    poker:contieneCarta poker:UnoDeBicho, poker:DosDeBicho, poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Lucha" ;
    poker:contieneCarta poker:OchoDeLucha, poker:NueveDeLucha, poker:DiezDeLucha, poker:OnceDeLucha, poker:DoceDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:DiezDePsiquico, poker:OnceDePsiquico, poker:DoceDePsiquico, poker:TreceDePsiquico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
