# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Nueve Ocho Seis Uno" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:NueveDeTierra, poker:UnoDeAgua, poker:TreceDePsiquico, poker:OchoDeRoca .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Nueve Tres Dos" ;
    poker:contieneCarta poker:NueveDeRoca, poker:TresDeAgua, poker:TreceDeVolador, poker:DosDeElectrico, poker:DoceDePsiquico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Diez Nueve Siete Tres" ;
    poker:contieneCarta poker:OnceDeTierra, poker:SieteDeAgua, poker:NueveDePlanta, poker:DiezDeTierra, poker:TresDeFuego .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Once Diez Siete Tres" ;
    poker:contieneCarta poker:DiezDeFuego, poker:TresDeNormal, poker:OnceDeVeneno, poker:SieteDePsiquico, poker:TreceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Onces con Doce Diez Nueve" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeElectrico, poker:NueveDeVeneno, poker:DiezDeTierra, poker:DoceDeVeneno .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Trece Siete Uno" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDeVeneno, poker:UnoDeNormal, poker:SieteDeRoca, poker:TreceDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Cincos con Diez Seis Tres" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeBicho, poker:TresDeFuego, poker:SeisDeVeneno, poker:DiezDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Sietes con Trece Diez Nueve" ;
    poker:contieneCarta poker:SieteDeBicho, poker:SieteDePlanta, poker:DiezDeFuego, poker:TreceDeAgua, poker:NueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Cuatros con Trece" ;
    poker:contieneCarta poker:SieteDeTierra, poker:SieteDeRoca, poker:CuatroDeFuego, poker:CuatroDeRoca, poker:TreceDeVeneno ;
    poker:manoTienePar poker:Siete, poker:Cuatro .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Unos con Cinco" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:UnoDeLucha, poker:TreceDeVolador, poker:TreceDePsiquico, poker:CincoDePlanta ;
    poker:manoTienePar poker:Uno, poker:Trece .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Sietes con Cuatro" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:NueveDePsiquico, poker:SieteDeVeneno, poker:SieteDeRoca, poker:CuatroDeNormal ;
    poker:manoTienePar poker:Nueve, poker:Siete .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Seises con Dos" ;
    poker:contieneCarta poker:DoceDeVolador, poker:DoceDeTierra, poker:SeisDePsiquico, poker:SeisDeElectrico, poker:DosDeVeneno ;
    poker:manoTienePar poker:Doce, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cincos con Trece Nueve" ;
    poker:contieneCarta poker:CincoDeBicho, poker:CincoDeAgua, poker:CincoDePlanta, poker:NueveDeLucha, poker:TreceDeLucha .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Onces con Seis Dos" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeVeneno, poker:OnceDeElectrico, poker:SeisDeFuego, poker:DosDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Onces con Cuatro Dos" ;
    poker:contieneCarta poker:OnceDeVolador, poker:OnceDeRoca, poker:OnceDeVeneno, poker:CuatroDeElectrico, poker:DosDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Doses con Diez Tres" ;
    poker:contieneCarta poker:DosDePsiquico, poker:DosDeVeneno, poker:DosDeAgua, poker:TresDeTierra, poker:DiezDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeAgua, poker:NueveDeTierra, poker:DiezDeFuego, poker:OnceDeTierra, poker:DoceDeElectrico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:SeisDeNormal, poker:SieteDePsiquico, poker:OchoDeAgua, poker:NueveDeTierra .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDeTierra, poker:TresDePlanta, poker:CuatroDeTierra, poker:CincoDeVeneno .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeNormal, poker:OchoDeLucha, poker:NueveDeBicho, poker:DiezDePsiquico, poker:OnceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Doce Once Ocho Siete Cinco de Veneno" ;
    poker:contieneCarta poker:DoceDeVeneno, poker:OnceDeVeneno, poker:SieteDeVeneno, poker:OchoDeVeneno, poker:CincoDeVeneno .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Trece Diez Seis Tres Uno de Veneno" ;
    poker:contieneCarta poker:TresDeVeneno, poker:DiezDeVeneno, poker:UnoDeVeneno, poker:SeisDeVeneno, poker:TreceDeVeneno .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Trece Doce Siete Seis Cuatro de Electrico" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:CuatroDeElectrico, poker:DoceDeElectrico, poker:SieteDeElectrico, poker:TreceDeElectrico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Trece Doce Diez Nueve Cinco de Roca" ;
    poker:contieneCarta poker:TreceDeRoca, poker:DoceDeRoca, poker:DiezDeRoca, poker:CincoDeRoca, poker:NueveDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Sietes" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeBicho, poker:DoceDeNormal, poker:SieteDePlanta, poker:SieteDeBicho ;
    poker:manoTienePar poker:Doce, poker:Siete .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Ochos" ;
    poker:contieneCarta poker:TresDeBicho, poker:TresDePsiquico, poker:TresDeNormal, poker:OchoDeElectrico, poker:OchoDeBicho ;
    poker:manoTienePar poker:Tres, poker:Ocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Dieces" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDeBicho, poker:CincoDeRoca, poker:DiezDeTierra, poker:DiezDeElectrico ;
    poker:manoTienePar poker:Cinco, poker:Diez .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Onces" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeNormal, poker:DosDeBicho, poker:OnceDeVolador, poker:OnceDeTierra ;
    poker:manoTienePar poker:Dos, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treses con Siete de Psiquico" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDePlanta, poker:TresDeAgua, poker:TresDeRoca, poker:SieteDePsiquico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Seises con Once de Electrico" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:SeisDeElectrico, poker:SeisDeLucha, poker:SeisDeVolador, poker:OnceDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treces con Cuatro de Planta" ;
    poker:contieneCarta poker:TreceDePsiquico, poker:TreceDeVolador, poker:TreceDeRoca, poker:TreceDeVeneno, poker:CuatroDePlanta .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Trece de Volador" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDePsiquico, poker:CuatroDeFuego, poker:CuatroDeLucha, poker:TreceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Veneno" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:NueveDeVeneno, poker:DiezDeVeneno, poker:OnceDeVeneno, poker:DoceDeVeneno .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Agua" ;
    poker:contieneCarta poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Psiquico" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:CincoDePsiquico, poker:SeisDePsiquico, poker:SieteDePsiquico, poker:OchoDePsiquico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Volador" ;
    poker:contieneCarta poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador, poker:SeisDeVolador, poker:SieteDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:DiezDePsiquico, poker:OnceDePsiquico, poker:DoceDePsiquico, poker:TreceDePsiquico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Roca" ;
    poker:contieneCarta poker:NueveDeRoca, poker:DiezDeRoca, poker:OnceDeRoca, poker:DoceDeRoca, poker:TreceDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
