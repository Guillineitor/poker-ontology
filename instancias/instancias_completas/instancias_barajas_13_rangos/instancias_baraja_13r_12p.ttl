# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Diez Nueve Siete Cuatro" ;
    poker:contieneCarta poker:NueveDeBicho, poker:SieteDePlanta, poker:DoceDeAgua, poker:CuatroDePsiquico, poker:DiezDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Nueve Ocho Siete Tres" ;
    poker:contieneCarta poker:TresDeBicho, poker:OchoDeLucha, poker:NueveDePsiquico, poker:DiezDePlanta, poker:SieteDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Once Tres Dos" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:DosDeFuego, poker:OnceDeVeneno, poker:DoceDeTierra, poker:TresDeRoca .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Ocho Cinco Cuatro Dos" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:DosDeNormal, poker:OchoDeBicho, poker:DoceDePsiquico, poker:CincoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Ochos con Once Diez Tres" ;
    poker:contieneCarta poker:OchoDeNormal, poker:OchoDeElectrico, poker:DiezDeBicho, poker:OnceDePlanta, poker:TresDeLucha .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Unos con Doce Ocho Tres" ;
    poker:contieneCarta poker:UnoDeLucha, poker:UnoDePsiquico, poker:OchoDePsiquico, poker:TresDeAgua, poker:DoceDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Treces con Cinco Cuatro Uno" ;
    poker:contieneCarta poker:TreceDeAgua, poker:TreceDeVeneno, poker:CincoDeFuego, poker:CuatroDeLucha, poker:UnoDePsiquico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Ochos con Nueve Cuatro Uno" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDePsiquico, poker:CuatroDePsiquico, poker:UnoDePsiquico, poker:NueveDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Doses con Diez" ;
    poker:contieneCarta poker:SieteDeVolador, poker:SieteDePsiquico, poker:DosDeLucha, poker:DosDeTierra, poker:DiezDeAgua ;
    poker:manoTienePar poker:Siete, poker:Dos .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Cuatros con Trece" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:DiezDePlanta, poker:CuatroDeBicho, poker:CuatroDeVolador, poker:TreceDeVolador ;
    poker:manoTienePar poker:Diez, poker:Cuatro .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Seises con Trece" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDeAgua, poker:OnceDeVeneno, poker:OnceDeFuego, poker:TreceDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Once .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Treses con Trece" ;
    poker:contieneCarta poker:TresDePsiquico, poker:TresDeRoca, poker:SeisDeElectrico, poker:SeisDeBicho, poker:TreceDeFuego ;
    poker:manoTienePar poker:Tres, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Trece Nueve" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDeElectrico, poker:CuatroDePsiquico, poker:NueveDeLucha, poker:TreceDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Dieces con Trece Once" ;
    poker:contieneCarta poker:DiezDeRoca, poker:DiezDeVeneno, poker:DiezDeVolador, poker:OnceDeVolador, poker:TreceDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Treses con Doce Diez" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeTierra, poker:TresDeBicho, poker:DoceDeAgua, poker:DiezDeVeneno .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Dieces con Cinco Cuatro" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:DiezDeNormal, poker:DiezDeVolador, poker:CuatroDeTierra, poker:CincoDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeTierra, poker:OchoDeFuego, poker:NueveDeTierra, poker:DiezDeTierra, poker:OnceDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeElectrico, poker:OnceDeBicho, poker:DoceDeAgua, poker:TreceDeFuego .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:DiezDeNormal, poker:OnceDeVeneno, poker:DoceDeFuego, poker:TreceDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeLucha, poker:CuatroDeVeneno, poker:CincoDePsiquico, poker:SeisDeVeneno, poker:SieteDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Doce Diez Ocho Tres Dos de Electrico" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:DosDeElectrico, poker:TresDeElectrico, poker:DoceDeElectrico, poker:OchoDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Trece Once Ocho Cuatro Uno de Volador" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:OnceDeVolador, poker:TreceDeVolador, poker:UnoDeVolador, poker:OchoDeVolador .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Doce Once Cinco Tres Dos de Veneno" ;
    poker:contieneCarta poker:OnceDeVeneno, poker:DoceDeVeneno, poker:TresDeVeneno, poker:DosDeVeneno, poker:CincoDeVeneno .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Once Diez Nueve Siete Tres de Psiquico" ;
    poker:contieneCarta poker:TresDePsiquico, poker:DiezDePsiquico, poker:OnceDePsiquico, poker:SieteDePsiquico, poker:NueveDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Doces" ;
    poker:contieneCarta poker:SieteDeRoca, poker:SieteDeFuego, poker:SieteDeLucha, poker:DoceDePlanta, poker:DoceDeVeneno ;
    poker:manoTienePar poker:Siete, poker:Doce .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Cincos" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CuatroDeVolador, poker:CincoDeElectrico, poker:CincoDeTierra ;
    poker:manoTienePar poker:Cuatro, poker:Cinco .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Cincos" ;
    poker:contieneCarta poker:OnceDeFuego, poker:OnceDePlanta, poker:OnceDeAgua, poker:CincoDeVolador, poker:CincoDeBicho ;
    poker:manoTienePar poker:Once, poker:Cinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Onces" ;
    poker:contieneCarta poker:DiezDeRoca, poker:DiezDeAgua, poker:DiezDeVeneno, poker:OnceDeVeneno, poker:OnceDeNormal ;
    poker:manoTienePar poker:Diez, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Cinco de Lucha" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeTierra, poker:CuatroDeRoca, poker:CuatroDeElectrico, poker:CincoDeLucha .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treces con Nueve de Electrico" ;
    poker:contieneCarta poker:TreceDeRoca, poker:TreceDePlanta, poker:TreceDeTierra, poker:TreceDeFuego, poker:NueveDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Onces con Trece de Psiquico" ;
    poker:contieneCarta poker:OnceDeTierra, poker:OnceDeRoca, poker:OnceDePsiquico, poker:OnceDeVeneno, poker:TreceDePsiquico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treces con Ocho de Roca" ;
    poker:contieneCarta poker:TreceDePsiquico, poker:TreceDeElectrico, poker:TreceDeAgua, poker:TreceDeNormal, poker:OchoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Volador" ;
    poker:contieneCarta poker:DosDeVolador, poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador, poker:SeisDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Lucha" ;
    poker:contieneCarta poker:CuatroDeLucha, poker:CincoDeLucha, poker:SeisDeLucha, poker:SieteDeLucha, poker:OchoDeLucha .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:DiezDeVeneno, poker:OnceDeVeneno, poker:DoceDeVeneno, poker:TreceDeVeneno .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:DiezDePsiquico, poker:OnceDePsiquico, poker:DoceDePsiquico, poker:TreceDePsiquico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:NueveDeVolador, poker:DiezDeVolador, poker:OnceDeVolador, poker:DoceDeVolador, poker:TreceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
