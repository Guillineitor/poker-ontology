# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Catorce con Ocho Siete Seis Cinco" ;
    poker:contieneCarta poker:OchoDePlanta, poker:SeisDePlanta, poker:SieteDeElectrico, poker:CatorceDePlanta, poker:CincoDeFuego .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Ocho Seis Cinco Cuatro" ;
    poker:contieneCarta poker:CincoDeAgua, poker:SeisDeElectrico, poker:OchoDeFuego, poker:DoceDePlanta, poker:CuatroDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Trece Ocho Cinco Uno" ;
    poker:contieneCarta poker:CincoDeAgua, poker:DiecinueveDeElectrico, poker:TreceDePlanta, poker:OchoDeElectrico, poker:UnoDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Diez Ocho Cuatro Uno" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:OchoDeFuego, poker:DiezDeAgua, poker:CuatroDePlanta, poker:UnoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Dieciochos con Catorce Nueve Ocho" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DieciochoDeAgua, poker:CatorceDeFuego, poker:OchoDeFuego, poker:NueveDePlanta .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cuatros con Quince Siete Cinco" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:QuinceDeElectrico, poker:CincoDePlanta, poker:SieteDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Treces con Diecinueve Cuatro Tres" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDePlanta, poker:TresDeAgua, poker:DiecinueveDePlanta, poker:CuatroDeElectrico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Dieces con Seis Cinco Tres" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeFuego, poker:SeisDeFuego, poker:TresDeAgua, poker:CincoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Dieciseises con Doce" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DieciochoDeFuego, poker:DieciseisDeAgua, poker:DieciseisDeElectrico, poker:DoceDeAgua ;
    poker:manoTienePar poker:Dieciocho, poker:Dieciseis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Doses con Catorce" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeAgua, poker:DiecisieteDeElectrico, poker:DiecisieteDeAgua, poker:CatorceDeElectrico ;
    poker:manoTienePar poker:Dos, poker:Diecisiete .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Cuatros con Siete" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeAgua, poker:DoceDeElectrico, poker:DoceDeFuego, poker:SieteDeAgua ;
    poker:manoTienePar poker:Cuatro, poker:Doce .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Cincos con Diecinueve" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:QuinceDeFuego, poker:QuinceDeAgua, poker:DiecinueveDePlanta ;
    poker:manoTienePar poker:Cinco, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Quinces con Diecisiete Ocho" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:QuinceDeAgua, poker:QuinceDeElectrico, poker:DiecisieteDePlanta, poker:OchoDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Ochos con Trece Cinco" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeAgua, poker:OchoDeFuego, poker:TreceDeFuego, poker:CincoDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Catorces con Cinco Tres" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDeElectrico, poker:CatorceDePlanta, poker:TresDeElectrico, poker:CincoDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Catorces con Dieciocho Cuatro" ;
    poker:contieneCarta poker:CatorceDeFuego, poker:CatorceDeElectrico, poker:CatorceDePlanta, poker:DieciochoDeElectrico, poker:CuatroDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDeAgua, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeElectrico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Trece-Catorce-Quince-Dieciseis-Diecisiete" ;
    poker:contieneCarta poker:TreceDePlanta, poker:CatorceDeFuego, poker:QuinceDePlanta, poker:DieciseisDeElectrico, poker:DiecisieteDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciocho Quince Trece Uno de Fuego" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:UnoDeFuego, poker:DiecinueveDeFuego, poker:QuinceDeFuego, poker:TreceDeFuego .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Quince Catorce Once Cinco Tres de Planta" ;
    poker:contieneCarta poker:TresDePlanta, poker:CincoDePlanta, poker:OnceDePlanta, poker:QuinceDePlanta, poker:CatorceDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecisiete Quince Seis Cuatro Uno de Electrico" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:DiecisieteDeElectrico, poker:CuatroDeElectrico, poker:UnoDeElectrico, poker:QuinceDeElectrico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Diecisiete Dieciseis Cinco Tres Uno de Agua" ;
    poker:contieneCarta poker:TresDeAgua, poker:UnoDeAgua, poker:DiecisieteDeAgua, poker:DieciseisDeAgua, poker:CincoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Dieces" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDeFuego, poker:TreceDePlanta, poker:DiezDeFuego, poker:DiezDePlanta ;
    poker:manoTienePar poker:Trece, poker:Diez .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Diecinueves" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:DiecinueveDeElectrico, poker:DiecinueveDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Diecinueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Diecisietes" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDePlanta, poker:SeisDeFuego, poker:DiecisieteDeElectrico, poker:DiecisieteDeAgua ;
    poker:manoTienePar poker:Seis, poker:Diecisiete .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Diecinueves con Par de Ochos" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:DiecinueveDeFuego, poker:DiecinueveDeElectrico, poker:OchoDeFuego, poker:OchoDePlanta ;
    poker:manoTienePar poker:Diecinueve, poker:Ocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Dos de Agua" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDePlanta, poker:CincoDeAgua, poker:CincoDeFuego, poker:DosDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treses con Dieciseis de Planta" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDePlanta, poker:TresDeAgua, poker:TresDeFuego, poker:DieciseisDePlanta .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Doces con Trece de Agua" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeFuego, poker:DoceDeElectrico, poker:DoceDePlanta, poker:TreceDeAgua .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Catorces con Cuatro de Fuego" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:CatorceDeAgua, poker:CatorceDeFuego, poker:CatorceDeElectrico, poker:CuatroDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Agua" ;
    poker:contieneCarta poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Agua" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Fuego" ;
    poker:contieneCarta poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeFuego, poker:DieciochoDeFuego, poker:DiecinueveDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
