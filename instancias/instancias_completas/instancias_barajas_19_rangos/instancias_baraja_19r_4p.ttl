# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Diecisiete Trece Doce Nueve" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiecisieteDePlanta, poker:TreceDeFuego, poker:DieciochoDeFuego, poker:DoceDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Catorce Ocho Cinco Dos" ;
    poker:contieneCarta poker:CincoDePlanta, poker:DosDeFuego, poker:CatorceDeElectrico, poker:OchoDePlanta, poker:DiecisieteDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Catorce Seis Cuatro Uno" ;
    poker:contieneCarta poker:SeisDeFuego, poker:DiecinueveDeFuego, poker:CatorceDePlanta, poker:UnoDePlanta, poker:CuatroDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciseis Catorce Trece Cinco" ;
    poker:contieneCarta poker:CincoDePlanta, poker:DieciseisDeFuego, poker:TreceDeFuego, poker:CatorceDePlanta, poker:DiecinueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Seises con Diecisiete Ocho Dos" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDePlanta, poker:DiecisieteDePlanta, poker:DosDeElectrico, poker:OchoDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieces con Diecisiete Doce Uno" ;
    poker:contieneCarta poker:DiezDeFuego, poker:DiezDeAgua, poker:DiecisieteDePlanta, poker:UnoDePlanta, poker:DoceDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Catorces con Diecinueve Dieciocho Doce" ;
    poker:contieneCarta poker:CatorceDeFuego, poker:CatorceDeAgua, poker:DieciochoDeElectrico, poker:DoceDePlanta, poker:DiecinueveDeElectrico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Doces con Trece Siete Tres" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeAgua, poker:SieteDeFuego, poker:TreceDeElectrico, poker:TresDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Sietes con Trece" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDeAgua, poker:DiecinueveDePlanta, poker:DiecinueveDeElectrico, poker:TreceDeElectrico ;
    poker:manoTienePar poker:Siete, poker:Diecinueve .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Doses con Doce" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeFuego, poker:DosDeFuego, poker:DosDeAgua, poker:DoceDeAgua ;
    poker:manoTienePar poker:Once, poker:Dos .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Seises con Dieciseis" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:SieteDeFuego, poker:SeisDePlanta, poker:SeisDeAgua, poker:DieciseisDeAgua ;
    poker:manoTienePar poker:Siete, poker:Seis .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Sietes con Diecinueve" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDePlanta, poker:OchoDeAgua, poker:OchoDePlanta, poker:DiecinueveDeAgua ;
    poker:manoTienePar poker:Siete, poker:Ocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Catorces con Seis Cuatro" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDeElectrico, poker:CatorceDeFuego, poker:SeisDeFuego, poker:CuatroDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Catorce Trece" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDePlanta, poker:DoceDeElectrico, poker:CatorceDeElectrico, poker:TreceDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Diecinueves con Nueve Seis" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:DiecinueveDeElectrico, poker:DiecinueveDeAgua, poker:NueveDeElectrico, poker:SeisDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Unos con Siete Tres" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeElectrico, poker:UnoDePlanta, poker:TresDeAgua, poker:SieteDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDePlanta, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDePlanta, poker:OchoDePlanta, poker:NueveDeElectrico, poker:DiezDePlanta, poker:OnceDeFuego .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeFuego, poker:DiecisieteDeAgua, poker:DieciochoDeFuego, poker:DiecinueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Dieciocho Quince Once Siete Dos de Eléctrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciochoDeElectrico, poker:OnceDeElectrico, poker:SieteDeElectrico, poker:DosDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Quince Trece Siete Cinco Dos de Eléctrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:TreceDeElectrico, poker:CincoDeElectrico, poker:DosDeElectrico, poker:SieteDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Dieciocho Diecisiete Catorce Trece Seis de Planta" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:TreceDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:SeisDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Dieciocho Quince Once Nueve Cinco de Eléctrico" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:DieciochoDeElectrico, poker:NueveDeElectrico, poker:CincoDeElectrico, poker:QuinceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciochos con Par de Unos" ;
    poker:contieneCarta poker:DieciochoDeElectrico, poker:DieciochoDeFuego, poker:DieciochoDePlanta, poker:UnoDeAgua, poker:UnoDeFuego ;
    poker:manoTienePar poker:Dieciocho, poker:Uno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Diecinueves" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeElectrico, poker:TreceDeFuego, poker:DiecinueveDeFuego, poker:DiecinueveDePlanta ;
    poker:manoTienePar poker:Trece, poker:Diecinueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciochos con Par de Dieciseises" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DieciochoDeFuego, poker:DieciochoDeElectrico, poker:DieciseisDeAgua, poker:DieciseisDePlanta ;
    poker:manoTienePar poker:Dieciocho, poker:Dieciseis .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciochos con Par de Cincos" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:DieciochoDeAgua, poker:DieciochoDeElectrico, poker:CincoDeAgua, poker:CincoDeFuego ;
    poker:manoTienePar poker:Dieciocho, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Nueves con Tres de Planta" ;
    poker:contieneCarta poker:NueveDeFuego, poker:NueveDeAgua, poker:NueveDePlanta, poker:NueveDeElectrico, poker:TresDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cincos con Ocho de Fuego" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeFuego, poker:CincoDeAgua, poker:CincoDeElectrico, poker:OchoDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Cinco de Fuego" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDePlanta, poker:TresDeElectrico, poker:TresDeFuego, poker:CincoDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Quinces con Uno de Planta" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:QuinceDeFuego, poker:QuinceDeAgua, poker:QuinceDePlanta, poker:UnoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Eléctrico" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico, poker:DiezDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Agua" ;
    poker:contieneCarta poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Fuego" ;
    poker:contieneCarta poker:DoceDeFuego, poker:TreceDeFuego, poker:CatorceDeFuego, poker:QuinceDeFuego, poker:DieciseisDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Nueve-Diez-Once-Doce-Trece de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeFuego, poker:DieciochoDeFuego, poker:DiecinueveDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
