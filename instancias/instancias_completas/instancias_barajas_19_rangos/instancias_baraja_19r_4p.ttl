# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Quince con Once Diez Nueve Dos" ;
    poker:contieneCarta poker:OnceDeAgua, poker:NueveDePlanta, poker:DiezDeElectrico, poker:QuinceDeAgua, poker:DosDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Diecisiete Nueve Ocho Cinco" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:DiecisieteDePlanta, poker:CincoDeFuego, poker:OchoDePlanta, poker:NueveDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciseis Quince Trece Nueve" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:NueveDePlanta, poker:TreceDePlanta, poker:DiecinueveDeElectrico, poker:DieciseisDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Ocho Siete Seis Uno" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:OchoDeFuego, poker:SeisDePlanta, poker:SieteDePlanta, poker:UnoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doces con Diecisiete Siete Seis" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeElectrico, poker:SeisDePlanta, poker:SieteDePlanta, poker:DiecisieteDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Seises con Once Ocho Cinco" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDeAgua, poker:OchoDeFuego, poker:CincoDePlanta, poker:OnceDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Diecinueves con Dieciocho Diecisiete Siete" ;
    poker:contieneCarta poker:DiecinueveDeAgua, poker:DiecinueveDeFuego, poker:DiecisieteDeFuego, poker:SieteDeAgua, poker:DieciochoDeAgua .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Nueves con Catorce Trece Once" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeElectrico, poker:TreceDeFuego, poker:OnceDeFuego, poker:CatorceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Dieciseises con Dieciocho" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DieciseisDeAgua, poker:DiecinueveDeFuego, poker:DiecinueveDeAgua, poker:DieciochoDeElectrico ;
    poker:manoTienePar poker:Dieciseis, poker:Diecinueve .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Treces con Catorce" ;
    poker:contieneCarta poker:TreceDeAgua, poker:TreceDePlanta, poker:QuinceDePlanta, poker:QuinceDeAgua, poker:CatorceDeFuego ;
    poker:manoTienePar poker:Trece, poker:Quince .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Cincos con Quince" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:DiecinueveDeFuego, poker:DiecinueveDeElectrico, poker:QuinceDeElectrico ;
    poker:manoTienePar poker:Cinco, poker:Diecinueve .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Onces con Diez" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DieciseisDeAgua, poker:OnceDeAgua, poker:OnceDeElectrico, poker:DiezDeFuego ;
    poker:manoTienePar poker:Dieciseis, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Dieciseis Diez" ;
    poker:contieneCarta poker:DieciochoDeElectrico, poker:DieciochoDeFuego, poker:DieciochoDeAgua, poker:DieciseisDePlanta, poker:DiezDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Seises con Once Uno" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:SeisDeElectrico, poker:UnoDeElectrico, poker:OnceDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doces con Diecinueve Dieciseis" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeElectrico, poker:DoceDeAgua, poker:DieciseisDeFuego, poker:DiecinueveDePlanta .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Sietes con Tres Uno" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDePlanta, poker:SieteDeElectrico, poker:UnoDeAgua, poker:TresDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeFuego, poker:CuatroDeAgua, poker:CincoDePlanta, poker:SeisDeElectrico, poker:SieteDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDeElectrico, poker:DiecisieteDeFuego, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeAgua, poker:CuatroDeElectrico, poker:CincoDeFuego, poker:SeisDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDePlanta, poker:CatorceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Dieciseis Catorce Nueve Siete Cinco de Fuego" ;
    poker:contieneCarta poker:CatorceDeFuego, poker:NueveDeFuego, poker:CincoDeFuego, poker:SieteDeFuego, poker:DieciseisDeFuego .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Diecisiete Catorce Doce Once Diez de Planta" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DiecisieteDePlanta, poker:DoceDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecinueve Doce Nueve Dos Uno de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:NueveDeAgua, poker:DoceDeAgua, poker:UnoDeAgua, poker:DiecinueveDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Dieciocho Catorce Doce Diez Seis de Electrico" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:DoceDeElectrico, poker:CatorceDeElectrico, poker:DiezDeElectrico, poker:DieciochoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Treces" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDePlanta, poker:CatorceDeElectrico, poker:TreceDeElectrico, poker:TreceDePlanta ;
    poker:manoTienePar poker:Catorce, poker:Trece .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Dieciochos" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeFuego, poker:DoceDePlanta, poker:DieciochoDeElectrico, poker:DieciochoDeFuego ;
    poker:manoTienePar poker:Doce, poker:Dieciocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Dieciochos" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeElectrico, poker:SeisDePlanta, poker:DieciochoDeFuego, poker:DieciochoDeAgua ;
    poker:manoTienePar poker:Seis, poker:Dieciocho .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Sietes" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDePlanta, poker:UnoDeFuego, poker:SieteDeElectrico, poker:SieteDeAgua ;
    poker:manoTienePar poker:Uno, poker:Siete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Sietes con Dieciseis de Agua" ;
    poker:contieneCarta poker:SieteDePlanta, poker:SieteDeElectrico, poker:SieteDeFuego, poker:SieteDeAgua, poker:DieciseisDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Doses con Cuatro de Planta" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeElectrico, poker:DosDePlanta, poker:DosDeAgua, poker:CuatroDePlanta .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Seis de Fuego" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:CuatroDeFuego, poker:SeisDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treses con Doce de Planta" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDePlanta, poker:TresDeElectrico, poker:TresDeAgua, poker:DoceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Electrico" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:TreceDeElectrico, poker:CatorceDeElectrico, poker:QuinceDeElectrico, poker:DieciseisDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Catorce-Quince-Dieciseis-Diecisiete-Dieciocho de Planta" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Electrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Planta" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SieteDePlanta, poker:OchoDePlanta, poker:NueveDePlanta, poker:DiezDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeFuego, poker:DieciochoDeFuego, poker:DiecinueveDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
