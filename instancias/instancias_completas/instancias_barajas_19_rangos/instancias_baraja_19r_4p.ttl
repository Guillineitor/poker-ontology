# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciocho Trece Cinco Tres" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:TresDePlanta, poker:TreceDeAgua, poker:DieciochoDeAgua, poker:CincoDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Diez Cuatro Tres Uno" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:UnoDeFuego, poker:CuatroDeFuego, poker:DiezDePlanta, poker:TresDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Diez Cinco Cuatro Tres" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:CuatroDeAgua, poker:DiezDeFuego, poker:TresDePlanta, poker:CincoDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Dieciseis Once Diez Seis" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:OnceDeFuego, poker:DiezDeElectrico, poker:DieciochoDeElectrico, poker:SeisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treses con Quince Trece Nueve" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeAgua, poker:QuinceDeAgua, poker:TreceDeAgua, poker:NueveDeElectrico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Diecinueve Catorce Diez" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DieciseisDeFuego, poker:CatorceDeElectrico, poker:DiecinueveDeFuego, poker:DiezDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doces con Nueve Seis Cinco" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeFuego, poker:NueveDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Sietes con Diecinueve Diecisiete Uno" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDePlanta, poker:DiecinueveDeAgua, poker:UnoDeElectrico, poker:DiecisieteDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Dieciochos con Nueve" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:DieciochoDeAgua, poker:DiecinueveDeFuego, poker:DiecinueveDePlanta, poker:NueveDeAgua ;
    poker:manoTienePar poker:Dieciocho, poker:Diecinueve .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Treces con Quince" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeFuego, poker:DiecisieteDeAgua, poker:DiecisieteDeElectrico, poker:QuinceDePlanta ;
    poker:manoTienePar poker:Trece, poker:Diecisiete .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Cuatros con Dieciocho" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDeElectrico, poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:DieciochoDePlanta ;
    poker:manoTienePar poker:Diez, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Seises con Diecisiete" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeElectrico, poker:NueveDeElectrico, poker:NueveDePlanta, poker:DiecisieteDeAgua ;
    poker:manoTienePar poker:Seis, poker:Nueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cincos con Seis Tres" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDePlanta, poker:CincoDeElectrico, poker:TresDeFuego, poker:SeisDeElectrico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Catorce Trece" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:DieciochoDeAgua, poker:DieciochoDePlanta, poker:TreceDeElectrico, poker:CatorceDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doses con Dieciseis Trece" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeAgua, poker:DosDeElectrico, poker:TreceDeFuego, poker:DieciseisDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Doces con Quince Seis" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeAgua, poker:DoceDePlanta, poker:SeisDeAgua, poker:QuinceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDePlanta, poker:DiezDeFuego .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDeFuego, poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeElectrico, poker:DieciochoDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:TreceDeFuego, poker:CatorceDePlanta, poker:QuinceDeElectrico, poker:DieciseisDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeElectrico, poker:OnceDeAgua, poker:DoceDeFuego, poker:TreceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diecinueve Catorce Siete Cuatro Uno de Electrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:CuatroDeElectrico, poker:CatorceDeElectrico, poker:SieteDeElectrico, poker:DiecinueveDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciocho Quince Once Cinco Dos de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:OnceDeAgua, poker:DosDeAgua, poker:QuinceDeAgua, poker:DieciochoDeAgua .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Quince Catorce Doce Ocho Cinco de Fuego" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:OchoDeFuego, poker:CatorceDeFuego, poker:DoceDeFuego, poker:CincoDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Quince Doce Siete Cuatro Uno de Agua" ;
    poker:contieneCarta poker:UnoDeAgua, poker:CuatroDeAgua, poker:DoceDeAgua, poker:SieteDeAgua, poker:QuinceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Treces" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeFuego, poker:SeisDeElectrico, poker:TreceDePlanta, poker:TreceDeFuego ;
    poker:manoTienePar poker:Seis, poker:Trece .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Sietes" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DiecisieteDeElectrico, poker:DiecisieteDeAgua, poker:SieteDePlanta, poker:SieteDeFuego ;
    poker:manoTienePar poker:Diecisiete, poker:Siete .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Ochos" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDeFuego, poker:CuatroDeAgua, poker:OchoDePlanta, poker:OchoDeFuego ;
    poker:manoTienePar poker:Cuatro, poker:Ocho .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Dieciochos" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:DieciochoDePlanta, poker:DieciochoDeFuego ;
    poker:manoTienePar poker:Cuatro, poker:Dieciocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Siete de Fuego" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeAgua, poker:CincoDeElectrico, poker:CincoDePlanta, poker:SieteDeFuego .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Sietes con Trece de Electrico" ;
    poker:contieneCarta poker:SieteDeAgua, poker:SieteDeElectrico, poker:SieteDeFuego, poker:SieteDePlanta, poker:TreceDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Diez de Electrico" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DiecisieteDeAgua, poker:DiecisieteDeElectrico, poker:DiecisieteDeFuego, poker:DiezDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Seises con Cuatro de Electrico" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeAgua, poker:SeisDeElectrico, poker:SeisDeFuego, poker:CuatroDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Planta" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SieteDePlanta, poker:OchoDePlanta, poker:NueveDePlanta, poker:DiezDePlanta .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Nueve-Diez-Once-Doce-Trece de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Fuego" ;
    poker:contieneCarta poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Fuego" ;
    poker:contieneCarta poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeFuego, poker:DieciochoDeFuego, poker:DiecinueveDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
