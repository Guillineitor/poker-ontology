# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciocho Dieciseis Once Dos" ;
    poker:contieneCarta poker:DieciseisDeRoca, poker:OnceDeTierra, poker:DieciochoDeFantasma, poker:DosDePsiquico, poker:DiecinueveDeVeneno .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Catorce Cuatro Dos Uno" ;
    poker:contieneCarta poker:DieciochoDeLucha, poker:CuatroDeVolador, poker:CatorceDeDragon, poker:DosDeBicho, poker:UnoDeRoca .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Quince Trece Tres Uno" ;
    poker:contieneCarta poker:TresDeLucha, poker:QuinceDeFantasma, poker:TreceDeTierra, poker:DiecinueveDeVeneno, poker:UnoDeLucha .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Dieciseis Doce Nueve Uno" ;
    poker:contieneCarta poker:UnoDeTierra, poker:NueveDePsiquico, poker:DoceDeTierra, poker:DieciseisDeDragon, poker:DiecisieteDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cuatros con Dieciseis Trece Tres" ;
    poker:contieneCarta poker:CuatroDeDragon, poker:CuatroDeLucha, poker:TreceDePlanta, poker:TresDeNormal, poker:DieciseisDeBicho .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Once Seis Uno" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeTierra, poker:SeisDeVolador, poker:OnceDePsiquico, poker:UnoDeTierra .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Dieciochos con Dieciseis Quince Cinco" ;
    poker:contieneCarta poker:DieciochoDePsiquico, poker:DieciochoDePlanta, poker:QuinceDeElectrico, poker:CincoDePsiquico, poker:DieciseisDeVeneno .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cincos con Quince Doce Ocho" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeBicho, poker:QuinceDeNormal, poker:OchoDeDragon, poker:DoceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Unos con Doce" ;
    poker:contieneCarta poker:DiecinueveDeVeneno, poker:DiecinueveDeFuego, poker:UnoDeVeneno, poker:UnoDeNormal, poker:DoceDeLucha ;
    poker:manoTienePar poker:Diecinueve, poker:Uno .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Treses con Quince" ;
    poker:contieneCarta poker:TresDeTierra, poker:TresDeBicho, poker:OchoDeHielo, poker:OchoDeVolador, poker:QuinceDeElectrico ;
    poker:manoTienePar poker:Tres, poker:Ocho .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Catorces con Diecisiete" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:QuinceDeNormal, poker:CatorceDeLucha, poker:CatorceDeDragon, poker:DiecisieteDeLucha ;
    poker:manoTienePar poker:Quince, poker:Catorce .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Doses con Dieciseis" ;
    poker:contieneCarta poker:DiezDeRoca, poker:DiezDeElectrico, poker:DosDeDragon, poker:DosDeVolador, poker:DieciseisDeSiniestro ;
    poker:manoTienePar poker:Diez, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Doce Ocho" ;
    poker:contieneCarta poker:CuatroDePsiquico, poker:CuatroDeVeneno, poker:CuatroDeVolador, poker:OchoDeSiniestro, poker:DoceDeVeneno .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Cincos con Doce Siete" ;
    poker:contieneCarta poker:CincoDePsiquico, poker:CincoDeHielo, poker:CincoDeLucha, poker:DoceDeVolador, poker:SieteDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Catorce Dos" ;
    poker:contieneCarta poker:CuatroDeRoca, poker:CuatroDeFantasma, poker:CuatroDeFuego, poker:DosDeRoca, poker:CatorceDePsiquico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Dieciseises con Seis Cinco" ;
    poker:contieneCarta poker:DieciseisDeTierra, poker:DieciseisDeVeneno, poker:DieciseisDeRoca, poker:SeisDeHielo, poker:CincoDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeTierra, poker:CincoDeTierra, poker:SeisDeHielo, poker:SieteDeRoca, poker:OchoDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeFantasma, poker:OnceDeVolador, poker:DoceDeTierra, poker:TreceDeHielo, poker:CatorceDeBicho .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeLucha, poker:CuatroDeFantasma, poker:CincoDeElectrico, poker:SeisDeVeneno, poker:SieteDePsiquico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeBicho, poker:SeisDeVolador, poker:SieteDeAgua, poker:OchoDeNormal, poker:NueveDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciocho Diecisiete Diez Tres de Eléctrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:DiezDeElectrico, poker:DiecinueveDeElectrico, poker:DieciochoDeElectrico, poker:DiecisieteDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Diecisiete Dieciseis Once Seis Uno de Tierra" ;
    poker:contieneCarta poker:DiecisieteDeTierra, poker:UnoDeTierra, poker:SeisDeTierra, poker:OnceDeTierra, poker:DieciseisDeTierra .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Catorce Trece Diez Nueve Dos de Agua" ;
    poker:contieneCarta poker:DiezDeAgua, poker:CatorceDeAgua, poker:DosDeAgua, poker:TreceDeAgua, poker:NueveDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Diecisiete Quince Nueve Seis Cinco de Roca" ;
    poker:contieneCarta poker:NueveDeRoca, poker:CincoDeRoca, poker:QuinceDeRoca, poker:DiecisieteDeRoca, poker:SeisDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Dieciseises" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeHielo, poker:NueveDePsiquico, poker:DieciseisDeTierra, poker:DieciseisDePsiquico ;
    poker:manoTienePar poker:Nueve, poker:Dieciseis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Dieciochos" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:NueveDeDragon, poker:NueveDeHielo, poker:DieciochoDeHielo, poker:DieciochoDeDragon ;
    poker:manoTienePar poker:Nueve, poker:Dieciocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Ochos" ;
    poker:contieneCarta poker:CatorceDePsiquico, poker:CatorceDeLucha, poker:CatorceDeNormal, poker:OchoDePsiquico, poker:OchoDeSiniestro ;
    poker:manoTienePar poker:Catorce, poker:Ocho .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Ochos" ;
    poker:contieneCarta poker:UnoDeTierra, poker:UnoDeVolador, poker:UnoDeFantasma, poker:OchoDeDragon, poker:OchoDeTierra ;
    poker:manoTienePar poker:Uno, poker:Ocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Diecinueves con Diez de Siniestro" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:DiecinueveDeTierra, poker:DiecinueveDeAgua, poker:DiecinueveDeNormal, poker:DiezDeSiniestro .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Dieciseises con Trece de Tierra" ;
    poker:contieneCarta poker:DieciseisDeRoca, poker:DieciseisDeTierra, poker:DieciseisDeDragon, poker:DieciseisDeSiniestro, poker:TreceDeTierra .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cincos con Diecinueve de Bicho" ;
    poker:contieneCarta poker:CincoDeRoca, poker:CincoDeElectrico, poker:CincoDeTierra, poker:CincoDeVeneno, poker:DiecinueveDeBicho .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Sietes con Doce de Hielo" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:SieteDeFuego, poker:SieteDePsiquico, poker:SieteDePlanta, poker:DoceDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Normal" ;
    poker:contieneCarta poker:DoceDeNormal, poker:TreceDeNormal, poker:CatorceDeNormal, poker:QuinceDeNormal, poker:DieciseisDeNormal .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Eléctrico" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico, poker:CatorceDeElectrico .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Fantasma" ;
    poker:contieneCarta poker:DoceDeFantasma, poker:TreceDeFantasma, poker:CatorceDeFantasma, poker:QuinceDeFantasma, poker:DieciseisDeFantasma .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Tierra" ;
    poker:contieneCarta poker:DoceDeTierra, poker:TreceDeTierra, poker:CatorceDeTierra, poker:QuinceDeTierra, poker:DieciseisDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:QuinceDeVolador, poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fantasma" ;
    poker:contieneCarta poker:QuinceDeFantasma, poker:DieciseisDeFantasma, poker:DiecisieteDeFantasma, poker:DieciochoDeFantasma, poker:DiecinueveDeFantasma .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Siniestro" ;
    poker:contieneCarta poker:QuinceDeSiniestro, poker:DieciseisDeSiniestro, poker:DiecisieteDeSiniestro, poker:DieciochoDeSiniestro, poker:DiecinueveDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
