# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Catorce Seis Tres Uno" ;
    poker:contieneCarta poker:SeisDeSiniestro, poker:UnoDeSiniestro, poker:DiecisieteDePlanta, poker:TresDeTierra, poker:CatorceDeLucha .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Nueve Ocho Tres Dos" ;
    poker:contieneCarta poker:OchoDeBicho, poker:NueveDeElectrico, poker:DosDeFantasma, poker:TresDeDragon, poker:OnceDeFantasma .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Doce Nueve Ocho Cuatro" ;
    poker:contieneCarta poker:OchoDeLucha, poker:NueveDeElectrico, poker:DoceDePlanta, poker:DieciseisDeBicho, poker:CuatroDeSiniestro .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Diez Siete Seis Cuatro" ;
    poker:contieneCarta poker:SieteDePlanta, poker:CuatroDeVeneno, poker:DiecinueveDeElectrico, poker:DiezDeVolador, poker:SeisDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Dieciocho Diez Tres" ;
    poker:contieneCarta poker:DosDeFantasma, poker:DosDeLucha, poker:TresDeTierra, poker:DiezDeFantasma, poker:DieciochoDeLucha .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Seises con Quince Nueve Ocho" ;
    poker:contieneCarta poker:SeisDeDragon, poker:SeisDeHielo, poker:NueveDePsiquico, poker:OchoDeHielo, poker:QuinceDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doces con Catorce Ocho Uno" ;
    poker:contieneCarta poker:DoceDeTierra, poker:DoceDeFantasma, poker:CatorceDeNormal, poker:OchoDeVolador, poker:UnoDeNormal .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Quinces con Diecisiete Siete Tres" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:QuinceDePsiquico, poker:TresDeRoca, poker:SieteDeTierra, poker:DiecisieteDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Seises con Nueve" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDeAgua, poker:DieciochoDeFantasma, poker:DieciochoDeNormal, poker:NueveDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Dieciocho .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Treses con Cinco" ;
    poker:contieneCarta poker:OnceDeTierra, poker:OnceDeAgua, poker:TresDePlanta, poker:TresDeSiniestro, poker:CincoDeNormal ;
    poker:manoTienePar poker:Once, poker:Tres .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Catorces y Sietes con Cinco" ;
    poker:contieneCarta poker:SieteDeSiniestro, poker:SieteDeHielo, poker:CatorceDeVolador, poker:CatorceDeElectrico, poker:CincoDeFuego ;
    poker:manoTienePar poker:Siete, poker:Catorce .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Ochos con Cuatro" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeDragon, poker:DieciseisDeBicho, poker:DieciseisDeVolador, poker:CuatroDeRoca ;
    poker:manoTienePar poker:Ocho, poker:Dieciseis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Quinces con Dieciseis Cuatro" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:QuinceDeRoca, poker:QuinceDeFantasma, poker:CuatroDeTierra, poker:DieciseisDeVeneno .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Catorces con Dieciocho Diecisiete" ;
    poker:contieneCarta poker:CatorceDeVeneno, poker:CatorceDeTierra, poker:CatorceDeFantasma, poker:DieciochoDeNormal, poker:DiecisieteDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Cinco Tres" ;
    poker:contieneCarta poker:DieciochoDeSiniestro, poker:DieciochoDeDragon, poker:DieciochoDeHielo, poker:TresDePsiquico, poker:CincoDeVeneno .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Treses con Dieciseis Doce" ;
    poker:contieneCarta poker:TresDeSiniestro, poker:TresDeTierra, poker:TresDeDragon, poker:DoceDeElectrico, poker:DieciseisDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDePsiquico, poker:DiecisieteDeVeneno, poker:DieciochoDeHielo .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeFantasma, poker:OnceDeSiniestro, poker:DoceDeLucha, poker:TreceDeVeneno, poker:CatorceDeVeneno .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeTierra, poker:DiezDeVolador, poker:OnceDeAgua, poker:DoceDeSiniestro, poker:TreceDeBicho .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CincoDeVeneno, poker:SeisDeVeneno, poker:SieteDePlanta, poker:OchoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Dieciocho Diecisiete Catorce Once Ocho de Agua" ;
    poker:contieneCarta poker:OnceDeAgua, poker:CatorceDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:OchoDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Doce Nueve Ocho Seis Uno de Lucha" ;
    poker:contieneCarta poker:UnoDeLucha, poker:DoceDeLucha, poker:NueveDeLucha, poker:OchoDeLucha, poker:SeisDeLucha .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciseis Quince Nueve Cuatro de Volador" ;
    poker:contieneCarta poker:NueveDeVolador, poker:QuinceDeVolador, poker:DieciseisDeVolador, poker:DiecinueveDeVolador, poker:CuatroDeVolador .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Dieciocho Dieciseis Catorce Diez Uno de Roca" ;
    poker:contieneCarta poker:DiezDeRoca, poker:DieciochoDeRoca, poker:DieciseisDeRoca, poker:CatorceDeRoca, poker:UnoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Doces" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:SeisDeLucha, poker:SeisDeHielo, poker:DoceDeHielo, poker:DoceDeAgua ;
    poker:manoTienePar poker:Seis, poker:Doce .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Treses" ;
    poker:contieneCarta poker:DoceDeRoca, poker:DoceDeFuego, poker:DoceDeDragon, poker:TresDeVolador, poker:TresDeHielo ;
    poker:manoTienePar poker:Doce, poker:Tres .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Diecinueves" ;
    poker:contieneCarta poker:SieteDeTierra, poker:SieteDeLucha, poker:SieteDePlanta, poker:DiecinueveDeFuego, poker:DiecinueveDeVeneno ;
    poker:manoTienePar poker:Siete, poker:Diecinueve .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Nueves" ;
    poker:contieneCarta poker:TreceDeTierra, poker:TreceDeAgua, poker:TreceDeRoca, poker:NueveDeRoca, poker:NueveDeDragon ;
    poker:manoTienePar poker:Trece, poker:Nueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treces con Cuatro de Lucha" ;
    poker:contieneCarta poker:TreceDeNormal, poker:TreceDeFantasma, poker:TreceDeHielo, poker:TreceDeLucha, poker:CuatroDeLucha .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Catorces con Diez de Planta" ;
    poker:contieneCarta poker:CatorceDeFantasma, poker:CatorceDeLucha, poker:CatorceDeElectrico, poker:CatorceDeBicho, poker:DiezDePlanta .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Ocho de Electrico" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDePlanta, poker:TresDeElectrico, poker:TresDePsiquico, poker:OchoDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Diecinueves con Catorce de Veneno" ;
    poker:contieneCarta poker:DiecinueveDeLucha, poker:DiecinueveDeTierra, poker:DiecinueveDeHielo, poker:DiecinueveDeVeneno, poker:CatorceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Lucha" ;
    poker:contieneCarta poker:SeisDeLucha, poker:SieteDeLucha, poker:OchoDeLucha, poker:NueveDeLucha, poker:DiezDeLucha .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Dragon" ;
    poker:contieneCarta poker:DosDeDragon, poker:TresDeDragon, poker:CuatroDeDragon, poker:CincoDeDragon, poker:SeisDeDragon .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Trece-Catorce-Quince-Dieciseis-Diecisiete de Volador" ;
    poker:contieneCarta poker:TreceDeVolador, poker:CatorceDeVolador, poker:QuinceDeVolador, poker:DieciseisDeVolador, poker:DiecisieteDeVolador .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Nueve-Diez-Once-Doce-Trece de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:QuinceDeTierra, poker:DieciseisDeTierra, poker:DiecisieteDeTierra, poker:DieciochoDeTierra, poker:DiecinueveDeTierra .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Siniestro" ;
    poker:contieneCarta poker:QuinceDeSiniestro, poker:DieciseisDeSiniestro, poker:DiecisieteDeSiniestro, poker:DieciochoDeSiniestro, poker:DiecinueveDeSiniestro .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Fantasma" ;
    poker:contieneCarta poker:QuinceDeFantasma, poker:DieciseisDeFantasma, poker:DiecisieteDeFantasma, poker:DieciochoDeFantasma, poker:DiecinueveDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
