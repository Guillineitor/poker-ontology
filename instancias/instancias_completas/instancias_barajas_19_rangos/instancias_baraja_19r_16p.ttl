# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Nueve Siete Seis Cuatro" ;
    poker:contieneCarta poker:NueveDeVolador, poker:CuatroDeElectrico, poker:SieteDeFantasma, poker:DiezDeFuego, poker:SeisDeTierra .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Quince Once Cuatro Uno" ;
    poker:contieneCarta poker:OnceDeSiniestro, poker:UnoDeFantasma, poker:DieciochoDeBicho, poker:CuatroDeBicho, poker:QuinceDeHielo .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Trece Ocho Seis Dos" ;
    poker:contieneCarta poker:TreceDePlanta, poker:DieciseisDeTierra, poker:SeisDePsiquico, poker:OchoDePsiquico, poker:DosDeDragon .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciseis Once Diez Nueve" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:NueveDeLucha, poker:DieciseisDeFantasma, poker:DiezDeElectrico, poker:OnceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Doce Tres Dos" ;
    poker:contieneCarta poker:DiecisieteDePsiquico, poker:DiecisieteDeElectrico, poker:DosDeHielo, poker:TresDeFuego, poker:DoceDePsiquico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Seises con Siete Cinco Tres" ;
    poker:contieneCarta poker:SeisDeLucha, poker:SeisDeTierra, poker:TresDeFuego, poker:SieteDeFantasma, poker:CincoDeTierra .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Treces con Quince Doce Ocho" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeElectrico, poker:OchoDeVolador, poker:QuinceDeFuego, poker:DoceDePsiquico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Dieciseis Trece Seis" ;
    poker:contieneCarta poker:DiecisieteDeRoca, poker:DiecisieteDeElectrico, poker:SeisDePlanta, poker:TreceDeFuego, poker:DieciseisDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Quinces con Diecisiete" ;
    poker:contieneCarta poker:DiecinueveDeBicho, poker:DiecinueveDeHielo, poker:QuinceDePsiquico, poker:QuinceDePlanta, poker:DiecisieteDeAgua ;
    poker:manoTienePar poker:Diecinueve, poker:Quince .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Unos con Dos" ;
    poker:contieneCarta poker:UnoDeTierra, poker:UnoDeBicho, poker:DoceDePlanta, poker:DoceDeFantasma, poker:DosDeTierra ;
    poker:manoTienePar poker:Uno, poker:Doce .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Unos con Dos" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeVolador, poker:TresDeVeneno, poker:TresDeVolador, poker:DosDeVeneno ;
    poker:manoTienePar poker:Uno, poker:Tres .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Sietes con Once" ;
    poker:contieneCarta poker:SieteDeFantasma, poker:SieteDeAgua, poker:DiecinueveDeBicho, poker:DiecinueveDeAgua, poker:OnceDeNormal ;
    poker:manoTienePar poker:Siete, poker:Diecinueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treses con Dieciseis Cuatro" ;
    poker:contieneCarta poker:TresDeTierra, poker:TresDePsiquico, poker:TresDeNormal, poker:CuatroDeNormal, poker:DieciseisDeBicho .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Ochos con Once Uno" ;
    poker:contieneCarta poker:OchoDeLucha, poker:OchoDeFantasma, poker:OchoDeRoca, poker:UnoDeVeneno, poker:OnceDeVeneno .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Diecisietes con Nueve Ocho" ;
    poker:contieneCarta poker:DiecisieteDeSiniestro, poker:DiecisieteDeFuego, poker:DiecisieteDeBicho, poker:NueveDeNormal, poker:OchoDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Onces con Diecisiete Cuatro" ;
    poker:contieneCarta poker:OnceDeTierra, poker:OnceDeElectrico, poker:OnceDeSiniestro, poker:CuatroDeNormal, poker:DiecisieteDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeTierra, poker:OchoDeLucha, poker:NueveDeAgua, poker:DiezDeDragon, poker:OnceDeRoca .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeVolador, poker:DosDeRoca, poker:TresDePlanta, poker:CuatroDeAgua, poker:CincoDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeVolador, poker:NueveDeVeneno, poker:DiezDeRoca, poker:OnceDeBicho, poker:DoceDeDragon .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeLucha, poker:NueveDeNormal, poker:DiezDeSiniestro, poker:OnceDePlanta, poker:DoceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Dieciseis Nueve Siete Seis Uno de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:SieteDePlanta, poker:SeisDePlanta, poker:DieciseisDePlanta, poker:UnoDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciocho Catorce Diez Ocho Siete de Normal" ;
    poker:contieneCarta poker:DiezDeNormal, poker:DieciochoDeNormal, poker:OchoDeNormal, poker:SieteDeNormal, poker:CatorceDeNormal .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecinueve Quince Catorce Trece Tres de Planta" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DiecinueveDePlanta, poker:TreceDePlanta, poker:TresDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciocho Doce Once Dos de Psiquico" ;
    poker:contieneCarta poker:DieciochoDePsiquico, poker:DosDePsiquico, poker:DiecinueveDePsiquico, poker:DoceDePsiquico, poker:OnceDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Unos" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DieciseisDeTierra, poker:DieciseisDeDragon, poker:UnoDeFuego, poker:UnoDeAgua ;
    poker:manoTienePar poker:Dieciseis, poker:Uno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Diecinueves" ;
    poker:contieneCarta poker:OchoDeNormal, poker:OchoDeElectrico, poker:OchoDeRoca, poker:DiecinueveDePlanta, poker:DiecinueveDeAgua ;
    poker:manoTienePar poker:Ocho, poker:Diecinueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Ochos" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDeFantasma, poker:CuatroDePlanta, poker:OchoDeDragon, poker:OchoDeFuego ;
    poker:manoTienePar poker:Cuatro, poker:Ocho .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Quinces" ;
    poker:contieneCarta poker:CincoDeLucha, poker:CincoDeDragon, poker:CincoDeBicho, poker:QuinceDeVolador, poker:QuinceDeFantasma ;
    poker:manoTienePar poker:Cinco, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Catorces con Seis de Roca" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDeNormal, poker:CatorceDeFuego, poker:CatorceDeLucha, poker:SeisDeRoca .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Onces con Trece de Tierra" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDeElectrico, poker:OnceDePlanta, poker:OnceDeVeneno, poker:TreceDeTierra .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Dieciseises con Uno de Hielo" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DieciseisDePsiquico, poker:DieciseisDeRoca, poker:DieciseisDeNormal, poker:UnoDeHielo .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Dieces con Cinco de Electrico" ;
    poker:contieneCarta poker:DiezDeHielo, poker:DiezDeFuego, poker:DiezDeDragon, poker:DiezDeSiniestro, poker:CincoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Hielo" ;
    poker:contieneCarta poker:SieteDeHielo, poker:OchoDeHielo, poker:NueveDeHielo, poker:DiezDeHielo, poker:OnceDeHielo .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Hielo" ;
    poker:contieneCarta poker:DiezDeHielo, poker:OnceDeHielo, poker:DoceDeHielo, poker:TreceDeHielo, poker:CatorceDeHielo .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Lucha" ;
    poker:contieneCarta poker:DiezDeLucha, poker:OnceDeLucha, poker:DoceDeLucha, poker:TreceDeLucha, poker:CatorceDeLucha .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Lucha" ;
    poker:contieneCarta poker:SieteDeLucha, poker:OchoDeLucha, poker:NueveDeLucha, poker:DiezDeLucha, poker:OnceDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fantasma" ;
    poker:contieneCarta poker:QuinceDeFantasma, poker:DieciseisDeFantasma, poker:DiecisieteDeFantasma, poker:DieciochoDeFantasma, poker:DiecinueveDeFantasma .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:QuinceDePsiquico, poker:DieciseisDePsiquico, poker:DiecisieteDePsiquico, poker:DieciochoDePsiquico, poker:DiecinueveDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
