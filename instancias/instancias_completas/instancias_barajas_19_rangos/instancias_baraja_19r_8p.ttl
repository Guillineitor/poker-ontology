# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Catorce con Diez Siete Cinco Tres" ;
    poker:contieneCarta poker:SieteDeNormal, poker:CatorceDePlanta, poker:CincoDeFuego, poker:DiezDeElectrico, poker:TresDeFuego .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Diecisiete Dieciseis Trece Seis" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:DieciochoDePlanta, poker:TreceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Catorce Doce Nueve Ocho" ;
    poker:contieneCarta poker:DoceDeNormal, poker:OchoDeVeneno, poker:NueveDeNormal, poker:CatorceDeElectrico, poker:DiecisieteDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Nueve Cinco Cuatro Uno" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:UnoDeElectrico, poker:CincoDeVolador, poker:NueveDeNormal, poker:DiecinueveDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Diecinueve Dieciocho Diez" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DieciseisDePlanta, poker:DieciochoDeElectrico, poker:DiezDeElectrico, poker:DiecinueveDeBicho .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieces con Diecinueve Dieciseis Cuatro" ;
    poker:contieneCarta poker:DiezDeFuego, poker:DiezDeNormal, poker:CuatroDeElectrico, poker:DieciseisDeElectrico, poker:DiecinueveDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doces con Dieciocho Diecisiete Dos" ;
    poker:contieneCarta poker:DoceDeBicho, poker:DoceDeAgua, poker:DiecisieteDeNormal, poker:DieciochoDeAgua, poker:DosDeVolador .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Catorces con Diecisiete Nueve Cuatro" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:CatorceDeVolador, poker:CuatroDeElectrico, poker:NueveDeBicho, poker:DiecisieteDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Unos con Doce" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeVolador, poker:UnoDeNormal, poker:UnoDePlanta, poker:DoceDePlanta ;
    poker:manoTienePar poker:Tres, poker:Uno .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Treses con Dieciseis" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:DiecinueveDeBicho, poker:TresDeAgua, poker:TresDeNormal, poker:DieciseisDeNormal ;
    poker:manoTienePar poker:Diecinueve, poker:Tres .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Doses con Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeNormal, poker:CincoDeVolador, poker:CincoDeAgua, poker:SeisDeNormal ;
    poker:manoTienePar poker:Dos, poker:Cinco .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Seises con Quince" ;
    poker:contieneCarta poker:OchoDeBicho, poker:OchoDeVeneno, poker:SeisDeVeneno, poker:SeisDePlanta, poker:QuinceDeFuego ;
    poker:manoTienePar poker:Ocho, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Cinco Cuatro" ;
    poker:contieneCarta poker:DieciochoDeBicho, poker:DieciochoDePlanta, poker:DieciochoDeFuego, poker:CincoDeVeneno, poker:CuatroDeVolador .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Sietes con Nueve Uno" ;
    poker:contieneCarta poker:SieteDePlanta, poker:SieteDeFuego, poker:SieteDeAgua, poker:NueveDeElectrico, poker:UnoDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieciseises con Quince Seis" ;
    poker:contieneCarta poker:DieciseisDeFuego, poker:DieciseisDeElectrico, poker:DieciseisDeAgua, poker:SeisDeVolador, poker:QuinceDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Treces con Once Cinco" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDeVeneno, poker:TreceDeAgua, poker:OnceDeNormal, poker:CincoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SieteDeElectrico, poker:OchoDeFuego, poker:NueveDeNormal, poker:DiezDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeNormal, poker:SeisDeFuego, poker:SieteDeNormal, poker:OchoDeElectrico, poker:NueveDeVeneno .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeVeneno, poker:DiezDeFuego, poker:OnceDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDePlanta, poker:SeisDeFuego, poker:SieteDeVeneno, poker:OchoDeBicho, poker:NueveDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diecisiete Quince Catorce Trece Once de Planta" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:DiecisieteDePlanta, poker:OnceDePlanta, poker:TreceDePlanta, poker:QuinceDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Diecinueve Diecisiete Dieciseis Doce Diez de Bicho" ;
    poker:contieneCarta poker:DiezDeBicho, poker:DoceDeBicho, poker:DiecisieteDeBicho, poker:DieciseisDeBicho, poker:DiecinueveDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Dieciocho Diecisiete Trece Siete Tres de Agua" ;
    poker:contieneCarta poker:DiecisieteDeAgua, poker:SieteDeAgua, poker:TreceDeAgua, poker:DieciochoDeAgua, poker:TresDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Catorce Trece Cinco Dos Uno de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:TreceDeFuego, poker:CincoDeFuego, poker:CatorceDeFuego, poker:UnoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Treses" ;
    poker:contieneCarta poker:OnceDeVeneno, poker:OnceDeNormal, poker:OnceDeFuego, poker:TresDeVolador, poker:TresDeAgua ;
    poker:manoTienePar poker:Once, poker:Tres .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Catorces" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDePlanta, poker:OchoDeNormal, poker:CatorceDeNormal, poker:CatorceDeVolador ;
    poker:manoTienePar poker:Ocho, poker:Catorce .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Diecinueves" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDePlanta, poker:SeisDeNormal, poker:DiecinueveDeFuego, poker:DiecinueveDeNormal ;
    poker:manoTienePar poker:Seis, poker:Diecinueve .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Seises" ;
    poker:contieneCarta poker:TresDeNormal, poker:TresDeElectrico, poker:TresDeAgua, poker:SeisDeFuego, poker:SeisDeVeneno ;
    poker:manoTienePar poker:Tres, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Onces con Dieciocho de Agua" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeVeneno, poker:OnceDeFuego, poker:OnceDeVolador, poker:DieciochoDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Unos con Catorce de Electrico" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeBicho, poker:UnoDeVolador, poker:UnoDePlanta, poker:CatorceDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Ochos con Cinco de Bicho" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDeNormal, poker:OchoDeVeneno, poker:OchoDeVolador, poker:CincoDeBicho .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Onces con Diez de Normal" ;
    poker:contieneCarta poker:OnceDeBicho, poker:OnceDeVolador, poker:OnceDeFuego, poker:OnceDePlanta, poker:DiezDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Volador" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SieteDeVolador, poker:OchoDeVolador, poker:NueveDeVolador, poker:DiezDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Volador" ;
    poker:contieneCarta poker:DoceDeVolador, poker:TreceDeVolador, poker:CatorceDeVolador, poker:QuinceDeVolador, poker:DieciseisDeVolador .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Trece-Catorce-Quince-Dieciseis-Diecisiete de Planta" ;
    poker:contieneCarta poker:TreceDePlanta, poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Normal" ;
    poker:contieneCarta poker:SieteDeNormal, poker:OchoDeNormal, poker:NueveDeNormal, poker:DiezDeNormal, poker:OnceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:DieciseisDeNormal, poker:DiecisieteDeNormal, poker:DieciochoDeNormal, poker:DiecinueveDeNormal .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:QuinceDeVolador, poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
