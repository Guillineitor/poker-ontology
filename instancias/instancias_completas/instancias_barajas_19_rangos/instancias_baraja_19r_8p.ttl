# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Quince Doce Diez Uno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DiecinueveDeFuego, poker:DoceDeFuego, poker:QuinceDeBicho, poker:DiezDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Diecisiete Doce Once Tres" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:DiecisieteDeVeneno, poker:OnceDeBicho, poker:DoceDeNormal, poker:TresDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Diecisiete Seis Cuatro Tres" ;
    poker:contieneCarta poker:DiecinueveDeVeneno, poker:DiecisieteDeVeneno, poker:CuatroDeElectrico, poker:TresDeBicho, poker:SeisDeVeneno .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Quince con Ocho Cinco Cuatro Dos" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:QuinceDeNormal, poker:OchoDePlanta, poker:DosDePlanta, poker:CuatroDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cincos con Quince Trece Nueve" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:QuinceDeVolador, poker:NueveDePlanta, poker:TreceDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Ochos con Once Cinco Uno" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDeElectrico, poker:OnceDePlanta, poker:UnoDeBicho, poker:CincoDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Catorce Trece Diez" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:DieciseisDeBicho, poker:DiezDeVeneno, poker:TreceDeVeneno, poker:CatorceDeBicho .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cincos con Dieciocho Ocho Seis" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeFuego, poker:DieciochoDeBicho, poker:OchoDeVolador, poker:SeisDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Dieciseises con Ocho" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DieciseisDeAgua, poker:DieciochoDeFuego, poker:DieciochoDeBicho, poker:OchoDeBicho ;
    poker:manoTienePar poker:Dieciseis, poker:Dieciocho .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Dieciseises con Tres" ;
    poker:contieneCarta poker:DieciseisDeBicho, poker:DieciseisDeElectrico, poker:DieciochoDeVolador, poker:DieciochoDeVeneno, poker:TresDeAgua ;
    poker:manoTienePar poker:Dieciseis, poker:Dieciocho .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Sietes con Dieciseis" ;
    poker:contieneCarta poker:TreceDeNormal, poker:TreceDeAgua, poker:SieteDeFuego, poker:SieteDeBicho, poker:DieciseisDeVeneno ;
    poker:manoTienePar poker:Trece, poker:Siete .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Cuatros con Siete" ;
    poker:contieneCarta poker:NueveDeVolador, poker:NueveDeFuego, poker:CuatroDeVolador, poker:CuatroDeVeneno, poker:SieteDeElectrico ;
    poker:manoTienePar poker:Nueve, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieces con Quince Doce" ;
    poker:contieneCarta poker:DiezDeNormal, poker:DiezDeVeneno, poker:DiezDeVolador, poker:QuinceDeVeneno, poker:DoceDeVolador .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Diecisiete Dieciseis" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CuatroDeElectrico, poker:CuatroDePlanta, poker:DieciseisDeFuego, poker:DiecisieteDeVeneno .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doces con Nueve Tres" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeVeneno, poker:DoceDeFuego, poker:TresDeFuego, poker:NueveDeVolador .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Quinces con Diecinueve Cinco" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDeElectrico, poker:QuinceDeBicho, poker:DiecinueveDeVolador, poker:CincoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeBicho, poker:NueveDePlanta, poker:DiezDeFuego, poker:OnceDeVolador, poker:DoceDeNormal .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SieteDeVolador, poker:OchoDeNormal, poker:NueveDeBicho, poker:DiezDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeElectrico, poker:CuatroDeNormal, poker:CincoDeAgua, poker:SeisDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeVolador, poker:DieciseisDeNormal, poker:DiecisieteDeElectrico, poker:DieciochoDeVolador, poker:DiecinueveDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Catorce Cinco Cuatro Tres Uno de Eléctrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:TresDeElectrico, poker:CatorceDeElectrico, poker:CincoDeElectrico, poker:CuatroDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciocho Dieciseis Catorce Trece Once de Planta" ;
    poker:contieneCarta poker:TreceDePlanta, poker:CatorceDePlanta, poker:DieciseisDePlanta, poker:DieciochoDePlanta, poker:OnceDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciseis Doce Ocho Cuatro de Agua" ;
    poker:contieneCarta poker:OchoDeAgua, poker:DoceDeAgua, poker:DiecinueveDeAgua, poker:DieciseisDeAgua, poker:CuatroDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Diecisiete Catorce Once Seis Cuatro de Normal" ;
    poker:contieneCarta poker:DiecisieteDeNormal, poker:CatorceDeNormal, poker:SeisDeNormal, poker:OnceDeNormal, poker:CuatroDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Quinces con Par de Treces" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:QuinceDePlanta, poker:QuinceDeVeneno, poker:TreceDeVeneno, poker:TreceDeBicho ;
    poker:manoTienePar poker:Quince, poker:Trece .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Cincos" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeElectrico, poker:OnceDePlanta, poker:CincoDeVolador, poker:CincoDeFuego ;
    poker:manoTienePar poker:Once, poker:Cinco .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Doses" ;
    poker:contieneCarta poker:DoceDeBicho, poker:DoceDeFuego, poker:DoceDeVolador, poker:DosDePlanta, poker:DosDeAgua ;
    poker:manoTienePar poker:Doce, poker:Dos .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Treses" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeBicho, poker:DoceDeNormal, poker:TresDeElectrico, poker:TresDeNormal ;
    poker:manoTienePar poker:Doce, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Nueve de Eléctrico" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:CincoDeVolador, poker:CincoDeVeneno, poker:NueveDeElectrico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Tres de Eléctrico" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DiecisieteDeNormal, poker:DiecisieteDeVeneno, poker:DiecisieteDeBicho, poker:TresDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Cinco de Normal" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeVolador, poker:CuatroDeBicho, poker:CuatroDePlanta, poker:CincoDeNormal .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Dos de Volador" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDeVeneno, poker:CuatroDeFuego, poker:CuatroDeAgua, poker:DosDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Veneno" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:OnceDeVeneno, poker:DoceDeVeneno, poker:TreceDeVeneno, poker:CatorceDeVeneno .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Agua" ;
    poker:contieneCarta poker:DoceDeAgua, poker:TreceDeAgua, poker:CatorceDeAgua, poker:QuinceDeAgua, poker:DieciseisDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Volador" ;
    poker:contieneCarta poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador, poker:SeisDeVolador, poker:SieteDeVolador .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Veneno" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:OnceDeVeneno, poker:DoceDeVeneno, poker:TreceDeVeneno, poker:CatorceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:QuinceDeVeneno, poker:DieciseisDeVeneno, poker:DiecisieteDeVeneno, poker:DieciochoDeVeneno, poker:DiecinueveDeVeneno .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
