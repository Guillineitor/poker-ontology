# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Catorce Trece Doce Nueve" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DieciseisDeBicho, poker:TreceDeElectrico, poker:DoceDeElectrico, poker:CatorceDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Quince Trece Once Siete" ;
    poker:contieneCarta poker:TreceDePlanta, poker:OnceDeElectrico, poker:QuinceDeNormal, poker:DieciochoDeVolador, poker:SieteDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Quince Siete Cinco Tres" ;
    poker:contieneCarta poker:QuinceDeVeneno, poker:TresDeVeneno, poker:SieteDeVolador, poker:CincoDeVolador, poker:DiecinueveDeVeneno .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Quince Once Ocho Tres" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:QuinceDeElectrico, poker:TresDeVeneno, poker:OchoDeAgua, poker:OnceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doces con Trece Siete Tres" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeAgua, poker:TreceDeVeneno, poker:SieteDeNormal, poker:TresDePlanta .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cuatros con Dieciseis Once Uno" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeNormal, poker:UnoDeVeneno, poker:OnceDePlanta, poker:DieciseisDeNormal .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Catorces con Trece Siete Uno" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:CatorceDeFuego, poker:UnoDePlanta, poker:SieteDeAgua, poker:TreceDeNormal .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Doses con Diecisiete Once Seis" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeBicho, poker:DiecisieteDeVolador, poker:OnceDeElectrico, poker:SeisDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Cincos con Doce" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:NueveDeVeneno, poker:CincoDePlanta, poker:CincoDeAgua, poker:DoceDeBicho ;
    poker:manoTienePar poker:Nueve, poker:Cinco .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Unos con Dieciseis" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeVeneno, poker:UnoDeBicho, poker:UnoDeElectrico, poker:DieciseisDeFuego ;
    poker:manoTienePar poker:Doce, poker:Uno .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Treses con Siete" ;
    poker:contieneCarta poker:TreceDeNormal, poker:TreceDeBicho, poker:TresDePlanta, poker:TresDeVolador, poker:SieteDeFuego ;
    poker:manoTienePar poker:Trece, poker:Tres .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Seises con Doce" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DiecisieteDeVeneno, poker:SeisDeVeneno, poker:SeisDeVolador, poker:DoceDeFuego ;
    poker:manoTienePar poker:Diecisiete, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cincos con Quince Nueve" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDeFuego, poker:CincoDeAgua, poker:QuinceDeFuego, poker:NueveDeNormal .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Diecisietes con Diecinueve Ocho" ;
    poker:contieneCarta poker:DiecisieteDeElectrico, poker:DiecisieteDeVeneno, poker:DiecisieteDeBicho, poker:OchoDeBicho, poker:DiecinueveDeVeneno .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieces con Seis Uno" ;
    poker:contieneCarta poker:DiezDeNormal, poker:DiezDeVolador, poker:DiezDePlanta, poker:UnoDePlanta, poker:SeisDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Quinces con Cinco Dos" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:QuinceDePlanta, poker:QuinceDeBicho, poker:DosDeElectrico, poker:CincoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDePlanta, poker:NueveDeVolador, poker:DiezDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeBicho, poker:DosDeBicho, poker:TresDeAgua, poker:CuatroDeFuego, poker:CincoDeBicho .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeAgua, poker:TreceDeAgua, poker:CatorceDeAgua, poker:QuinceDeFuego, poker:DieciseisDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CincoDeFuego, poker:SeisDeNormal, poker:SieteDeVeneno, poker:OchoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diecinueve Quince Trece Nueve Uno de Planta" ;
    poker:contieneCarta poker:TreceDePlanta, poker:QuinceDePlanta, poker:UnoDePlanta, poker:NueveDePlanta, poker:DiecinueveDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciseis Trece Seis Tres Dos de Veneno" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:TreceDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:SeisDeVeneno .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecisiete Trece Doce Cuatro Uno de Veneno" ;
    poker:contieneCarta poker:DoceDeVeneno, poker:CuatroDeVeneno, poker:DiecisieteDeVeneno, poker:UnoDeVeneno, poker:TreceDeVeneno .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Quince Once Diez Ocho Seis de Fuego" ;
    poker:contieneCarta poker:DiezDeFuego, poker:QuinceDeFuego, poker:SeisDeFuego, poker:OchoDeFuego, poker:OnceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Diecinueves con Par de Catorces" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:DiecinueveDeVeneno, poker:DiecinueveDeFuego, poker:CatorceDeFuego, poker:CatorceDeBicho ;
    poker:manoTienePar poker:Diecinueve, poker:Catorce .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Unos" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeElectrico, poker:TresDeVolador, poker:UnoDeElectrico, poker:UnoDeVolador ;
    poker:manoTienePar poker:Tres, poker:Uno .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Quinces" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDeVeneno, poker:CuatroDeAgua, poker:QuinceDeVeneno, poker:QuinceDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Quince .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Sietes" ;
    poker:contieneCarta poker:CatorceDeNormal, poker:CatorceDeFuego, poker:CatorceDeElectrico, poker:SieteDeNormal, poker:SieteDeElectrico ;
    poker:manoTienePar poker:Catorce, poker:Siete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Catorces con Ocho de Electrico" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDePlanta, poker:CatorceDeVeneno, poker:CatorceDeBicho, poker:OchoDeElectrico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cincos con Catorce de Agua" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDePlanta, poker:CincoDeBicho, poker:CincoDeAgua, poker:CatorceDeAgua .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cincos con Nueve de Bicho" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDeVolador, poker:CincoDeNormal, poker:CincoDeBicho, poker:NueveDeBicho .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Doces con Trece de Agua" ;
    poker:contieneCarta poker:DoceDeBicho, poker:DoceDeAgua, poker:DoceDeFuego, poker:DoceDeElectrico, poker:TreceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Bicho" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SieteDeBicho, poker:OchoDeBicho, poker:NueveDeBicho, poker:DiezDeBicho .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Bicho" ;
    poker:contieneCarta poker:SieteDeBicho, poker:OchoDeBicho, poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeFuego, poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:DieciseisDeBicho, poker:DiecisieteDeBicho, poker:DieciochoDeBicho, poker:DiecinueveDeBicho .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:DieciseisDeNormal, poker:DiecisieteDeNormal, poker:DieciochoDeNormal, poker:DiecinueveDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
