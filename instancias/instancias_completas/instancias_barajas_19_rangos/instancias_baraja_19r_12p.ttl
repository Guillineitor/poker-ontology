# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Catorce Nueve Ocho Cuatro" ;
    poker:contieneCarta poker:DieciochoDeTierra, poker:OchoDeRoca, poker:CatorceDeBicho, poker:NueveDePlanta, poker:CuatroDeNormal .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciseis Cinco Cuatro Uno" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DieciseisDePsiquico, poker:CincoDePlanta, poker:DiecinueveDeNormal, poker:CuatroDeRoca .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Diez Nueve Seis Cuatro" ;
    poker:contieneCarta poker:DiecisieteDeElectrico, poker:SeisDeTierra, poker:CuatroDeNormal, poker:NueveDeBicho, poker:DiezDeVolador .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Ocho Cuatro Dos Uno" ;
    poker:contieneCarta poker:DosDePlanta, poker:CuatroDeAgua, poker:UnoDeBicho, poker:DieciseisDePsiquico, poker:OchoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Catorces con Dieciseis Trece Seis" ;
    poker:contieneCarta poker:CatorceDeRoca, poker:CatorceDeVolador, poker:DieciseisDeVeneno, poker:TreceDeVeneno, poker:SeisDeRoca .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Seises con Dieciseis Siete Cinco" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeRoca, poker:SieteDePsiquico, poker:DieciseisDePlanta, poker:CincoDeTierra .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doses con Diecinueve Dieciseis Ocho" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeRoca, poker:DiecinueveDeLucha, poker:OchoDeVeneno, poker:DieciseisDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Quince Diez Uno" ;
    poker:contieneCarta poker:DieciseisDeLucha, poker:DieciseisDeFuego, poker:UnoDeBicho, poker:QuinceDeVolador, poker:DiezDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Ochos con Diecinueve" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:OchoDeTierra, poker:QuinceDeBicho, poker:QuinceDeAgua, poker:DiecinueveDeRoca ;
    poker:manoTienePar poker:Ocho, poker:Quince .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Treces con Quince" ;
    poker:contieneCarta poker:DieciochoDeTierra, poker:DieciochoDeVolador, poker:TreceDeBicho, poker:TreceDeRoca, poker:QuinceDeVeneno ;
    poker:manoTienePar poker:Dieciocho, poker:Trece .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Treses con Once" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDeElectrico, poker:NueveDeFuego, poker:NueveDeRoca, poker:OnceDeVolador ;
    poker:manoTienePar poker:Tres, poker:Nueve .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Treces con Diecinueve" ;
    poker:contieneCarta poker:DiecisieteDeTierra, poker:DiecisieteDePlanta, poker:TreceDeTierra, poker:TreceDeElectrico, poker:DiecinueveDeVeneno ;
    poker:manoTienePar poker:Diecisiete, poker:Trece .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Ochos con Dieciocho Once" ;
    poker:contieneCarta poker:OchoDePsiquico, poker:OchoDeBicho, poker:OchoDeNormal, poker:OnceDeNormal, poker:DieciochoDeLucha .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Quinces con Dieciocho Dos" ;
    poker:contieneCarta poker:QuinceDeRoca, poker:QuinceDeAgua, poker:QuinceDeTierra, poker:DieciochoDeVeneno, poker:DosDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Nueves con Once Uno" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:NueveDeElectrico, poker:NueveDeAgua, poker:OnceDeVeneno, poker:UnoDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Diecisietes con Seis Cuatro" ;
    poker:contieneCarta poker:DiecisieteDeFuego, poker:DiecisieteDeNormal, poker:DiecisieteDeTierra, poker:CuatroDeLucha, poker:SeisDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:OnceDePlanta, poker:DoceDeFuego, poker:TreceDeVolador, poker:CatorceDeFuego .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeLucha, poker:DiezDeElectrico, poker:OnceDePsiquico, poker:DoceDeVolador, poker:TreceDeLucha .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:QuinceDeAgua, poker:DieciseisDeNormal, poker:DiecisieteDeBicho, poker:DieciochoDeFuego .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDePsiquico, poker:OnceDeAgua, poker:DoceDePlanta, poker:TreceDeVolador, poker:CatorceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diecinueve Diecisiete Dieciseis Catorce Siete de Volador" ;
    poker:contieneCarta poker:DieciseisDeVolador, poker:DiecinueveDeVolador, poker:DiecisieteDeVolador, poker:CatorceDeVolador, poker:SieteDeVolador .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciocho Doce Nueve Seis de Roca" ;
    poker:contieneCarta poker:DiecinueveDeRoca, poker:DieciochoDeRoca, poker:NueveDeRoca, poker:DoceDeRoca, poker:SeisDeRoca .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Ocho Siete Seis Cuatro Uno de Lucha" ;
    poker:contieneCarta poker:SieteDeLucha, poker:UnoDeLucha, poker:SeisDeLucha, poker:OchoDeLucha, poker:CuatroDeLucha .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Quince Doce Diez Nueve Seis de Normal" ;
    poker:contieneCarta poker:DiezDeNormal, poker:DoceDeNormal, poker:SeisDeNormal, poker:NueveDeNormal, poker:QuinceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Cuatros" ;
    poker:contieneCarta poker:SieteDePlanta, poker:SieteDeVeneno, poker:SieteDeAgua, poker:CuatroDeVeneno, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Siete, poker:Cuatro .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Quinces" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDePlanta, poker:OnceDeLucha, poker:QuinceDeBicho, poker:QuinceDeVeneno ;
    poker:manoTienePar poker:Once, poker:Quince .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Dieciochos" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:NueveDeNormal, poker:NueveDeVeneno, poker:DieciochoDePlanta, poker:DieciochoDeRoca ;
    poker:manoTienePar poker:Nueve, poker:Dieciocho .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Diecisietes" ;
    poker:contieneCarta poker:DieciseisDeVolador, poker:DieciseisDeElectrico, poker:DieciseisDeBicho, poker:DiecisieteDeBicho, poker:DiecisieteDeAgua ;
    poker:manoTienePar poker:Dieciseis, poker:Diecisiete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Quinces con Dieciocho de Bicho" ;
    poker:contieneCarta poker:QuinceDeTierra, poker:QuinceDeVolador, poker:QuinceDeVeneno, poker:QuinceDeNormal, poker:DieciochoDeBicho .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treses con Trece de Roca" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDeNormal, poker:TresDePlanta, poker:TresDeElectrico, poker:TreceDeRoca .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Quince de Veneno" ;
    poker:contieneCarta poker:DiecisieteDeBicho, poker:DiecisieteDeLucha, poker:DiecisieteDeTierra, poker:DiecisieteDeElectrico, poker:QuinceDeVeneno .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Tres de Volador" ;
    poker:contieneCarta poker:DiecisieteDeFuego, poker:DiecisieteDeBicho, poker:DiecisieteDeAgua, poker:DiecisieteDeRoca, poker:TresDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Eléctrico" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Nueve-Diez-Once-Doce-Trece de Lucha" ;
    poker:contieneCarta poker:NueveDeLucha, poker:DiezDeLucha, poker:OnceDeLucha, poker:DoceDeLucha, poker:TreceDeLucha .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Roca" ;
    poker:contieneCarta poker:OchoDeRoca, poker:NueveDeRoca, poker:DiezDeRoca, poker:OnceDeRoca, poker:DoceDeRoca .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Planta" ;
    poker:contieneCarta poker:DoceDePlanta, poker:TreceDePlanta, poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:DieciseisDeBicho, poker:DiecisieteDeBicho, poker:DieciochoDeBicho, poker:DiecinueveDeBicho .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:QuinceDeVolador, poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
