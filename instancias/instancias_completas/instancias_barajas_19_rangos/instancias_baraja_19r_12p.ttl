# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Trece Doce Once Cuatro" ;
    poker:contieneCarta poker:CuatroDeLucha, poker:TreceDeVolador, poker:OnceDePsiquico, poker:DieciochoDePlanta, poker:DoceDePsiquico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Quince Trece Doce Seis" ;
    poker:contieneCarta poker:SeisDePlanta, poker:QuinceDePsiquico, poker:TreceDeElectrico, poker:DoceDeTierra, poker:DiecinueveDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Trece Once Seis Cinco" ;
    poker:contieneCarta poker:CincoDeVolador, poker:SeisDeLucha, poker:OnceDeAgua, poker:TreceDePsiquico, poker:DiecisieteDeVeneno .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Trece Once Siete Uno" ;
    poker:contieneCarta poker:OnceDeBicho, poker:DieciseisDeVeneno, poker:SieteDeTierra, poker:TreceDeNormal, poker:UnoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Onces con Diecisiete Diez Uno" ;
    poker:contieneCarta poker:OnceDePlanta, poker:OnceDeVeneno, poker:UnoDeTierra, poker:DiecisieteDeFuego, poker:DiezDeNormal .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Onces con Quince Doce Cuatro" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDeLucha, poker:CuatroDeAgua, poker:DoceDeAgua, poker:QuinceDePlanta .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Catorces con Dieciocho Nueve Cuatro" ;
    poker:contieneCarta poker:CatorceDeLucha, poker:CatorceDeAgua, poker:DieciochoDeVeneno, poker:NueveDeBicho, poker:CuatroDeNormal .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Ochos con Trece Tres Dos" ;
    poker:contieneCarta poker:OchoDeRoca, poker:OchoDeLucha, poker:TresDePsiquico, poker:DosDePsiquico, poker:TreceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Sietes con Uno" ;
    poker:contieneCarta poker:SieteDeTierra, poker:SieteDeVeneno, poker:OchoDeBicho, poker:OchoDeVolador, poker:UnoDeElectrico ;
    poker:manoTienePar poker:Siete, poker:Ocho .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Unos con Tres" ;
    poker:contieneCarta poker:UnoDeNormal, poker:UnoDeFuego, poker:SieteDeVeneno, poker:SieteDeVolador, poker:TresDeRoca ;
    poker:manoTienePar poker:Uno, poker:Siete .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Doses con Dieciocho" ;
    poker:contieneCarta poker:DiecinueveDeLucha, poker:DiecinueveDeAgua, poker:DosDeFuego, poker:DosDePlanta, poker:DieciochoDeLucha ;
    poker:manoTienePar poker:Diecinueve, poker:Dos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Quinces con Diecisiete" ;
    poker:contieneCarta poker:DieciseisDeNormal, poker:DieciseisDeTierra, poker:QuinceDeVeneno, poker:QuinceDePsiquico, poker:DiecisieteDeRoca ;
    poker:manoTienePar poker:Dieciseis, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treces con Siete Cinco" ;
    poker:contieneCarta poker:TreceDeTierra, poker:TreceDeVeneno, poker:TreceDeVolador, poker:CincoDeLucha, poker:SieteDeElectrico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Diecinueve Cuatro" ;
    poker:contieneCarta poker:DoceDeTierra, poker:DoceDeAgua, poker:DoceDeVeneno, poker:CuatroDeElectrico, poker:DiecinueveDeTierra .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Catorces con Doce Nueve" ;
    poker:contieneCarta poker:CatorceDeRoca, poker:CatorceDeNormal, poker:CatorceDeElectrico, poker:NueveDeBicho, poker:DoceDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Onces con Dieciocho Doce" ;
    poker:contieneCarta poker:OnceDePlanta, poker:OnceDeVolador, poker:OnceDeRoca, poker:DieciochoDeTierra, poker:DoceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:DosDeTierra, poker:TresDeNormal, poker:CuatroDeVolador, poker:CincoDeElectrico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Once-Doce-Trece-Catorce-Quince" ;
    poker:contieneCarta poker:OnceDeTierra, poker:DoceDePsiquico, poker:TreceDeLucha, poker:CatorceDeFuego, poker:QuinceDeVeneno .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeBicho, poker:OchoDeElectrico, poker:NueveDeElectrico, poker:DiezDeVolador, poker:OnceDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeTierra, poker:DieciochoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Dieciseis Doce Diez Cuatro Tres de Volador" ;
    poker:contieneCarta poker:DiezDeVolador, poker:CuatroDeVolador, poker:DieciseisDeVolador, poker:TresDeVolador, poker:DoceDeVolador .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciocho Catorce Diez Ocho Cuatro de Volador" ;
    poker:contieneCarta poker:OchoDeVolador, poker:CatorceDeVolador, poker:DiezDeVolador, poker:DieciochoDeVolador, poker:CuatroDeVolador .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Dieciocho Doce Once Ocho Uno de Bicho" ;
    poker:contieneCarta poker:OchoDeBicho, poker:UnoDeBicho, poker:DieciochoDeBicho, poker:OnceDeBicho, poker:DoceDeBicho .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Quince Nueve Seis Cinco Uno de Tierra" ;
    poker:contieneCarta poker:SeisDeTierra, poker:CincoDeTierra, poker:QuinceDeTierra, poker:UnoDeTierra, poker:NueveDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Quinces con Par de Diecinueves" ;
    poker:contieneCarta poker:QuinceDeTierra, poker:QuinceDeLucha, poker:QuinceDeBicho, poker:DiecinueveDeNormal, poker:DiecinueveDePlanta ;
    poker:manoTienePar poker:Quince, poker:Diecinueve .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Unos" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDePlanta, poker:CuatroDeAgua, poker:UnoDeVeneno, poker:UnoDePsiquico ;
    poker:manoTienePar poker:Cuatro, poker:Uno .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Cuatros" ;
    poker:contieneCarta poker:SieteDeNormal, poker:SieteDeVolador, poker:SieteDeTierra, poker:CuatroDeNormal, poker:CuatroDeRoca ;
    poker:manoTienePar poker:Siete, poker:Cuatro .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Ochos" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeRoca, poker:CincoDeTierra, poker:OchoDeAgua, poker:OchoDeVolador ;
    poker:manoTienePar poker:Cinco, poker:Ocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Dieciochos con Dos de Tierra" ;
    poker:contieneCarta poker:DieciochoDeTierra, poker:DieciochoDeBicho, poker:DieciochoDeVolador, poker:DieciochoDeFuego, poker:DosDeTierra .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Doses con Seis de Lucha" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeTierra, poker:DosDeRoca, poker:DosDePsiquico, poker:SeisDeLucha .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Doces con Seis de Roca" ;
    poker:contieneCarta poker:DoceDePsiquico, poker:DoceDeBicho, poker:DoceDeVeneno, poker:DoceDeFuego, poker:SeisDeRoca .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Ochos con Doce de Agua" ;
    poker:contieneCarta poker:OchoDeFuego, poker:OchoDeElectrico, poker:OchoDeVeneno, poker:OchoDeNormal, poker:DoceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Roca" ;
    poker:contieneCarta poker:CincoDeRoca, poker:SeisDeRoca, poker:SieteDeRoca, poker:OchoDeRoca, poker:NueveDeRoca .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Lucha" ;
    poker:contieneCarta poker:SieteDeLucha, poker:OchoDeLucha, poker:NueveDeLucha, poker:DiezDeLucha, poker:OnceDeLucha .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Planta" ;
    poker:contieneCarta poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta, poker:SeisDePlanta .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Psiquico" ;
    poker:contieneCarta poker:DosDePsiquico, poker:TresDePsiquico, poker:CuatroDePsiquico, poker:CincoDePsiquico, poker:SeisDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:QuinceDePsiquico, poker:DieciseisDePsiquico, poker:DiecisieteDePsiquico, poker:DieciochoDePsiquico, poker:DiecinueveDePsiquico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:DieciseisDeNormal, poker:DiecisieteDeNormal, poker:DieciochoDeNormal, poker:DiecinueveDeNormal .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:QuinceDeVolador, poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:QuinceDeTierra, poker:DieciseisDeTierra, poker:DiecisieteDeTierra, poker:DieciochoDeTierra, poker:DiecinueveDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
