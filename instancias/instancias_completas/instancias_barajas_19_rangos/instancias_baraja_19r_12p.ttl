# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Catorce con Trece Nueve Siete Cuatro" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:CuatroDeRoca, poker:CatorceDeTierra, poker:TreceDePsiquico, poker:SieteDeBicho .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Dieciseis Catorce Once Cuatro" ;
    poker:contieneCarta poker:CatorceDeBicho, poker:DieciseisDePsiquico, poker:DiecisieteDeVeneno, poker:OnceDeBicho, poker:CuatroDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Diez Ocho Cinco Tres" ;
    poker:contieneCarta poker:TreceDeVolador, poker:DiezDeRoca, poker:OchoDeVolador, poker:TresDeElectrico, poker:CincoDeVeneno .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Catorce con Doce Nueve Seis Tres" ;
    poker:contieneCarta poker:TresDePsiquico, poker:NueveDeFuego, poker:CatorceDeBicho, poker:SeisDeTierra, poker:DoceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Catorces con Dieciocho Trece Once" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:CatorceDeVolador, poker:TreceDeVeneno, poker:DieciochoDeRoca, poker:OnceDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Diecinueve Nueve Cinco" ;
    poker:contieneCarta poker:DieciseisDeLucha, poker:DieciseisDeAgua, poker:NueveDeTierra, poker:CincoDeLucha, poker:DiecinueveDeVolador .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Trece Once Tres" ;
    poker:contieneCarta poker:DieciseisDeNormal, poker:DieciseisDeBicho, poker:OnceDePsiquico, poker:TresDeAgua, poker:TreceDeLucha .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Nueves con Once Seis Tres" ;
    poker:contieneCarta poker:NueveDeTierra, poker:NueveDeRoca, poker:SeisDePsiquico, poker:TresDePsiquico, poker:OnceDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Catorces y Doces con Nueve" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeFuego, poker:CatorceDeLucha, poker:CatorceDeTierra, poker:NueveDeLucha ;
    poker:manoTienePar poker:Doce, poker:Catorce .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Seises con Trece" ;
    poker:contieneCarta poker:DiezDeFuego, poker:DiezDeVolador, poker:SeisDePsiquico, poker:SeisDePlanta, poker:TreceDeElectrico ;
    poker:manoTienePar poker:Diez, poker:Seis .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Doses con Dieciocho" ;
    poker:contieneCarta poker:DieciseisDePsiquico, poker:DieciseisDeNormal, poker:DosDeFuego, poker:DosDeNormal, poker:DieciochoDeVolador ;
    poker:manoTienePar poker:Dieciseis, poker:Dos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Cincos con Dieciseis" ;
    poker:contieneCarta poker:OnceDeVolador, poker:OnceDeAgua, poker:CincoDeLucha, poker:CincoDeTierra, poker:DieciseisDeLucha ;
    poker:manoTienePar poker:Once, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Doce Tres" ;
    poker:contieneCarta poker:CuatroDeLucha, poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:TresDePlanta, poker:DoceDeVolador .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Diecisietes con Once Diez" ;
    poker:contieneCarta poker:DiecisieteDeVeneno, poker:DiecisieteDePlanta, poker:DiecisieteDeTierra, poker:DiezDeLucha, poker:OnceDeElectrico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Sietes con Seis Cinco" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDeNormal, poker:SieteDeVeneno, poker:CincoDeVolador, poker:SeisDeBicho .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Catorces con Quince Ocho" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:CatorceDeBicho, poker:CatorceDeAgua, poker:OchoDeBicho, poker:QuinceDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDePsiquico, poker:SeisDeRoca, poker:SieteDePlanta, poker:OchoDeLucha, poker:NueveDePsiquico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeLucha, poker:OnceDeFuego, poker:DoceDeAgua, poker:TreceDeAgua, poker:CatorceDeElectrico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:QuinceDeVolador, poker:DieciseisDeAgua, poker:DiecisieteDeRoca, poker:DieciochoDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Once-Doce-Trece-Catorce-Quince" ;
    poker:contieneCarta poker:OnceDeAgua, poker:DoceDeElectrico, poker:TreceDeLucha, poker:CatorceDeAgua, poker:QuinceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciocho Dieciseis Catorce Cuatro de Planta" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:DieciochoDePlanta, poker:CuatroDePlanta, poker:DiecinueveDePlanta, poker:CatorceDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciocho Quince Catorce Nueve Ocho de Bicho" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:CatorceDeBicho, poker:OchoDeBicho, poker:NueveDeBicho, poker:DieciochoDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciseis Doce Diez Seis de Fuego" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DieciseisDeFuego, poker:DiecinueveDeFuego, poker:DiezDeFuego, poker:SeisDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Diecisiete Trece Doce Cuatro Dos de Lucha" ;
    poker:contieneCarta poker:TreceDeLucha, poker:CuatroDeLucha, poker:DoceDeLucha, poker:DiecisieteDeLucha, poker:DosDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Doces" ;
    poker:contieneCarta poker:OchoDeNormal, poker:OchoDeVeneno, poker:OchoDeElectrico, poker:DoceDeLucha, poker:DoceDeBicho ;
    poker:manoTienePar poker:Ocho, poker:Doce .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Ochos" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDeNormal, poker:SeisDeAgua, poker:OchoDePsiquico, poker:OchoDeLucha ;
    poker:manoTienePar poker:Seis, poker:Ocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Dieces" ;
    poker:contieneCarta poker:OnceDeNormal, poker:OnceDeRoca, poker:OnceDeTierra, poker:DiezDeNormal, poker:DiezDeAgua ;
    poker:manoTienePar poker:Once, poker:Diez .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Onces" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeVeneno, poker:SeisDeBicho, poker:OnceDeLucha, poker:OnceDeVolador ;
    poker:manoTienePar poker:Seis, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doses con Tres de Normal" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDeLucha, poker:DosDeFuego, poker:DosDeVolador, poker:TresDeNormal .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Quinces con Cinco de Lucha" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDeNormal, poker:QuinceDeAgua, poker:QuinceDeLucha, poker:CincoDeLucha .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Sietes con Dos de Roca" ;
    poker:contieneCarta poker:SieteDeVolador, poker:SieteDePsiquico, poker:SieteDeAgua, poker:SieteDeLucha, poker:DosDeRoca .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Quinces con Nueve de Veneno" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:QuinceDeVeneno, poker:QuinceDeElectrico, poker:QuinceDeLucha, poker:NueveDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Normal" ;
    poker:contieneCarta poker:DoceDeNormal, poker:TreceDeNormal, poker:CatorceDeNormal, poker:QuinceDeNormal, poker:DieciseisDeNormal .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Veneno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CincoDeVeneno, poker:SeisDeVeneno, poker:SieteDeVeneno, poker:OchoDeVeneno .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Psiquico" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:DosDePsiquico, poker:TresDePsiquico, poker:CuatroDePsiquico, poker:CincoDePsiquico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Normal" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SieteDeNormal, poker:OchoDeNormal, poker:NueveDeNormal, poker:DiezDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:QuinceDeTierra, poker:DieciseisDeTierra, poker:DiecisieteDeTierra, poker:DieciochoDeTierra, poker:DiecinueveDeTierra .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:DieciochoDeElectrico, poker:DiecinueveDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:QuinceDeVolador, poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
