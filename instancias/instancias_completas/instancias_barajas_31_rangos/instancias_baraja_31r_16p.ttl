# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Veintinueve Dieciseis Trece Siete" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:VeintinueveDeTierra, poker:DieciseisDeRoca, poker:TreintayunoDeFantasma, poker:SieteDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veinte Dieciocho Ocho Seis" ;
    poker:contieneCarta poker:TreintaDeNormal, poker:VeinteDeRoca, poker:SeisDeDragon, poker:DieciochoDeDragon, poker:OchoDeHielo .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciseis Doce Diez Cinco" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:DieciseisDePlanta, poker:DiecinueveDeFuego, poker:CincoDeFantasma, poker:DoceDeLucha .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiocho con Veintidos Once Diez Seis" ;
    poker:contieneCarta poker:SeisDePlanta, poker:DiezDeHielo, poker:OnceDeFuego, poker:VeintiochoDeAgua, poker:VeintidosDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Veintidoses con Veintinueve Veintisiete Trece" ;
    poker:contieneCarta poker:VeintidosDeVolador, poker:VeintidosDeVeneno, poker:TreceDePlanta, poker:VeintisieteDeElectrico, poker:VeintinueveDeTierra .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Catorces con Treinta Siete Tres" ;
    poker:contieneCarta poker:CatorceDeNormal, poker:CatorceDePlanta, poker:TresDeHielo, poker:SieteDeVolador, poker:TreintaDeNormal .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintiunos con Veintinueve Diecinueve Once" ;
    poker:contieneCarta poker:VeintiunoDeRoca, poker:VeintiunoDeVolador, poker:DiecinueveDeLucha, poker:VeintinueveDeNormal, poker:OnceDeBicho .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Seises con Treinta Ocho Uno" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDeVolador, poker:OchoDeSiniestro, poker:TreintaDeElectrico, poker:UnoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintiochos y Doces con Veintidos" ;
    poker:contieneCarta poker:DoceDeTierra, poker:DoceDeBicho, poker:VeintiochoDeRoca, poker:VeintiochoDeHielo, poker:VeintidosDeSiniestro ;
    poker:manoTienePar poker:Doce, poker:Veintiocho .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Quinces con Once" ;
    poker:contieneCarta poker:VeintiunoDeLucha, poker:VeintiunoDeHielo, poker:QuinceDeDragon, poker:QuinceDeFantasma, poker:OnceDeElectrico ;
    poker:manoTienePar poker:Veintiuno, poker:Quince .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Cuatros con Veintidos" ;
    poker:contieneCarta poker:DoceDeVeneno, poker:DoceDeDragon, poker:CuatroDePsiquico, poker:CuatroDeFantasma, poker:VeintidosDeFuego ;
    poker:manoTienePar poker:Doce, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Unos con Veinte" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintiunoDeHielo, poker:UnoDeLucha, poker:UnoDeBicho, poker:VeinteDeLucha ;
    poker:manoTienePar poker:Veintiuno, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treintas con Veintinueve Siete" ;
    poker:contieneCarta poker:TreintaDeVolador, poker:TreintaDePsiquico, poker:TreintaDeNormal, poker:SieteDeLucha, poker:VeintinueveDeDragon .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Veinticuatros con Veintisiete Quince" ;
    poker:contieneCarta poker:VeinticuatroDeRoca, poker:VeinticuatroDeVolador, poker:VeinticuatroDeBicho, poker:VeintisieteDePlanta, poker:QuinceDeSiniestro .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintiunos con Veintitres Cuatro" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintiunoDeVeneno, poker:VeintiunoDeSiniestro, poker:CuatroDeElectrico, poker:VeintitresDeVolador .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veintiseises con Catorce Dos" ;
    poker:contieneCarta poker:VeintiseisDeDragon, poker:VeintiseisDeHielo, poker:VeintiseisDePlanta, poker:CatorceDeLucha, poker:DosDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Once-Doce-Trece-Catorce-Quince" ;
    poker:contieneCarta poker:OnceDeBicho, poker:DoceDeNormal, poker:TreceDeLucha, poker:CatorceDeRoca, poker:QuinceDeHielo .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeintiunoDeFuego, poker:VeintidosDeBicho, poker:VeintitresDeLucha, poker:VeinticuatroDeRoca .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Trece-Catorce-Quince-Dieciseis-Diecisiete" ;
    poker:contieneCarta poker:TreceDeFuego, poker:CatorceDePsiquico, poker:QuinceDeFuego, poker:DieciseisDeFantasma, poker:DiecisieteDePsiquico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDeVeneno, poker:QuinceDeAgua, poker:DieciseisDeDragon, poker:DiecisieteDeDragon, poker:DieciochoDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintayuno Treinta Veintiocho Veintidos Diez de Fantasma" ;
    poker:contieneCarta poker:TreintayunoDeFantasma, poker:TreintaDeFantasma, poker:DiezDeFantasma, poker:VeintiochoDeFantasma, poker:VeintidosDeFantasma .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treinta Veintiocho Trece Nueve Cuatro de Lucha" ;
    poker:contieneCarta poker:TreceDeLucha, poker:CuatroDeLucha, poker:NueveDeLucha, poker:VeintiochoDeLucha, poker:TreintaDeLucha .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Diecinueve Dieciocho Dieciseis Nueve Dos de Tierra" ;
    poker:contieneCarta poker:DieciseisDeTierra, poker:DieciochoDeTierra, poker:NueveDeTierra, poker:DosDeTierra, poker:DiecinueveDeTierra .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veintitres Dieciocho Quince Tres de Agua" ;
    poker:contieneCarta poker:VeintitresDeAgua, poker:TresDeAgua, poker:VeintiochoDeAgua, poker:DieciochoDeAgua, poker:QuinceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticincos con Par de Veintiunos" ;
    poker:contieneCarta poker:VeinticincoDeRoca, poker:VeinticincoDeElectrico, poker:VeinticincoDeVeneno, poker:VeintiunoDeDragon, poker:VeintiunoDeFuego ;
    poker:manoTienePar poker:Veinticinco, poker:Veintiuno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Veintinueves" ;
    poker:contieneCarta poker:UnoDeHielo, poker:UnoDeRoca, poker:UnoDeLucha, poker:VeintinueveDeFantasma, poker:VeintinueveDeNormal ;
    poker:manoTienePar poker:Uno, poker:Veintinueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Seises" ;
    poker:contieneCarta poker:TreceDePsiquico, poker:TreceDeDragon, poker:TreceDeVeneno, poker:SeisDeLucha, poker:SeisDeAgua ;
    poker:manoTienePar poker:Trece, poker:Seis .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Treses" ;
    poker:contieneCarta poker:OnceDeFuego, poker:OnceDeLucha, poker:OnceDePsiquico, poker:TresDeElectrico, poker:TresDeLucha ;
    poker:manoTienePar poker:Once, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doces con Once de Agua" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeAgua, poker:DoceDeVeneno, poker:DoceDeVolador, poker:OnceDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treintayunos con Veintitres de Hielo" ;
    poker:contieneCarta poker:TreintayunoDeHielo, poker:TreintayunoDeDragon, poker:TreintayunoDeVolador, poker:TreintayunoDePlanta, poker:VeintitresDeHielo .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Ochos con Dieciseis de Volador" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDeVolador, poker:OchoDeHielo, poker:OchoDeNormal, poker:DieciseisDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Veintiseises con Siete de Fantasma" ;
    poker:contieneCarta poker:VeintiseisDeNormal, poker:VeintiseisDeSiniestro, poker:VeintiseisDeTierra, poker:VeintiseisDeAgua, poker:SieteDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:DosDeVeneno, poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta de Psiquico" ;
    poker:contieneCarta poker:VeintiseisDePsiquico, poker:VeintisieteDePsiquico, poker:VeintiochoDePsiquico, poker:VeintinueveDePsiquico, poker:TreintaDePsiquico .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve de Psiquico" ;
    poker:contieneCarta poker:VeinticincoDePsiquico, poker:VeintiseisDePsiquico, poker:VeintisieteDePsiquico, poker:VeintiochoDePsiquico, poker:VeintinueveDePsiquico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Siniestro" ;
    poker:contieneCarta poker:VeintitresDeSiniestro, poker:VeinticuatroDeSiniestro, poker:VeinticincoDeSiniestro, poker:VeintiseisDeSiniestro, poker:VeintisieteDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:VeintisieteDeLucha, poker:VeintiochoDeLucha, poker:VeintinueveDeLucha, poker:TreintaDeLucha, poker:TreintayunoDeLucha .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Hielo" ;
    poker:contieneCarta poker:VeintisieteDeHielo, poker:VeintiochoDeHielo, poker:VeintinueveDeHielo, poker:TreintaDeHielo, poker:TreintayunoDeHielo .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico, poker:TreintayunoDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:VeintisieteDePsiquico, poker:VeintiochoDePsiquico, poker:VeintinueveDePsiquico, poker:TreintaDePsiquico, poker:TreintayunoDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
