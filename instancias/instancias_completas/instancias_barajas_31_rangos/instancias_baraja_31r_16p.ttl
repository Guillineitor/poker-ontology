# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiuno con Catorce Diez Cuatro Uno" ;
    poker:contieneCarta poker:CatorceDeFantasma, poker:CuatroDeHielo, poker:DiezDeFantasma, poker:VeintiunoDeLucha, poker:UnoDeRoca .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Veintinueve Veintiocho Veintiseis Ocho" ;
    poker:contieneCarta poker:OchoDeLucha, poker:VeintiochoDeDragon, poker:VeintiseisDeHielo, poker:TreintayunoDeDragon, poker:VeintinueveDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintisiete con Veinticuatro Veinte Dieciseis Seis" ;
    poker:contieneCarta poker:SeisDeTierra, poker:DieciseisDeBicho, poker:VeintisieteDeRoca, poker:VeinticuatroDeFuego, poker:VeinteDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintisiete con Veinticinco Diecinueve Diecisiete Dieciseis" ;
    poker:contieneCarta poker:VeinticincoDeAgua, poker:DieciseisDeRoca, poker:DiecinueveDeTierra, poker:DiecisieteDePsiquico, poker:VeintisieteDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Veintisietes con Veintiocho Diecisiete Trece" ;
    poker:contieneCarta poker:VeintisieteDeDragon, poker:VeintisieteDePsiquico, poker:TreceDeFuego, poker:VeintiochoDeAgua, poker:DiecisieteDeVolador .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Treinta Veintidos Uno" ;
    poker:contieneCarta poker:DieciseisDeSiniestro, poker:DieciseisDeLucha, poker:TreintaDeVeneno, poker:VeintidosDeSiniestro, poker:UnoDeElectrico .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintinueves con Treinta Doce Cuatro" ;
    poker:contieneCarta poker:VeintinueveDePlanta, poker:VeintinueveDeVolador, poker:DoceDeHielo, poker:CuatroDePsiquico, poker:TreintaDeVolador .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Ochos con Diecinueve Seis Cinco" ;
    poker:contieneCarta poker:OchoDePsiquico, poker:OchoDeNormal, poker:CincoDeTierra, poker:SeisDeRoca, poker:DiecinueveDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Dieciseises con Uno" ;
    poker:contieneCarta poker:VeintidosDeElectrico, poker:VeintidosDePlanta, poker:DieciseisDeLucha, poker:DieciseisDePlanta, poker:UnoDeFantasma ;
    poker:manoTienePar poker:Veintidos, poker:Dieciseis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Dieciochos con Doce" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintiunoDeDragon, poker:DieciochoDeVeneno, poker:DieciochoDeFantasma, poker:DoceDePlanta ;
    poker:manoTienePar poker:Veintiuno, poker:Dieciocho .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintinueves y Ochos con Uno" ;
    poker:contieneCarta poker:VeintinueveDeVolador, poker:VeintinueveDeDragon, poker:OchoDeSiniestro, poker:OchoDePsiquico, poker:UnoDeHielo ;
    poker:manoTienePar poker:Veintinueve, poker:Ocho .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Treintayunos y Ochos con Cuatro" ;
    poker:contieneCarta poker:TreintayunoDeFantasma, poker:TreintayunoDeLucha, poker:OchoDeBicho, poker:OchoDeVeneno, poker:CuatroDeElectrico ;
    poker:manoTienePar poker:Treintayuno, poker:Ocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Veintiseises con Veintinueve Diecinueve" ;
    poker:contieneCarta poker:VeintiseisDeFantasma, poker:VeintiseisDeTierra, poker:VeintiseisDePlanta, poker:VeintinueveDeFuego, poker:DiecinueveDeRoca .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Treces con Diecisiete Cuatro" ;
    poker:contieneCarta poker:TreceDeVeneno, poker:TreceDeDragon, poker:TreceDePsiquico, poker:CuatroDeVeneno, poker:DiecisieteDeFantasma .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Treintayunos con Cinco Cuatro" ;
    poker:contieneCarta poker:TreintayunoDeDragon, poker:TreintayunoDePsiquico, poker:TreintayunoDeHielo, poker:CuatroDePsiquico, poker:CincoDePsiquico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veinticincos con Diecisiete Doce" ;
    poker:contieneCarta poker:VeinticincoDeHielo, poker:VeinticincoDeLucha, poker:VeinticincoDeVeneno, poker:DoceDeElectrico, poker:DiecisieteDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeHielo, poker:TreceDeVolador, poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDeSiniestro .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeDragon, poker:TresDeFuego, poker:CuatroDeRoca, poker:CincoDeLucha, poker:SeisDeVolador .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeFantasma, poker:TreceDeAgua, poker:CatorceDeVolador .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta" ;
    poker:contieneCarta poker:VeintiseisDeBicho, poker:VeintisieteDePsiquico, poker:VeintiochoDeFantasma, poker:VeintinueveDeTierra, poker:TreintaDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintidos Diecinueve Catorce Cuatro de Electrico" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:CatorceDeElectrico, poker:VeintinueveDeElectrico, poker:VeintidosDeElectrico, poker:CuatroDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treinta Veintitres Veintiuno Dieciseis Cinco de Veneno" ;
    poker:contieneCarta poker:TreintaDeVeneno, poker:VeintitresDeVeneno, poker:DieciseisDeVeneno, poker:CincoDeVeneno, poker:VeintiunoDeVeneno .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintayuno Treinta Veintinueve Veinte Uno de Hielo" ;
    poker:contieneCarta poker:VeinteDeHielo, poker:TreintaDeHielo, poker:VeintinueveDeHielo, poker:TreintayunoDeHielo, poker:UnoDeHielo .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintiocho Trece Ocho Tres de Hielo" ;
    poker:contieneCarta poker:OchoDeHielo, poker:TreceDeHielo, poker:VeintinueveDeHielo, poker:TresDeHielo, poker:VeintiochoDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Diecisietes" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:SeisDeNormal, poker:SeisDeVeneno, poker:DiecisieteDeBicho, poker:DiecisieteDeTierra ;
    poker:manoTienePar poker:Seis, poker:Diecisiete .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintitreses con Par de Treses" ;
    poker:contieneCarta poker:VeintitresDeElectrico, poker:VeintitresDeNormal, poker:VeintitresDeFantasma, poker:TresDeBicho, poker:TresDeLucha ;
    poker:manoTienePar poker:Veintitres, poker:Tres .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Diecinueves con Par de Catorces" ;
    poker:contieneCarta poker:DiecinueveDeVeneno, poker:DiecinueveDeTierra, poker:DiecinueveDeElectrico, poker:CatorceDeLucha, poker:CatorceDeVeneno ;
    poker:manoTienePar poker:Diecinueve, poker:Catorce .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Veinticuatros" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintidosDeVeneno, poker:VeintidosDeLucha, poker:VeinticuatroDeFuego, poker:VeinticuatroDeRoca ;
    poker:manoTienePar poker:Veintidos, poker:Veinticuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Dos de Tierra" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDePsiquico, poker:CincoDePlanta, poker:CincoDeBicho, poker:DosDeTierra .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Veinticinco de Hielo" ;
    poker:contieneCarta poker:CuatroDeTierra, poker:CuatroDePlanta, poker:CuatroDeSiniestro, poker:CuatroDePsiquico, poker:VeinticincoDeHielo .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veintinueves con Dieciocho de Planta" ;
    poker:contieneCarta poker:VeintinueveDeFantasma, poker:VeintinueveDeBicho, poker:VeintinueveDeVeneno, poker:VeintinueveDeSiniestro, poker:DieciochoDePlanta .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treintayunos con Ocho de Volador" ;
    poker:contieneCarta poker:TreintayunoDeSiniestro, poker:TreintayunoDeElectrico, poker:TreintayunoDeFuego, poker:TreintayunoDeBicho, poker:OchoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno de Agua" ;
    poker:contieneCarta poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua, poker:VeinteDeAgua, poker:VeintiunoDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Electrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos de Hielo" ;
    poker:contieneCarta poker:DieciochoDeHielo, poker:DiecinueveDeHielo, poker:VeinteDeHielo, poker:VeintiunoDeHielo, poker:VeintidosDeHielo .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta de Tierra" ;
    poker:contieneCarta poker:VeintiseisDeTierra, poker:VeintisieteDeTierra, poker:VeintiochoDeTierra, poker:VeintinueveDeTierra, poker:TreintaDeTierra .

