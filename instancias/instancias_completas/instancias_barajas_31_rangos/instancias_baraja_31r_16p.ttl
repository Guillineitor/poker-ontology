# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Veintidos Veintiuno Diecinueve Cuatro" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:VeintiunoDeFuego, poker:VeintidosDeNormal, poker:VeinticincoDeHielo, poker:CuatroDeHielo .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Veintidos Catorce Siete Tres" ;
    poker:contieneCarta poker:VeinticuatroDeVolador, poker:CatorceDeDragon, poker:TresDeTierra, poker:SieteDeSiniestro, poker:VeintidosDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintisiete Veinticuatro Once Ocho" ;
    poker:contieneCarta poker:OnceDeFantasma, poker:OchoDeHielo, poker:VeinticuatroDeTierra, poker:TreintaDeNormal, poker:VeintisieteDeNormal .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciseis Diez Cinco Cuatro" ;
    poker:contieneCarta poker:DiecinueveDeRoca, poker:CincoDeDragon, poker:DieciseisDeVolador, poker:DiezDePlanta, poker:CuatroDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Seises con Veinticinco Cinco Uno" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeHielo, poker:VeinticincoDePlanta, poker:UnoDeTierra, poker:CincoDeVolador .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Unos con Catorce Diez Cuatro" ;
    poker:contieneCarta poker:UnoDeSiniestro, poker:UnoDeVeneno, poker:CatorceDeFuego, poker:DiezDePsiquico, poker:CuatroDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintidoses con Veintitres Diez Cuatro" ;
    poker:contieneCarta poker:VeintidosDeFantasma, poker:VeintidosDeVolador, poker:CuatroDeLucha, poker:VeintitresDeHielo, poker:DiezDeElectrico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veinticincos con Veintiseis Quince Seis" ;
    poker:contieneCarta poker:VeinticincoDeNormal, poker:VeinticincoDeAgua, poker:QuinceDeNormal, poker:SeisDePlanta, poker:VeintiseisDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Unos con Veintiseis" ;
    poker:contieneCarta poker:UnoDeDragon, poker:UnoDeElectrico, poker:VeintidosDeVolador, poker:VeintidosDePsiquico, poker:VeintiseisDeAgua ;
    poker:manoTienePar poker:Uno, poker:Veintidos .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintiochos y Sietes con Dieciseis" ;
    poker:contieneCarta poker:VeintiochoDeHielo, poker:VeintiochoDeVeneno, poker:SieteDeNormal, poker:SieteDeLucha, poker:DieciseisDeElectrico ;
    poker:manoTienePar poker:Veintiocho, poker:Siete .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veinticuatros y Veintiunos con Veintiseis" ;
    poker:contieneCarta poker:VeinticuatroDePsiquico, poker:VeinticuatroDePlanta, poker:VeintiunoDeFuego, poker:VeintiunoDeDragon, poker:VeintiseisDeAgua ;
    poker:manoTienePar poker:Veinticuatro, poker:Veintiuno .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Treces con Nueve" ;
    poker:contieneCarta poker:VeintidosDeSiniestro, poker:VeintidosDeLucha, poker:TreceDeRoca, poker:TreceDeDragon, poker:NueveDeTierra ;
    poker:manoTienePar poker:Veintidos, poker:Trece .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Diecisietes con Ocho Tres" ;
    poker:contieneCarta poker:DiecisieteDeHielo, poker:DiecisieteDeElectrico, poker:DiecisieteDeRoca, poker:OchoDeLucha, poker:TresDeAgua .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Seises con Dieciseis Quince" ;
    poker:contieneCarta poker:SeisDeTierra, poker:SeisDeVolador, poker:SeisDeElectrico, poker:DieciseisDeFuego, poker:QuinceDeFantasma .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Treses con Quince Uno" ;
    poker:contieneCarta poker:TresDeVolador, poker:TresDeBicho, poker:TresDeVeneno, poker:UnoDePlanta, poker:QuinceDeTierra .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Dieces con Dieciseis Nueve" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:DiezDePsiquico, poker:DiezDePlanta, poker:DieciseisDeTierra, poker:NueveDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeTierra, poker:OnceDeFantasma, poker:DoceDeRoca, poker:TreceDeElectrico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SieteDePlanta, poker:OchoDeBicho, poker:NueveDePlanta, poker:DiezDeVolador .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeFantasma, poker:DieciseisDeElectrico, poker:DiecisieteDeSiniestro, poker:DieciochoDeVolador, poker:DiecinueveDeTierra .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeFuego, poker:DieciochoDeLucha, poker:DiecinueveDePlanta, poker:VeinteDeSiniestro, poker:VeintiunoDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintidos Veintiuno Cinco Dos de Siniestro" ;
    poker:contieneCarta poker:DosDeSiniestro, poker:VeintiunoDeSiniestro, poker:VeintinueveDeSiniestro, poker:CincoDeSiniestro, poker:VeintidosDeSiniestro .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veintinueve Veintiseis Catorce Once de Lucha" ;
    poker:contieneCarta poker:CatorceDeLucha, poker:TreintayunoDeLucha, poker:VeintiseisDeLucha, poker:OnceDeLucha, poker:VeintinueveDeLucha .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintiseis Veintiuno Ocho Cinco Cuatro de Lucha" ;
    poker:contieneCarta poker:CincoDeLucha, poker:VeintiunoDeLucha, poker:CuatroDeLucha, poker:VeintiseisDeLucha, poker:OchoDeLucha .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Treinta Veintinueve Veinticuatro Catorce Tres de Agua" ;
    poker:contieneCarta poker:VeintinueveDeAgua, poker:VeinticuatroDeAgua, poker:CatorceDeAgua, poker:TresDeAgua, poker:TreintaDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Veintinueves" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeFantasma, poker:CuatroDePsiquico, poker:VeintinueveDeLucha, poker:VeintinueveDeVolador ;
    poker:manoTienePar poker:Cuatro, poker:Veintinueve .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Seises" ;
    poker:contieneCarta poker:CatorceDeVeneno, poker:CatorceDeNormal, poker:CatorceDeSiniestro, poker:SeisDeElectrico, poker:SeisDeFantasma ;
    poker:manoTienePar poker:Catorce, poker:Seis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciochos con Par de Quinces" ;
    poker:contieneCarta poker:DieciochoDeVeneno, poker:DieciochoDeRoca, poker:DieciochoDeAgua, poker:QuinceDeFantasma, poker:QuinceDeSiniestro ;
    poker:manoTienePar poker:Dieciocho, poker:Quince .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Diecinueves con Par de Sietes" ;
    poker:contieneCarta poker:DiecinueveDeHielo, poker:DiecinueveDeRoca, poker:DiecinueveDeFuego, poker:SieteDePsiquico, poker:SieteDeTierra ;
    poker:manoTienePar poker:Diecinueve, poker:Siete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Doce de Electrico" ;
    poker:contieneCarta poker:VeinticincoDeLucha, poker:VeinticincoDeTierra, poker:VeinticincoDeDragon, poker:VeinticincoDeFuego, poker:DoceDeElectrico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veintiseises con Veintiuno de Fantasma" ;
    poker:contieneCarta poker:VeintiseisDeVeneno, poker:VeintiseisDeTierra, poker:VeintiseisDeVolador, poker:VeintiseisDeAgua, poker:VeintiunoDeFantasma .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Nueve de Volador" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeVolador, poker:TresDeHielo, poker:TresDeBicho, poker:NueveDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Veintes con Treintayuno de Bicho" ;
    poker:contieneCarta poker:VeinteDeTierra, poker:VeinteDeRoca, poker:VeinteDeFuego, poker:VeinteDeHielo, poker:TreintayunoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Normal" ;
    poker:contieneCarta poker:DoceDeNormal, poker:TreceDeNormal, poker:CatorceDeNormal, poker:QuinceDeNormal, poker:DieciseisDeNormal .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Electrico" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Bicho" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SieteDeBicho, poker:OchoDeBicho, poker:NueveDeBicho, poker:DiezDeBicho .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Catorce-Quince-Dieciseis-Diecisiete-Dieciocho de Roca" ;
    poker:contieneCarta poker:CatorceDeRoca, poker:QuinceDeRoca, poker:DieciseisDeRoca, poker:DiecisieteDeRoca, poker:DieciochoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintiochoDePlanta, poker:VeintinueveDePlanta, poker:TreintaDePlanta, poker:TreintayunoDePlanta .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:VeintisieteDeVolador, poker:VeintiochoDeVolador, poker:VeintinueveDeVolador, poker:TreintaDeVolador, poker:TreintayunoDeVolador .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:VeintisieteDeTierra, poker:VeintiochoDeTierra, poker:VeintinueveDeTierra, poker:TreintaDeTierra, poker:TreintayunoDeTierra .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Dragon" ;
    poker:contieneCarta poker:VeintisieteDeDragon, poker:VeintiochoDeDragon, poker:VeintinueveDeDragon, poker:TreintaDeDragon, poker:TreintayunoDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
