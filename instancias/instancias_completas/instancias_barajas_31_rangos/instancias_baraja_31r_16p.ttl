# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Catorce Once Seis Dos" ;
    poker:contieneCarta poker:VeintinueveDeLucha, poker:OnceDePsiquico, poker:SeisDePlanta, poker:CatorceDeAgua, poker:DosDeFantasma .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Veintiocho Veinticinco Trece Tres" ;
    poker:contieneCarta poker:VeintinueveDeTierra, poker:VeintiochoDeNormal, poker:VeinticincoDeTierra, poker:TresDeDragon, poker:TreceDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintiseis Veinticinco Tres Dos" ;
    poker:contieneCarta poker:VeinticincoDePlanta, poker:TresDeDragon, poker:DosDeAgua, poker:VeintiseisDeNormal, poker:TreintaDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiseis con Trece Nueve Ocho Uno" ;
    poker:contieneCarta poker:TreceDeFantasma, poker:NueveDeDragon, poker:OchoDePsiquico, poker:VeintiseisDeVeneno, poker:UnoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Dieciocho Diez Ocho" ;
    poker:contieneCarta poker:DiecisieteDeVeneno, poker:DiecisieteDeSiniestro, poker:DieciochoDeFuego, poker:DiezDeVeneno, poker:OchoDeLucha .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treses con Veintisiete Diez Siete" ;
    poker:contieneCarta poker:TresDeVolador, poker:TresDeDragon, poker:DiezDeRoca, poker:VeintisieteDeFantasma, poker:SieteDeBicho .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doces con Veintiocho Veintiuno Catorce" ;
    poker:contieneCarta poker:DoceDeFantasma, poker:DoceDeVeneno, poker:CatorceDeVolador, poker:VeintiochoDeTierra, poker:VeintiunoDeHielo .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veintisietes con Veintiocho Veintitres Uno" ;
    poker:contieneCarta poker:VeintisieteDeVeneno, poker:VeintisieteDeBicho, poker:VeintitresDeBicho, poker:VeintiochoDeBicho, poker:UnoDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Treces con Nueve" ;
    poker:contieneCarta poker:TreceDeBicho, poker:TreceDeElectrico, poker:VeintiunoDePsiquico, poker:VeintiunoDeElectrico, poker:NueveDeElectrico ;
    poker:manoTienePar poker:Trece, poker:Veintiuno .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Doces con Seis" ;
    poker:contieneCarta poker:DoceDeBicho, poker:DoceDeRoca, poker:DiecinueveDeHielo, poker:DiecinueveDeVolador, poker:SeisDeLucha ;
    poker:manoTienePar poker:Doce, poker:Diecinueve .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treintas y Veintinueves con Once" ;
    poker:contieneCarta poker:VeintinueveDeVeneno, poker:VeintinueveDeLucha, poker:TreintaDeFuego, poker:TreintaDeSiniestro, poker:OnceDeSiniestro ;
    poker:manoTienePar poker:Veintinueve, poker:Treinta .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Dieces con Once" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:DiezDePsiquico, poker:QuinceDeLucha, poker:QuinceDeTierra, poker:OnceDeNormal ;
    poker:manoTienePar poker:Diez, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Sietes con Treinta Veintinueve" ;
    poker:contieneCarta poker:SieteDeNormal, poker:SieteDeSiniestro, poker:SieteDeDragon, poker:VeintinueveDeFuego, poker:TreintaDeLucha .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Dieces con Veinticuatro Trece" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:DiezDeFantasma, poker:DiezDeTierra, poker:VeinticuatroDePlanta, poker:TreceDeTierra .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Unos con Siete Cuatro" ;
    poker:contieneCarta poker:UnoDeNormal, poker:UnoDeAgua, poker:UnoDeBicho, poker:CuatroDeVolador, poker:SieteDeSiniestro .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Cincos con Veinticinco Ocho" ;
    poker:contieneCarta poker:CincoDeSiniestro, poker:CincoDePlanta, poker:CincoDeLucha, poker:OchoDeBicho, poker:VeinticincoDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Trece-Catorce-Quince-Dieciseis-Diecisiete" ;
    poker:contieneCarta poker:TreceDeVeneno, poker:CatorceDeSiniestro, poker:QuinceDeFantasma, poker:DieciseisDeElectrico, poker:DiecisieteDeVeneno .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DiezDeFantasma, poker:OnceDeLucha, poker:DoceDeElectrico, poker:TreceDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho" ;
    poker:contieneCarta poker:VeinticuatroDeRoca, poker:VeinticincoDeDragon, poker:VeintiseisDeTierra, poker:VeintisieteDeElectrico, poker:VeintiochoDeVolador .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeHielo, poker:NueveDeTierra, poker:DiezDeBicho, poker:OnceDeLucha, poker:DoceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veintinueve Veintidos Veintiuno Dos de Siniestro" ;
    poker:contieneCarta poker:TreintayunoDeSiniestro, poker:VeintidosDeSiniestro, poker:VeintinueveDeSiniestro, poker:DosDeSiniestro, poker:VeintiunoDeSiniestro .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintayuno Catorce Doce Cinco Uno de Fantasma" ;
    poker:contieneCarta poker:TreintayunoDeFantasma, poker:CatorceDeFantasma, poker:UnoDeFantasma, poker:DoceDeFantasma, poker:CincoDeFantasma .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treinta Veintinueve Veintisiete Veintidos Once de Dragón" ;
    poker:contieneCarta poker:VeintinueveDeDragon, poker:VeintidosDeDragon, poker:OnceDeDragon, poker:VeintisieteDeDragon, poker:TreintaDeDragon .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintiuno Diecinueve Trece Cinco de Agua" ;
    poker:contieneCarta poker:VeintinueveDeAgua, poker:TreceDeAgua, poker:DiecinueveDeAgua, poker:CincoDeAgua, poker:VeintiunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Cincos" ;
    poker:contieneCarta poker:CatorceDeSiniestro, poker:CatorceDeFuego, poker:CatorceDeTierra, poker:CincoDeLucha, poker:CincoDeHielo ;
    poker:manoTienePar poker:Catorce, poker:Cinco .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Dieces" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeBicho, poker:DosDeLucha, poker:DiezDeVeneno, poker:DiezDeFuego ;
    poker:manoTienePar poker:Dos, poker:Diez .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Veinticincos" ;
    poker:contieneCarta poker:DiezDeDragon, poker:DiezDeElectrico, poker:DiezDePsiquico, poker:VeinticincoDeAgua, poker:VeinticincoDeBicho ;
    poker:manoTienePar poker:Diez, poker:Veinticinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Treintas" ;
    poker:contieneCarta poker:SieteDeHielo, poker:SieteDeFuego, poker:SieteDeSiniestro, poker:TreintaDeVolador, poker:TreintaDeDragon ;
    poker:manoTienePar poker:Siete, poker:Treinta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Onces con Siete de Eléctrico" ;
    poker:contieneCarta poker:OnceDeVeneno, poker:OnceDePlanta, poker:OnceDePsiquico, poker:OnceDeFuego, poker:SieteDeElectrico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treintayunos con Veinticinco de Hielo" ;
    poker:contieneCarta poker:TreintayunoDeHielo, poker:TreintayunoDeVolador, poker:TreintayunoDeAgua, poker:TreintayunoDeElectrico, poker:VeinticincoDeHielo .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Veintiuno de Bicho" ;
    poker:contieneCarta poker:VeinticincoDeVolador, poker:VeinticincoDeTierra, poker:VeinticincoDeNormal, poker:VeinticincoDeLucha, poker:VeintiunoDeBicho .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Veinticuatros con Uno de Planta" ;
    poker:contieneCarta poker:VeinticuatroDeNormal, poker:VeinticuatroDeVolador, poker:VeinticuatroDeTierra, poker:VeinticuatroDeElectrico, poker:UnoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve de Volador" ;
    poker:contieneCarta poker:QuinceDeVolador, poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Hielo" ;
    poker:contieneCarta poker:DosDeHielo, poker:TresDeHielo, poker:CuatroDeHielo, poker:CincoDeHielo, poker:SeisDeHielo .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Fuego" ;
    poker:contieneCarta poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco de Planta" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta, poker:VeinticincoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Roca" ;
    poker:contieneCarta poker:VeintisieteDeRoca, poker:VeintiochoDeRoca, poker:VeintinueveDeRoca, poker:TreintaDeRoca, poker:TreintayunoDeRoca .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:VeintisieteDeBicho, poker:VeintiochoDeBicho, poker:VeintinueveDeBicho, poker:TreintaDeBicho, poker:TreintayunoDeBicho .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Hielo" ;
    poker:contieneCarta poker:VeintisieteDeHielo, poker:VeintiochoDeHielo, poker:VeintinueveDeHielo, poker:TreintaDeHielo, poker:TreintayunoDeHielo .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Dragón" ;
    poker:contieneCarta poker:VeintisieteDeDragon, poker:VeintiochoDeDragon, poker:VeintinueveDeDragon, poker:TreintaDeDragon, poker:TreintayunoDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
