# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Quince con Catorce Ocho Siete Tres" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:TresDeFuego, poker:SieteDeNormal, poker:CatorceDeNormal, poker:OchoDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Diecisiete Doce Nueve Cinco" ;
    poker:contieneCarta poker:DiecisieteDeVolador, poker:NueveDeBicho, poker:TreintaDeFuego, poker:CincoDeVolador, poker:DoceDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Veintisiete Diecinueve Diecisiete Diez" ;
    poker:contieneCarta poker:DiezDeBicho, poker:VeintinueveDeVeneno, poker:VeintisieteDeVeneno, poker:DiecisieteDeFuego, poker:DiecinueveDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiseis con Veinticinco Veinte Quince Doce" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:DoceDeBicho, poker:VeinteDeAgua, poker:VeintiseisDeNormal, poker:VeinticincoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Catorces con Veintitres Veintidos Diecinueve" ;
    poker:contieneCarta poker:CatorceDeVeneno, poker:CatorceDeElectrico, poker:VeintitresDeNormal, poker:DiecinueveDeAgua, poker:VeintidosDeElectrico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Nueves con Veinticinco Diez Tres" ;
    poker:contieneCarta poker:NueveDeVolador, poker:NueveDeBicho, poker:TresDePlanta, poker:DiezDeElectrico, poker:VeinticincoDeBicho .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veinticuatros con Veintidos Dieciseis Quince" ;
    poker:contieneCarta poker:VeinticuatroDePlanta, poker:VeinticuatroDeElectrico, poker:DieciseisDeVeneno, poker:QuinceDePlanta, poker:VeintidosDeFuego .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Cincos con Veintiocho Veintitres Siete" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDePlanta, poker:SieteDeFuego, poker:VeintitresDePlanta, poker:VeintiochoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Quinces con Veintinueve" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDeBicho, poker:VeintiunoDePlanta, poker:VeintiunoDeAgua, poker:VeintinueveDeAgua ;
    poker:manoTienePar poker:Quince, poker:Veintiuno .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veinticuatros y Veintes con Ocho" ;
    poker:contieneCarta poker:VeinteDeFuego, poker:VeinteDeNormal, poker:VeinticuatroDePlanta, poker:VeinticuatroDeVolador, poker:OchoDeVolador ;
    poker:manoTienePar poker:Veinte, poker:Veinticuatro .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Cuatros con Diecisiete" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:CincoDeFuego, poker:CincoDeElectrico, poker:DiecisieteDeVolador ;
    poker:manoTienePar poker:Cuatro, poker:Cinco .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintiochos y Quinces con Treintayuno" ;
    poker:contieneCarta poker:VeintiochoDeNormal, poker:VeintiochoDeElectrico, poker:QuinceDeElectrico, poker:QuinceDeFuego, poker:TreintayunoDeElectrico ;
    poker:manoTienePar poker:Veintiocho, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Diecinueves con Treinta Cinco" ;
    poker:contieneCarta poker:DiecinueveDeNormal, poker:DiecinueveDePlanta, poker:DiecinueveDeFuego, poker:TreintaDeVeneno, poker:CincoDeVolador .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Veintiochos con Veintiuno Cinco" ;
    poker:contieneCarta poker:VeintiochoDeElectrico, poker:VeintiochoDeVeneno, poker:VeintiochoDeFuego, poker:CincoDeVolador, poker:VeintiunoDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintinueves con Veintiocho Veintitres" ;
    poker:contieneCarta poker:VeintinueveDeVolador, poker:VeintinueveDeFuego, poker:VeintinueveDePlanta, poker:VeintiochoDeFuego, poker:VeintitresDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veintiseises con Diez Uno" ;
    poker:contieneCarta poker:VeintiseisDeVolador, poker:VeintiseisDeAgua, poker:VeintiseisDePlanta, poker:UnoDeAgua, poker:DiezDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Ocho-Nueve-Diez-Once-Doce" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:NueveDeVolador, poker:DiezDeFuego, poker:OnceDeNormal, poker:DoceDeVolador .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:DiezDeVolador, poker:OnceDeBicho, poker:DoceDeAgua, poker:TreceDeNormal .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veintisiete-Veintiocho-Veintinueve-Treinta-Treintayuno" ;
    poker:contieneCarta poker:VeintisieteDeBicho, poker:VeintiochoDeVeneno, poker:VeintinueveDeElectrico, poker:TreintaDeAgua, poker:TreintayunoDeBicho .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos" ;
    poker:contieneCarta poker:DieciochoDeBicho, poker:DiecinueveDeNormal, poker:VeinteDeFuego, poker:VeintiunoDeBicho, poker:VeintidosDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veinte Quince Trece Doce de Volador" ;
    poker:contieneCarta poker:TreceDeVolador, poker:DoceDeVolador, poker:QuinceDeVolador, poker:VeinticuatroDeVolador, poker:VeinteDeVolador .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veintiseis Veinte Ocho Tres Uno de Fuego" ;
    poker:contieneCarta poker:VeintiseisDeFuego, poker:VeinteDeFuego, poker:OchoDeFuego, poker:UnoDeFuego, poker:TresDeFuego .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintiseis Catorce Siete Tres de Volador" ;
    poker:contieneCarta poker:VeintinueveDeVolador, poker:TresDeVolador, poker:CatorceDeVolador, poker:VeintiseisDeVolador, poker:SieteDeVolador .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veinte Diecinueve Dieciocho Tres de Volador" ;
    poker:contieneCarta poker:DieciochoDeVolador, poker:DiecinueveDeVolador, poker:TresDeVolador, poker:VeinteDeVolador, poker:VeintiochoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticincos con Par de Treces" ;
    poker:contieneCarta poker:VeinticincoDeVeneno, poker:VeinticincoDeVolador, poker:VeinticincoDeAgua, poker:TreceDeBicho, poker:TreceDeElectrico ;
    poker:manoTienePar poker:Veinticinco, poker:Trece .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintiochos con Par de Ochos" ;
    poker:contieneCarta poker:VeintiochoDeAgua, poker:VeintiochoDeBicho, poker:VeintiochoDeFuego, poker:OchoDeVeneno, poker:OchoDeNormal ;
    poker:manoTienePar poker:Veintiocho, poker:Ocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Quinces con Par de Veintisietes" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:QuinceDeFuego, poker:QuinceDeVolador, poker:VeintisieteDePlanta, poker:VeintisieteDeVeneno ;
    poker:manoTienePar poker:Quince, poker:Veintisiete .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Quinces" ;
    poker:contieneCarta poker:DiecisieteDeAgua, poker:DiecisieteDeElectrico, poker:DiecisieteDeBicho, poker:QuinceDeFuego, poker:QuinceDeVolador ;
    poker:manoTienePar poker:Diecisiete, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Cincos con Cuatro de Bicho" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeAgua, poker:CincoDeFuego, poker:CincoDeBicho, poker:CuatroDeBicho .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Cinco de Normal" ;
    poker:contieneCarta poker:DiecisieteDeVeneno, poker:DiecisieteDeVolador, poker:DiecisieteDeBicho, poker:DiecisieteDePlanta, poker:CincoDeNormal .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Dieciseises con Treinta de Veneno" ;
    poker:contieneCarta poker:DieciseisDeNormal, poker:DieciseisDePlanta, poker:DieciseisDeVolador, poker:DieciseisDeAgua, poker:TreintaDeVeneno .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Dieciseises con Dieciocho de Agua" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DieciseisDeNormal, poker:DieciseisDeFuego, poker:DieciseisDePlanta, poker:DieciochoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve de Normal" ;
    poker:contieneCarta poker:VeinticincoDeNormal, poker:VeintiseisDeNormal, poker:VeintisieteDeNormal, poker:VeintiochoDeNormal, poker:VeintinueveDeNormal .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Bicho" ;
    poker:contieneCarta poker:VeintitresDeBicho, poker:VeinticuatroDeBicho, poker:VeinticincoDeBicho, poker:VeintiseisDeBicho, poker:VeintisieteDeBicho .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco de Fuego" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintidosDeFuego, poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Volador" ;
    poker:contieneCarta poker:DoceDeVolador, poker:TreceDeVolador, poker:CatorceDeVolador, poker:QuinceDeVolador, poker:DieciseisDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:VeintisieteDeVeneno, poker:VeintiochoDeVeneno, poker:VeintinueveDeVeneno, poker:TreintaDeVeneno, poker:TreintayunoDeVeneno .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:VeintisieteDeNormal, poker:VeintiochoDeNormal, poker:VeintinueveDeNormal, poker:TreintaDeNormal, poker:TreintayunoDeNormal .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintiochoDePlanta, poker:VeintinueveDePlanta, poker:TreintaDePlanta, poker:TreintayunoDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:VeintisieteDeBicho, poker:VeintiochoDeBicho, poker:VeintinueveDeBicho, poker:TreintaDeBicho, poker:TreintayunoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
