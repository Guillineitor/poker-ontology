# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Diecisiete Once Seis Cuatro" ;
    poker:contieneCarta poker:OnceDeNormal, poker:CuatroDeVeneno, poker:SeisDeVeneno, poker:VeinticuatroDeVeneno, poker:DiecisieteDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Diez Cinco Cuatro Tres" ;
    poker:contieneCarta poker:TresDeElectrico, poker:DiezDeNormal, poker:CuatroDeVeneno, poker:CincoDeAgua, poker:DiecisieteDeVolador .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veinticuatro Diecisiete Catorce Ocho" ;
    poker:contieneCarta poker:OchoDeNormal, poker:VeinticuatroDeVolador, poker:DiecisieteDeFuego, poker:TreintaDePlanta, poker:CatorceDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Veintiuno Diecisiete Quince Once" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:VeintiunoDeVeneno, poker:VeintitresDeElectrico, poker:OnceDeVolador, poker:DiecisieteDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Veintes con Veintidos Dieciseis Cinco" ;
    poker:contieneCarta poker:VeinteDeVolador, poker:VeinteDeFuego, poker:DieciseisDeFuego, poker:VeintidosDeAgua, poker:CincoDePlanta .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Veintiocho Doce Once" ;
    poker:contieneCarta poker:DiecisieteDeElectrico, poker:DiecisieteDeVolador, poker:OnceDeFuego, poker:DoceDeVolador, poker:VeintiochoDeVolador .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doses con Treinta Veintitres Trece" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDeBicho, poker:VeintitresDeFuego, poker:TreceDeVolador, poker:TreintaDeVolador .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Doses con Treinta Veintiocho Tres" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeAgua, poker:VeintiochoDeVolador, poker:TresDeFuego, poker:TreintaDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Doses con Trece" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeAgua, poker:NueveDePlanta, poker:NueveDeVeneno, poker:TreceDeAgua ;
    poker:manoTienePar poker:Dos, poker:Nueve .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Cincos con Veintisiete" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDePlanta, poker:VeintidosDePlanta, poker:VeintidosDeVolador, poker:VeintisieteDeElectrico ;
    poker:manoTienePar poker:Cinco, poker:Veintidos .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treintas y Dieces con Veintitres" ;
    poker:contieneCarta poker:TreintaDePlanta, poker:TreintaDeNormal, poker:DiezDeBicho, poker:DiezDeNormal, poker:VeintitresDeBicho ;
    poker:manoTienePar poker:Treinta, poker:Diez .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintisietes y Dieciochos con Veinte" ;
    poker:contieneCarta poker:DieciochoDeNormal, poker:DieciochoDeAgua, poker:VeintisieteDeFuego, poker:VeintisieteDeNormal, poker:VeinteDeVolador ;
    poker:manoTienePar poker:Dieciocho, poker:Veintisiete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Veintes con Diez Cuatro" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeinteDeNormal, poker:VeinteDeBicho, poker:DiezDePlanta, poker:CuatroDeElectrico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Onces con Veintiuno Trece" ;
    poker:contieneCarta poker:OnceDeBicho, poker:OnceDeElectrico, poker:OnceDeVolador, poker:TreceDeBicho, poker:VeintiunoDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintitreses con Veintiuno Diecisiete" ;
    poker:contieneCarta poker:VeintitresDePlanta, poker:VeintitresDeFuego, poker:VeintitresDeNormal, poker:VeintiunoDeElectrico, poker:DiecisieteDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veintiunos con Veintinueve Doce" ;
    poker:contieneCarta poker:VeintiunoDeVeneno, poker:VeintiunoDeNormal, poker:VeintiunoDeAgua, poker:VeintinueveDeNormal, poker:DoceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:OnceDeElectrico, poker:DoceDeVeneno, poker:TreceDeNormal, poker:CatorceDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte" ;
    poker:contieneCarta poker:DieciseisDeVolador, poker:DiecisieteDeElectrico, poker:DieciochoDeVeneno, poker:DiecinueveDeVeneno, poker:VeinteDeBicho .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho" ;
    poker:contieneCarta poker:VeinticuatroDeAgua, poker:VeinticincoDePlanta, poker:VeintiseisDeFuego, poker:VeintisieteDeFuego, poker:VeintiochoDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Once-Doce-Trece-Catorce-Quince" ;
    poker:contieneCarta poker:OnceDeAgua, poker:DoceDeElectrico, poker:TreceDeBicho, poker:CatorceDeElectrico, poker:QuinceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veintiuno Seis Cuatro Dos de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:CuatroDeAgua, poker:VeintiunoDeAgua, poker:SeisDeAgua, poker:TreintayunoDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintayuno Dieciocho Diecisiete Doce Cinco de Veneno" ;
    poker:contieneCarta poker:DieciochoDeVeneno, poker:TreintayunoDeVeneno, poker:DiecisieteDeVeneno, poker:DoceDeVeneno, poker:CincoDeVeneno .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veintiseis Once Nueve Cuatro de Electrico" ;
    poker:contieneCarta poker:VeintiochoDeElectrico, poker:OnceDeElectrico, poker:CuatroDeElectrico, poker:NueveDeElectrico, poker:VeintiseisDeElectrico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintiocho Catorce Trece Diez Siete de Normal" ;
    poker:contieneCarta poker:VeintiochoDeNormal, poker:DiezDeNormal, poker:SieteDeNormal, poker:TreceDeNormal, poker:CatorceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Treintayunos" ;
    poker:contieneCarta poker:DoceDeVolador, poker:DoceDeAgua, poker:DoceDeVeneno, poker:TreintayunoDePlanta, poker:TreintayunoDeBicho ;
    poker:manoTienePar poker:Doce, poker:Treintayuno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Ochos" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:CatorceDeNormal, poker:CatorceDeVeneno, poker:OchoDePlanta, poker:OchoDeFuego ;
    poker:manoTienePar poker:Catorce, poker:Ocho .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Doces" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintidosDeFuego, poker:VeintidosDePlanta, poker:DoceDePlanta, poker:DoceDeVeneno ;
    poker:manoTienePar poker:Veintidos, poker:Doce .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Diecinueves" ;
    poker:contieneCarta poker:SieteDeBicho, poker:SieteDeFuego, poker:SieteDeVeneno, poker:DiecinueveDeAgua, poker:DiecinueveDeElectrico ;
    poker:manoTienePar poker:Siete, poker:Diecinueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Catorce de Normal" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:VeinticincoDeNormal, poker:VeinticincoDeBicho, poker:VeinticincoDeVeneno, poker:CatorceDeNormal .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treintayunos con Veintidos de Veneno" ;
    poker:contieneCarta poker:TreintayunoDeNormal, poker:TreintayunoDeVeneno, poker:TreintayunoDeVolador, poker:TreintayunoDePlanta, poker:VeintidosDeVeneno .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treintas con Quince de Bicho" ;
    poker:contieneCarta poker:TreintaDePlanta, poker:TreintaDeNormal, poker:TreintaDeFuego, poker:TreintaDeVolador, poker:QuinceDeBicho .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Diecinueves con Catorce de Planta" ;
    poker:contieneCarta poker:DiecinueveDeVeneno, poker:DiecinueveDeBicho, poker:DiecinueveDeAgua, poker:DiecinueveDeNormal, poker:CatorceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Bicho" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SieteDeBicho, poker:OchoDeBicho, poker:NueveDeBicho, poker:DiezDeBicho .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Fuego" ;
    poker:contieneCarta poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego, poker:VeintiseisDeFuego, poker:VeintisieteDeFuego .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte de Planta" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta, poker:VeinteDePlanta .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Planta" ;
    poker:contieneCarta poker:DoceDePlanta, poker:TreceDePlanta, poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintisieteDeAgua, poker:VeintiochoDeAgua, poker:VeintinueveDeAgua, poker:TreintaDeAgua, poker:TreintayunoDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintiochoDeFuego, poker:VeintinueveDeFuego, poker:TreintaDeFuego, poker:TreintayunoDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico, poker:TreintayunoDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintiochoDePlanta, poker:VeintinueveDePlanta, poker:TreintaDePlanta, poker:TreintayunoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
