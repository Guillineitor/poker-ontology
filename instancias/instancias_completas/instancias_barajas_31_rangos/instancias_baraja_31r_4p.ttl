# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintisiete con Veintiuno Diecinueve Nueve Cuatro" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:CuatroDePlanta, poker:VeintiunoDeFuego, poker:DiecinueveDeElectrico, poker:NueveDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Veintiuno Cinco Tres Uno" ;
    poker:contieneCarta poker:UnoDeAgua, poker:TreintayunoDeAgua, poker:VeintiunoDeAgua, poker:TresDePlanta, poker:CincoDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Veinticinco Siete Cinco Tres" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:TresDePlanta, poker:VeintinueveDeFuego, poker:CincoDeElectrico, poker:SieteDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintiocho Veintidos Once Dos" ;
    poker:contieneCarta poker:VeintiochoDeFuego, poker:DosDeAgua, poker:OnceDePlanta, poker:TreintaDePlanta, poker:VeintidosDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Veintiseises con Dieciseis Catorce Cuatro" ;
    poker:contieneCarta poker:VeintiseisDeAgua, poker:VeintiseisDeElectrico, poker:CatorceDeFuego, poker:DieciseisDePlanta, poker:CuatroDePlanta .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Veintes con Veintinueve Veintiocho Tres" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeinteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TresDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doces con Dieciseis Nueve Cuatro" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeAgua, poker:DieciseisDeFuego, poker:NueveDeAgua, poker:CuatroDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treintas con Treintayuno Veintitres Siete" ;
    poker:contieneCarta poker:TreintaDeElectrico, poker:TreintaDeAgua, poker:SieteDeFuego, poker:VeintitresDeAgua, poker:TreintayunoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Unos con Ocho" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDePlanta, poker:QuinceDeElectrico, poker:QuinceDeAgua, poker:OchoDeElectrico ;
    poker:manoTienePar poker:Uno, poker:Quince .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintiochos y Unos con Siete" ;
    poker:contieneCarta poker:VeintiochoDeElectrico, poker:VeintiochoDeFuego, poker:UnoDeAgua, poker:UnoDeFuego, poker:SieteDeAgua ;
    poker:manoTienePar poker:Veintiocho, poker:Uno .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintitreses y Dieces con Catorce" ;
    poker:contieneCarta poker:VeintitresDeElectrico, poker:VeintitresDeAgua, poker:DiezDePlanta, poker:DiezDeAgua, poker:CatorceDeFuego ;
    poker:manoTienePar poker:Veintitres, poker:Diez .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintiochos y Seises con Cuatro" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDeElectrico, poker:VeintiochoDePlanta, poker:VeintiochoDeAgua, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Seis, poker:Veintiocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treintayunos con Veinte Once" ;
    poker:contieneCarta poker:TreintayunoDePlanta, poker:TreintayunoDeAgua, poker:TreintayunoDeFuego, poker:OnceDeElectrico, poker:VeinteDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Veintiseis Catorce" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDePlanta, poker:DoceDeFuego, poker:CatorceDePlanta, poker:VeintiseisDeElectrico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintes con Treintayuno Veinticuatro" ;
    poker:contieneCarta poker:VeinteDeAgua, poker:VeinteDeFuego, poker:VeinteDeElectrico, poker:VeinticuatroDeAgua, poker:TreintayunoDePlanta .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Doces con Veintinueve Catorce" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeAgua, poker:DoceDeFuego, poker:CatorceDeElectrico, poker:VeintinueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeFuego, poker:TreceDeElectrico, poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeElectrico, poker:OchoDeElectrico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeAgua, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeFuego, poker:CatorceDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro" ;
    poker:contieneCarta poker:VeinteDeElectrico, poker:VeintiunoDeAgua, poker:VeintidosDeAgua, poker:VeintitresDeElectrico, poker:VeinticuatroDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veintiseis Doce Cinco Cuatro de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:DoceDeAgua, poker:CuatroDeAgua, poker:VeintiseisDeAgua, poker:TreintayunoDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veintisiete Veintiseis Trece Nueve Uno de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico, poker:UnoDeElectrico, poker:TreceDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veintidos Once Seis Cuatro de Planta" ;
    poker:contieneCarta poker:SeisDePlanta, poker:VeintiochoDePlanta, poker:VeintidosDePlanta, poker:OnceDePlanta, poker:CuatroDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintiseis Veintitres Veinte Diez Siete de Fuego" ;
    poker:contieneCarta poker:VeintitresDeFuego, poker:SieteDeFuego, poker:VeinteDeFuego, poker:DiezDeFuego, poker:VeintiseisDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciochos con Par de Veintiunos" ;
    poker:contieneCarta poker:DieciochoDeElectrico, poker:DieciochoDeAgua, poker:DieciochoDeFuego, poker:VeintiunoDeElectrico, poker:VeintiunoDeAgua ;
    poker:manoTienePar poker:Dieciocho, poker:Veintiuno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Diecinueves con Par de Veintinueves" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:DiecinueveDeFuego, poker:DiecinueveDeAgua, poker:VeintinueveDeAgua, poker:VeintinueveDeElectrico ;
    poker:manoTienePar poker:Diecinueve, poker:Veintinueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Nueves" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDeFuego, poker:TreceDePlanta, poker:NueveDeAgua, poker:NueveDePlanta ;
    poker:manoTienePar poker:Trece, poker:Nueve .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Treintas" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDePlanta, poker:DosDeFuego, poker:TreintaDeElectrico, poker:TreintaDePlanta ;
    poker:manoTienePar poker:Dos, poker:Treinta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Onces con Veinticinco de Planta" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeFuego, poker:OnceDeElectrico, poker:OnceDePlanta, poker:VeinticincoDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veintiseises con Veintitres de Electrico" ;
    poker:contieneCarta poker:VeintiseisDeAgua, poker:VeintiseisDeFuego, poker:VeintiseisDeElectrico, poker:VeintiseisDePlanta, poker:VeintitresDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Diecinueves con Veintiseis de Electrico" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:DiecinueveDeFuego, poker:DiecinueveDeElectrico, poker:DiecinueveDeAgua, poker:VeintiseisDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Cinco de Fuego" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:VeinticincoDeAgua, poker:VeinticincoDePlanta, poker:VeinticincoDeElectrico, poker:CincoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Electrico" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve de Agua" ;
    poker:contieneCarta poker:VeinticincoDeAgua, poker:VeintiseisDeAgua, poker:VeintisieteDeAgua, poker:VeintiochoDeAgua, poker:VeintinueveDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Electrico" ;
    poker:contieneCarta poker:VeintitresDeElectrico, poker:VeinticuatroDeElectrico, poker:VeinticincoDeElectrico, poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Planta" ;
    poker:contieneCarta poker:SieteDePlanta, poker:OchoDePlanta, poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico, poker:TreintayunoDeElectrico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintiochoDeFuego, poker:VeintinueveDeFuego, poker:TreintaDeFuego, poker:TreintayunoDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintiochoDePlanta, poker:VeintinueveDePlanta, poker:TreintaDePlanta, poker:TreintayunoDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintisieteDeAgua, poker:VeintiochoDeAgua, poker:VeintinueveDeAgua, poker:TreintaDeAgua, poker:TreintayunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
