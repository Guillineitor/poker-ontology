# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiocho con Veintisiete Veinte Quince Diez" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:VeintisieteDePlanta, poker:VeintiochoDePlanta, poker:DiezDeFuego, poker:VeinteDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Veintiuno Quince Seis Cinco" ;
    poker:contieneCarta poker:CincoDePlanta, poker:QuinceDeFuego, poker:SeisDeAgua, poker:VeintiunoDeAgua, poker:VeintidosDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiuno con Quince Catorce Once Dos" ;
    poker:contieneCarta poker:CatorceDeFuego, poker:DosDePlanta, poker:OnceDeFuego, poker:VeintiunoDeElectrico, poker:QuinceDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Veintidos Veintiuno Trece Diez" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:VeintinueveDeAgua, poker:DiezDeElectrico, poker:VeintiunoDeElectrico, poker:VeintidosDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Ochos con Veintinueve Doce Once" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeElectrico, poker:VeintinueveDeFuego, poker:OnceDeAgua, poker:DoceDeElectrico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Unos con Veinticinco Veintiuno Diecisiete" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeAgua, poker:DiecisieteDeFuego, poker:VeinticincoDeAgua, poker:VeintiunoDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doses con Veintidos Dieciseis Seis" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeAgua, poker:VeintidosDePlanta, poker:SeisDeAgua, poker:DieciseisDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Sietes con Veintidos Catorce Tres" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDeAgua, poker:CatorceDeFuego, poker:VeintidosDeFuego, poker:TresDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintitreses y Veintes con Nueve" ;
    poker:contieneCarta poker:VeinteDeFuego, poker:VeinteDePlanta, poker:VeintitresDeAgua, poker:VeintitresDePlanta, poker:NueveDeAgua ;
    poker:manoTienePar poker:Veinte, poker:Veintitres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veinticuatros y Sietes con Uno" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:VeinticuatroDePlanta, poker:SieteDeAgua, poker:SieteDeElectrico, poker:UnoDeFuego ;
    poker:manoTienePar poker:Veinticuatro, poker:Siete .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Dieces con Dieciseis" ;
    poker:contieneCarta poker:DiezDeFuego, poker:DiezDePlanta, poker:VeintidosDeElectrico, poker:VeintidosDePlanta, poker:DieciseisDePlanta ;
    poker:manoTienePar poker:Diez, poker:Veintidos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Dieces con Dieciseis" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDePlanta, poker:VeintidosDeAgua, poker:VeintidosDeElectrico, poker:DieciseisDePlanta ;
    poker:manoTienePar poker:Diez, poker:Veintidos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Seises con Ocho Cinco" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDeElectrico, poker:SeisDePlanta, poker:OchoDeFuego, poker:CincoDeAgua .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Veintitreses con Treinta Cinco" ;
    poker:contieneCarta poker:VeintitresDeAgua, poker:VeintitresDePlanta, poker:VeintitresDeElectrico, poker:TreintaDeAgua, poker:CincoDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintiochos con Diecisiete Siete" ;
    poker:contieneCarta poker:VeintiochoDeElectrico, poker:VeintiochoDePlanta, poker:VeintiochoDeAgua, poker:DiecisieteDeElectrico, poker:SieteDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Dieciseises con Treintayuno Trece" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:DieciseisDeElectrico, poker:DieciseisDeAgua, poker:TreintayunoDeFuego, poker:TreceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDePlanta, poker:CuatroDeFuego, poker:CincoDeElectrico, poker:SeisDeFuego, poker:SieteDeElectrico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veintidos-Veintitres-Veinticuatro-Veinticinco-Veintiseis" ;
    poker:contieneCarta poker:VeintidosDeElectrico, poker:VeintitresDeAgua, poker:VeinticuatroDePlanta, poker:VeinticincoDeElectrico, poker:VeintiseisDeElectrico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CincoDePlanta, poker:SeisDePlanta, poker:SieteDeElectrico, poker:OchoDeAgua .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Veintisiete-Veintiocho-Veintinueve-Treinta-Treintayuno" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintiochoDeAgua, poker:VeintinueveDeAgua, poker:TreintaDeFuego, poker:TreintayunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintiseis Veinticinco Veintiuno Nueve Cinco de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:VeintiunoDePlanta, poker:VeintiseisDePlanta, poker:CincoDePlanta, poker:VeinticincoDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treinta Veintisiete Veinticuatro Veintidos Trece de Agua" ;
    poker:contieneCarta poker:VeintisieteDeAgua, poker:VeinticuatroDeAgua, poker:TreceDeAgua, poker:VeintidosDeAgua, poker:TreintaDeAgua .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintitres Veintidos Diecinueve Dieciseis Cuatro de Planta" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:VeintitresDePlanta, poker:VeintidosDePlanta, poker:CuatroDePlanta, poker:DiecinueveDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Dieciocho Catorce Nueve Seis Tres de Agua" ;
    poker:contieneCarta poker:TresDeAgua, poker:CatorceDeAgua, poker:DieciochoDeAgua, poker:NueveDeAgua, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veintinueves con Par de Cincos" ;
    poker:contieneCarta poker:VeintinueveDeElectrico, poker:VeintinueveDeFuego, poker:VeintinueveDeAgua, poker:CincoDeFuego, poker:CincoDeAgua ;
    poker:manoTienePar poker:Veintinueve, poker:Cinco .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treintayunos con Par de Seises" ;
    poker:contieneCarta poker:TreintayunoDePlanta, poker:TreintayunoDeAgua, poker:TreintayunoDeFuego, poker:SeisDeAgua, poker:SeisDePlanta ;
    poker:manoTienePar poker:Treintayuno, poker:Seis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Treintayunos" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDeFuego, poker:OchoDePlanta, poker:TreintayunoDePlanta, poker:TreintayunoDeAgua ;
    poker:manoTienePar poker:Ocho, poker:Treintayuno .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Veinticuatros" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeFuego, poker:UnoDeElectrico, poker:VeinticuatroDeFuego, poker:VeinticuatroDePlanta ;
    poker:manoTienePar poker:Uno, poker:Veinticuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Veinticuatros con Quince de Planta" ;
    poker:contieneCarta poker:VeinticuatroDeElectrico, poker:VeinticuatroDeFuego, poker:VeinticuatroDePlanta, poker:VeinticuatroDeAgua, poker:QuinceDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veintidoses con Quince de Planta" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintidosDeElectrico, poker:VeintidosDePlanta, poker:VeintidosDeFuego, poker:QuinceDePlanta .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veintitreses con Doce de Fuego" ;
    poker:contieneCarta poker:VeintitresDePlanta, poker:VeintitresDeFuego, poker:VeintitresDeElectrico, poker:VeintitresDeAgua, poker:DoceDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Veinticuatros con Veintiocho de Agua" ;
    poker:contieneCarta poker:VeinticuatroDeElectrico, poker:VeinticuatroDeFuego, poker:VeinticuatroDeAgua, poker:VeinticuatroDePlanta, poker:VeintiochoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho de Agua" ;
    poker:contieneCarta poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua, poker:VeintiseisDeAgua, poker:VeintisieteDeAgua, poker:VeintiochoDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Trece-Catorce-Quince-Dieciseis-Diecisiete de Fuego" ;
    poker:contieneCarta poker:TreceDeFuego, poker:CatorceDeFuego, poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeFuego .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Catorce-Quince-Dieciseis-Diecisiete-Dieciocho de Agua" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve de Agua" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico, poker:TreintayunoDeElectrico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintiochoDeFuego, poker:VeintinueveDeFuego, poker:TreintaDeFuego, poker:TreintayunoDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintiochoDePlanta, poker:VeintinueveDePlanta, poker:TreintaDePlanta, poker:TreintayunoDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintisieteDeAgua, poker:VeintiochoDeAgua, poker:VeintinueveDeAgua, poker:TreintaDeAgua, poker:TreintayunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
