# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiocho con Veintisiete Veintiseis Diecisiete Siete" ;
    poker:contieneCarta poker:VeintiseisDeElectrico, poker:VeintiochoDeElectrico, poker:DiecisieteDePlanta, poker:SieteDeElectrico, poker:VeintisieteDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Ocho Siete Seis Dos" ;
    poker:contieneCarta poker:DosDeElectrico, poker:SeisDeAgua, poker:VeintinueveDePlanta, poker:SieteDeElectrico, poker:OchoDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiuno con Quince Diez Ocho Cuatro" ;
    poker:contieneCarta poker:OchoDePlanta, poker:QuinceDeElectrico, poker:CuatroDeElectrico, poker:VeintiunoDeFuego, poker:DiezDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Veintisiete Dieciocho Nueve Ocho" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:VeintisieteDeElectrico, poker:TreintayunoDeAgua, poker:DieciochoDePlanta, poker:OchoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Nueves con Veinticinco Veinte Siete" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:NueveDePlanta, poker:VeinteDeAgua, poker:VeinticincoDeElectrico, poker:SieteDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Dieciocho Seis Tres" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:DieciochoDeFuego, poker:TresDePlanta, poker:SeisDeElectrico .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veinticuatros con Veintiseis Diecinueve Quince" ;
    poker:contieneCarta poker:VeinticuatroDeElectrico, poker:VeinticuatroDeFuego, poker:VeintiseisDeFuego, poker:QuinceDePlanta, poker:DiecinueveDeFuego .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Dieces con Veintinueve Veintisiete Trece" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDePlanta, poker:TreceDeAgua, poker:VeintinueveDePlanta, poker:VeintisieteDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Cincos con Veintidos" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDePlanta, poker:CincoDePlanta, poker:CincoDeElectrico, poker:VeintidosDeElectrico ;
    poker:manoTienePar poker:Trece, poker:Cinco .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintinueves y Veintes con Quince" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeinteDeElectrico, poker:VeintinueveDePlanta, poker:VeintinueveDeElectrico, poker:QuinceDeFuego ;
    poker:manoTienePar poker:Veinte, poker:Veintinueve .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Sietes con Diecinueve" ;
    poker:contieneCarta poker:DiezDeFuego, poker:DiezDeElectrico, poker:SieteDeElectrico, poker:SieteDeAgua, poker:DiecinueveDeAgua ;
    poker:manoTienePar poker:Diez, poker:Siete .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintinueves y Veintiochos con Catorce" ;
    poker:contieneCarta poker:VeintinueveDePlanta, poker:VeintinueveDeFuego, poker:VeintiochoDeAgua, poker:VeintiochoDeFuego, poker:CatorceDePlanta ;
    poker:manoTienePar poker:Veintinueve, poker:Veintiocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Nueves con Dieciocho Catorce" ;
    poker:contieneCarta poker:NueveDeFuego, poker:NueveDeElectrico, poker:NueveDeAgua, poker:CatorceDeElectrico, poker:DieciochoDeAgua .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Veinticinco Diecinueve" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeAgua, poker:DoceDePlanta, poker:VeinticincoDeElectrico, poker:DiecinueveDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Seises con Treintayuno Cinco" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeElectrico, poker:SeisDePlanta, poker:TreintayunoDeFuego, poker:CincoDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Treses con Veintiocho Uno" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeElectrico, poker:TresDeFuego, poker:UnoDeFuego, poker:VeintiochoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeElectrico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeElectrico, poker:DieciochoDeFuego, poker:DiecinueveDeElectrico, poker:VeinteDePlanta, poker:VeintiunoDeFuego .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve" ;
    poker:contieneCarta poker:VeinticincoDeAgua, poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:DieciseisDeAgua, poker:DiecisieteDePlanta, poker:DieciochoDePlanta, poker:DiecinueveDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintiuno Diecinueve Once Tres de Planta" ;
    poker:contieneCarta poker:VeinticuatroDePlanta, poker:TresDePlanta, poker:VeintiunoDePlanta, poker:DiecinueveDePlanta, poker:OnceDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treinta Veintiseis Diecinueve Cuatro Tres de Electrico" ;
    poker:contieneCarta poker:VeintiseisDeElectrico, poker:TreintaDeElectrico, poker:CuatroDeElectrico, poker:DiecinueveDeElectrico, poker:TresDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veintiuno Diez Siete Tres de Agua" ;
    poker:contieneCarta poker:TresDeAgua, poker:VeintiochoDeAgua, poker:DiezDeAgua, poker:VeintiunoDeAgua, poker:SieteDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintidos Veintiuno Trece Tres de Planta" ;
    poker:contieneCarta poker:TresDePlanta, poker:VeintidosDePlanta, poker:TreceDePlanta, poker:VeintinueveDePlanta, poker:VeintiunoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Seises" ;
    poker:contieneCarta poker:NueveDeFuego, poker:NueveDePlanta, poker:NueveDeAgua, poker:SeisDeAgua, poker:SeisDeElectrico ;
    poker:manoTienePar poker:Nueve, poker:Seis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Veintinueves" ;
    poker:contieneCarta poker:NueveDeAgua, poker:NueveDeElectrico, poker:NueveDeFuego, poker:VeintinueveDePlanta, poker:VeintinueveDeFuego ;
    poker:manoTienePar poker:Nueve, poker:Veintinueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticuatros con Par de Diecisietes" ;
    poker:contieneCarta poker:VeinticuatroDeElectrico, poker:VeinticuatroDeAgua, poker:VeinticuatroDePlanta, poker:DiecisieteDeElectrico, poker:DiecisieteDeFuego ;
    poker:manoTienePar poker:Veinticuatro, poker:Diecisiete .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Veintes con Par de Veintitreses" ;
    poker:contieneCarta poker:VeinteDeAgua, poker:VeinteDePlanta, poker:VeinteDeElectrico, poker:VeintitresDeFuego, poker:VeintitresDePlanta ;
    poker:manoTienePar poker:Veinte, poker:Veintitres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Siete de Agua" ;
    poker:contieneCarta poker:DiecisieteDeFuego, poker:DiecisieteDeElectrico, poker:DiecisieteDeAgua, poker:DiecisieteDePlanta, poker:SieteDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Dieciochos con Seis de Fuego" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DieciochoDeAgua, poker:DieciochoDeFuego, poker:DieciochoDeElectrico, poker:SeisDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veinticuatros con Diecisiete de Planta" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:VeinticuatroDeElectrico, poker:VeinticuatroDeAgua, poker:VeinticuatroDePlanta, poker:DiecisieteDePlanta .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Ochos con Diez de Electrico" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeFuego, poker:OchoDeElectrico, poker:OchoDeAgua, poker:DiezDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Fuego" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte de Agua" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:DieciochoDeAgua, poker:DiecinueveDeAgua, poker:VeinteDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Nueve-Diez-Once-Doce-Trece de Electrico" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintiochoDeFuego, poker:VeintinueveDeFuego, poker:TreintaDeFuego, poker:TreintayunoDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintiochoDePlanta, poker:VeintinueveDePlanta, poker:TreintaDePlanta, poker:TreintayunoDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico, poker:TreintayunoDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintisieteDeAgua, poker:VeintiochoDeAgua, poker:VeintinueveDeAgua, poker:TreintaDeAgua, poker:TreintayunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
