# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Doce Seis Cinco Tres" ;
    poker:contieneCarta poker:CincoDeNormal, poker:DoceDeAgua, poker:TresDeTierra, poker:VeintidosDeTierra, poker:SeisDeBicho .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Veintiuno Diecisiete Doce Tres" ;
    poker:contieneCarta poker:DiecisieteDeElectrico, poker:DoceDeElectrico, poker:VeintiunoDeLucha, poker:VeintitresDeVolador, poker:TresDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Veintitres Diecinueve Trece Uno" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:TreceDeNormal, poker:DiecinueveDeLucha, poker:VeintitresDeElectrico, poker:UnoDePsiquico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Trece Diez Cuatro Uno" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:DieciseisDeLucha, poker:DiezDeAgua, poker:TreceDePlanta, poker:UnoDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Veintiseises con Veintisiete Diecisiete Doce" ;
    poker:contieneCarta poker:VeintiseisDeElectrico, poker:VeintiseisDeVeneno, poker:DiecisieteDePlanta, poker:VeintisieteDeLucha, poker:DoceDeRoca .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Dieciseis Tres Uno" ;
    poker:contieneCarta poker:DiecisieteDeLucha, poker:DiecisieteDeTierra, poker:TresDeNormal, poker:DieciseisDeTierra, poker:UnoDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Veintitres Doce Seis" ;
    poker:contieneCarta poker:DiecisieteDeNormal, poker:DiecisieteDeAgua, poker:VeintitresDeFuego, poker:DoceDeVeneno, poker:SeisDeNormal .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Seises con Veintisiete Veintidos Nueve" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDePsiquico, poker:VeintisieteDeNormal, poker:VeintidosDeTierra, poker:NueveDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Quinces con Ocho" ;
    poker:contieneCarta poker:DieciseisDeBicho, poker:DieciseisDeNormal, poker:QuinceDeTierra, poker:QuinceDePlanta, poker:OchoDeElectrico ;
    poker:manoTienePar poker:Dieciseis, poker:Quince .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Doses con Catorce" ;
    poker:contieneCarta poker:DosDeRoca, poker:DosDeLucha, poker:DieciseisDeTierra, poker:DieciseisDeFuego, poker:CatorceDePsiquico ;
    poker:manoTienePar poker:Dos, poker:Dieciseis .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Diecinueves con Nueve" ;
    poker:contieneCarta poker:DiecinueveDeBicho, poker:DiecinueveDeVolador, poker:VeinteDeElectrico, poker:VeinteDeTierra, poker:NueveDeAgua ;
    poker:manoTienePar poker:Diecinueve, poker:Veinte .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veinticincos y Unos con Nueve" ;
    poker:contieneCarta poker:UnoDeTierra, poker:UnoDeRoca, poker:VeinticincoDePlanta, poker:VeinticincoDeNormal, poker:NueveDeVeneno ;
    poker:manoTienePar poker:Uno, poker:Veinticinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Unos con Veinticuatro Cuatro" ;
    poker:contieneCarta poker:UnoDeVolador, poker:UnoDeVeneno, poker:UnoDeAgua, poker:VeinticuatroDeFuego, poker:CuatroDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Veinte Ocho" ;
    poker:contieneCarta poker:DoceDeTierra, poker:DoceDeLucha, poker:DoceDePlanta, poker:OchoDeTierra, poker:VeinteDeFuego .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cincos con Veintinueve Diecisiete" ;
    poker:contieneCarta poker:CincoDeLucha, poker:CincoDeAgua, poker:CincoDeTierra, poker:DiecisieteDeVolador, poker:VeintinueveDeLucha .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Diecisietes con Quince Dos" ;
    poker:contieneCarta poker:DiecisieteDeAgua, poker:DiecisieteDeTierra, poker:DiecisieteDeRoca, poker:DosDeRoca, poker:QuinceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Trece-Catorce-Quince-Dieciseis-Diecisiete" ;
    poker:contieneCarta poker:TreceDePsiquico, poker:CatorceDeRoca, poker:QuinceDeNormal, poker:DieciseisDeVeneno, poker:DiecisieteDePsiquico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeElectrico, poker:TresDeLucha, poker:CuatroDeElectrico, poker:CincoDeFuego, poker:SeisDeLucha .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CincoDeVeneno, poker:SeisDeElectrico, poker:SieteDePsiquico, poker:OchoDeLucha .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SieteDeBicho, poker:OchoDeRoca, poker:NueveDeVeneno, poker:DiezDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veintiocho Veintisiete Veinticinco Dos de Roca" ;
    poker:contieneCarta poker:VeintisieteDeRoca, poker:VeinticincoDeRoca, poker:DosDeRoca, poker:TreintayunoDeRoca, poker:VeintiochoDeRoca .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treinta Veintitres Veinte Dieciseis Uno de Volador" ;
    poker:contieneCarta poker:DieciseisDeVolador, poker:UnoDeVolador, poker:TreintaDeVolador, poker:VeintitresDeVolador, poker:VeinteDeVolador .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veinte Dieciocho Catorce Uno de Tierra" ;
    poker:contieneCarta poker:VeinteDeTierra, poker:CatorceDeTierra, poker:DieciochoDeTierra, poker:TreintayunoDeTierra, poker:UnoDeTierra .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Treinta Veintiseis Diecinueve Catorce Ocho de Bicho" ;
    poker:contieneCarta poker:DiecinueveDeBicho, poker:OchoDeBicho, poker:CatorceDeBicho, poker:VeintiseisDeBicho, poker:TreintaDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Veintiseises" ;
    poker:contieneCarta poker:VeintidosDeTierra, poker:VeintidosDeAgua, poker:VeintidosDeVeneno, poker:VeintiseisDePsiquico, poker:VeintiseisDeAgua ;
    poker:manoTienePar poker:Veintidos, poker:Veintiseis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintes con Par de Catorces" ;
    poker:contieneCarta poker:VeinteDeElectrico, poker:VeinteDeVolador, poker:VeinteDePsiquico, poker:CatorceDeElectrico, poker:CatorceDeVeneno ;
    poker:manoTienePar poker:Veinte, poker:Catorce .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Dieciseises" ;
    poker:contieneCarta poker:SieteDeBicho, poker:SieteDeVeneno, poker:SieteDePlanta, poker:DieciseisDeElectrico, poker:DieciseisDeFuego ;
    poker:manoTienePar poker:Siete, poker:Dieciseis .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Unos" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeFuego, poker:NueveDeElectrico, poker:UnoDeBicho, poker:UnoDeNormal ;
    poker:manoTienePar poker:Nueve, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Dieciseises con Veintinueve de Lucha" ;
    poker:contieneCarta poker:DieciseisDeElectrico, poker:DieciseisDeLucha, poker:DieciseisDeTierra, poker:DieciseisDeAgua, poker:VeintinueveDeLucha .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Catorces con Diecinueve de Roca" ;
    poker:contieneCarta poker:CatorceDeBicho, poker:CatorceDeRoca, poker:CatorceDeFuego, poker:CatorceDeNormal, poker:DiecinueveDeRoca .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Siete de Normal" ;
    poker:contieneCarta poker:VeinticincoDeVolador, poker:VeinticincoDeRoca, poker:VeinticincoDeLucha, poker:VeinticincoDeElectrico, poker:SieteDeNormal .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Nueves con Veintiocho de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:NueveDeFuego, poker:NueveDeVolador, poker:NueveDeNormal, poker:VeintiochoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco de Lucha" ;
    poker:contieneCarta poker:VeintiunoDeLucha, poker:VeintidosDeLucha, poker:VeintitresDeLucha, poker:VeinticuatroDeLucha, poker:VeinticincoDeLucha .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho de Veneno" ;
    poker:contieneCarta poker:VeinticuatroDeVeneno, poker:VeinticincoDeVeneno, poker:VeintiseisDeVeneno, poker:VeintisieteDeVeneno, poker:VeintiochoDeVeneno .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Electrico" ;
    poker:contieneCarta poker:VeintitresDeElectrico, poker:VeinticuatroDeElectrico, poker:VeinticincoDeElectrico, poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Planta" ;
    poker:contieneCarta poker:UnoDePlanta, poker:DosDePlanta, poker:TresDePlanta, poker:CuatroDePlanta, poker:CincoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:VeintisieteDeVolador, poker:VeintiochoDeVolador, poker:VeintinueveDeVolador, poker:TreintaDeVolador, poker:TreintayunoDeVolador .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:VeintisieteDeTierra, poker:VeintiochoDeTierra, poker:VeintinueveDeTierra, poker:TreintaDeTierra, poker:TreintayunoDeTierra .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:VeintisieteDeNormal, poker:VeintiochoDeNormal, poker:VeintinueveDeNormal, poker:TreintaDeNormal, poker:TreintayunoDeNormal .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:VeintisieteDeLucha, poker:VeintiochoDeLucha, poker:VeintinueveDeLucha, poker:TreintaDeLucha, poker:TreintayunoDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
