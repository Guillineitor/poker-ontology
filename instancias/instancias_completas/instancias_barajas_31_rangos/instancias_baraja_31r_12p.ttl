# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiseis con Dieciseis Doce Seis Uno" ;
    poker:contieneCarta poker:SeisDeAgua, poker:DoceDeLucha, poker:VeintiseisDeVolador, poker:DieciseisDeVolador, poker:UnoDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiseis con Veinticinco Catorce Cinco Tres" ;
    poker:contieneCarta poker:VeintiseisDeElectrico, poker:CatorceDeElectrico, poker:VeinticincoDeVeneno, poker:TresDePsiquico, poker:CincoDeVolador .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Veinte Doce Diez Uno" ;
    poker:contieneCarta poker:DoceDeLucha, poker:VeinticuatroDeNormal, poker:UnoDePsiquico, poker:DiezDeAgua, poker:VeinteDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintiocho Veinte Once Tres" ;
    poker:contieneCarta poker:OnceDeVolador, poker:VeinteDeBicho, poker:VeintiochoDeTierra, poker:TreintaDeLucha, poker:TresDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cuatros con Treinta Veinte Dieciocho" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeBicho, poker:TreintaDeVeneno, poker:VeinteDeFuego, poker:DieciochoDeRoca .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treces con Veintiseis Veintitres Ocho" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDeVolador, poker:OchoDeVolador, poker:VeintitresDePsiquico, poker:VeintiseisDeElectrico .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Onces con Veintiocho Veinticinco Dieciocho" ;
    poker:contieneCarta poker:OnceDeVeneno, poker:OnceDeBicho, poker:VeinticincoDePlanta, poker:VeintiochoDeVolador, poker:DieciochoDeBicho .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veintisietes con Treinta Dieciocho Tres" ;
    poker:contieneCarta poker:VeintisieteDeElectrico, poker:VeintisieteDeVolador, poker:TreintaDeVolador, poker:TresDePlanta, poker:DieciochoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintiochos y Veintitreses con Doce" ;
    poker:contieneCarta poker:VeintiochoDeBicho, poker:VeintiochoDeVolador, poker:VeintitresDeBicho, poker:VeintitresDeRoca, poker:DoceDeBicho ;
    poker:manoTienePar poker:Veintiocho, poker:Veintitres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintinueves y Veintitreses con Dieciocho" ;
    poker:contieneCarta poker:VeintitresDeAgua, poker:VeintitresDeBicho, poker:VeintinueveDeVolador, poker:VeintinueveDePsiquico, poker:DieciochoDeVolador ;
    poker:manoTienePar poker:Veintitres, poker:Veintinueve .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Doses con Doce" ;
    poker:contieneCarta poker:NueveDePlanta, poker:NueveDeRoca, poker:DosDeTierra, poker:DosDePsiquico, poker:DoceDeTierra ;
    poker:manoTienePar poker:Nueve, poker:Dos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintiseises y Dieciseises con Diecisiete" ;
    poker:contieneCarta poker:VeintiseisDeAgua, poker:VeintiseisDeFuego, poker:DieciseisDeVeneno, poker:DieciseisDeElectrico, poker:DiecisieteDeVolador ;
    poker:manoTienePar poker:Veintiseis, poker:Dieciseis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Veinticuatro Diez" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:CuatroDeNormal, poker:VeinticuatroDeFuego, poker:DiezDeTierra .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Sietes con Veintiocho Veintitres" ;
    poker:contieneCarta poker:SieteDeNormal, poker:SieteDeElectrico, poker:SieteDeVolador, poker:VeintitresDeRoca, poker:VeintiochoDePsiquico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieciseises con Treinta Veintisiete" ;
    poker:contieneCarta poker:DieciseisDeLucha, poker:DieciseisDeVeneno, poker:DieciseisDeNormal, poker:TreintaDeNormal, poker:VeintisieteDeVeneno .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Treses con Treinta Doce" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeLucha, poker:TresDeBicho, poker:DoceDeNormal, poker:TreintaDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeElectrico, poker:CuatroDeFuego, poker:CincoDeBicho, poker:SeisDeVeneno, poker:SieteDeElectrico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta" ;
    poker:contieneCarta poker:VeintiseisDeTierra, poker:VeintisieteDeNormal, poker:VeintiochoDeNormal, poker:VeintinueveDeRoca, poker:TreintaDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte" ;
    poker:contieneCarta poker:DieciseisDeLucha, poker:DiecisieteDeFuego, poker:DieciochoDeLucha, poker:DiecinueveDeRoca, poker:VeinteDePsiquico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CincoDeRoca, poker:SeisDePsiquico, poker:SieteDeRoca, poker:OchoDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintiuno Once Seis Cuatro Tres de Psiquico" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:VeintiunoDePsiquico, poker:TresDePsiquico, poker:CuatroDePsiquico, poker:OnceDePsiquico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veinticinco Veinticuatro Diez Siete Cinco de Bicho" ;
    poker:contieneCarta poker:SieteDeBicho, poker:DiezDeBicho, poker:VeinticuatroDeBicho, poker:VeinticincoDeBicho, poker:CincoDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintidos Veinte Diecisiete Cinco de Normal" ;
    poker:contieneCarta poker:CincoDeNormal, poker:DiecisieteDeNormal, poker:VeintidosDeNormal, poker:VeinticuatroDeNormal, poker:VeinteDeNormal .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintisiete Ocho Seis Dos de Electrico" ;
    poker:contieneCarta poker:VeintinueveDeElectrico, poker:VeintisieteDeElectrico, poker:OchoDeElectrico, poker:SeisDeElectrico, poker:DosDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticincos con Par de Doces" ;
    poker:contieneCarta poker:VeinticincoDeVeneno, poker:VeinticincoDePlanta, poker:VeinticincoDeRoca, poker:DoceDeVeneno, poker:DoceDeTierra ;
    poker:manoTienePar poker:Veinticinco, poker:Doce .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Cincos" ;
    poker:contieneCarta poker:VeintidosDeLucha, poker:VeintidosDeAgua, poker:VeintidosDeBicho, poker:CincoDeTierra, poker:CincoDePlanta ;
    poker:manoTienePar poker:Veintidos, poker:Cinco .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Cincos" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:NueveDeNormal, poker:NueveDePlanta, poker:CincoDeTierra, poker:CincoDeNormal ;
    poker:manoTienePar poker:Nueve, poker:Cinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Dieciochos" ;
    poker:contieneCarta poker:SieteDeLucha, poker:SieteDePsiquico, poker:SieteDeNormal, poker:DieciochoDeVolador, poker:DieciochoDeNormal ;
    poker:manoTienePar poker:Siete, poker:Dieciocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Sietes con Veintisiete de Planta" ;
    poker:contieneCarta poker:SieteDeVolador, poker:SieteDeLucha, poker:SieteDePlanta, poker:SieteDePsiquico, poker:VeintisieteDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veintiochos con Trece de Lucha" ;
    poker:contieneCarta poker:VeintiochoDePlanta, poker:VeintiochoDeFuego, poker:VeintiochoDeVolador, poker:VeintiochoDeNormal, poker:TreceDeLucha .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Dieces con Veintidos de Normal" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDeRoca, poker:DiezDePsiquico, poker:DiezDeVolador, poker:VeintidosDeNormal .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Unos con Veinticinco de Normal" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDePlanta, poker:UnoDeAgua, poker:UnoDeBicho, poker:VeinticincoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Once-Doce-Trece-Catorce-Quince de Normal" ;
    poker:contieneCarta poker:OnceDeNormal, poker:DoceDeNormal, poker:TreceDeNormal, poker:CatorceDeNormal, poker:QuinceDeNormal .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veintidos-Veintitres-Veinticuatro-Veinticinco-Veintiseis de Agua" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua, poker:VeintiseisDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve de Lucha" ;
    poker:contieneCarta poker:QuinceDeLucha, poker:DieciseisDeLucha, poker:DiecisieteDeLucha, poker:DieciochoDeLucha, poker:DiecinueveDeLucha .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve de Psiquico" ;
    poker:contieneCarta poker:VeinticincoDePsiquico, poker:VeintiseisDePsiquico, poker:VeintisieteDePsiquico, poker:VeintiochoDePsiquico, poker:VeintinueveDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:VeintisieteDeVeneno, poker:VeintiochoDeVeneno, poker:VeintinueveDeVeneno, poker:TreintaDeVeneno, poker:TreintayunoDeVeneno .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:VeintisieteDeLucha, poker:VeintiochoDeLucha, poker:VeintinueveDeLucha, poker:TreintaDeLucha, poker:TreintayunoDeLucha .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintiochoDeFuego, poker:VeintinueveDeFuego, poker:TreintaDeFuego, poker:TreintayunoDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:VeintisieteDePsiquico, poker:VeintiochoDePsiquico, poker:VeintinueveDePsiquico, poker:TreintaDePsiquico, poker:TreintayunoDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
