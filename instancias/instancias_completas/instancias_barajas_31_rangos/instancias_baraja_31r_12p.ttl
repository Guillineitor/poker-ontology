# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintisiete Dieciocho Nueve Ocho" ;
    poker:contieneCarta poker:OchoDeTierra, poker:NueveDeVolador, poker:VeintisieteDeRoca, poker:DieciochoDeVolador, poker:TreintaDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintisiete con Veintiuno Quince Once Ocho" ;
    poker:contieneCarta poker:VeintisieteDeTierra, poker:QuinceDeNormal, poker:OchoDePlanta, poker:OnceDeAgua, poker:VeintiunoDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintisiete con Dieciseis Once Siete Cuatro" ;
    poker:contieneCarta poker:OnceDeNormal, poker:VeintisieteDeLucha, poker:DieciseisDeRoca, poker:SieteDeFuego, poker:CuatroDeTierra .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Veinticinco Dieciocho Seis Cuatro" ;
    poker:contieneCarta poker:DieciochoDeAgua, poker:SeisDeNormal, poker:VeinticincoDeFuego, poker:TreintayunoDeVeneno, poker:CuatroDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Cuatros con Veintiocho Once Seis" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDeRoca, poker:SeisDePlanta, poker:VeintiochoDePsiquico, poker:OnceDeNormal .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Treintayuno Veintiseis Cinco" ;
    poker:contieneCarta poker:DieciseisDeFuego, poker:DieciseisDePlanta, poker:TreintayunoDeFuego, poker:VeintiseisDeNormal, poker:CincoDeLucha .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Sietes con Veintidos Veintiuno Once" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:SieteDeVolador, poker:VeintidosDePsiquico, poker:OnceDeLucha, poker:VeintiunoDePsiquico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veinticuatros con Quince Siete Cinco" ;
    poker:contieneCarta poker:VeinticuatroDePsiquico, poker:VeinticuatroDeBicho, poker:CincoDePlanta, poker:QuinceDePsiquico, poker:SieteDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Treces con Seis" ;
    poker:contieneCarta poker:VeintiunoDeLucha, poker:VeintiunoDePlanta, poker:TreceDeNormal, poker:TreceDeVolador, poker:SeisDeTierra ;
    poker:manoTienePar poker:Veintiuno, poker:Trece .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintisietes y Cincos con Veintiocho" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintisieteDeTierra, poker:CincoDeElectrico, poker:CincoDePlanta, poker:VeintiochoDeRoca ;
    poker:manoTienePar poker:Veintisiete, poker:Cinco .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Ochos con Diez" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDePlanta, poker:OchoDePlanta, poker:OchoDePsiquico, poker:DiezDeVolador ;
    poker:manoTienePar poker:Once, poker:Ocho .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintiochos y Veinticincos con Veintidos" ;
    poker:contieneCarta poker:VeinticincoDeTierra, poker:VeinticincoDeLucha, poker:VeintiochoDeElectrico, poker:VeintiochoDeAgua, poker:VeintidosDeTierra ;
    poker:manoTienePar poker:Veinticinco, poker:Veintiocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Veinticincos con Veintidos Cinco" ;
    poker:contieneCarta poker:VeinticincoDeNormal, poker:VeinticincoDeFuego, poker:VeinticincoDeVolador, poker:CincoDeRoca, poker:VeintidosDeLucha .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Treintas con Nueve Uno" ;
    poker:contieneCarta poker:TreintaDePsiquico, poker:TreintaDePlanta, poker:TreintaDeTierra, poker:NueveDeVeneno, poker:UnoDeLucha .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Diecinueves con Veintidos Trece" ;
    poker:contieneCarta poker:DiecinueveDePsiquico, poker:DiecinueveDeRoca, poker:DiecinueveDeTierra, poker:VeintidosDeTierra, poker:TreceDeRoca .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veintinueves con Veintitres Diecisiete" ;
    poker:contieneCarta poker:VeintinueveDeVolador, poker:VeintinueveDeLucha, poker:VeintinueveDeNormal, poker:VeintitresDeVeneno, poker:DiecisieteDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeLucha, poker:SieteDePlanta, poker:OchoDeTierra, poker:NueveDeVeneno, poker:DiezDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve" ;
    poker:contieneCarta poker:VeinticincoDePlanta, poker:VeintiseisDeFuego, poker:VeintisieteDeBicho, poker:VeintiochoDeRoca, poker:VeintinueveDeVeneno .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve" ;
    poker:contieneCarta poker:VeinticincoDeTierra, poker:VeintiseisDeLucha, poker:VeintisieteDeAgua, poker:VeintiochoDeBicho, poker:VeintinueveDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Tres-Cuatro-Cinco-Seis-Siete" ;
    poker:contieneCarta poker:TresDeRoca, poker:CuatroDePsiquico, poker:CincoDePsiquico, poker:SeisDeVolador, poker:SieteDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintiocho Once Ocho Dos Uno de Fuego" ;
    poker:contieneCarta poker:OchoDeFuego, poker:DosDeFuego, poker:OnceDeFuego, poker:VeintiochoDeFuego, poker:UnoDeFuego .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veintiuno Diecisiete Dieciseis Nueve Siete de Agua" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:DiecisieteDeAgua, poker:SieteDeAgua, poker:NueveDeAgua, poker:VeintiunoDeAgua .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veintitres Veintiuno Doce Cuatro de Planta" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:VeintiochoDePlanta, poker:VeintitresDePlanta, poker:DoceDePlanta, poker:VeintiunoDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintinueve Nueve Cinco Tres Uno de Volador" ;
    poker:contieneCarta poker:UnoDeVolador, poker:CincoDeVolador, poker:VeintinueveDeVolador, poker:NueveDeVolador, poker:TresDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Catorces" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeBicho, poker:UnoDeAgua, poker:CatorceDeBicho, poker:CatorceDeAgua ;
    poker:manoTienePar poker:Uno, poker:Catorce .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Nueves" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:CatorceDeVolador, poker:CatorceDePsiquico, poker:NueveDeAgua, poker:NueveDeElectrico ;
    poker:manoTienePar poker:Catorce, poker:Nueve .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Quinces" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:SeisDeRoca, poker:SeisDeVeneno, poker:QuinceDePlanta, poker:QuinceDePsiquico ;
    poker:manoTienePar poker:Seis, poker:Quince .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Veintiochos con Par de Veintidoses" ;
    poker:contieneCarta poker:VeintiochoDeRoca, poker:VeintiochoDeAgua, poker:VeintiochoDeNormal, poker:VeintidosDeLucha, poker:VeintidosDePsiquico ;
    poker:manoTienePar poker:Veintiocho, poker:Veintidos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Ochos con Veinticinco de Volador" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:OchoDeTierra, poker:OchoDePlanta, poker:OchoDeBicho, poker:VeinticincoDeVolador .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Seises con Diez de Fuego" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeVeneno, poker:SeisDeNormal, poker:SeisDeRoca, poker:DiezDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Doses con Siete de Agua" ;
    poker:contieneCarta poker:DosDeRoca, poker:DosDeFuego, poker:DosDeAgua, poker:DosDeTierra, poker:SieteDeAgua .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Catorces con Cuatro de Planta" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:CatorceDePsiquico, poker:CatorceDeLucha, poker:CatorceDeVolador, poker:CuatroDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Electrico" ;
    poker:contieneCarta poker:TresDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Bicho" ;
    poker:contieneCarta poker:TresDeBicho, poker:CuatroDeBicho, poker:CincoDeBicho, poker:SeisDeBicho, poker:SieteDeBicho .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro de Planta" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve de Electrico" ;
    poker:contieneCarta poker:VeinticincoDeElectrico, poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:VeintisieteDeTierra, poker:VeintiochoDeTierra, poker:VeintinueveDeTierra, poker:TreintaDeTierra, poker:TreintayunoDeTierra .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:VeintisieteDeVolador, poker:VeintiochoDeVolador, poker:VeintinueveDeVolador, poker:TreintaDeVolador, poker:TreintayunoDeVolador .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:VeintisieteDeNormal, poker:VeintiochoDeNormal, poker:VeintinueveDeNormal, poker:TreintaDeNormal, poker:TreintayunoDeNormal .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintiochoDePlanta, poker:VeintinueveDePlanta, poker:TreintaDePlanta, poker:TreintayunoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
