# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaycinco con Veintiocho Veinte Ocho Uno" ;
    poker:contieneCarta poker:VeintiochoDeBicho, poker:OchoDeHielo, poker:VeinteDeSiniestro, poker:TreintaycincoDeTierra, poker:UnoDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Veinticuatro Diecisiete Quince Doce" ;
    poker:contieneCarta poker:TreintaysieteDePsiquico, poker:DiecisieteDeElectrico, poker:DoceDeRoca, poker:QuinceDeVolador, poker:VeinticuatroDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Veintiuno Diez Ocho Dos" ;
    poker:contieneCarta poker:OchoDeDragon, poker:VeintiunoDeDragon, poker:DiezDeVolador, poker:TreintaysieteDePlanta, poker:DosDePsiquico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintisiete con Veinticinco Doce Nueve Dos" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DosDeFuego, poker:VeinticincoDeLucha, poker:NueveDePlanta, poker:VeintisieteDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Catorces con Veintinueve Veintiocho Veinte" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDeHielo, poker:VeintinueveDePsiquico, poker:VeinteDeElectrico, poker:VeintiochoDePsiquico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Nueves con Diecinueve Doce Uno" ;
    poker:contieneCarta poker:NueveDeRoca, poker:NueveDePlanta, poker:DoceDeRoca, poker:DiecinueveDePsiquico, poker:UnoDeFantasma .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Doses con Veintiuno Dieciocho Quince" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeLucha, poker:DieciochoDeTierra, poker:VeintiunoDeRoca, poker:QuinceDeVolador .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Treintaysiete Veintidos Siete" ;
    poker:contieneCarta poker:DiecisieteDeBicho, poker:DiecisieteDeAgua, poker:TreintaysieteDeRoca, poker:VeintidosDeNormal, poker:SieteDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintinueves y Veintiseises con Catorce" ;
    poker:contieneCarta poker:VeintinueveDeLucha, poker:VeintinueveDeFuego, poker:VeintiseisDeNormal, poker:VeintiseisDeAgua, poker:CatorceDeTierra ;
    poker:manoTienePar poker:Veintinueve, poker:Veintiseis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Catorces y Onces con Veintinueve" ;
    poker:contieneCarta poker:OnceDeHielo, poker:OnceDeFantasma, poker:CatorceDeFuego, poker:CatorceDeDragon, poker:VeintinueveDeHielo ;
    poker:manoTienePar poker:Once, poker:Catorce .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Cuatros con Quince" ;
    poker:contieneCarta poker:VeinteDeTierra, poker:VeinteDeVeneno, poker:CuatroDeHielo, poker:CuatroDePsiquico, poker:QuinceDeNormal ;
    poker:manoTienePar poker:Veinte, poker:Cuatro .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintisietes y Veinticincos con Treintayseis" ;
    poker:contieneCarta poker:VeintisieteDeTierra, poker:VeintisieteDeElectrico, poker:VeinticincoDeLucha, poker:VeinticincoDeVeneno, poker:TreintayseisDeRoca ;
    poker:manoTienePar poker:Veintisiete, poker:Veinticinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Catorces con Veintidos Cinco" ;
    poker:contieneCarta poker:CatorceDeSiniestro, poker:CatorceDeAgua, poker:CatorceDeHielo, poker:VeintidosDeBicho, poker:CincoDeNormal .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Treintayseis Once" ;
    poker:contieneCarta poker:DoceDePsiquico, poker:DoceDePlanta, poker:DoceDeHielo, poker:OnceDeVolador, poker:TreintayseisDePsiquico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintitreses con Veinticuatro Nueve" ;
    poker:contieneCarta poker:VeintitresDeSiniestro, poker:VeintitresDeElectrico, poker:VeintitresDeTierra, poker:NueveDePlanta, poker:VeinticuatroDeSiniestro .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Dieciseises con Trece Seis" ;
    poker:contieneCarta poker:DieciseisDeLucha, poker:DieciseisDeFantasma, poker:DieciseisDeHielo, poker:SeisDePlanta, poker:TreceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeTierra, poker:CincoDeTierra, poker:SeisDeFantasma, poker:SieteDeVeneno, poker:OchoDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veintinueve-Treinta-Treintayuno-Treintaydos-Treintaytres" ;
    poker:contieneCarta poker:VeintinueveDeVeneno, poker:TreintaDeSiniestro, poker:TreintayunoDeLucha, poker:TreintaydosDeFantasma, poker:TreintaytresDeNormal .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeSiniestro, poker:SeisDeSiniestro, poker:SieteDeRoca, poker:OchoDeFuego, poker:NueveDeRoca .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DieciochoDeTierra, poker:DiecinueveDeNormal, poker:VeinteDeLucha, poker:VeintiunoDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Treintaytres Treinta Diez Cinco de Planta" ;
    poker:contieneCarta poker:TreintaytresDePlanta, poker:TreintaycincoDePlanta, poker:CincoDePlanta, poker:TreintaDePlanta, poker:DiezDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintisiete Veintiseis Cinco Cuatro de Hielo" ;
    poker:contieneCarta poker:VeintinueveDeHielo, poker:CuatroDeHielo, poker:VeintisieteDeHielo, poker:CincoDeHielo, poker:VeintiseisDeHielo .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Dieciseis Quince Once Cinco Uno de Normal" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:UnoDeNormal, poker:OnceDeNormal, poker:CincoDeNormal, poker:DieciseisDeNormal .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintiuno Diecisiete Ocho Uno de Fantasma" ;
    poker:contieneCarta poker:VeintiunoDeFantasma, poker:UnoDeFantasma, poker:OchoDeFantasma, poker:DiecisieteDeFantasma, poker:VeintinueveDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veintisietes con Par de Veintinueves" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintisieteDeHielo, poker:VeintisieteDeNormal, poker:VeintinueveDeBicho, poker:VeintinueveDePsiquico ;
    poker:manoTienePar poker:Veintisiete, poker:Veintinueve .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Treses" ;
    poker:contieneCarta poker:CincoDeDragon, poker:CincoDeFantasma, poker:CincoDeFuego, poker:TresDeVeneno, poker:TresDeFuego ;
    poker:manoTienePar poker:Cinco, poker:Tres .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Catorces" ;
    poker:contieneCarta poker:DiecisieteDeFuego, poker:DiecisieteDeNormal, poker:DiecisieteDePlanta, poker:CatorceDeFuego, poker:CatorceDeVeneno ;
    poker:manoTienePar poker:Diecisiete, poker:Catorce .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaydoses con Par de Treintaysietes" ;
    poker:contieneCarta poker:TreintaydosDeVeneno, poker:TreintaydosDeLucha, poker:TreintaydosDeElectrico, poker:TreintaysieteDeVolador, poker:TreintaysieteDeElectrico ;
    poker:manoTienePar poker:Treintaydos, poker:Treintaysiete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Dieces con Dieciseis de Psiquico" ;
    poker:contieneCarta poker:DiezDeVolador, poker:DiezDeRoca, poker:DiezDeElectrico, poker:DiezDeFantasma, poker:DieciseisDePsiquico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Cincos con Treintayseis de Hielo" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDePlanta, poker:CincoDeSiniestro, poker:CincoDeRoca, poker:TreintayseisDeHielo .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Doces con Veintidos de Electrico" ;
    poker:contieneCarta poker:DoceDeVolador, poker:DoceDeNormal, poker:DoceDeFuego, poker:DoceDePsiquico, poker:VeintidosDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Unos con Cinco de Veneno" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeBicho, poker:UnoDeAgua, poker:UnoDeVolador, poker:CincoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Volador" ;
    poker:contieneCarta poker:SieteDeVolador, poker:OchoDeVolador, poker:NueveDeVolador, poker:DiezDeVolador, poker:OnceDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Normal" ;
    poker:contieneCarta poker:DoceDeNormal, poker:TreceDeNormal, poker:CatorceDeNormal, poker:QuinceDeNormal, poker:DieciseisDeNormal .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Treinta-Treintayuno-Treintaydos-Treintaytres-Treintaycuatro de Psiquico" ;
    poker:contieneCarta poker:TreintaDePsiquico, poker:TreintayunoDePsiquico, poker:TreintaydosDePsiquico, poker:TreintaytresDePsiquico, poker:TreintaycuatroDePsiquico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Roca" ;
    poker:contieneCarta poker:TresDeRoca, poker:CuatroDeRoca, poker:CincoDeRoca, poker:SeisDeRoca, poker:SieteDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:TreintaytresDeNormal, poker:TreintaycuatroDeNormal, poker:TreintaycincoDeNormal, poker:TreintayseisDeNormal, poker:TreintaysieteDeNormal .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:TreintaytresDeLucha, poker:TreintaycuatroDeLucha, poker:TreintaycincoDeLucha, poker:TreintayseisDeLucha, poker:TreintaysieteDeLucha .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:TreintaytresDeTierra, poker:TreintaycuatroDeTierra, poker:TreintaycincoDeTierra, poker:TreintayseisDeTierra, poker:TreintaysieteDeTierra .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:TreintaytresDeBicho, poker:TreintaycuatroDeBicho, poker:TreintaycincoDeBicho, poker:TreintayseisDeBicho, poker:TreintaysieteDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
