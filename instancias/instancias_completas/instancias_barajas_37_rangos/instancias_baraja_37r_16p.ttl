# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Diecisiete Siete Cinco Cuatro" ;
    poker:contieneCarta poker:CuatroDeHielo, poker:SieteDeFantasma, poker:CincoDeLucha, poker:VeintidosDeRoca, poker:DiecisieteDeLucha .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayseis con Treintaytres Veintinueve Diecinueve Diez" ;
    poker:contieneCarta poker:DiezDeNormal, poker:VeintinueveDeFuego, poker:TreintayseisDeVolador, poker:TreintaytresDeElectrico, poker:DiecinueveDeRoca .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayseis con Treintaycuatro Dieciseis Once Nueve" ;
    poker:contieneCarta poker:OnceDeVeneno, poker:DieciseisDeDragon, poker:NueveDeVeneno, poker:TreintaycuatroDeVolador, poker:TreintayseisDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Treinta Once Cinco Dos" ;
    poker:contieneCarta poker:TreintayunoDeHielo, poker:DosDeElectrico, poker:CincoDeVeneno, poker:OnceDeFantasma, poker:TreintaDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treintayunos con Diecinueve Dieciseis Tres" ;
    poker:contieneCarta poker:TreintayunoDeNormal, poker:TreintayunoDeFantasma, poker:DiecinueveDeTierra, poker:DieciseisDeAgua, poker:TresDeElectrico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Veinticuatros con Treintaycinco Once Diez" ;
    poker:contieneCarta poker:VeinticuatroDeAgua, poker:VeinticuatroDeVeneno, poker:DiezDeLucha, poker:TreintaycincoDeDragon, poker:OnceDeRoca .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintiseises con Nueve Cuatro Dos" ;
    poker:contieneCarta poker:VeintiseisDePlanta, poker:VeintiseisDePsiquico, poker:NueveDeAgua, poker:CuatroDePlanta, poker:DosDePsiquico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treintaysietes con Treintaycinco Veintisiete Catorce" ;
    poker:contieneCarta poker:TreintaysieteDePsiquico, poker:TreintaysieteDeDragon, poker:TreintaycincoDeNormal, poker:VeintisieteDePlanta, poker:CatorceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treintaycuatros y Veintiunos con Treintaysiete" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintiunoDeAgua, poker:TreintaycuatroDeNormal, poker:TreintaycuatroDeLucha, poker:TreintaysieteDeSiniestro ;
    poker:manoTienePar poker:Veintiuno, poker:Treintaycuatro .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Ochos con Uno" ;
    poker:contieneCarta poker:OchoDeFantasma, poker:OchoDeDragon, poker:NueveDeAgua, poker:NueveDeTierra, poker:UnoDeAgua ;
    poker:manoTienePar poker:Ocho, poker:Nueve .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Diecisietes con Diez" ;
    poker:contieneCarta poker:DiecinueveDeNormal, poker:DiecinueveDeTierra, poker:DiecisieteDeFantasma, poker:DiecisieteDeBicho, poker:DiezDeRoca ;
    poker:manoTienePar poker:Diecinueve, poker:Diecisiete .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Unos con Treintaytres" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:UnoDeHielo, poker:DiecisieteDeHielo, poker:DiecisieteDeBicho, poker:TreintaytresDeVolador ;
    poker:manoTienePar poker:Uno, poker:Diecisiete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treintaysietes con Treinta Dieciseis" ;
    poker:contieneCarta poker:TreintaysieteDeAgua, poker:TreintaysieteDePlanta, poker:TreintaysieteDeFantasma, poker:DieciseisDeRoca, poker:TreintaDePsiquico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Veinticincos con Veintidos Diecisiete" ;
    poker:contieneCarta poker:VeinticincoDeHielo, poker:VeinticincoDeVolador, poker:VeinticincoDeDragon, poker:DiecisieteDeFantasma, poker:VeintidosDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Quinces con Treintaysiete Catorce" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:QuinceDeFuego, poker:QuinceDeVolador, poker:CatorceDeFantasma, poker:TreintaysieteDeRoca .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Treses con Veintisiete Diecinueve" ;
    poker:contieneCarta poker:TresDeRoca, poker:TresDeVeneno, poker:TresDeVolador, poker:VeintisieteDeAgua, poker:DiecinueveDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Once-Doce-Trece-Catorce-Quince" ;
    poker:contieneCarta poker:OnceDeFuego, poker:DoceDeTierra, poker:TreceDeFuego, poker:CatorceDeNormal, poker:QuinceDeSiniestro .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeLucha, poker:OnceDeVolador, poker:DoceDeSiniestro, poker:TreceDeFantasma, poker:CatorceDePsiquico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veintiocho-Veintinueve-Treinta-Treintayuno-Treintaydos" ;
    poker:contieneCarta poker:VeintiochoDeVolador, poker:VeintinueveDeSiniestro, poker:TreintaDeVolador, poker:TreintayunoDeHielo, poker:TreintaydosDeDragon .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Treinta-Treintayuno-Treintaydos-Treintaytres-Treintaycuatro" ;
    poker:contieneCarta poker:TreintaDeElectrico, poker:TreintayunoDeDragon, poker:TreintaydosDePsiquico, poker:TreintaytresDePlanta, poker:TreintaycuatroDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Veinticinco Veinticuatro Dieciocho Uno de Fantasma" ;
    poker:contieneCarta poker:DieciochoDeFantasma, poker:VeinticincoDeFantasma, poker:VeinticuatroDeFantasma, poker:UnoDeFantasma, poker:TreintaycincoDeFantasma .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veintitres Veinte Dieciseis Cinco Uno de Fantasma" ;
    poker:contieneCarta poker:UnoDeFantasma, poker:VeintitresDeFantasma, poker:CincoDeFantasma, poker:VeinteDeFantasma, poker:DieciseisDeFantasma .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintayuno Treinta Veintinueve Veintiuno Diez de Agua" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:DiezDeAgua, poker:VeintinueveDeAgua, poker:TreintaDeAgua, poker:TreintayunoDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Treintaydos Veintisiete Veinticuatro Nueve de Fuego" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:TreintaycincoDeFuego, poker:NueveDeFuego, poker:VeintisieteDeFuego, poker:TreintaydosDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaycincos con Par de Doces" ;
    poker:contieneCarta poker:TreintaycincoDeHielo, poker:TreintaycincoDeLucha, poker:TreintaycincoDeVeneno, poker:DoceDeHielo, poker:DoceDeBicho ;
    poker:manoTienePar poker:Treintaycinco, poker:Doce .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Seises" ;
    poker:contieneCarta poker:DiecisieteDeRoca, poker:DiecisieteDePlanta, poker:DiecisieteDeHielo, poker:SeisDeRoca, poker:SeisDeElectrico ;
    poker:manoTienePar poker:Diecisiete, poker:Seis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaycuatros con Par de Nueves" ;
    poker:contieneCarta poker:TreintaycuatroDePlanta, poker:TreintaycuatroDeNormal, poker:TreintaycuatroDeSiniestro, poker:NueveDeSiniestro, poker:NueveDeDragon ;
    poker:manoTienePar poker:Treintaycuatro, poker:Nueve .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Quinces con Par de Treces" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:QuinceDeVeneno, poker:QuinceDePlanta, poker:TreceDeBicho, poker:TreceDeSiniestro ;
    poker:manoTienePar poker:Quince, poker:Trece .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treces con Treintaytres de Veneno" ;
    poker:contieneCarta poker:TreceDeVolador, poker:TreceDeFuego, poker:TreceDeLucha, poker:TreceDeHielo, poker:TreintaytresDeVeneno .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treintas con Once de Agua" ;
    poker:contieneCarta poker:TreintaDeElectrico, poker:TreintaDeVeneno, poker:TreintaDeRoca, poker:TreintaDePlanta, poker:OnceDeAgua .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veintidoses con Veinticuatro de Electrico" ;
    poker:contieneCarta poker:VeintidosDeTierra, poker:VeintidosDePlanta, poker:VeintidosDeSiniestro, poker:VeintidosDeNormal, poker:VeinticuatroDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Veintiuno de Volador" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDeVeneno, poker:CuatroDeLucha, poker:CuatroDeHielo, poker:VeintiunoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Volador" ;
    poker:contieneCarta poker:TresDeVolador, poker:CuatroDeVolador, poker:CincoDeVolador, poker:SeisDeVolador, poker:SieteDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Roca" ;
    poker:contieneCarta poker:VeintitresDeRoca, poker:VeinticuatroDeRoca, poker:VeinticincoDeRoca, poker:VeintiseisDeRoca, poker:VeintisieteDeRoca .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Nueve-Diez-Once-Doce-Trece de Volador" ;
    poker:contieneCarta poker:NueveDeVolador, poker:DiezDeVolador, poker:OnceDeVolador, poker:DoceDeVolador, poker:TreceDeVolador .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Electrico" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico, poker:CatorceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Roca" ;
    poker:contieneCarta poker:TreintaytresDeRoca, poker:TreintaycuatroDeRoca, poker:TreintaycincoDeRoca, poker:TreintayseisDeRoca, poker:TreintaysieteDeRoca .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:TreintaytresDePsiquico, poker:TreintaycuatroDePsiquico, poker:TreintaycincoDePsiquico, poker:TreintayseisDePsiquico, poker:TreintaysieteDePsiquico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:TreintaytresDeTierra, poker:TreintaycuatroDeTierra, poker:TreintaycincoDeTierra, poker:TreintayseisDeTierra, poker:TreintaysieteDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
