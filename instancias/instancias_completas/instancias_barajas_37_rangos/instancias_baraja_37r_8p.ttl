# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaycinco con Veinticuatro Dieciseis Once Dos" ;
    poker:contieneCarta poker:DosDeNormal, poker:TreintaycincoDeBicho, poker:OnceDeFuego, poker:VeinticuatroDeVeneno, poker:DieciseisDeVeneno .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaycinco con Veintinueve Veintiseis Nueve Siete" ;
    poker:contieneCarta poker:SieteDeNormal, poker:VeintiseisDeElectrico, poker:TreintaycincoDeAgua, poker:NueveDeAgua, poker:VeintinueveDeFuego .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaytres con Veintiocho Veintiuno Dieciocho Nueve" ;
    poker:contieneCarta poker:DieciochoDeVeneno, poker:VeintiochoDePlanta, poker:VeintiunoDeVeneno, poker:TreintaytresDeVolador, poker:NueveDeVeneno .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Veintiseis Diecisiete Ocho Dos" ;
    poker:contieneCarta poker:DosDeElectrico, poker:VeintiseisDeBicho, poker:OchoDeVeneno, poker:TreintaysieteDeBicho, poker:DiecisieteDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treintaycuatros con Veinticuatro Dieciocho Diecisiete" ;
    poker:contieneCarta poker:TreintaycuatroDeVeneno, poker:TreintaycuatroDeAgua, poker:DiecisieteDeNormal, poker:VeinticuatroDeFuego, poker:DieciochoDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Cincos con Treintaycinco Treintaycuatro Ocho" ;
    poker:contieneCarta poker:CincoDeBicho, poker:CincoDeFuego, poker:TreintaycincoDeVolador, poker:OchoDeVolador, poker:TreintaycuatroDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Catorces con Veintiseis Veinte Diecinueve" ;
    poker:contieneCarta poker:CatorceDeVolador, poker:CatorceDeAgua, poker:DiecinueveDeBicho, poker:VeintiseisDeVolador, poker:VeinteDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treintaytreses con Quince Doce Dos" ;
    poker:contieneCarta poker:TreintaytresDeNormal, poker:TreintaytresDeBicho, poker:DoceDeAgua, poker:QuinceDeAgua, poker:DosDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Quinces con Treintaycuatro" ;
    poker:contieneCarta poker:VeinteDeAgua, poker:VeinteDeBicho, poker:QuinceDeElectrico, poker:QuinceDeVolador, poker:TreintaycuatroDeElectrico ;
    poker:manoTienePar poker:Veinte, poker:Quince .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Cuatros con Uno" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeNormal, poker:SieteDePlanta, poker:SieteDeBicho, poker:UnoDeNormal ;
    poker:manoTienePar poker:Cuatro, poker:Siete .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Catorces con Veintitres" ;
    poker:contieneCarta poker:CatorceDeVolador, poker:CatorceDeNormal, poker:DieciochoDeElectrico, poker:DieciochoDeNormal, poker:VeintitresDeElectrico ;
    poker:manoTienePar poker:Catorce, poker:Dieciocho .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Cincos con Veintisiete" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:SieteDePlanta, poker:CincoDeVolador, poker:CincoDePlanta, poker:VeintisieteDeFuego ;
    poker:manoTienePar poker:Siete, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treintayseises con Diez Tres" ;
    poker:contieneCarta poker:TreintayseisDeNormal, poker:TreintayseisDeFuego, poker:TreintayseisDeVeneno, poker:TresDeVolador, poker:DiezDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Ochos con Treintaydos Veintiseis" ;
    poker:contieneCarta poker:OchoDeAgua, poker:OchoDePlanta, poker:OchoDeVeneno, poker:VeintiseisDeAgua, poker:TreintaydosDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Treintaysiete Uno" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CuatroDeAgua, poker:CuatroDeBicho, poker:UnoDeBicho, poker:TreintaysieteDeVeneno .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Catorces con Veintidos Nueve" ;
    poker:contieneCarta poker:CatorceDeVeneno, poker:CatorceDeElectrico, poker:CatorceDeVolador, poker:VeintidosDeVolador, poker:NueveDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:DieciseisDeNormal, poker:DiecisieteDeFuego, poker:DieciochoDeBicho, poker:DiecinueveDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Trece-Catorce-Quince-Dieciseis-Diecisiete" ;
    poker:contieneCarta poker:TreceDeVolador, poker:CatorceDeVolador, poker:QuinceDeElectrico, poker:DieciseisDePlanta, poker:DiecisieteDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeVolador, poker:DiecisieteDePlanta, poker:DieciochoDeNormal, poker:DiecinueveDeNormal .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Veintiocho-Veintinueve-Treinta-Treintayuno-Treintaydos" ;
    poker:contieneCarta poker:VeintiochoDeVeneno, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico, poker:TreintayunoDeElectrico, poker:TreintaydosDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintaysiete Veintiuno Diecinueve Trece Diez de Planta" ;
    poker:contieneCarta poker:TreintaysieteDePlanta, poker:VeintiunoDePlanta, poker:DiecinueveDePlanta, poker:TreceDePlanta, poker:DiezDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Treintaytres Veintisiete Veintidos Dieciocho de Bicho" ;
    poker:contieneCarta poker:DieciochoDeBicho, poker:VeintisieteDeBicho, poker:TreintaytresDeBicho, poker:TreintaycincoDeBicho, poker:VeintidosDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Treintaycuatro Treinta Veinticinco Tres de Agua" ;
    poker:contieneCarta poker:TreintaycincoDeAgua, poker:VeinticincoDeAgua, poker:TreintaDeAgua, poker:TreintaycuatroDeAgua, poker:TresDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Treintayseis Veintiseis Veintidos Diecinueve Seis de Veneno" ;
    poker:contieneCarta poker:TreintayseisDeVeneno, poker:VeintiseisDeVeneno, poker:SeisDeVeneno, poker:VeintidosDeVeneno, poker:DiecinueveDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Cincos" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDePlanta, poker:TresDeVeneno, poker:CincoDeVeneno, poker:CincoDeBicho ;
    poker:manoTienePar poker:Tres, poker:Cinco .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintiochos con Par de Treintaydoses" ;
    poker:contieneCarta poker:VeintiochoDeFuego, poker:VeintiochoDeAgua, poker:VeintiochoDeBicho, poker:TreintaydosDeVeneno, poker:TreintaydosDeElectrico ;
    poker:manoTienePar poker:Veintiocho, poker:Treintaydos .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaydoses con Par de Seises" ;
    poker:contieneCarta poker:TreintaydosDeBicho, poker:TreintaydosDeNormal, poker:TreintaydosDeAgua, poker:SeisDeElectrico, poker:SeisDeBicho ;
    poker:manoTienePar poker:Treintaydos, poker:Seis .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treintayseises con Par de Treintaysietes" ;
    poker:contieneCarta poker:TreintayseisDeAgua, poker:TreintayseisDeFuego, poker:TreintayseisDePlanta, poker:TreintaysieteDeBicho, poker:TreintaysieteDePlanta ;
    poker:manoTienePar poker:Treintayseis, poker:Treintaysiete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Veintidoses con Veintiseis de Volador" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintidosDeVeneno, poker:VeintidosDeNormal, poker:VeintidosDeFuego, poker:VeintiseisDeVolador .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veinticuatros con Veinte de Electrico" ;
    poker:contieneCarta poker:VeinticuatroDeElectrico, poker:VeinticuatroDeNormal, poker:VeinticuatroDeVeneno, poker:VeinticuatroDeVolador, poker:VeinteDeElectrico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treses con Seis de Veneno" ;
    poker:contieneCarta poker:TresDeBicho, poker:TresDeVeneno, poker:TresDeNormal, poker:TresDeElectrico, poker:SeisDeVeneno .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treintayseises con Doce de Electrico" ;
    poker:contieneCarta poker:TreintayseisDeElectrico, poker:TreintayseisDeBicho, poker:TreintayseisDeNormal, poker:TreintayseisDeVolador, poker:DoceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco de Veneno" ;
    poker:contieneCarta poker:VeintiunoDeVeneno, poker:VeintidosDeVeneno, poker:VeintitresDeVeneno, poker:VeinticuatroDeVeneno, poker:VeinticincoDeVeneno .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veintidos-Veintitres-Veinticuatro-Veinticinco-Veintiseis de Fuego" ;
    poker:contieneCarta poker:VeintidosDeFuego, poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego, poker:VeintiseisDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Normal" ;
    poker:contieneCarta poker:SieteDeNormal, poker:OchoDeNormal, poker:NueveDeNormal, poker:DiezDeNormal, poker:OnceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:TreintaytresDeNormal, poker:TreintaycuatroDeNormal, poker:TreintaycincoDeNormal, poker:TreintayseisDeNormal, poker:TreintaysieteDeNormal .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:TreintaytresDeBicho, poker:TreintaycuatroDeBicho, poker:TreintaycincoDeBicho, poker:TreintayseisDeBicho, poker:TreintaysieteDeBicho .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:TreintaytresDeVolador, poker:TreintaycuatroDeVolador, poker:TreintaycincoDeVolador, poker:TreintayseisDeVolador, poker:TreintaysieteDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
