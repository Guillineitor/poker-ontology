# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Veintitres Dieciseis Ocho Siete" ;
    poker:contieneCarta poker:TreintaysieteDeElectrico, poker:OchoDeElectrico, poker:SieteDeFuego, poker:VeintitresDeVeneno, poker:DieciseisDeVeneno .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Diecinueve Once Cinco Dos" ;
    poker:contieneCarta poker:DiecinueveDeBicho, poker:OnceDeAgua, poker:VeinticuatroDeVolador, poker:DosDeBicho, poker:CincoDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Veinticinco Trece Doce Diez" ;
    poker:contieneCarta poker:DiezDeBicho, poker:DoceDeNormal, poker:VeinticincoDeFuego, poker:TreintaysieteDePlanta, poker:TreceDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaycuatro con Treintaytres Dieciseis Quince Once" ;
    poker:contieneCarta poker:TreintaycuatroDeNormal, poker:OnceDeVolador, poker:QuinceDeBicho, poker:DieciseisDePlanta, poker:TreintaytresDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Ochos con Treinta Siete Cuatro" ;
    poker:contieneCarta poker:OchoDeBicho, poker:OchoDeElectrico, poker:CuatroDePlanta, poker:TreintaDeFuego, poker:SieteDeBicho .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treintaysietes con Diecinueve Quince Ocho" ;
    poker:contieneCarta poker:TreintaysieteDeElectrico, poker:TreintaysieteDeBicho, poker:QuinceDePlanta, poker:DiecinueveDeElectrico, poker:OchoDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Treintaydoses con Treintayseis Trece Tres" ;
    poker:contieneCarta poker:TreintaydosDeElectrico, poker:TreintaydosDeAgua, poker:TreceDeVeneno, poker:TresDeAgua, poker:TreintayseisDeFuego .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treintaycincos con Treintaytres Veintiseis Veinticuatro" ;
    poker:contieneCarta poker:TreintaycincoDeElectrico, poker:TreintaycincoDeAgua, poker:VeinticuatroDeVeneno, poker:VeintiseisDePlanta, poker:TreintaytresDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Doses con Veintidos" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeBicho, poker:VeinteDeBicho, poker:VeinteDeNormal, poker:VeintidosDePlanta ;
    poker:manoTienePar poker:Dos, poker:Veinte .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Doces con Veintiseis" ;
    poker:contieneCarta poker:DoceDeBicho, poker:DoceDeNormal, poker:VeintiunoDePlanta, poker:VeintiunoDeBicho, poker:VeintiseisDeVolador ;
    poker:manoTienePar poker:Doce, poker:Veintiuno .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Sietes con Veinte" ;
    poker:contieneCarta poker:SieteDeNormal, poker:SieteDeBicho, poker:DieciochoDeVeneno, poker:DieciochoDeElectrico, poker:VeinteDeElectrico ;
    poker:manoTienePar poker:Siete, poker:Dieciocho .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Onces con Dieciocho" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeFuego, poker:OnceDeElectrico, poker:OnceDeBicho, poker:DieciochoDeFuego ;
    poker:manoTienePar poker:Doce, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Veinticuatros con Veintitres Trece" ;
    poker:contieneCarta poker:VeinticuatroDeBicho, poker:VeinticuatroDeFuego, poker:VeinticuatroDePlanta, poker:TreceDePlanta, poker:VeintitresDeVeneno .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doses con Veinticinco Diecinueve" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeBicho, poker:DosDeVolador, poker:DiecinueveDeVolador, poker:VeinticincoDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doces con Treintaycuatro Nueve" ;
    poker:contieneCarta poker:DoceDeNormal, poker:DoceDePlanta, poker:DoceDeVeneno, poker:TreintaycuatroDeElectrico, poker:NueveDeAgua .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veintinueves con Treintaydos Veintisiete" ;
    poker:contieneCarta poker:VeintinueveDeAgua, poker:VeintinueveDeBicho, poker:VeintinueveDeVolador, poker:TreintaydosDeNormal, poker:VeintisieteDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve" ;
    poker:contieneCarta poker:VeinticincoDePlanta, poker:VeintiseisDeFuego, poker:VeintisieteDeVolador, poker:VeintiochoDeVeneno, poker:VeintinueveDeAgua .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CincoDeBicho, poker:SeisDeVeneno, poker:SieteDeBicho, poker:OchoDeBicho .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta" ;
    poker:contieneCarta poker:VeintiseisDeVeneno, poker:VeintisieteDeVolador, poker:VeintiochoDeAgua, poker:VeintinueveDeFuego, poker:TreintaDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeNormal, poker:DieciochoDeVeneno, poker:DiecinueveDeFuego, poker:VeinteDeAgua, poker:VeintiunoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintayseis Treintaycinco Diez Siete Cuatro de Electrico" ;
    poker:contieneCarta poker:TreintayseisDeElectrico, poker:CuatroDeElectrico, poker:TreintaycincoDeElectrico, poker:DiezDeElectrico, poker:SieteDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Catorce Ocho Siete Dos de Normal" ;
    poker:contieneCarta poker:CatorceDeNormal, poker:OchoDeNormal, poker:DosDeNormal, poker:VeinticuatroDeNormal, poker:SieteDeNormal .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veinticuatro Catorce Nueve Cinco de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:TreintayunoDeAgua, poker:VeinticuatroDeAgua, poker:NueveDeAgua, poker:CatorceDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Treintaydos Veintiuno Doce Once Ocho de Agua" ;
    poker:contieneCarta poker:DoceDeAgua, poker:VeintiunoDeAgua, poker:OchoDeAgua, poker:TreintaydosDeAgua, poker:OnceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Veintiseises" ;
    poker:contieneCarta poker:DieciseisDeNormal, poker:DieciseisDeVeneno, poker:DieciseisDeVolador, poker:VeintiseisDePlanta, poker:VeintiseisDeNormal ;
    poker:manoTienePar poker:Dieciseis, poker:Veintiseis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintisietes con Par de Diecisietes" ;
    poker:contieneCarta poker:VeintisieteDeElectrico, poker:VeintisieteDeFuego, poker:VeintisieteDeNormal, poker:DiecisieteDePlanta, poker:DiecisieteDeNormal ;
    poker:manoTienePar poker:Veintisiete, poker:Diecisiete .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treintayseises con Par de Nueves" ;
    poker:contieneCarta poker:TreintayseisDeElectrico, poker:TreintayseisDeFuego, poker:TreintayseisDeNormal, poker:NueveDeVeneno, poker:NueveDePlanta ;
    poker:manoTienePar poker:Treintayseis, poker:Nueve .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treintayunos con Par de Treces" ;
    poker:contieneCarta poker:TreintayunoDeVolador, poker:TreintayunoDeAgua, poker:TreintayunoDePlanta, poker:TreceDeNormal, poker:TreceDeVolador ;
    poker:manoTienePar poker:Treintayuno, poker:Trece .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treintaysietes con Veinticuatro de Agua" ;
    poker:contieneCarta poker:TreintaysieteDeFuego, poker:TreintaysieteDeAgua, poker:TreintaysieteDeElectrico, poker:TreintaysieteDeNormal, poker:VeinticuatroDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Doses con Trece de Normal" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeVolador, poker:DosDeVeneno, poker:DosDeAgua, poker:TreceDeNormal .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Doce de Electrico" ;
    poker:contieneCarta poker:VeinticincoDeElectrico, poker:VeinticincoDePlanta, poker:VeinticincoDeVeneno, poker:VeinticincoDeAgua, poker:DoceDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treintaycincos con Veintiseis de Fuego" ;
    poker:contieneCarta poker:TreintaycincoDePlanta, poker:TreintaycincoDeVolador, poker:TreintaycincoDeVeneno, poker:TreintaycincoDeAgua, poker:VeintiseisDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Agua" ;
    poker:contieneCarta poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua, poker:CatorceDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Treintayuno-Treintaydos-Treintaytres-Treintaycuatro-Treintaycinco de Bicho" ;
    poker:contieneCarta poker:TreintayunoDeBicho, poker:TreintaydosDeBicho, poker:TreintaytresDeBicho, poker:TreintaycuatroDeBicho, poker:TreintaycincoDeBicho .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte de Volador" ;
    poker:contieneCarta poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador, poker:VeinteDeVolador .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte de Volador" ;
    poker:contieneCarta poker:DieciseisDeVolador, poker:DiecisieteDeVolador, poker:DieciochoDeVolador, poker:DiecinueveDeVolador, poker:VeinteDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaycuatroDeFuego, poker:TreintaycincoDeFuego, poker:TreintayseisDeFuego, poker:TreintaysieteDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:TreintaytresDeVeneno, poker:TreintaycuatroDeVeneno, poker:TreintaycincoDeVeneno, poker:TreintayseisDeVeneno, poker:TreintaysieteDeVeneno .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:TreintaytresDeNormal, poker:TreintaycuatroDeNormal, poker:TreintaycincoDeNormal, poker:TreintayseisDeNormal, poker:TreintaysieteDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
