# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayseis con Treintaytres Treinta Dieciocho Once" ;
    poker:contieneCarta poker:TreintaDeVeneno, poker:TreintaytresDeFuego, poker:TreintayseisDeElectrico, poker:OnceDePlanta, poker:DieciochoDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Treinta Veintinueve Diecinueve Doce" ;
    poker:contieneCarta poker:TreintayunoDeVolador, poker:VeintinueveDePlanta, poker:TreintaDeBicho, poker:DiecinueveDeElectrico, poker:DoceDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Quince Doce Ocho Cinco" ;
    poker:contieneCarta poker:OchoDeBicho, poker:CincoDeFuego, poker:DoceDeNormal, poker:TreintayunoDeAgua, poker:QuinceDeNormal .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaydos con Treinta Veintisiete Veintiseis Ocho" ;
    poker:contieneCarta poker:TreintaDeNormal, poker:TreintaydosDeElectrico, poker:OchoDeVolador, poker:VeintisieteDeVeneno, poker:VeintiseisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Seises con Treintayuno Veintiseis Nueve" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeFuego, poker:VeintiseisDeNormal, poker:NueveDeAgua, poker:TreintayunoDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Treintaysietes con Treintaytres Veintinueve Uno" ;
    poker:contieneCarta poker:TreintaysieteDeNormal, poker:TreintaysieteDeElectrico, poker:TreintaytresDeAgua, poker:VeintinueveDeElectrico, poker:UnoDeElectrico .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Veinticinco Seis Uno" ;
    poker:contieneCarta poker:DiecisieteDeBicho, poker:DiecisieteDePlanta, poker:SeisDeBicho, poker:VeinticincoDeVeneno, poker:UnoDeVolador .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veintiochos con Diecinueve Catorce Uno" ;
    poker:contieneCarta poker:VeintiochoDeNormal, poker:VeintiochoDeElectrico, poker:CatorceDeAgua, poker:DiecinueveDeFuego, poker:UnoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintiochos y Doces con Treintaytres" ;
    poker:contieneCarta poker:VeintiochoDeNormal, poker:VeintiochoDeFuego, poker:DoceDeVeneno, poker:DoceDeAgua, poker:TreintaytresDeFuego ;
    poker:manoTienePar poker:Veintiocho, poker:Doce .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Catorces con Dos" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DieciseisDeAgua, poker:CatorceDeAgua, poker:CatorceDeBicho, poker:DosDeFuego ;
    poker:manoTienePar poker:Dieciseis, poker:Catorce .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treintaysietes y Catorces con Veintiuno" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:CatorceDeAgua, poker:TreintaysieteDeAgua, poker:TreintaysieteDePlanta, poker:VeintiunoDeNormal ;
    poker:manoTienePar poker:Catorce, poker:Treintaysiete .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Treintaydoses y Cincos con Veintinueve" ;
    poker:contieneCarta poker:CincoDeBicho, poker:CincoDeAgua, poker:TreintaydosDeVeneno, poker:TreintaydosDePlanta, poker:VeintinueveDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Treintaydos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Nueves con Treintaycinco Siete" ;
    poker:contieneCarta poker:NueveDeBicho, poker:NueveDeVeneno, poker:NueveDeElectrico, poker:TreintaycincoDeFuego, poker:SieteDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Veinticuatros con Veinticinco Nueve" ;
    poker:contieneCarta poker:VeinticuatroDeElectrico, poker:VeinticuatroDeVolador, poker:VeinticuatroDeVeneno, poker:VeinticincoDeVeneno, poker:NueveDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Treces con Veintinueve Veintiocho" ;
    poker:contieneCarta poker:TreceDeVolador, poker:TreceDeAgua, poker:TreceDeVeneno, poker:VeintinueveDeVeneno, poker:VeintiochoDeElectrico .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Unos con Treintaydos Veinticinco" ;
    poker:contieneCarta poker:UnoDeNormal, poker:UnoDeFuego, poker:UnoDePlanta, poker:VeinticincoDePlanta, poker:TreintaydosDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeAgua, poker:DiecisieteDePlanta, poker:DieciochoDeAgua, poker:DiecinueveDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeNormal, poker:OchoDeVolador, poker:NueveDeElectrico, poker:DiezDeNormal, poker:OnceDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeVeneno, poker:TreceDePlanta, poker:CatorceDePlanta, poker:QuinceDeAgua, poker:DieciseisDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta" ;
    poker:contieneCarta poker:VeintiseisDeBicho, poker:VeintisieteDePlanta, poker:VeintiochoDeNormal, poker:VeintinueveDeFuego, poker:TreintaDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Treintaycuatro Veintiocho Veinticinco Quince de Volador" ;
    poker:contieneCarta poker:TreintaycincoDeVolador, poker:TreintaycuatroDeVolador, poker:VeintiochoDeVolador, poker:QuinceDeVolador, poker:VeinticincoDeVolador .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintayseis Treintaydos Veintinueve Veinticuatro Diez de Bicho" ;
    poker:contieneCarta poker:TreintaydosDeBicho, poker:TreintayseisDeBicho, poker:VeinticuatroDeBicho, poker:VeintinueveDeBicho, poker:DiezDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintaycuatro Veintinueve Dieciocho Nueve Ocho de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:DieciochoDeFuego, poker:VeintinueveDeFuego, poker:TreintaycuatroDeFuego, poker:OchoDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintidos Dieciseis Trece Once Cuatro de Normal" ;
    poker:contieneCarta poker:DieciseisDeNormal, poker:TreceDeNormal, poker:OnceDeNormal, poker:CuatroDeNormal, poker:VeintidosDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veintinueves con Par de Treintaydoses" ;
    poker:contieneCarta poker:VeintinueveDeFuego, poker:VeintinueveDePlanta, poker:VeintinueveDeAgua, poker:TreintaydosDeVolador, poker:TreintaydosDeElectrico ;
    poker:manoTienePar poker:Veintinueve, poker:Treintaydos .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treintayunos con Par de Cincos" ;
    poker:contieneCarta poker:TreintayunoDeNormal, poker:TreintayunoDeBicho, poker:TreintayunoDeAgua, poker:CincoDePlanta, poker:CincoDeAgua ;
    poker:manoTienePar poker:Treintayuno, poker:Cinco .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Treintaysietes" ;
    poker:contieneCarta poker:TreceDeBicho, poker:TreceDeVolador, poker:TreceDeElectrico, poker:TreintaysieteDePlanta, poker:TreintaysieteDeVolador ;
    poker:manoTienePar poker:Trece, poker:Treintaysiete .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Treintayseises" ;
    poker:contieneCarta poker:TresDeVeneno, poker:TresDeFuego, poker:TresDeAgua, poker:TreintayseisDeBicho, poker:TreintayseisDeVolador ;
    poker:manoTienePar poker:Tres, poker:Treintayseis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Seises con Uno de Agua" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDePlanta, poker:SeisDeElectrico, poker:SeisDeFuego, poker:UnoDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Catorces con Veintiocho de Fuego" ;
    poker:contieneCarta poker:CatorceDeNormal, poker:CatorceDePlanta, poker:CatorceDeBicho, poker:CatorceDeAgua, poker:VeintiochoDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treintaycincos con Seis de Veneno" ;
    poker:contieneCarta poker:TreintaycincoDeNormal, poker:TreintaycincoDeElectrico, poker:TreintaycincoDeAgua, poker:TreintaycincoDeBicho, poker:SeisDeVeneno .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Veintiochos con Dieciocho de Planta" ;
    poker:contieneCarta poker:VeintiochoDeAgua, poker:VeintiochoDeVeneno, poker:VeintiochoDeElectrico, poker:VeintiochoDeNormal, poker:DieciochoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro de Volador" ;
    poker:contieneCarta poker:VeinteDeVolador, poker:VeintiunoDeVolador, poker:VeintidosDeVolador, poker:VeintitresDeVolador, poker:VeinticuatroDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Veneno" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:NueveDeVeneno, poker:DiezDeVeneno, poker:OnceDeVeneno, poker:DoceDeVeneno .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veintidos-Veintitres-Veinticuatro-Veinticinco-Veintiseis de Volador" ;
    poker:contieneCarta poker:VeintidosDeVolador, poker:VeintitresDeVolador, poker:VeinticuatroDeVolador, poker:VeinticincoDeVolador, poker:VeintiseisDeVolador .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Agua" ;
    poker:contieneCarta poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:TreintaytresDeElectrico, poker:TreintaycuatroDeElectrico, poker:TreintaycincoDeElectrico, poker:TreintayseisDeElectrico, poker:TreintaysieteDeElectrico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:TreintaytresDePlanta, poker:TreintaycuatroDePlanta, poker:TreintaycincoDePlanta, poker:TreintayseisDePlanta, poker:TreintaysieteDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaycuatroDeFuego, poker:TreintaycincoDeFuego, poker:TreintayseisDeFuego, poker:TreintaysieteDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
