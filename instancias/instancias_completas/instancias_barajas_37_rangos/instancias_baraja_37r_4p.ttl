# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaydos con Veintisiete Veinticinco Diecisiete Cinco" ;
    poker:contieneCarta poker:TreintaydosDeAgua, poker:CincoDeElectrico, poker:VeinticincoDeFuego, poker:DiecisieteDePlanta, poker:VeintisieteDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaytres con Veintidos Veintiuno Veinte Once" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:OnceDePlanta, poker:VeintidosDeFuego, poker:VeinteDeFuego, poker:VeintiunoDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Dieciocho Trece Once Cinco" ;
    poker:contieneCarta poker:OnceDePlanta, poker:CincoDeFuego, poker:DieciochoDeFuego, poker:TreceDeElectrico, poker:TreintaDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Veintidos Dieciocho Siete Cuatro" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:VeintidosDePlanta, poker:TreintayunoDeAgua, poker:DieciochoDePlanta, poker:SieteDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treces con Veintiseis Diecinueve Quince" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDeAgua, poker:DiecinueveDeElectrico, poker:QuinceDeFuego, poker:VeintiseisDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doces con Treinta Veinticinco Veinte" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeElectrico, poker:TreintaDeAgua, poker:VeinticincoDeAgua, poker:VeinteDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintidoses con Treintaysiete Veinte Diecisiete" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintidosDeElectrico, poker:DiecisieteDePlanta, poker:TreintaysieteDeElectrico, poker:VeinteDeAgua .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Dieciochos con Treinta Dieciseis Diez" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:DieciochoDeAgua, poker:TreintaDeFuego, poker:DiezDeAgua, poker:DieciseisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Treses con Dieciseis" ;
    poker:contieneCarta poker:VeintidosDeElectrico, poker:VeintidosDeFuego, poker:TresDeElectrico, poker:TresDePlanta, poker:DieciseisDeFuego ;
    poker:manoTienePar poker:Veintidos, poker:Tres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treintas y Catorces con Diecisiete" ;
    poker:contieneCarta poker:TreintaDeFuego, poker:TreintaDePlanta, poker:CatorceDeAgua, poker:CatorceDeFuego, poker:DiecisieteDePlanta ;
    poker:manoTienePar poker:Treinta, poker:Catorce .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veinticincos y Doses con Dieciocho" ;
    poker:contieneCarta poker:VeinticincoDeAgua, poker:VeinticincoDePlanta, poker:DosDeElectrico, poker:DosDeFuego, poker:DieciochoDePlanta ;
    poker:manoTienePar poker:Veinticinco, poker:Dos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Doces con Veintisiete" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeElectrico, poker:DiecinueveDeFuego, poker:DiecinueveDeAgua, poker:VeintisieteDeAgua ;
    poker:manoTienePar poker:Doce, poker:Diecinueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Veintitreses con Veinticinco Siete" ;
    poker:contieneCarta poker:VeintitresDeElectrico, poker:VeintitresDePlanta, poker:VeintitresDeFuego, poker:SieteDeFuego, poker:VeinticincoDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Doces con Veintinueve Uno" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeAgua, poker:DoceDeElectrico, poker:UnoDeFuego, poker:VeintinueveDeAgua .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Onces con Treintaycinco Dieciseis" ;
    poker:contieneCarta poker:OnceDeFuego, poker:OnceDePlanta, poker:OnceDeAgua, poker:TreintaycincoDeAgua, poker:DieciseisDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veintidoses con Veintisiete Quince" ;
    poker:contieneCarta poker:VeintidosDeFuego, poker:VeintidosDePlanta, poker:VeintidosDeElectrico, poker:VeintisieteDePlanta, poker:QuinceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego, poker:VeintiseisDeAgua, poker:VeintisieteDeAgua, poker:VeintiochoDeElectrico .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDePlanta, poker:OchoDeFuego, poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeFuego .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeAgua, poker:TreceDePlanta, poker:CatorceDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:VeintiseisDeElectrico, poker:VeintisieteDeAgua, poker:VeintiochoDeFuego, poker:VeintinueveDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintiseis Veintitres Dieciocho Doce Nueve de Electrico" ;
    poker:contieneCarta poker:DieciochoDeElectrico, poker:NueveDeElectrico, poker:VeintitresDeElectrico, poker:DoceDeElectrico, poker:VeintiseisDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintaytres Treinta Veintisiete Veinticinco Siete de Fuego" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:TreintaytresDeFuego, poker:SieteDeFuego, poker:VeintisieteDeFuego, poker:TreintaDeFuego .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintaysiete Veintiseis Quince Doce Ocho de Electrico" ;
    poker:contieneCarta poker:TreintaysieteDeElectrico, poker:OchoDeElectrico, poker:VeintiseisDeElectrico, poker:DoceDeElectrico, poker:QuinceDeElectrico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Treintaysiete Treintaycuatro Veintidos Dieciseis Diez de Fuego" ;
    poker:contieneCarta poker:TreintaysieteDeFuego, poker:DieciseisDeFuego, poker:DiezDeFuego, poker:VeintidosDeFuego, poker:TreintaycuatroDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Cuatros" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeElectrico, poker:SeisDeAgua, poker:CuatroDeElectrico, poker:CuatroDeFuego ;
    poker:manoTienePar poker:Seis, poker:Cuatro .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciseises con Par de Treintaycuatros" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:DieciseisDeElectrico, poker:DieciseisDeFuego, poker:TreintaycuatroDeAgua, poker:TreintaycuatroDePlanta ;
    poker:manoTienePar poker:Dieciseis, poker:Treintaycuatro .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Veintes con Par de Cuatros" ;
    poker:contieneCarta poker:VeinteDeFuego, poker:VeinteDeElectrico, poker:VeinteDeAgua, poker:CuatroDePlanta, poker:CuatroDeElectrico ;
    poker:manoTienePar poker:Veinte, poker:Cuatro .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Treintaysietes" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeAgua, poker:UnoDeElectrico, poker:TreintaysieteDeFuego, poker:TreintaysieteDePlanta ;
    poker:manoTienePar poker:Uno, poker:Treintaysiete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Nueves con Cuatro de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:NueveDePlanta, poker:NueveDeElectrico, poker:NueveDeFuego, poker:CuatroDeAgua .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treintayunos con Uno de Agua" ;
    poker:contieneCarta poker:TreintayunoDeAgua, poker:TreintayunoDePlanta, poker:TreintayunoDeElectrico, poker:TreintayunoDeFuego, poker:UnoDeAgua .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Veintiunos con Trece de Electrico" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintiunoDeAgua, poker:VeintiunoDePlanta, poker:VeintiunoDeFuego, poker:TreceDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Veintiochos con Siete de Electrico" ;
    poker:contieneCarta poker:VeintiochoDeFuego, poker:VeintiochoDePlanta, poker:VeintiochoDeElectrico, poker:VeintiochoDeAgua, poker:SieteDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Agua" ;
    poker:contieneCarta poker:DoceDeAgua, poker:TreceDeAgua, poker:CatorceDeAgua, poker:QuinceDeAgua, poker:DieciseisDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta de Electrico" ;
    poker:contieneCarta poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Diecinueve-Veinte-Veintiuno-Veintidos-Veintitres de Electrico" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:VeinteDeElectrico, poker:VeintiunoDeElectrico, poker:VeintidosDeElectrico, poker:VeintitresDeElectrico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho de Electrico" ;
    poker:contieneCarta poker:VeinticuatroDeElectrico, poker:VeinticincoDeElectrico, poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:TreintaytresDeElectrico, poker:TreintaycuatroDeElectrico, poker:TreintaycincoDeElectrico, poker:TreintayseisDeElectrico, poker:TreintaysieteDeElectrico .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaycuatroDeFuego, poker:TreintaycincoDeFuego, poker:TreintayseisDeFuego, poker:TreintaysieteDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:TreintaytresDePlanta, poker:TreintaycuatroDePlanta, poker:TreintaycincoDePlanta, poker:TreintayseisDePlanta, poker:TreintaysieteDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
