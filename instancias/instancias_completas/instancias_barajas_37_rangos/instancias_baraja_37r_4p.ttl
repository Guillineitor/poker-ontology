# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiocho con Dieciseis Doce Cuatro Tres" ;
    poker:contieneCarta poker:TresDeFuego, poker:DieciseisDeElectrico, poker:CuatroDeElectrico, poker:VeintiochoDeAgua, poker:DoceDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaycuatro con Veintidos Veintiuno Dieciseis Tres" ;
    poker:contieneCarta poker:TresDeElectrico, poker:VeintidosDeElectrico, poker:DieciseisDeAgua, poker:TreintaycuatroDePlanta, poker:VeintiunoDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Diecisiete Quince Catorce Ocho" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:VeinticuatroDeFuego, poker:QuinceDeFuego, poker:OchoDeAgua, poker:DiecisieteDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Veintinueve Veinte Ocho Cinco" ;
    poker:contieneCarta poker:VeintinueveDeAgua, poker:OchoDeFuego, poker:TreintaysieteDeElectrico, poker:VeinteDePlanta, poker:CincoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Diez Seis Cinco" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeAgua, poker:SeisDePlanta, poker:CincoDeFuego, poker:DiezDeFuego .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doses con Veintiuno Dieciseis Trece" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeAgua, poker:VeintiunoDePlanta, poker:TreceDeElectrico, poker:DieciseisDeElectrico .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Seises con Treintaytres Veinte Once" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDePlanta, poker:VeinteDePlanta, poker:TreintaytresDePlanta, poker:OnceDePlanta .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Diecisietes con Treintaycinco Treinta Cinco" ;
    poker:contieneCarta poker:DiecisieteDeElectrico, poker:DiecisieteDePlanta, poker:TreintaDeElectrico, poker:CincoDeFuego, poker:TreintaycincoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Treses con Veinticuatro" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DiecisieteDeFuego, poker:TresDeFuego, poker:TresDeAgua, poker:VeinticuatroDePlanta ;
    poker:manoTienePar poker:Diecisiete, poker:Tres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintitreses y Quinces con Treintayseis" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:QuinceDePlanta, poker:VeintitresDeFuego, poker:VeintitresDeAgua, poker:TreintayseisDePlanta ;
    poker:manoTienePar poker:Quince, poker:Veintitres .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Catorces y Doces con Treintaysiete" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeElectrico, poker:CatorceDeElectrico, poker:CatorceDeAgua, poker:TreintaysieteDeFuego ;
    poker:manoTienePar poker:Doce, poker:Catorce .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Treintayunos y Veinticincos con Cinco" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:VeinticincoDeElectrico, poker:TreintayunoDePlanta, poker:TreintayunoDeElectrico, poker:CincoDePlanta ;
    poker:manoTienePar poker:Veinticinco, poker:Treintayuno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treintaysietes con Dieciocho Doce" ;
    poker:contieneCarta poker:TreintaysieteDeAgua, poker:TreintaysieteDeElectrico, poker:TreintaysieteDeFuego, poker:DoceDeFuego, poker:DieciochoDePlanta .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Cincos con Veintiuno Cuatro" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:CincoDeFuego, poker:CuatroDeAgua, poker:VeintiunoDePlanta .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Diecinueves con Veintitres Veintiuno" ;
    poker:contieneCarta poker:DiecinueveDeAgua, poker:DiecinueveDeElectrico, poker:DiecinueveDeFuego, poker:VeintiunoDeAgua, poker:VeintitresDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Catorces con Treintaysiete Veinte" ;
    poker:contieneCarta poker:CatorceDeFuego, poker:CatorceDeAgua, poker:CatorceDePlanta, poker:VeinteDePlanta, poker:TreintaysieteDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:DieciseisDeElectrico, poker:DiecisieteDePlanta, poker:DieciochoDeAgua, poker:DiecinueveDeAgua .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veintiocho-Veintinueve-Treinta-Treintayuno-Treintaydos" ;
    poker:contieneCarta poker:VeintiochoDeElectrico, poker:VeintinueveDePlanta, poker:TreintaDeFuego, poker:TreintayunoDeElectrico, poker:TreintaydosDeElectrico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeAgua, poker:OchoDeElectrico, poker:NueveDeAgua, poker:DiezDePlanta, poker:OnceDeElectrico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos" ;
    poker:contieneCarta poker:DieciochoDeAgua, poker:DiecinueveDeFuego, poker:VeinteDeElectrico, poker:VeintiunoDeAgua, poker:VeintidosDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Treintaydos Once Diez Nueve de Agua" ;
    poker:contieneCarta poker:DiezDeAgua, poker:TreintaycincoDeAgua, poker:OnceDeAgua, poker:NueveDeAgua, poker:TreintaydosDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciocho Diecisiete Doce Siete Seis de Electrico" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DiecisieteDeElectrico, poker:SieteDeElectrico, poker:DieciochoDeElectrico, poker:SeisDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintayseis Veinticinco Veinticuatro Trece Siete de Planta" ;
    poker:contieneCarta poker:TreceDePlanta, poker:VeinticincoDePlanta, poker:VeinticuatroDePlanta, poker:TreintayseisDePlanta, poker:SieteDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veintisiete Veintidos Dieciocho Nueve de Agua" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintiochoDeAgua, poker:DieciochoDeAgua, poker:VeintisieteDeAgua, poker:NueveDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticuatros con Par de Unos" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:VeinticuatroDePlanta, poker:VeinticuatroDeAgua, poker:UnoDeAgua, poker:UnoDeElectrico ;
    poker:manoTienePar poker:Veinticuatro, poker:Uno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Veinticuatros" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:CincoDeFuego, poker:VeinticuatroDePlanta, poker:VeinticuatroDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Veinticuatro .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticincos con Par de Veintes" ;
    poker:contieneCarta poker:VeinticincoDeAgua, poker:VeinticincoDePlanta, poker:VeinticincoDeFuego, poker:VeinteDePlanta, poker:VeinteDeElectrico ;
    poker:manoTienePar poker:Veinticinco, poker:Veinte .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Veintidoses" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeElectrico, poker:DosDeFuego, poker:VeintidosDeFuego, poker:VeintidosDeAgua ;
    poker:manoTienePar poker:Dos, poker:Veintidos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treintaysietes con Veintiuno de Electrico" ;
    poker:contieneCarta poker:TreintaysieteDeAgua, poker:TreintaysieteDeFuego, poker:TreintaysieteDeElectrico, poker:TreintaysieteDePlanta, poker:VeintiunoDeElectrico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treintayseises con Veintiseis de Fuego" ;
    poker:contieneCarta poker:TreintayseisDePlanta, poker:TreintayseisDeFuego, poker:TreintayseisDeElectrico, poker:TreintayseisDeAgua, poker:VeintiseisDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Ochos con Treintaycuatro de Electrico" ;
    poker:contieneCarta poker:OchoDeFuego, poker:OchoDeAgua, poker:OchoDePlanta, poker:OchoDeElectrico, poker:TreintaycuatroDeElectrico .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Doces con Siete de Fuego" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeAgua, poker:DoceDeFuego, poker:DoceDeElectrico, poker:SieteDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve de Agua" ;
    poker:contieneCarta poker:VeinticincoDeAgua, poker:VeintiseisDeAgua, poker:VeintisieteDeAgua, poker:VeintiochoDeAgua, poker:VeintinueveDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:CuatroDeFuego, poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Agua" ;
    poker:contieneCarta poker:CincoDeAgua, poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Fuego" ;
    poker:contieneCarta poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego, poker:VeintiseisDeFuego, poker:VeintisieteDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:TreintaytresDePlanta, poker:TreintaycuatroDePlanta, poker:TreintaycincoDePlanta, poker:TreintayseisDePlanta, poker:TreintaysieteDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaycuatroDeFuego, poker:TreintaycincoDeFuego, poker:TreintayseisDeFuego, poker:TreintaysieteDeFuego .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:TreintaytresDeElectrico, poker:TreintaycuatroDeElectrico, poker:TreintaycincoDeElectrico, poker:TreintayseisDeElectrico, poker:TreintaysieteDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
