# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiuno con Veinte Catorce Once Tres" ;
    poker:contieneCarta poker:TresDeElectrico, poker:CatorceDeBicho, poker:VeintiunoDePlanta, poker:VeinteDePlanta, poker:OnceDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaytres con Catorce Ocho Siete Cinco" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:OchoDeRoca, poker:TreintaytresDeLucha, poker:CatorceDePsiquico, poker:SieteDeNormal .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintidos Veintiuno Trece Nueve" ;
    poker:contieneCarta poker:NueveDePsiquico, poker:TreceDeBicho, poker:VeintiunoDeAgua, poker:VeintidosDePlanta, poker:TreintaDeRoca .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaydos con Veinticuatro Dieciocho Quince Seis" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:QuinceDePlanta, poker:VeinticuatroDePsiquico, poker:TreintaydosDeVolador, poker:DieciochoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Catorces con Treintaytres Treintaydos Veintitres" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDeTierra, poker:TreintaytresDeFuego, poker:VeintitresDeRoca, poker:TreintaydosDeVeneno .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doces con Veintiocho Veinticinco Diez" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeNormal, poker:DiezDeNormal, poker:VeinticincoDeBicho, poker:VeintiochoDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintisietes con Treintayuno Once Tres" ;
    poker:contieneCarta poker:VeintisieteDeVeneno, poker:VeintisieteDePsiquico, poker:TresDeTierra, poker:OnceDePsiquico, poker:TreintayunoDeVeneno .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Doses con Veintiuno Diecisiete Seis" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeAgua, poker:SeisDePsiquico, poker:VeintiunoDeRoca, poker:DiecisieteDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Dieciochos con Treintaycuatro" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:DiecinueveDeLucha, poker:DieciochoDeRoca, poker:DieciochoDeFuego, poker:TreintaycuatroDeBicho ;
    poker:manoTienePar poker:Diecinueve, poker:Dieciocho .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treintayseises y Nueves con Cinco" ;
    poker:contieneCarta poker:TreintayseisDeAgua, poker:TreintayseisDeLucha, poker:NueveDeVolador, poker:NueveDePsiquico, poker:CincoDeAgua ;
    poker:manoTienePar poker:Treintayseis, poker:Nueve .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treintas y Treses con Treintayuno" ;
    poker:contieneCarta poker:TreintaDeBicho, poker:TreintaDeLucha, poker:TresDePlanta, poker:TresDeRoca, poker:TreintayunoDeNormal ;
    poker:manoTienePar poker:Treinta, poker:Tres .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Treintayunos y Treses con Uno" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDeNormal, poker:TreintayunoDePlanta, poker:TreintayunoDePsiquico, poker:UnoDePsiquico ;
    poker:manoTienePar poker:Tres, poker:Treintayuno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Veinticuatros con Veintiocho Cinco" ;
    poker:contieneCarta poker:VeinticuatroDeBicho, poker:VeinticuatroDeTierra, poker:VeinticuatroDeVolador, poker:VeintiochoDeAgua, poker:CincoDeElectrico .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Veinticuatros con Doce Siete" ;
    poker:contieneCarta poker:VeinticuatroDeLucha, poker:VeinticuatroDeRoca, poker:VeinticuatroDeBicho, poker:SieteDeNormal, poker:DoceDePsiquico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Doses con Veintitres Once" ;
    poker:contieneCarta poker:DosDeLucha, poker:DosDeAgua, poker:DosDePlanta, poker:OnceDePlanta, poker:VeintitresDeFuego .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Seises con Cuatro Dos" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDeElectrico, poker:SeisDePsiquico, poker:CuatroDeRoca, poker:DosDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeBicho, poker:TreceDeBicho, poker:CatorceDeVeneno, poker:QuinceDeNormal, poker:DieciseisDeFuego .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeBicho, poker:DieciochoDePlanta, poker:DiecinueveDeLucha, poker:VeinteDeVolador, poker:VeintiunoDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeVolador, poker:TreceDeAgua, poker:CatorceDeTierra, poker:QuinceDeVeneno, poker:DieciseisDePsiquico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete" ;
    poker:contieneCarta poker:VeintitresDeRoca, poker:VeinticuatroDePlanta, poker:VeinticincoDePsiquico, poker:VeintiseisDeNormal, poker:VeintisieteDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintiseis Diecinueve Dieciseis Ocho de Psiquico" ;
    poker:contieneCarta poker:DiecinueveDePsiquico, poker:DieciseisDePsiquico, poker:OchoDePsiquico, poker:VeintinueveDePsiquico, poker:VeintiseisDePsiquico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintaydos Veinte Dieciseis Siete Dos de Bicho" ;
    poker:contieneCarta poker:DosDeBicho, poker:DieciseisDeBicho, poker:TreintaydosDeBicho, poker:VeinteDeBicho, poker:SieteDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintaycuatro Veintinueve Veintiocho Veinticinco Uno de Fuego" ;
    poker:contieneCarta poker:TreintaycuatroDeFuego, poker:VeintinueveDeFuego, poker:VeintiochoDeFuego, poker:VeinticincoDeFuego, poker:UnoDeFuego .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Veintinueve Veintiseis Siete Dos de Planta" ;
    poker:contieneCarta poker:SieteDePlanta, poker:DosDePlanta, poker:TreintaycincoDePlanta, poker:VeintinueveDePlanta, poker:VeintiseisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaycincos con Par de Treces" ;
    poker:contieneCarta poker:TreintaycincoDePlanta, poker:TreintaycincoDeNormal, poker:TreintaycincoDeElectrico, poker:TreceDeVolador, poker:TreceDeAgua ;
    poker:manoTienePar poker:Treintaycinco, poker:Trece .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticuatros con Par de Doces" ;
    poker:contieneCarta poker:VeinticuatroDeVolador, poker:VeinticuatroDeNormal, poker:VeinticuatroDeAgua, poker:DoceDeVeneno, poker:DoceDeBicho ;
    poker:manoTienePar poker:Veinticuatro, poker:Doce .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Veintidoses" ;
    poker:contieneCarta poker:OnceDePsiquico, poker:OnceDeFuego, poker:OnceDeNormal, poker:VeintidosDeFuego, poker:VeintidosDeBicho ;
    poker:manoTienePar poker:Once, poker:Veintidos .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Veintitreses con Par de Veintiseises" ;
    poker:contieneCarta poker:VeintitresDeVolador, poker:VeintitresDeElectrico, poker:VeintitresDeVeneno, poker:VeintiseisDeAgua, poker:VeintiseisDePsiquico ;
    poker:manoTienePar poker:Veintitres, poker:Veintiseis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doces con Treintaycinco de Volador" ;
    poker:contieneCarta poker:DoceDeLucha, poker:DoceDeRoca, poker:DoceDeFuego, poker:DoceDeAgua, poker:TreintaycincoDeVolador .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Nueves con Ocho de Volador" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:NueveDeFuego, poker:NueveDeBicho, poker:NueveDePlanta, poker:OchoDeVolador .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Dieciseises con Dieciocho de Volador" ;
    poker:contieneCarta poker:DieciseisDeLucha, poker:DieciseisDeVolador, poker:DieciseisDeNormal, poker:DieciseisDeVeneno, poker:DieciochoDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treintaytreses con Veinticinco de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaytresDeElectrico, poker:TreintaytresDePlanta, poker:TreintaytresDeBicho, poker:VeinticincoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veintidos-Veintitres-Veinticuatro-Veinticinco-Veintiseis de Psiquico" ;
    poker:contieneCarta poker:VeintidosDePsiquico, poker:VeintitresDePsiquico, poker:VeinticuatroDePsiquico, poker:VeinticincoDePsiquico, poker:VeintiseisDePsiquico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho de Fuego" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego, poker:VeintiseisDeFuego, poker:VeintisieteDeFuego, poker:VeintiochoDeFuego .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Agua" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SieteDeAgua, poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Lucha" ;
    poker:contieneCarta poker:SieteDeLucha, poker:OchoDeLucha, poker:NueveDeLucha, poker:DiezDeLucha, poker:OnceDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:TreintaytresDePlanta, poker:TreintaycuatroDePlanta, poker:TreintaycincoDePlanta, poker:TreintayseisDePlanta, poker:TreintaysieteDePlanta .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:TreintaytresDeBicho, poker:TreintaycuatroDeBicho, poker:TreintaycincoDeBicho, poker:TreintayseisDeBicho, poker:TreintaysieteDeBicho .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaycuatroDeFuego, poker:TreintaycincoDeFuego, poker:TreintayseisDeFuego, poker:TreintaysieteDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
