# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaytres con Treintaydos Diecisiete Dieciseis Catorce" ;
    poker:contieneCarta poker:DiecisieteDeNormal, poker:TreintaytresDePlanta, poker:CatorceDePsiquico, poker:TreintaydosDeAgua, poker:DieciseisDeBicho .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Veinticuatro Quince Catorce Cuatro" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:VeinticuatroDeRoca, poker:QuinceDeLucha, poker:TreintaysieteDeTierra, poker:CuatroDePsiquico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayseis con Quince Nueve Ocho Seis" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:NueveDeRoca, poker:OchoDeBicho, poker:TreintayseisDeElectrico, poker:SeisDeElectrico .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintisiete con Veintiseis Diecinueve Ocho Dos" ;
    poker:contieneCarta poker:VeintiseisDeAgua, poker:OchoDeElectrico, poker:DosDeTierra, poker:DiecinueveDeVolador, poker:VeintisieteDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Dieces con Treinta Catorce Siete" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeAgua, poker:CatorceDePsiquico, poker:SieteDeVolador, poker:TreintaDeRoca .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Onces con Veinticuatro Veintitres Trece" ;
    poker:contieneCarta poker:OnceDeRoca, poker:OnceDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDePlanta, poker:TreceDeTierra .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Treses con Diecisiete Once Cinco" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeElectrico, poker:DiecisieteDeTierra, poker:CincoDePlanta, poker:OnceDeNormal .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treintaysietes con Treintaydos Veinte Ocho" ;
    poker:contieneCarta poker:TreintaysieteDeLucha, poker:TreintaysieteDeElectrico, poker:VeinteDeLucha, poker:OchoDeVolador, poker:TreintaydosDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Sietes con Veintiuno" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DieciseisDeElectrico, poker:SieteDeLucha, poker:SieteDePlanta, poker:VeintiunoDeLucha ;
    poker:manoTienePar poker:Dieciseis, poker:Siete .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Catorces con Treintayuno" ;
    poker:contieneCarta poker:CatorceDeBicho, poker:CatorceDeRoca, poker:QuinceDeFuego, poker:QuinceDeVeneno, poker:TreintayunoDeAgua ;
    poker:manoTienePar poker:Catorce, poker:Quince .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treintaycincos y Veintinueves con Veintidos" ;
    poker:contieneCarta poker:TreintaycincoDeRoca, poker:TreintaycincoDeFuego, poker:VeintinueveDePlanta, poker:VeintinueveDeRoca, poker:VeintidosDeVeneno ;
    poker:manoTienePar poker:Treintaycinco, poker:Veintinueve .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Treintaytreses y Veintiochos con Cinco" ;
    poker:contieneCarta poker:VeintiochoDeBicho, poker:VeintiochoDeAgua, poker:TreintaytresDeVolador, poker:TreintaytresDePlanta, poker:CincoDeTierra ;
    poker:manoTienePar poker:Veintiocho, poker:Treintaytres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Ochos con Veintiuno Diecisiete" ;
    poker:contieneCarta poker:OchoDePsiquico, poker:OchoDeVeneno, poker:OchoDeRoca, poker:VeintiunoDeTierra, poker:DiecisieteDeBicho .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Seises con Treinta Veinticinco" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDePlanta, poker:SeisDePsiquico, poker:VeinticincoDeTierra, poker:TreintaDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Unos con Treintayuno Veintiuno" ;
    poker:contieneCarta poker:UnoDeRoca, poker:UnoDeVolador, poker:UnoDeLucha, poker:TreintayunoDeElectrico, poker:VeintiunoDeVeneno .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Treintas con Veintiseis Diecisiete" ;
    poker:contieneCarta poker:TreintaDeElectrico, poker:TreintaDeTierra, poker:TreintaDePlanta, poker:VeintiseisDeBicho, poker:DiecisieteDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDePsiquico, poker:OchoDeLucha, poker:NueveDeVeneno, poker:DiezDeElectrico, poker:OnceDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:DiecisieteDeVolador, poker:DieciochoDeRoca, poker:DiecinueveDeNormal, poker:VeinteDeBicho .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco" ;
    poker:contieneCarta poker:VeintiunoDeTierra, poker:VeintidosDeTierra, poker:VeintitresDeElectrico, poker:VeinticuatroDeFuego, poker:VeinticincoDeBicho .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDePsiquico, poker:DieciochoDeBicho, poker:DiecinueveDePsiquico, poker:VeinteDeVolador, poker:VeintiunoDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Treinta Quince Cinco Tres de Electrico" ;
    poker:contieneCarta poker:TreintaycincoDeElectrico, poker:CincoDeElectrico, poker:TreintaDeElectrico, poker:QuinceDeElectrico, poker:TresDeElectrico .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintaycuatro Treintayuno Veintiocho Trece Dos de Lucha" ;
    poker:contieneCarta poker:DosDeLucha, poker:TreintayunoDeLucha, poker:VeintiochoDeLucha, poker:TreceDeLucha, poker:TreintaycuatroDeLucha .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintayseis Treintaycinco Doce Cinco Tres de Bicho" ;
    poker:contieneCarta poker:TreintaycincoDeBicho, poker:DoceDeBicho, poker:TreintayseisDeBicho, poker:TresDeBicho, poker:CincoDeBicho .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Treintaysiete Treintaycuatro Veinte Once Nueve de Lucha" ;
    poker:contieneCarta poker:TreintaysieteDeLucha, poker:VeinteDeLucha, poker:TreintaycuatroDeLucha, poker:NueveDeLucha, poker:OnceDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Quinces con Par de Veintitreses" ;
    poker:contieneCarta poker:QuinceDeTierra, poker:QuinceDeBicho, poker:QuinceDeRoca, poker:VeintitresDeRoca, poker:VeintitresDeLucha ;
    poker:manoTienePar poker:Quince, poker:Veintitres .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Treintaycincos" ;
    poker:contieneCarta poker:VeintidosDeRoca, poker:VeintidosDeVeneno, poker:VeintidosDeAgua, poker:TreintaycincoDeElectrico, poker:TreintaycincoDeVeneno ;
    poker:manoTienePar poker:Veintidos, poker:Treintaycinco .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaysietes con Par de Treintaycincos" ;
    poker:contieneCarta poker:TreintaysieteDeBicho, poker:TreintaysieteDeFuego, poker:TreintaysieteDeAgua, poker:TreintaycincoDeLucha, poker:TreintaycincoDeTierra ;
    poker:manoTienePar poker:Treintaysiete, poker:Treintaycinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Veintiochos" ;
    poker:contieneCarta poker:TresDePsiquico, poker:TresDeTierra, poker:TresDePlanta, poker:VeintiochoDeLucha, poker:VeintiochoDeElectrico ;
    poker:manoTienePar poker:Tres, poker:Veintiocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Dieciochos con Veintinueve de Electrico" ;
    poker:contieneCarta poker:DieciochoDeVeneno, poker:DieciochoDePlanta, poker:DieciochoDeVolador, poker:DieciochoDeRoca, poker:VeintinueveDeElectrico .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Catorces con Treintayuno de Psiquico" ;
    poker:contieneCarta poker:CatorceDeRoca, poker:CatorceDeFuego, poker:CatorceDeElectrico, poker:CatorceDeVolador, poker:TreintayunoDePsiquico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Dieciocho de Volador" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeElectrico, poker:CuatroDeVeneno, poker:CuatroDeVolador, poker:DieciochoDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Doces con Veintiocho de Lucha" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:DoceDeBicho, poker:DoceDeTierra, poker:DoceDeLucha, poker:VeintiochoDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Diecinueve-Veinte-Veintiuno-Veintidos-Veintitres de Volador" ;
    poker:contieneCarta poker:DiecinueveDeVolador, poker:VeinteDeVolador, poker:VeintiunoDeVolador, poker:VeintidosDeVolador, poker:VeintitresDeVolador .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Roca" ;
    poker:contieneCarta poker:SeisDeRoca, poker:SieteDeRoca, poker:OchoDeRoca, poker:NueveDeRoca, poker:DiezDeRoca .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Agua" ;
    poker:contieneCarta poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Bicho" ;
    poker:contieneCarta poker:CincoDeBicho, poker:SeisDeBicho, poker:SieteDeBicho, poker:OchoDeBicho, poker:NueveDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:TreintaytresDeNormal, poker:TreintaycuatroDeNormal, poker:TreintaycincoDeNormal, poker:TreintayseisDeNormal, poker:TreintaysieteDeNormal .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Psiquico" ;
    poker:contieneCarta poker:TreintaytresDePsiquico, poker:TreintaycuatroDePsiquico, poker:TreintaycincoDePsiquico, poker:TreintayseisDePsiquico, poker:TreintaysieteDePsiquico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:TreintaytresDeVeneno, poker:TreintaycuatroDeVeneno, poker:TreintaycincoDeVeneno, poker:TreintayseisDeVeneno, poker:TreintaysieteDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
