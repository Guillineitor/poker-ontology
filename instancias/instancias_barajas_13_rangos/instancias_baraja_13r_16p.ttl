# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Nueve Ocho Tres Uno" ;
    poker:contieneCarta poker:UnoDeRoca, poker:TresDeFuego, poker:OchoDeElectrico, poker:NueveDeVolador, poker:DoceDeLucha .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Once Nueve Ocho Uno" ;
    poker:contieneCarta poker:OchoDeBicho, poker:UnoDeSiniestro, poker:NueveDeElectrico, poker:OnceDeHielo, poker:DoceDeBicho .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Diez Nueve Siete Cuatro" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:DiezDePlanta, poker:CuatroDeDragon, poker:DoceDeSiniestro, poker:NueveDeFuego .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Seis Cinco Cuatro Uno" ;
    poker:contieneCarta poker:DoceDePlanta, poker:CuatroDeVolador, poker:SeisDeHielo, poker:UnoDeRoca, poker:CincoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Unos con Trece Doce Siete" ;
    poker:contieneCarta poker:UnoDeSiniestro, poker:UnoDeLucha, poker:TreceDeNormal, poker:DoceDeDragon, poker:SieteDeVeneno .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Doses con Nueve Cuatro Tres" ;
    poker:contieneCarta poker:DosDeLucha, poker:DosDeSiniestro, poker:CuatroDeFantasma, poker:NueveDeSiniestro, poker:TresDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Dieces con Ocho Seis Dos" ;
    poker:contieneCarta poker:DiezDeBicho, poker:DiezDeHielo, poker:DosDeRoca, poker:OchoDeVolador, poker:SeisDeBicho .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Treces con Diez Cinco Cuatro" ;
    poker:contieneCarta poker:TreceDeRoca, poker:TreceDeVeneno, poker:CincoDeHielo, poker:DiezDeVeneno, poker:CuatroDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Nueves con Once" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeVolador, poker:NueveDeNormal, poker:NueveDeFuego, poker:OnceDeElectrico ;
    poker:manoTienePar poker:Trece, poker:Nueve .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Cuatros con Diez" ;
    poker:contieneCarta poker:CuatroDeHielo, poker:CuatroDePlanta, poker:CincoDeNormal, poker:CincoDeVeneno, poker:DiezDeBicho ;
    poker:manoTienePar poker:Cuatro, poker:Cinco .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Treses con Ocho" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDeDragon, poker:SieteDeNormal, poker:SieteDeSiniestro, poker:OchoDeFuego ;
    poker:manoTienePar poker:Tres, poker:Siete .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Doses con Uno" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeSiniestro, poker:DosDeVeneno, poker:DosDeFuego, poker:UnoDeFantasma ;
    poker:manoTienePar poker:Diez, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieces con Trece Tres" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeVolador, poker:DiezDeDragon, poker:TreceDeElectrico, poker:TresDeBicho .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Cincos con Trece Siete" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeVeneno, poker:CincoDeLucha, poker:TreceDeFantasma, poker:SieteDeRoca .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Treces con Cuatro Dos" ;
    poker:contieneCarta poker:TreceDeHielo, poker:TreceDePlanta, poker:TreceDePsiquico, poker:DosDeHielo, poker:CuatroDePlanta .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Nueves con Trece Dos" ;
    poker:contieneCarta poker:NueveDeFuego, poker:NueveDePlanta, poker:NueveDeHielo, poker:DosDeNormal, poker:TreceDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeFuego, poker:OnceDeVeneno, poker:DoceDeLucha, poker:TreceDeHielo .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeFuego, poker:TresDeVolador, poker:CuatroDePsiquico, poker:CincoDeTierra, poker:SeisDeElectrico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:OchoDeNormal, poker:NueveDeTierra, poker:DiezDeBicho, poker:OnceDePsiquico .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeVolador, poker:CuatroDeFuego, poker:CincoDeElectrico, poker:SeisDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Trece Ocho Siete Cinco Uno de Volador" ;
    poker:contieneCarta poker:SieteDeVolador, poker:UnoDeVolador, poker:OchoDeVolador, poker:TreceDeVolador, poker:CincoDeVolador .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Diez Seis Cinco Cuatro Uno de Bicho" ;
    poker:contieneCarta poker:CincoDeBicho, poker:DiezDeBicho, poker:SeisDeBicho, poker:UnoDeBicho, poker:CuatroDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Trece Doce Diez Nueve Seis de Agua" ;
    poker:contieneCarta poker:DoceDeAgua, poker:TreceDeAgua, poker:DiezDeAgua, poker:SeisDeAgua, poker:NueveDeAgua .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Doce Diez Siete Cuatro Uno de Dragón" ;
    poker:contieneCarta poker:SieteDeDragon, poker:CuatroDeDragon, poker:DiezDeDragon, poker:UnoDeDragon, poker:DoceDeDragon .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Unos" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeSiniestro, poker:DosDeVolador, poker:UnoDeTierra, poker:UnoDeVeneno ;
    poker:manoTienePar poker:Dos, poker:Uno .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Unos" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDePsiquico, poker:TreceDeFantasma, poker:UnoDeFuego, poker:UnoDeRoca ;
    poker:manoTienePar poker:Trece, poker:Uno .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Nueves" ;
    poker:contieneCarta poker:OchoDeTierra, poker:OchoDeDragon, poker:OchoDeVolador, poker:NueveDePsiquico, poker:NueveDeSiniestro ;
    poker:manoTienePar poker:Ocho, poker:Nueve .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Cuatros" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDePlanta, poker:CincoDeHielo, poker:CuatroDeHielo, poker:CuatroDeNormal ;
    poker:manoTienePar poker:Cinco, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Doces con Once de Roca" ;
    poker:contieneCarta poker:DoceDeFantasma, poker:DoceDeElectrico, poker:DoceDeBicho, poker:DoceDeLucha, poker:OnceDeRoca .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Unos con Trece de Psíquico" ;
    poker:contieneCarta poker:UnoDeLucha, poker:UnoDeFuego, poker:UnoDeSiniestro, poker:UnoDeRoca, poker:TreceDePsiquico .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Siete de Roca" ;
    poker:contieneCarta poker:CuatroDeDragon, poker:CuatroDePlanta, poker:CuatroDeFuego, poker:CuatroDeSiniestro, poker:SieteDeRoca .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Ochos con Cuatro de Psíquico" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:OchoDeFantasma, poker:OchoDeSiniestro, poker:OchoDeRoca, poker:CuatroDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Fantasma" ;
    poker:contieneCarta poker:SieteDeFantasma, poker:OchoDeFantasma, poker:NueveDeFantasma, poker:DiezDeFantasma, poker:OnceDeFantasma .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Fuego" ;
    poker:contieneCarta poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Normal" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal, poker:SeisDeNormal .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Uno-Dos-Tres-Cuatro-Cinco de Normal" ;
    poker:contieneCarta poker:UnoDeNormal, poker:DosDeNormal, poker:TresDeNormal, poker:CuatroDeNormal, poker:CincoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Siniestro" ;
    poker:contieneCarta poker:NueveDeSiniestro, poker:DiezDeSiniestro, poker:OnceDeSiniestro, poker:DoceDeSiniestro, poker:TreceDeSiniestro .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:NueveDeVolador, poker:DiezDeVolador, poker:OnceDeVolador, poker:DoceDeVolador, poker:TreceDeVolador .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
