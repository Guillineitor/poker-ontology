# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Treintaytres Treintayuno Trece Nueve" ;
    poker:contieneCarta poker:NueveDePlanta, poker:TreintaytresDeVeneno, poker:TreintaysieteDeBicho, poker:TreceDeBicho, poker:TreintayunoDeBicho .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Dieciocho Catorce Tres Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:DieciochoDeBicho, poker:UnoDeAgua, poker:TreintaDePlanta, poker:CatorceDeVolador .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintiuno Veinte Diecinueve Dos" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:TreintaDeFuego, poker:VeinteDeNormal, poker:DosDePlanta, poker:DiecinueveDeVolador .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaysiete con Treintaycinco Veintiseis Veintiuno Catorce" ;
    poker:contieneCarta poker:CatorceDeVolador, poker:VeintiseisDeNormal, poker:TreintaycincoDePlanta, poker:TreintaysieteDePlanta, poker:VeintiunoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treintaytreses con Ocho Siete Seis" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaytresDePlanta, poker:SeisDeElectrico, poker:SieteDeBicho, poker:OchoDeAgua .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Veintitreses con Doce Ocho Cinco" ;
    poker:contieneCarta poker:VeintitresDeVolador, poker:VeintitresDeBicho, poker:CincoDeElectrico, poker:DoceDeElectrico, poker:OchoDeVeneno .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Treintaytreses con Treintaysiete Diecinueve Dieciseis" ;
    poker:contieneCarta poker:TreintaytresDeElectrico, poker:TreintaytresDePlanta, poker:DiecinueveDeVeneno, poker:TreintaysieteDePlanta, poker:DieciseisDeElectrico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veintidoses con Veintiseis Veinte Catorce" ;
    poker:contieneCarta poker:VeintidosDeVeneno, poker:VeintidosDeBicho, poker:VeinteDeVeneno, poker:CatorceDeVolador, poker:VeintiseisDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treintayseises y Veintisietes con Diecisiete" ;
    poker:contieneCarta poker:VeintisieteDeVolador, poker:VeintisieteDeVeneno, poker:TreintayseisDeElectrico, poker:TreintayseisDeVeneno, poker:DiecisieteDeVeneno ;
    poker:manoTienePar poker:Veintisiete, poker:Treintayseis .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treintaysietes y Veintidoses con Veintitres" ;
    poker:contieneCarta poker:TreintaysieteDePlanta, poker:TreintaysieteDeVeneno, poker:VeintidosDeVeneno, poker:VeintidosDeAgua, poker:VeintitresDeBicho ;
    poker:manoTienePar poker:Treintaysiete, poker:Veintidos .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treintaydoses y Cincos con Treintaysiete" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDeNormal, poker:TreintaydosDeAgua, poker:TreintaydosDeVolador, poker:TreintaysieteDePlanta ;
    poker:manoTienePar poker:Cinco, poker:Treintaydos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Quinces con Veinte" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DieciseisDeNormal, poker:QuinceDeBicho, poker:QuinceDeVolador, poker:VeinteDePlanta ;
    poker:manoTienePar poker:Dieciseis, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieces con Veintiuno Dieciocho" ;
    poker:contieneCarta poker:DiezDeBicho, poker:DiezDeAgua, poker:DiezDeElectrico, poker:DieciochoDeElectrico, poker:VeintiunoDeVeneno .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Treintayunos con Treintaycuatro Veintiocho" ;
    poker:contieneCarta poker:TreintayunoDePlanta, poker:TreintayunoDeNormal, poker:TreintayunoDeElectrico, poker:TreintaycuatroDeElectrico, poker:VeintiochoDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veintidoses con Veintiseis Diecisiete" ;
    poker:contieneCarta poker:VeintidosDeElectrico, poker:VeintidosDeNormal, poker:VeintidosDeVeneno, poker:VeintiseisDeElectrico, poker:DiecisieteDeVeneno .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Seises con Treintaycuatro Treintaytres" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeFuego, poker:SeisDeElectrico, poker:TreintaycuatroDeBicho, poker:TreintaytresDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dieciseis-Diecisiete-Dieciocho-Diecinueve-Veinte" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DiecisieteDeElectrico, poker:DieciochoDeNormal, poker:DiecinueveDeNormal, poker:VeinteDeNormal .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete" ;
    poker:contieneCarta poker:VeintitresDeNormal, poker:VeinticuatroDeFuego, poker:VeinticincoDeVolador, poker:VeintiseisDeBicho, poker:VeintisieteDeVolador .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Treintaydos-Treintaytres-Treintaycuatro-Treintaycinco-Treintayseis" ;
    poker:contieneCarta poker:TreintaydosDeVeneno, poker:TreintaytresDeElectrico, poker:TreintaycuatroDeVeneno, poker:TreintaycincoDeVeneno, poker:TreintayseisDeFuego .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeVolador, poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeVolador, poker:CincoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintayuno Ocho Seis Cinco Uno de Planta" ;
    poker:contieneCarta poker:OchoDePlanta, poker:UnoDePlanta, poker:CincoDePlanta, poker:TreintayunoDePlanta, poker:SeisDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintaytres Treintaydos Veintitres Catorce Tres de Bicho" ;
    poker:contieneCarta poker:CatorceDeBicho, poker:TreintaydosDeBicho, poker:VeintitresDeBicho, poker:TreintaytresDeBicho, poker:TresDeBicho .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintaycuatro Veintiseis Dieciseis Catorce Tres de Eléctrico" ;
    poker:contieneCarta poker:TreintaycuatroDeElectrico, poker:VeintiseisDeElectrico, poker:CatorceDeElectrico, poker:DieciseisDeElectrico, poker:TresDeElectrico .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veinticinco Veinte Diecinueve Uno de Volador" ;
    poker:contieneCarta poker:VeinteDeVolador, poker:VeintiochoDeVolador, poker:DiecinueveDeVolador, poker:VeinticincoDeVolador, poker:UnoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Veinticincos" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeNormal, poker:SeisDeAgua, poker:VeinticincoDeFuego, poker:VeinticincoDeVeneno ;
    poker:manoTienePar poker:Seis, poker:Veinticinco .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treintas con Par de Veintiseises" ;
    poker:contieneCarta poker:TreintaDePlanta, poker:TreintaDeBicho, poker:TreintaDeFuego, poker:VeintiseisDePlanta, poker:VeintiseisDeElectrico ;
    poker:manoTienePar poker:Treinta, poker:Veintiseis .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Treintaysietes" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDeBicho, poker:SeisDeNormal, poker:TreintaysieteDeNormal, poker:TreintaysieteDeVeneno ;
    poker:manoTienePar poker:Seis, poker:Treintaysiete .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Veintes con Par de Veintiochos" ;
    poker:contieneCarta poker:VeinteDeFuego, poker:VeinteDePlanta, poker:VeinteDeAgua, poker:VeintiochoDePlanta, poker:VeintiochoDeFuego ;
    poker:manoTienePar poker:Veinte, poker:Veintiocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Dieces con Treintaysiete de Planta" ;
    poker:contieneCarta poker:DiezDeBicho, poker:DiezDeAgua, poker:DiezDeVolador, poker:DiezDeFuego, poker:TreintaysieteDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Dieciochos con Treintaydos de Veneno" ;
    poker:contieneCarta poker:DieciochoDeElectrico, poker:DieciochoDeVolador, poker:DieciochoDeBicho, poker:DieciochoDeAgua, poker:TreintaydosDeVeneno .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Treintaytreses con Veintidos de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeElectrico, poker:TreintaytresDePlanta, poker:TreintaytresDeAgua, poker:TreintaytresDeFuego, poker:VeintidosDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treintaydoses con Treintayseis de Fuego" ;
    poker:contieneCarta poker:TreintaydosDeAgua, poker:TreintaydosDeElectrico, poker:TreintaydosDeFuego, poker:TreintaydosDePlanta, poker:TreintayseisDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Bicho" ;
    poker:contieneCarta poker:SieteDeBicho, poker:OchoDeBicho, poker:NueveDeBicho, poker:DiezDeBicho, poker:OnceDeBicho .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Once-Doce-Trece-Catorce-Quince de Bicho" ;
    poker:contieneCarta poker:OnceDeBicho, poker:DoceDeBicho, poker:TreceDeBicho, poker:CatorceDeBicho, poker:QuinceDeBicho .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Eléctrico" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico, poker:TreceDeElectrico, poker:CatorceDeElectrico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Catorce-Quince-Dieciseis-Diecisiete-Dieciocho de Fuego" ;
    poker:contieneCarta poker:CatorceDeFuego, poker:QuinceDeFuego, poker:DieciseisDeFuego, poker:DiecisieteDeFuego, poker:DieciochoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Normal" ;
    poker:contieneCarta poker:TreintaytresDeNormal, poker:TreintaycuatroDeNormal, poker:TreintaycincoDeNormal, poker:TreintayseisDeNormal, poker:TreintaysieteDeNormal .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaycuatroDeFuego, poker:TreintaycincoDeFuego, poker:TreintayseisDeFuego, poker:TreintaysieteDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:TreintaytresDeElectrico, poker:TreintaycuatroDeElectrico, poker:TreintaycincoDeElectrico, poker:TreintayseisDeElectrico, poker:TreintaysieteDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:TreintaytresDeVeneno, poker:TreintaycuatroDeVeneno, poker:TreintaycincoDeVeneno, poker:TreintayseisDeVeneno, poker:TreintaysieteDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
