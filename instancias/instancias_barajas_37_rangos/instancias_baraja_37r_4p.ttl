# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_4p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiseis con Veinte Dieciseis Doce Diez" ;
    poker:contieneCarta poker:DiezDeElectrico, poker:DoceDeFuego, poker:DieciseisDeElectrico, poker:VeinteDePlanta, poker:VeintiseisDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Dieciocho Once Diez Tres" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:OnceDeAgua, poker:DieciochoDeAgua, poker:TresDeFuego, poker:DiezDePlanta .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Veintitres Diecisiete Trece Nueve" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:TreceDeFuego, poker:NueveDeElectrico, poker:DiecisieteDePlanta, poker:VeintitresDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Diecinueve Dieciocho Catorce Doce" ;
    poker:contieneCarta poker:DiecinueveDeAgua, poker:CatorceDeFuego, poker:DieciochoDePlanta, poker:TreintaDeAgua, poker:DoceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Treces con Veinticinco Veintitres Quince" ;
    poker:contieneCarta poker:TreceDeAgua, poker:TreceDePlanta, poker:VeinticincoDePlanta, poker:VeintitresDeElectrico, poker:QuinceDePlanta .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Quinces con Treintaycinco Veinte Catorce" ;
    poker:contieneCarta poker:QuinceDeAgua, poker:QuinceDePlanta, poker:TreintaycincoDeElectrico, poker:VeinteDePlanta, poker:CatorceDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Diecinueves con Veintiseis Dieciseis Trece" ;
    poker:contieneCarta poker:DiecinueveDeAgua, poker:DiecinueveDeElectrico, poker:TreceDeFuego, poker:DieciseisDePlanta, poker:VeintiseisDeElectrico .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Sietes con Treintaycuatro Veintitres Veintiuno" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:SieteDePlanta, poker:TreintaycuatroDePlanta, poker:VeintiunoDeAgua, poker:VeintitresDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Treintayseises y Dieciochos con Treintaycuatro" ;
    poker:contieneCarta poker:TreintayseisDeElectrico, poker:TreintayseisDePlanta, poker:DieciochoDeAgua, poker:DieciochoDePlanta, poker:TreintaycuatroDePlanta ;
    poker:manoTienePar poker:Treintayseis, poker:Dieciocho .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veintisietes y Cuatros con Cinco" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeElectrico, poker:VeintisieteDeFuego, poker:VeintisieteDePlanta, poker:CincoDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Veintisiete .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Treintaydoses y Cuatros con Siete" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:TreintaydosDePlanta, poker:TreintaydosDeElectrico, poker:SieteDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Treintaydos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Treintayunos y Veintes con Diecisiete" ;
    poker:contieneCarta poker:TreintayunoDeFuego, poker:TreintayunoDeElectrico, poker:VeinteDePlanta, poker:VeinteDeAgua, poker:DiecisieteDeAgua ;
    poker:manoTienePar poker:Treintayuno, poker:Veinte .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Treintas con Treintaycuatro Tres" ;
    poker:contieneCarta poker:TreintaDeAgua, poker:TreintaDeElectrico, poker:TreintaDePlanta, poker:TresDeElectrico, poker:TreintaycuatroDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Veintitreses con Treintayseis Veinticinco" ;
    poker:contieneCarta poker:VeintitresDeAgua, poker:VeintitresDeElectrico, poker:VeintitresDeFuego, poker:TreintayseisDeAgua, poker:VeinticincoDeElectrico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Veinticincos con Once Cuatro" ;
    poker:contieneCarta poker:VeinticincoDePlanta, poker:VeinticincoDeElectrico, poker:VeinticincoDeFuego, poker:OnceDeElectrico, poker:CuatroDePlanta .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Diecisietes con Catorce Doce" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:DiecisieteDeFuego, poker:DiecisieteDeAgua, poker:CatorceDeElectrico, poker:DoceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos" ;
    poker:contieneCarta poker:DieciochoDeElectrico, poker:DiecinueveDeFuego, poker:VeinteDeAgua, poker:VeintiunoDeFuego, poker:VeintidosDePlanta .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDePlanta, poker:TreceDePlanta .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Diecinueve-Veinte-Veintiuno-Veintidos-Veintitres" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:VeinteDeElectrico, poker:VeintiunoDePlanta, poker:VeintidosDeAgua, poker:VeintitresDePlanta .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDePlanta, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeAgua, poker:CatorceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Treintaytres Treintayuno Veintidos Quince Diez de Planta" ;
    poker:contieneCarta poker:TreintayunoDePlanta, poker:TreintaytresDePlanta, poker:DiezDePlanta, poker:QuinceDePlanta, poker:VeintidosDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Treintaycuatro Veintidos Cinco Cuatro de Eléctrico" ;
    poker:contieneCarta poker:TreintaycincoDeElectrico, poker:VeintidosDeElectrico, poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:TreintaycuatroDeElectrico .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veintidos Veinte Diecinueve Dieciseis de Planta" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:TreintayunoDePlanta, poker:VeinteDePlanta, poker:DiecinueveDePlanta, poker:VeintidosDePlanta .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintisiete Veinticuatro Nueve Dos Uno de Fuego" ;
    poker:contieneCarta poker:NueveDeFuego, poker:VeinticuatroDeFuego, poker:DosDeFuego, poker:VeintisieteDeFuego, poker:UnoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veintiunos con Par de Treintaysietes" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintiunoDeElectrico, poker:VeintiunoDeAgua, poker:TreintaysieteDePlanta, poker:TreintaysieteDeAgua ;
    poker:manoTienePar poker:Veintiuno, poker:Treintaysiete .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Doces con Par de Treintayunos" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDePlanta, poker:DoceDeElectrico, poker:TreintayunoDeElectrico, poker:TreintayunoDeFuego ;
    poker:manoTienePar poker:Doce, poker:Treintayuno .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaycuatros con Par de Dieces" ;
    poker:contieneCarta poker:TreintaycuatroDeAgua, poker:TreintaycuatroDePlanta, poker:TreintaycuatroDeFuego, poker:DiezDeAgua, poker:DiezDeElectrico ;
    poker:manoTienePar poker:Treintaycuatro, poker:Diez .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaydoses con Par de Dieces" ;
    poker:contieneCarta poker:TreintaydosDeAgua, poker:TreintaydosDeFuego, poker:TreintaydosDePlanta, poker:DiezDeAgua, poker:DiezDePlanta ;
    poker:manoTienePar poker:Treintaydos, poker:Diez .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Treintaytreses con Dieciocho de Planta" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaytresDePlanta, poker:TreintaytresDeAgua, poker:TreintaytresDeElectrico, poker:DieciochoDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Treintaytreses con Treintaycinco de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaytresDePlanta, poker:TreintaytresDeFuego, poker:TreintaytresDeElectrico, poker:TreintaycincoDeFuego .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Unos con Treintaysiete de Fuego" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeFuego, poker:UnoDeElectrico, poker:UnoDeAgua, poker:TreintaysieteDeFuego .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Veintiseises con Once de Eléctrico" ;
    poker:contieneCarta poker:VeintiseisDeElectrico, poker:VeintiseisDeFuego, poker:VeintiseisDePlanta, poker:VeintiseisDeAgua, poker:OnceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta de Eléctrico" ;
    poker:contieneCarta poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Dos-Tres-Cuatro-Cinco-Seis de Agua" ;
    poker:contieneCarta poker:DosDeAgua, poker:TresDeAgua, poker:CuatroDeAgua, poker:CincoDeAgua, poker:SeisDeAgua .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve de Eléctrico" ;
    poker:contieneCarta poker:VeinticincoDeElectrico, poker:VeintiseisDeElectrico, poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Nueve-Diez-Once-Doce-Trece de Planta" ;
    poker:contieneCarta poker:NueveDePlanta, poker:DiezDePlanta, poker:OnceDePlanta, poker:DoceDePlanta, poker:TreceDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:TreintaytresDeFuego, poker:TreintaycuatroDeFuego, poker:TreintaycincoDeFuego, poker:TreintayseisDeFuego, poker:TreintaysieteDeFuego .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:TreintaytresDePlanta, poker:TreintaycuatroDePlanta, poker:TreintaycincoDePlanta, poker:TreintayseisDePlanta, poker:TreintaysieteDePlanta .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:TreintaytresDeElectrico, poker:TreintaycuatroDeElectrico, poker:TreintaycincoDeElectrico, poker:TreintayseisDeElectrico, poker:TreintaysieteDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:TreintaytresDeAgua, poker:TreintaycuatroDeAgua, poker:TreintaycincoDeAgua, poker:TreintayseisDeAgua, poker:TreintaysieteDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
