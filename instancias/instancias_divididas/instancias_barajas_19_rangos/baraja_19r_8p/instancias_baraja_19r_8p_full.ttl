# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Doses" ;
    poker:contieneCarta poker:DiecisieteDeVeneno, poker:DiecisieteDePlanta, poker:DiecisieteDeElectrico, poker:DosDeElectrico, poker:DosDeBicho ;
    poker:manoTienePar poker:Diecisiete, poker:Dos .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Diecisietes" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDeFuego, poker:DiezDePlanta, poker:DiecisieteDeFuego, poker:DiecisieteDeVeneno ;
    poker:manoTienePar poker:Diez, poker:Diecisiete .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Onces" ;
    poker:contieneCarta poker:NueveDeElectrico, poker:NueveDeAgua, poker:NueveDeBicho, poker:OnceDeAgua, poker:OnceDePlanta ;
    poker:manoTienePar poker:Nueve, poker:Once .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Treces" ;
    poker:contieneCarta poker:CincoDeVolador, poker:CincoDePlanta, poker:CincoDeBicho, poker:TreceDeFuego, poker:TreceDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Trece .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
