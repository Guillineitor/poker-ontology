# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera
# =============================================================================

@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 5. Escalera." .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:DieciseisDeAgua, poker:DiecisieteDePlanta, poker:DieciochoDeVolador, poker:DiecinueveDeNormal .

escalera:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDeBicho, poker:QuinceDeNormal, poker:DieciseisDeElectrico, poker:DiecisieteDeBicho, poker:DieciochoDeElectrico .

escalera:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeFuego, poker:TreceDeVolador, poker:CatorceDeFuego, poker:QuinceDePlanta, poker:DieciseisDeVeneno .

escalera:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Cinco-Seis-Siete-Ocho-Nueve" ;
    poker:contieneCarta poker:CincoDeVolador, poker:SeisDeBicho, poker:SieteDeVeneno, poker:OchoDeAgua, poker:NueveDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano1 escalera:Mano2 escalera:Mano3 escalera:Mano4 ) .
