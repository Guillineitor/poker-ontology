# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Diez Tres Dos Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:DosDeFuego, poker:UnoDePlanta, poker:DiecisieteDeFuego, poker:DiezDeNormal .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Doce Seis Tres Dos" ;
    poker:contieneCarta poker:DieciochoDeVeneno, poker:DosDeElectrico, poker:TresDeVeneno, poker:DoceDeAgua, poker:SeisDeBicho .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Catorce Diez Nueve Tres" ;
    poker:contieneCarta poker:TresDeAgua, poker:NueveDeAgua, poker:DiecisieteDeBicho, poker:CatorceDeBicho, poker:DiezDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Doce Diez Cinco Tres" ;
    poker:contieneCarta poker:DiezDePlanta, poker:CincoDeFuego, poker:DoceDeElectrico, poker:TresDePlanta, poker:DiecinueveDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
