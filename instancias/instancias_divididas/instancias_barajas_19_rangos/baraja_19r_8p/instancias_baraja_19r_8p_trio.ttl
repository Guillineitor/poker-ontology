# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Doces con Dieciseis Diez" ;
    poker:contieneCarta poker:DoceDeVolador, poker:DoceDeVeneno, poker:DoceDeAgua, poker:DieciseisDeVeneno, poker:DiezDeBicho .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Diez Uno" ;
    poker:contieneCarta poker:DieciochoDeAgua, poker:DieciochoDeVolador, poker:DieciochoDeFuego, poker:UnoDeElectrico, poker:DiezDeVeneno .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Diecisiete Catorce" ;
    poker:contieneCarta poker:DieciochoDeBicho, poker:DieciochoDePlanta, poker:DieciochoDeVolador, poker:DiecisieteDeVeneno, poker:CatorceDeVolador .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Ochos con Diecisiete Seis" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDePlanta, poker:OchoDeAgua, poker:SeisDeElectrico, poker:DiecisieteDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
