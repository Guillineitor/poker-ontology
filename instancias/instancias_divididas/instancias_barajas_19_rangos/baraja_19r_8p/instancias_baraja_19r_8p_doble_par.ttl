# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Cuatros con Seis" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CuatroDeVolador, poker:DiezDePlanta, poker:DiezDeFuego, poker:SeisDeNormal ;
    poker:manoTienePar poker:Cuatro, poker:Diez .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Onces con Catorce" ;
    poker:contieneCarta poker:OnceDeVolador, poker:OnceDeFuego, poker:DieciseisDeElectrico, poker:DieciseisDeBicho, poker:CatorceDeBicho ;
    poker:manoTienePar poker:Once, poker:Dieciseis .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Ochos con Catorce" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDeNormal, poker:OchoDeBicho, poker:OchoDeNormal, poker:CatorceDeFuego ;
    poker:manoTienePar poker:Quince, poker:Ocho .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Dieces con Diecinueve" ;
    poker:contieneCarta poker:DiezDeBicho, poker:DiezDeNormal, poker:DoceDeAgua, poker:DoceDePlanta, poker:DiecinueveDeElectrico ;
    poker:manoTienePar poker:Diez, poker:Doce .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
