# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Treces con Diecisiete Nueve Ocho" ;
    poker:contieneCarta poker:TreceDeBicho, poker:TreceDeAgua, poker:DiecisieteDeLucha, poker:NueveDeVeneno, poker:OchoDeTierra .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Treses con Nueve Seis Cuatro" ;
    poker:contieneCarta poker:TresDeRoca, poker:TresDeTierra, poker:NueveDeBicho, poker:SeisDePsiquico, poker:CuatroDeNormal .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Treses con Catorce Trece Cuatro" ;
    poker:contieneCarta poker:TresDeRoca, poker:TresDeVolador, poker:TreceDeVeneno, poker:CuatroDeFuego, poker:CatorceDeTierra .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Doses con Once Ocho Uno" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDeFuego, poker:OchoDeBicho, poker:UnoDeRoca, poker:OnceDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
