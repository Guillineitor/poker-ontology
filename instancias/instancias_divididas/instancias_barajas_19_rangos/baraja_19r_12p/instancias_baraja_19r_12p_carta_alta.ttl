# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Ocho Seis Cinco Dos" ;
    poker:contieneCarta poker:CincoDeBicho, poker:DosDeTierra, poker:DiecinueveDePsiquico, poker:SeisDeElectrico, poker:OchoDeBicho .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Quince Catorce Tres Dos" ;
    poker:contieneCarta poker:DosDePsiquico, poker:DieciseisDeTierra, poker:CatorceDeVolador, poker:QuinceDePsiquico, poker:TresDeRoca .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciocho con Catorce Once Diez Nueve" ;
    poker:contieneCarta poker:CatorceDeRoca, poker:DiezDeFuego, poker:DieciochoDeRoca, poker:NueveDeVeneno, poker:OnceDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Diecisiete Quince Catorce Trece" ;
    poker:contieneCarta poker:CatorceDeVeneno, poker:DiecisieteDePsiquico, poker:QuinceDePlanta, poker:TreceDeTierra, poker:DiecinueveDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
