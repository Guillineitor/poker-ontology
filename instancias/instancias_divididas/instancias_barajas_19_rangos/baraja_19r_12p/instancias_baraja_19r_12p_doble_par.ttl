# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Doses con Once" ;
    poker:contieneCarta poker:DosDeTierra, poker:DosDeLucha, poker:DieciseisDeFuego, poker:DieciseisDeTierra, poker:OnceDeTierra ;
    poker:manoTienePar poker:Dos, poker:Dieciseis .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Ochos y Treses con Dieciseis" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeElectrico, poker:OchoDeBicho, poker:OchoDeTierra, poker:DieciseisDeTierra ;
    poker:manoTienePar poker:Tres, poker:Ocho .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Unos con Catorce" ;
    poker:contieneCarta poker:UnoDeRoca, poker:UnoDeElectrico, poker:CincoDeFuego, poker:CincoDeElectrico, poker:CatorceDeFuego ;
    poker:manoTienePar poker:Uno, poker:Cinco .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Seises con Tres" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:QuinceDeLucha, poker:SeisDeRoca, poker:SeisDeVeneno, poker:TresDeTierra ;
    poker:manoTienePar poker:Quince, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
