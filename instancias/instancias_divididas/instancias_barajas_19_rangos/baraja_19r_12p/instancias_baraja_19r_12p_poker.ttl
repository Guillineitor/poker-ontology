# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Seises con Catorce de Bicho" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDeFuego, poker:SeisDeLucha, poker:SeisDeTierra, poker:CatorceDeBicho .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Doses con Siete de Roca" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDeVeneno, poker:DosDePlanta, poker:DosDeLucha, poker:SieteDeRoca .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Sietes con Dos de Lucha" ;
    poker:contieneCarta poker:SieteDeNormal, poker:SieteDeRoca, poker:SieteDeVeneno, poker:SieteDeFuego, poker:DosDeLucha .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Dieciocho de Volador" ;
    poker:contieneCarta poker:DiecisieteDePsiquico, poker:DiecisieteDeTierra, poker:DiecisieteDeNormal, poker:DiecisieteDeRoca, poker:DieciochoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
