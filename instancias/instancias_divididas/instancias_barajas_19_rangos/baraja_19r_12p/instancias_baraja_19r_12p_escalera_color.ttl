# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color
# =============================================================================

@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 9. Escalera de Color." .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Electrico" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico .

escalera_color:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Veneno" ;
    poker:contieneCarta poker:DoceDeVeneno, poker:TreceDeVeneno, poker:CatorceDeVeneno, poker:QuinceDeVeneno, poker:DieciseisDeVeneno .

escalera_color:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Veneno" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:NueveDeVeneno, poker:DiezDeVeneno, poker:OnceDeVeneno, poker:DoceDeVeneno .

escalera_color:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Fuego" ;
    poker:contieneCarta poker:DiezDeFuego, poker:OnceDeFuego, poker:DoceDeFuego, poker:TreceDeFuego, poker:CatorceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano1 escalera_color:Mano2 escalera_color:Mano3 escalera_color:Mano4 ) .
