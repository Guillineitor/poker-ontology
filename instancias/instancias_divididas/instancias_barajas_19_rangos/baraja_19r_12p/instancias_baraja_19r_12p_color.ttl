# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 6. Color
# =============================================================================

@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 6. Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 6. Color." .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano1 a poker:Mano ;
    rdfs:label "Color de Quince Catorce Ocho Cuatro Uno de Agua" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CatorceDeAgua, poker:OchoDeAgua, poker:UnoDeAgua, poker:QuinceDeAgua .

color:Mano2 a poker:Mano ;
    rdfs:label "Color de Dieciocho Quince Doce Diez Siete de Volador" ;
    poker:contieneCarta poker:DiezDeVolador, poker:DieciochoDeVolador, poker:QuinceDeVolador, poker:SieteDeVolador, poker:DoceDeVolador .

color:Mano3 a poker:Mano ;
    rdfs:label "Color de Dieciocho Once Diez Nueve Dos de Roca" ;
    poker:contieneCarta poker:NueveDeRoca, poker:DiezDeRoca, poker:DosDeRoca, poker:OnceDeRoca, poker:DieciochoDeRoca .

color:Mano4 a poker:Mano ;
    rdfs:label "Color de Diecisiete Catorce Cuatro Tres Dos de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:DosDeFuego, poker:CuatroDeFuego, poker:DiecisieteDeFuego, poker:CatorceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano1 color:Mano2 color:Mano3 color:Mano4 ) .
