# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Doses" ;
    poker:contieneCarta poker:OnceDePlanta, poker:OnceDeElectrico, poker:OnceDeAgua, poker:DosDeAgua, poker:DosDeFuego ;
    poker:manoTienePar poker:Once, poker:Dos .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Quinces con Par de Cuatros" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDeElectrico, poker:QuinceDePlanta, poker:CuatroDeFuego, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Quince, poker:Cuatro .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Treses" ;
    poker:contieneCarta poker:DiecisieteDeElectrico, poker:DiecisieteDeAgua, poker:DiecisieteDePlanta, poker:TresDeElectrico, poker:TresDeAgua ;
    poker:manoTienePar poker:Diecisiete, poker:Tres .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Onces" ;
    poker:contieneCarta poker:SieteDeAgua, poker:SieteDeElectrico, poker:SieteDeFuego, poker:OnceDeAgua, poker:OnceDeFuego ;
    poker:manoTienePar poker:Siete, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
