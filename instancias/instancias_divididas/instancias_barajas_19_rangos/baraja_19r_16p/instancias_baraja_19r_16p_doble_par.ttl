# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Doces con Trece" ;
    poker:contieneCarta poker:DiecinueveDeHielo, poker:DiecinueveDeVeneno, poker:DoceDePsiquico, poker:DoceDeAgua, poker:TreceDeDragon ;
    poker:manoTienePar poker:Diecinueve, poker:Doce .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Cuatros con Dieciseis" ;
    poker:contieneCarta poker:OnceDeVolador, poker:OnceDeHielo, poker:CuatroDeFantasma, poker:CuatroDeBicho, poker:DieciseisDePsiquico ;
    poker:manoTienePar poker:Once, poker:Cuatro .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Cincos con Dieciocho" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeFuego, poker:TreceDeTierra, poker:TreceDeDragon, poker:DieciochoDeVeneno ;
    poker:manoTienePar poker:Cinco, poker:Trece .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Cuatros con Siete" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDeFuego, poker:CincoDeTierra, poker:CincoDeDragon, poker:SieteDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
