# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Catorce Doce Siete Cuatro" ;
    poker:contieneCarta poker:SieteDeFuego, poker:CuatroDeRoca, poker:DieciseisDeRoca, poker:CatorceDeRoca, poker:DoceDeSiniestro .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Quince con Catorce Trece Doce Tres" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:CatorceDeBicho, poker:DoceDeAgua, poker:TresDeElectrico, poker:TreceDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Once Seis Cuatro Dos" ;
    poker:contieneCarta poker:OnceDeTierra, poker:CuatroDePsiquico, poker:SeisDeNormal, poker:DieciseisDeLucha, poker:DosDeTierra .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Once Nueve Seis Uno" ;
    poker:contieneCarta poker:UnoDeFantasma, poker:NueveDePlanta, poker:DieciseisDeFantasma, poker:OnceDePlanta, poker:SeisDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
