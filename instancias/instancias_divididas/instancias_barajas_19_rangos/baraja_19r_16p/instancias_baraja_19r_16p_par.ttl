# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Dieces con Dieciocho Once Cuatro" ;
    poker:contieneCarta poker:DiezDeSiniestro, poker:DiezDeVeneno, poker:OnceDeDragon, poker:CuatroDeRoca, poker:DieciochoDePsiquico .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Seises con Quince Trece Doce" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeSiniestro, poker:QuinceDeVeneno, poker:TreceDeLucha, poker:DoceDeVeneno .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Onces con Ocho Tres Dos" ;
    poker:contieneCarta poker:OnceDeBicho, poker:OnceDeElectrico, poker:DosDeSiniestro, poker:TresDeDragon, poker:OchoDeVeneno .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Diecinueves con Dieciocho Dieciseis Siete" ;
    poker:contieneCarta poker:DiecinueveDePsiquico, poker:DiecinueveDeLucha, poker:DieciseisDeHielo, poker:DieciochoDeFuego, poker:SieteDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
