# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Unos con Ocho de Veneno" ;
    poker:contieneCarta poker:UnoDeTierra, poker:UnoDeVeneno, poker:UnoDeVolador, poker:UnoDeSiniestro, poker:OchoDeVeneno .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Dieciseises con Seis de Lucha" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DieciseisDePlanta, poker:DieciseisDeNormal, poker:DieciseisDeBicho, poker:SeisDeLucha .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Cincos con Seis de Veneno" ;
    poker:contieneCarta poker:CincoDeBicho, poker:CincoDeSiniestro, poker:CincoDeElectrico, poker:CincoDeNormal, poker:SeisDeVeneno .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Diez de Fantasma" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDeAgua, poker:CuatroDePsiquico, poker:CuatroDeTierra, poker:DiezDeFantasma .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
