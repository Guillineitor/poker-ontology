# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_19r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_19r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Seises con Dieciseis Once" ;
    poker:contieneCarta poker:SeisDeDragon, poker:SeisDeSiniestro, poker:SeisDeLucha, poker:OnceDeSiniestro, poker:DieciseisDeElectrico .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Once Ocho" ;
    poker:contieneCarta poker:CuatroDeRoca, poker:CuatroDeFantasma, poker:CuatroDePsiquico, poker:OnceDeDragon, poker:OchoDeVolador .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Diecisietes con Nueve Cinco" ;
    poker:contieneCarta poker:DiecisieteDeVeneno, poker:DiecisieteDeVolador, poker:DiecisieteDeElectrico, poker:CincoDeFantasma, poker:NueveDeLucha .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Diecinueves con Diez Ocho" ;
    poker:contieneCarta poker:DiecinueveDeVolador, poker:DiecinueveDeLucha, poker:DiecinueveDeElectrico, poker:DiezDeLucha, poker:OchoDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
