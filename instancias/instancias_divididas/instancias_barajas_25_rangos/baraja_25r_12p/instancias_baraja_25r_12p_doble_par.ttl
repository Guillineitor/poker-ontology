# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Veinticuatros y Cuatros con Uno" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDeBicho, poker:VeinticuatroDeFuego, poker:VeinticuatroDeRoca, poker:UnoDeRoca ;
    poker:manoTienePar poker:Cuatro, poker:Veinticuatro .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Catorces y Onces con Dieciseis" ;
    poker:contieneCarta poker:CatorceDeRoca, poker:CatorceDeBicho, poker:OnceDeVolador, poker:OnceDeTierra, poker:DieciseisDeFuego ;
    poker:manoTienePar poker:Catorce, poker:Once .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Veinticincos y Doces con Ocho" ;
    poker:contieneCarta poker:VeinticincoDeRoca, poker:VeinticincoDeAgua, poker:DoceDeFuego, poker:DoceDeVeneno, poker:OchoDePlanta ;
    poker:manoTienePar poker:Veinticinco, poker:Doce .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Diecisietes y Sietes con Veintidos" ;
    poker:contieneCarta poker:SieteDeBicho, poker:SieteDeTierra, poker:DiecisieteDeVeneno, poker:DiecisieteDeBicho, poker:VeintidosDeVeneno ;
    poker:manoTienePar poker:Siete, poker:Diecisiete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
