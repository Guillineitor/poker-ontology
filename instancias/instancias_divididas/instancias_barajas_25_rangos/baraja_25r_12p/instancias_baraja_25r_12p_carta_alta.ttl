# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Veintidos Trece Cinco Cuatro" ;
    poker:contieneCarta poker:VeintidosDeRoca, poker:CincoDeElectrico, poker:TreceDeAgua, poker:CuatroDeNormal, poker:VeinticuatroDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veinte con Doce Nueve Ocho Uno" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:DoceDeVeneno, poker:VeinteDeVeneno, poker:OchoDeBicho, poker:UnoDeRoca .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Quince con Catorce Doce Diez Cuatro" ;
    poker:contieneCarta poker:CuatroDeTierra, poker:CatorceDePlanta, poker:DiezDeFuego, poker:QuinceDeTierra, poker:DoceDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecisiete con Ocho Cuatro Dos Uno" ;
    poker:contieneCarta poker:DosDeNormal, poker:CuatroDeLucha, poker:UnoDeBicho, poker:DiecisieteDePlanta, poker:OchoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
