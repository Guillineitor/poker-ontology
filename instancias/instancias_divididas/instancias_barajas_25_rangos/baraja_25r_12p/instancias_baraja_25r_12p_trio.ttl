# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Veintidos Dos" ;
    poker:contieneCarta poker:DieciochoDePsiquico, poker:DieciochoDeBicho, poker:DieciochoDeNormal, poker:VeintidosDeVeneno, poker:DosDeBicho .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Sietes con Catorce Doce" ;
    poker:contieneCarta poker:SieteDeAgua, poker:SieteDeVolador, poker:SieteDeBicho, poker:CatorceDePsiquico, poker:DoceDeVolador .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Diecinueves con Veinte Trece" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:DiecinueveDeLucha, poker:DiecinueveDeVeneno, poker:TreceDeVolador, poker:VeinteDeBicho .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Catorces con Veintiuno Tres" ;
    poker:contieneCarta poker:CatorceDeFuego, poker:CatorceDeElectrico, poker:CatorceDeNormal, poker:TresDeVolador, poker:VeintiunoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
