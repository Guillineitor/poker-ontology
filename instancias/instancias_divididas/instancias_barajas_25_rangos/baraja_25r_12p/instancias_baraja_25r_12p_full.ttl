# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Cincos" ;
    poker:contieneCarta poker:NueveDeLucha, poker:NueveDeBicho, poker:NueveDeFuego, poker:CincoDeElectrico, poker:CincoDeVolador ;
    poker:manoTienePar poker:Nueve, poker:Cinco .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Sietes" ;
    poker:contieneCarta poker:DiecisieteDeTierra, poker:DiecisieteDePlanta, poker:DiecisieteDeElectrico, poker:SieteDeElectrico, poker:SieteDePlanta ;
    poker:manoTienePar poker:Diecisiete, poker:Siete .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Cuatros" ;
    poker:contieneCarta poker:VeintidosDeVeneno, poker:VeintidosDeFuego, poker:VeintidosDePsiquico, poker:CuatroDeVolador, poker:CuatroDeRoca ;
    poker:manoTienePar poker:Veintidos, poker:Cuatro .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Cincos" ;
    poker:contieneCarta poker:VeintidosDeBicho, poker:VeintidosDeVolador, poker:VeintidosDeNormal, poker:CincoDeElectrico, poker:CincoDeTierra ;
    poker:manoTienePar poker:Veintidos, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
