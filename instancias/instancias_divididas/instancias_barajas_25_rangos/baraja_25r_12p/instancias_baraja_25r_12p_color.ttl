# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 6. Color
# =============================================================================

@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 6. Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 6. Color." .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano1 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintidos Dieciocho Seis Dos de Planta" ;
    poker:contieneCarta poker:VeinticuatroDePlanta, poker:DieciochoDePlanta, poker:VeintidosDePlanta, poker:DosDePlanta, poker:SeisDePlanta .

color:Mano2 a poker:Mano ;
    rdfs:label "Color de Dieciocho Nueve Ocho Siete Dos de Planta" ;
    poker:contieneCarta poker:OchoDePlanta, poker:DosDePlanta, poker:NueveDePlanta, poker:SieteDePlanta, poker:DieciochoDePlanta .

color:Mano3 a poker:Mano ;
    rdfs:label "Color de Veintidos Dieciocho Doce Ocho Cuatro de Electrico" ;
    poker:contieneCarta poker:VeintidosDeElectrico, poker:DieciochoDeElectrico, poker:OchoDeElectrico, poker:DoceDeElectrico, poker:CuatroDeElectrico .

color:Mano4 a poker:Mano ;
    rdfs:label "Color de Veintidos Doce Nueve Cinco Cuatro de Bicho" ;
    poker:contieneCarta poker:DoceDeBicho, poker:NueveDeBicho, poker:CincoDeBicho, poker:VeintidosDeBicho, poker:CuatroDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano1 color:Mano2 color:Mano3 color:Mano4 ) .
