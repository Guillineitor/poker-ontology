# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera
# =============================================================================

@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 5. Escalera." .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Seis-Siete-Ocho-Nueve-Diez" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SieteDeNormal, poker:OchoDeNormal, poker:NueveDeAgua, poker:DiezDePlanta .

escalera:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:QuinceDeSiniestro, poker:DieciseisDeBicho, poker:DiecisieteDeFuego, poker:DieciochoDeAgua .

escalera:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeFuego, poker:OchoDeTierra, poker:NueveDeElectrico, poker:DiezDeRoca, poker:OnceDePlanta .

escalera:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos" ;
    poker:contieneCarta poker:DieciochoDeNormal, poker:DiecinueveDeDragon, poker:VeinteDeFantasma, poker:VeintiunoDeBicho, poker:VeintidosDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano1 escalera:Mano2 escalera:Mano3 escalera:Mano4 ) .
