# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Dieces con Veintidos Cinco" ;
    poker:contieneCarta poker:DiezDeBicho, poker:DiezDeNormal, poker:DiezDeTierra, poker:CincoDeNormal, poker:VeintidosDeLucha .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Nueves con Veinticuatro Dos" ;
    poker:contieneCarta poker:NueveDeVolador, poker:NueveDeElectrico, poker:NueveDePsiquico, poker:VeinticuatroDeNormal, poker:DosDePlanta .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Catorces con Veinticinco Siete" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDePsiquico, poker:CatorceDeDragon, poker:VeinticincoDeRoca, poker:SieteDeRoca .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Dieces con Diecisiete Catorce" ;
    poker:contieneCarta poker:DiezDeFantasma, poker:DiezDeHielo, poker:DiezDeAgua, poker:CatorceDeVolador, poker:DiecisieteDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
