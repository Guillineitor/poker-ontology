# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Dos de Electrico" ;
    poker:contieneCarta poker:DiecisieteDeDragon, poker:DiecisieteDeNormal, poker:DiecisieteDeTierra, poker:DiecisieteDePlanta, poker:DosDeElectrico .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Quinces con Veintidos de Roca" ;
    poker:contieneCarta poker:QuinceDeBicho, poker:QuinceDeRoca, poker:QuinceDePlanta, poker:QuinceDeTierra, poker:VeintidosDeRoca .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Doses con Diez de Dragon" ;
    poker:contieneCarta poker:DosDeSiniestro, poker:DosDeFuego, poker:DosDePsiquico, poker:DosDeFantasma, poker:DiezDeDragon .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Doces con Ocho de Bicho" ;
    poker:contieneCarta poker:DoceDeSiniestro, poker:DoceDeTierra, poker:DoceDeBicho, poker:DoceDePlanta, poker:OchoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
