# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Sietes con Cuatro" ;
    poker:contieneCarta poker:SieteDeAgua, poker:SieteDePsiquico, poker:QuinceDeVeneno, poker:QuinceDeAgua, poker:CuatroDePsiquico ;
    poker:manoTienePar poker:Siete, poker:Quince .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Veinticincos y Seises con Veintitres" ;
    poker:contieneCarta poker:SeisDeLucha, poker:SeisDeSiniestro, poker:VeinticincoDeRoca, poker:VeinticincoDeElectrico, poker:VeintitresDePsiquico ;
    poker:manoTienePar poker:Seis, poker:Veinticinco .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Nueves con Tres" ;
    poker:contieneCarta poker:NueveDeHielo, poker:NueveDeElectrico, poker:VeintiunoDeAgua, poker:VeintiunoDeElectrico, poker:TresDeVolador ;
    poker:manoTienePar poker:Nueve, poker:Veintiuno .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Unos con Dieciocho" ;
    poker:contieneCarta poker:UnoDeLucha, poker:UnoDeTierra, poker:DoceDeVeneno, poker:DoceDeNormal, poker:DieciochoDeVolador ;
    poker:manoTienePar poker:Uno, poker:Doce .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
