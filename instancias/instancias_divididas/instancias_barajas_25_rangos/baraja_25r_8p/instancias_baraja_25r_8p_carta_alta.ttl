# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Nueve Cuatro Tres Uno" ;
    poker:contieneCarta poker:NueveDeAgua, poker:TresDeElectrico, poker:OnceDeAgua, poker:UnoDeNormal, poker:CuatroDeBicho .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Catorce con Nueve Seis Tres Uno" ;
    poker:contieneCarta poker:UnoDeNormal, poker:TresDeAgua, poker:SeisDeFuego, poker:CatorceDeFuego, poker:NueveDeVeneno .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Dieciocho Diecisiete Catorce Tres" ;
    poker:contieneCarta poker:DiecisieteDePlanta, poker:CatorceDeElectrico, poker:VeintitresDeFuego, poker:DieciochoDeBicho, poker:TresDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Veintidos Diecinueve Quince Ocho" ;
    poker:contieneCarta poker:OchoDePlanta, poker:VeintidosDeVeneno, poker:QuinceDeFuego, poker:VeinticuatroDeAgua, poker:DiecinueveDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
