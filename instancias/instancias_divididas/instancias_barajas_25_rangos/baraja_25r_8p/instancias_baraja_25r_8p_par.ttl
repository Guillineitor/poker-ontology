# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Veinticuatro Once Seis" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:DieciseisDeBicho, poker:VeinticuatroDeVeneno, poker:OnceDePlanta, poker:SeisDeFuego .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Veintes con Veintitres Dieciseis Uno" ;
    poker:contieneCarta poker:VeinteDeBicho, poker:VeinteDeNormal, poker:UnoDeFuego, poker:VeintitresDePlanta, poker:DieciseisDeVeneno .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Diecinueves con Veinticinco Siete Uno" ;
    poker:contieneCarta poker:DiecinueveDePlanta, poker:DiecinueveDeVolador, poker:VeinticincoDeNormal, poker:UnoDeFuego, poker:SieteDeBicho .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Veintitreses con Quince Catorce Trece" ;
    poker:contieneCarta poker:VeintitresDeAgua, poker:VeintitresDeVeneno, poker:TreceDeFuego, poker:CatorceDeVolador, poker:QuinceDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
