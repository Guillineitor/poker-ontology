# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Quinces con Veinte Diecisiete Dos" ;
    poker:contieneCarta poker:QuinceDePlanta, poker:QuinceDeElectrico, poker:DosDeFuego, poker:VeinteDeFuego, poker:DiecisieteDeElectrico .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Diecinueves con Dieciocho Dieciseis Dos" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:DiecinueveDePlanta, poker:DieciseisDeFuego, poker:DosDePlanta, poker:DieciochoDeAgua .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Dieciseises con Catorce Ocho Seis" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:DieciseisDeElectrico, poker:CatorceDeElectrico, poker:OchoDeFuego, poker:SeisDePlanta .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Dieciochos con Diez Siete Seis" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DieciochoDeFuego, poker:DiezDeFuego, poker:SieteDeFuego, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
