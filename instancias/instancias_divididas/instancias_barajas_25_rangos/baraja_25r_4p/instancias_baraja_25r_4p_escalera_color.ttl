# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color
# =============================================================================

@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 9. Escalera de Color." .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Electrico" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico, poker:DiezDeElectrico .

escalera_color:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Color Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro de Planta" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta .

escalera_color:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos de Agua" ;
    poker:contieneCarta poker:DieciochoDeAgua, poker:DiecinueveDeAgua, poker:VeinteDeAgua, poker:VeintiunoDeAgua, poker:VeintidosDeAgua .

escalera_color:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Electrico" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico, poker:NueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano1 escalera_color:Mano2 escalera_color:Mano3 escalera_color:Mano4 ) .
