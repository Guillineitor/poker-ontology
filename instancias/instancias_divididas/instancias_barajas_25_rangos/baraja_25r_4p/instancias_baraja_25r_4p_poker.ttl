# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Dieciseises con Cinco de Fuego" ;
    poker:contieneCarta poker:DieciseisDeFuego, poker:DieciseisDeElectrico, poker:DieciseisDePlanta, poker:DieciseisDeAgua, poker:CincoDeFuego .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Dieciochos con Diecisiete de Agua" ;
    poker:contieneCarta poker:DieciochoDeAgua, poker:DieciochoDeElectrico, poker:DieciochoDeFuego, poker:DieciochoDePlanta, poker:DiecisieteDeAgua .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Veintiunos con Diez de Agua" ;
    poker:contieneCarta poker:VeintiunoDeFuego, poker:VeintiunoDeAgua, poker:VeintiunoDeElectrico, poker:VeintiunoDePlanta, poker:DiezDeAgua .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Unos con Catorce de Agua" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeAgua, poker:UnoDePlanta, poker:UnoDeElectrico, poker:CatorceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
