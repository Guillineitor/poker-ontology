# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Nueves con Dos" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeFuego, poker:NueveDeElectrico, poker:NueveDeAgua, poker:DosDeFuego ;
    poker:manoTienePar poker:Diez, poker:Nueve .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Unos con Veintiuno" ;
    poker:contieneCarta poker:VeinteDePlanta, poker:VeinteDeFuego, poker:UnoDeFuego, poker:UnoDeElectrico, poker:VeintiunoDeAgua ;
    poker:manoTienePar poker:Veinte, poker:Uno .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Quinces y Doces con Dieciseis" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDePlanta, poker:DoceDePlanta, poker:DoceDeAgua, poker:DieciseisDeFuego ;
    poker:manoTienePar poker:Quince, poker:Doce .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Veintiunos y Diecinueves con Veinte" ;
    poker:contieneCarta poker:DiecinueveDeFuego, poker:DiecinueveDePlanta, poker:VeintiunoDeAgua, poker:VeintiunoDePlanta, poker:VeinteDeAgua ;
    poker:manoTienePar poker:Diecinueve, poker:Veintiuno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
