# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Doses con Veintinueve Veinticinco Cuatro" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDePsiquico, poker:VeinticincoDePlanta, poker:VeintinueveDeLucha, poker:CuatroDeNormal .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Veintidoses con Treintayseis Nueve Tres" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintidosDePsiquico, poker:TreintayseisDeBicho, poker:NueveDeAgua, poker:TresDeTierra .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Treintaydoses con Treintaysiete Veinte Quince" ;
    poker:contieneCarta poker:TreintaydosDeVolador, poker:TreintaydosDeBicho, poker:VeinteDeVeneno, poker:TreintaysieteDeNormal, poker:QuinceDeVolador .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Treintaycuatros con Diecinueve Dieciocho Once" ;
    poker:contieneCarta poker:TreintaycuatroDeLucha, poker:TreintaycuatroDeVolador, poker:DiecinueveDeTierra, poker:OnceDeRoca, poker:DieciochoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
