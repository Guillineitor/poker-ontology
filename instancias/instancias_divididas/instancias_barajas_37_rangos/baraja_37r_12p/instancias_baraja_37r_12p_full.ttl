# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaydoses con Par de Veintiochos" ;
    poker:contieneCarta poker:TreintaydosDePlanta, poker:TreintaydosDePsiquico, poker:TreintaydosDeVeneno, poker:VeintiochoDeTierra, poker:VeintiochoDeLucha ;
    poker:manoTienePar poker:Treintaydos, poker:Veintiocho .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Treintayseises" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDeTierra, poker:TreceDeBicho, poker:TreintayseisDeElectrico, poker:TreintayseisDeVeneno ;
    poker:manoTienePar poker:Trece, poker:Treintayseis .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Diecisietes" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDeFuego, poker:CincoDeElectrico, poker:DiecisieteDeLucha, poker:DiecisieteDeNormal ;
    poker:manoTienePar poker:Cinco, poker:Diecisiete .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Veinticuatros" ;
    poker:contieneCarta poker:CuatroDeVeneno, poker:CuatroDeRoca, poker:CuatroDeBicho, poker:VeinticuatroDeAgua, poker:VeinticuatroDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Veinticuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
