# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Nueves con Veintiocho de Electrico" ;
    poker:contieneCarta poker:NueveDeAgua, poker:NueveDeFuego, poker:NueveDeElectrico, poker:NueveDePlanta, poker:VeintiochoDeElectrico .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Treces con Diez de Agua" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDePlanta, poker:TreceDeAgua, poker:TreceDeFuego, poker:DiezDeAgua .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Quinces con Ocho de Electrico" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDePlanta, poker:QuinceDeAgua, poker:QuinceDeElectrico, poker:OchoDeElectrico .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Treintaydoses con Treintaycinco de Electrico" ;
    poker:contieneCarta poker:TreintaydosDeFuego, poker:TreintaydosDePlanta, poker:TreintaydosDeElectrico, poker:TreintaydosDeAgua, poker:TreintaycincoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
