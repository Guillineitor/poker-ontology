# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Sietes con Quince Seis" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:SieteDeAgua, poker:SieteDeFuego, poker:SeisDeElectrico, poker:QuinceDePlanta .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Treintayunos con Diez Uno" ;
    poker:contieneCarta poker:TreintayunoDeAgua, poker:TreintayunoDeFuego, poker:TreintayunoDeElectrico, poker:UnoDeFuego, poker:DiezDeAgua .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Once Diez" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CuatroDeFuego, poker:OnceDeFuego, poker:DiezDeAgua .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Dieciseises con Veinticuatro Seis" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:DieciseisDeElectrico, poker:DieciseisDeFuego, poker:VeinticuatroDeFuego, poker:SeisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
