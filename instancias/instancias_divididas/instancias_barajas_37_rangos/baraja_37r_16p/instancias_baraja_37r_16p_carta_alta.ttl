# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaydos con Veintiocho Veintisiete Siete Tres" ;
    poker:contieneCarta poker:TresDeRoca, poker:SieteDeRoca, poker:VeintisieteDePlanta, poker:TreintaydosDeAgua, poker:VeintiochoDeHielo .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Veinticuatro Veintiuno Diez Uno" ;
    poker:contieneCarta poker:VeintiunoDeDragon, poker:DiezDeNormal, poker:UnoDePlanta, poker:VeinticincoDeElectrico, poker:VeinticuatroDePsiquico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaycuatro con Veinticinco Veinticuatro Dieciseis Uno" ;
    poker:contieneCarta poker:VeinticincoDeVolador, poker:TreintaycuatroDeRoca, poker:UnoDeTierra, poker:VeinticuatroDeAgua, poker:DieciseisDeHielo .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaycinco con Veintiseis Catorce Tres Dos" ;
    poker:contieneCarta poker:TreintaycincoDeRoca, poker:DosDeBicho, poker:TresDeTierra, poker:CatorceDeRoca, poker:VeintiseisDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
