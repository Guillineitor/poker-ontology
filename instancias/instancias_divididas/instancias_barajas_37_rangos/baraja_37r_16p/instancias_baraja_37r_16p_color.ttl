# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 6. Color
# =============================================================================

@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 6. Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 6. Color." .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano1 a poker:Mano ;
    rdfs:label "Color de Treintaysiete Veintidos Quince Trece Once de Veneno" ;
    poker:contieneCarta poker:QuinceDeVeneno, poker:OnceDeVeneno, poker:TreceDeVeneno, poker:TreintaysieteDeVeneno, poker:VeintidosDeVeneno .

color:Mano2 a poker:Mano ;
    rdfs:label "Color de Treintaycuatro Treintaytres Ocho Siete Tres de Roca" ;
    poker:contieneCarta poker:OchoDeRoca, poker:TreintaycuatroDeRoca, poker:TresDeRoca, poker:SieteDeRoca, poker:TreintaytresDeRoca .

color:Mano3 a poker:Mano ;
    rdfs:label "Color de Treintaysiete Veintiseis Diez Nueve Uno de Psiquico" ;
    poker:contieneCarta poker:DiezDePsiquico, poker:VeintiseisDePsiquico, poker:UnoDePsiquico, poker:TreintaysieteDePsiquico, poker:NueveDePsiquico .

color:Mano4 a poker:Mano ;
    rdfs:label "Color de Treintaycinco Veinte Diecinueve Trece Uno de Electrico" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:TreintaycincoDeElectrico, poker:VeinteDeElectrico, poker:TreceDeElectrico, poker:DiecinueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano1 color:Mano2 color:Mano3 color:Mano4 ) .
