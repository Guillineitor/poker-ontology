# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera
# =============================================================================

@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 5. Escalera." .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Treintayuno-Treintaydos-Treintaytres-Treintaycuatro-Treintaycinco" ;
    poker:contieneCarta poker:TreintayunoDeNormal, poker:TreintaydosDeTierra, poker:TreintaytresDePsiquico, poker:TreintaycuatroDePsiquico, poker:TreintaycincoDeRoca .

escalera:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeHielo, poker:DieciochoDeLucha, poker:DiecinueveDePsiquico, poker:VeinteDeNormal, poker:VeintiunoDeSiniestro .

escalera:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho" ;
    poker:contieneCarta poker:VeinticuatroDeNormal, poker:VeinticincoDeVeneno, poker:VeintiseisDeDragon, poker:VeintisieteDeFantasma, poker:VeintiochoDeLucha .

escalera:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta" ;
    poker:contieneCarta poker:VeintiseisDePsiquico, poker:VeintisieteDeFantasma, poker:VeintiochoDePlanta, poker:VeintinueveDeHielo, poker:TreintaDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano1 escalera:Mano2 escalera:Mano3 escalera:Mano4 ) .
