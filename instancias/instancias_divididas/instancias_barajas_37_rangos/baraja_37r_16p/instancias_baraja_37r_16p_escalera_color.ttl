# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color
# =============================================================================

@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 9. Escalera de Color." .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Color Diez-Once-Doce-Trece-Catorce de Siniestro" ;
    poker:contieneCarta poker:DiezDeSiniestro, poker:OnceDeSiniestro, poker:DoceDeSiniestro, poker:TreceDeSiniestro, poker:CatorceDeSiniestro .

escalera_color:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Color Treinta-Treintayuno-Treintaydos-Treintaytres-Treintaycuatro de Fuego" ;
    poker:contieneCarta poker:TreintaDeFuego, poker:TreintayunoDeFuego, poker:TreintaydosDeFuego, poker:TreintaytresDeFuego, poker:TreintaycuatroDeFuego .

escalera_color:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Color Cuatro-Cinco-Seis-Siete-Ocho de Electrico" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CincoDeElectrico, poker:SeisDeElectrico, poker:SieteDeElectrico, poker:OchoDeElectrico .

escalera_color:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos de Roca" ;
    poker:contieneCarta poker:DieciochoDeRoca, poker:DiecinueveDeRoca, poker:VeinteDeRoca, poker:VeintiunoDeRoca, poker:VeintidosDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano1 escalera_color:Mano2 escalera_color:Mano3 escalera_color:Mano4 ) .
