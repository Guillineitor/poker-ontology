# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 10. Escalera Real
# =============================================================================

@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_real>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 10. Escalera Real" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 10. Escalera Real." .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano1 a poker:Mano ;
    rdfs:label "Escalera Real de Electrico" ;
    poker:contieneCarta poker:TreintaytresDeElectrico, poker:TreintaycuatroDeElectrico, poker:TreintaycincoDeElectrico, poker:TreintayseisDeElectrico, poker:TreintaysieteDeElectrico .

escalera_real:Mano2 a poker:Mano ;
    rdfs:label "Escalera Real de Siniestro" ;
    poker:contieneCarta poker:TreintaytresDeSiniestro, poker:TreintaycuatroDeSiniestro, poker:TreintaycincoDeSiniestro, poker:TreintayseisDeSiniestro, poker:TreintaysieteDeSiniestro .

escalera_real:Mano3 a poker:Mano ;
    rdfs:label "Escalera Real de Dragon" ;
    poker:contieneCarta poker:TreintaytresDeDragon, poker:TreintaycuatroDeDragon, poker:TreintaycincoDeDragon, poker:TreintayseisDeDragon, poker:TreintaysieteDeDragon .

escalera_real:Mano4 a poker:Mano ;
    rdfs:label "Escalera Real de Hielo" ;
    poker:contieneCarta poker:TreintaytresDeHielo, poker:TreintaycuatroDeHielo, poker:TreintaycincoDeHielo, poker:TreintayseisDeHielo, poker:TreintaysieteDeHielo .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano1 escalera_real:Mano2 escalera_real:Mano3 escalera_real:Mano4 ) .
