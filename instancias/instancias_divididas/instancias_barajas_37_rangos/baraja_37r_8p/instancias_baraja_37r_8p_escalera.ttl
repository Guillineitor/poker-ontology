# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera
# =============================================================================

@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 5. Escalera." .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Veintiuno-Veintidos-Veintitres-Veinticuatro-Veinticinco" ;
    poker:contieneCarta poker:VeintiunoDeBicho, poker:VeintidosDeBicho, poker:VeintitresDePlanta, poker:VeinticuatroDeVolador, poker:VeinticincoDeBicho .

escalera:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:VeintiseisDeNormal, poker:VeintisieteDeBicho, poker:VeintiochoDeNormal, poker:VeintinueveDeElectrico .

escalera:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete" ;
    poker:contieneCarta poker:VeintitresDeAgua, poker:VeinticuatroDeVeneno, poker:VeinticincoDeVeneno, poker:VeintiseisDeVolador, poker:VeintisieteDePlanta .

escalera:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:DieciseisDeNormal, poker:DiecisieteDeElectrico, poker:DieciochoDeVolador, poker:DiecinueveDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano1 escalera:Mano2 escalera:Mano3 escalera:Mano4 ) .
