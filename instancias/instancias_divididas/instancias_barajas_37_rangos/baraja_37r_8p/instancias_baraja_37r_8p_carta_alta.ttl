# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Doce Diez Siete Cuatro" ;
    poker:contieneCarta poker:TreintaDeVeneno, poker:DiezDeFuego, poker:CuatroDeNormal, poker:SieteDeFuego, poker:DoceDeElectrico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaycuatro con Treintayuno Veintitres Veinte Dos" ;
    poker:contieneCarta poker:DosDeFuego, poker:TreintaycuatroDeVolador, poker:TreintayunoDeAgua, poker:VeintitresDeVolador, poker:VeinteDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treintaytres con Veintiocho Trece Doce Seis" ;
    poker:contieneCarta poker:TreintaytresDePlanta, poker:SeisDePlanta, poker:DoceDeBicho, poker:VeintiochoDeElectrico, poker:TreceDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Once Diez Seis Tres" ;
    poker:contieneCarta poker:DiezDeVolador, poker:SeisDeFuego, poker:TresDeBicho, poker:OnceDeVeneno, poker:VeintitresDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
