# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Diecisietes" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:UnoDeVolador, poker:UnoDeElectrico, poker:DiecisieteDeAgua, poker:DiecisieteDeElectrico ;
    poker:manoTienePar poker:Uno, poker:Diecisiete .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Ochos" ;
    poker:contieneCarta poker:DiezDePlanta, poker:DiezDeVeneno, poker:DiezDeElectrico, poker:OchoDeElectrico, poker:OchoDeNormal ;
    poker:manoTienePar poker:Diez, poker:Ocho .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Treintaydoses con Par de Veintinueves" ;
    poker:contieneCarta poker:TreintaydosDeVeneno, poker:TreintaydosDeNormal, poker:TreintaydosDeAgua, poker:VeintinueveDeVeneno, poker:VeintinueveDePlanta ;
    poker:manoTienePar poker:Treintaydos, poker:Veintinueve .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Ochos" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeVolador, poker:DosDeFuego, poker:OchoDeVeneno, poker:OchoDeVolador ;
    poker:manoTienePar poker:Dos, poker:Ocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
