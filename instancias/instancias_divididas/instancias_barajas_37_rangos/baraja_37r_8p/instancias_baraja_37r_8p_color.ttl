# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 6. Color
# =============================================================================

@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 6. Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 6. Color." .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano1 a poker:Mano ;
    rdfs:label "Color de Treintaydos Veintisiete Veinticinco Seis Cuatro de Electrico" ;
    poker:contieneCarta poker:VeinticincoDeElectrico, poker:TreintaydosDeElectrico, poker:VeintisieteDeElectrico, poker:SeisDeElectrico, poker:CuatroDeElectrico .

color:Mano2 a poker:Mano ;
    rdfs:label "Color de Treintaydos Veintinueve Veintiocho Doce Tres de Electrico" ;
    poker:contieneCarta poker:VeintiochoDeElectrico, poker:DoceDeElectrico, poker:VeintinueveDeElectrico, poker:TresDeElectrico, poker:TreintaydosDeElectrico .

color:Mano3 a poker:Mano ;
    rdfs:label "Color de Treintayuno Veinticinco Veintitres Veintidos Dos de Planta" ;
    poker:contieneCarta poker:TreintayunoDePlanta, poker:VeinticincoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:DosDePlanta .

color:Mano4 a poker:Mano ;
    rdfs:label "Color de Veintiseis Diecisiete Quince Nueve Tres de Veneno" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:DiecisieteDeVeneno, poker:VeintiseisDeVeneno, poker:TresDeVeneno, poker:QuinceDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano1 color:Mano2 color:Mano3 color:Mano4 ) .
