# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Veinticuatros con Veintitres Veintidos Catorce" ;
    poker:contieneCarta poker:VeinticuatroDeFuego, poker:VeinticuatroDeElectrico, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:CatorceDePlanta .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Seises con Treintaytres Veintiocho Dieciocho" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDePlanta, poker:TreintaytresDeNormal, poker:DieciochoDeAgua, poker:VeintiochoDeNormal .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Cincos con Treintayuno Siete Cuatro" ;
    poker:contieneCarta poker:CincoDeVolador, poker:CincoDeNormal, poker:CuatroDeAgua, poker:SieteDeFuego, poker:TreintayunoDeVeneno .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Dieciochos con Treintaycinco Diez Ocho" ;
    poker:contieneCarta poker:DieciochoDeElectrico, poker:DieciochoDePlanta, poker:TreintaycincoDeVeneno, poker:OchoDeAgua, poker:DiezDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
