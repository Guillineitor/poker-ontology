# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_37r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_37r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Veintiseises y Catorces con Treintaysiete" ;
    poker:contieneCarta poker:VeintiseisDeNormal, poker:VeintiseisDeVolador, poker:CatorceDeBicho, poker:CatorceDeElectrico, poker:TreintaysieteDeVeneno ;
    poker:manoTienePar poker:Veintiseis, poker:Catorce .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Dieciseises y Nueves con Uno" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DieciseisDeAgua, poker:NueveDeFuego, poker:NueveDeElectrico, poker:UnoDeNormal ;
    poker:manoTienePar poker:Dieciseis, poker:Nueve .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Dieces y Ochos con Veintitres" ;
    poker:contieneCarta poker:OchoDePlanta, poker:OchoDeBicho, poker:DiezDePlanta, poker:DiezDeVolador, poker:VeintitresDeNormal ;
    poker:manoTienePar poker:Ocho, poker:Diez .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Treintaycuatros y Veinticincos con Doce" ;
    poker:contieneCarta poker:VeinticincoDeNormal, poker:VeinticincoDeBicho, poker:TreintaycuatroDeBicho, poker:TreintaycuatroDePlanta, poker:DoceDeNormal ;
    poker:manoTienePar poker:Veinticinco, poker:Treintaycuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
