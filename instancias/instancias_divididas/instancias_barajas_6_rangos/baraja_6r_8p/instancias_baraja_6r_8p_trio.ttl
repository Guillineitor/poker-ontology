# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Cincos con Cuatro Dos" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeNormal, poker:CincoDePlanta, poker:DosDeVolador, poker:CuatroDePlanta .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Doses con Cuatro Tres" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeBicho, poker:DosDeFuego, poker:TresDeVeneno, poker:CuatroDeElectrico .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Cinco Uno" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeNormal, poker:CuatroDeElectrico, poker:UnoDeFuego, poker:CincoDeAgua .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Cincos con Tres Dos" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:CincoDeBicho, poker:CincoDeElectrico, poker:TresDeVeneno, poker:DosDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
