# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Cuatros con Uno" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeVolador, poker:CuatroDeVolador, poker:CuatroDeBicho, poker:UnoDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Cuatro .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Doses con Uno" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDeNormal, poker:TresDeBicho, poker:TresDePlanta, poker:UnoDeFuego ;
    poker:manoTienePar poker:Dos, poker:Tres .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Treses con Dos" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDePlanta, poker:TresDeVeneno, poker:TresDeNormal, poker:DosDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Tres .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Seis" ;
    poker:contieneCarta poker:UnoDeVeneno, poker:UnoDeNormal, poker:CuatroDeVolador, poker:CuatroDeElectrico, poker:SeisDeBicho ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
