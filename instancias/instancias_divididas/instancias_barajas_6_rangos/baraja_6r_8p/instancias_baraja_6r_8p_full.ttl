# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Cincos" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeVolador, poker:UnoDeVeneno, poker:CincoDeElectrico, poker:CincoDeVolador ;
    poker:manoTienePar poker:Uno, poker:Cinco .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Cuatros" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeVolador, poker:TresDeElectrico, poker:CuatroDePlanta, poker:CuatroDeBicho ;
    poker:manoTienePar poker:Tres, poker:Cuatro .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Cincos" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDePlanta, poker:SeisDeNormal, poker:CincoDeElectrico, poker:CincoDeNormal ;
    poker:manoTienePar poker:Seis, poker:Cinco .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Unos" ;
    poker:contieneCarta poker:TresDeVeneno, poker:TresDeAgua, poker:TresDePlanta, poker:UnoDeFuego, poker:UnoDeBicho ;
    poker:manoTienePar poker:Tres, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
