# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Cincos con Cuatro Dos Uno" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeElectrico, poker:DosDeFuego, poker:CuatroDeNormal, poker:UnoDeAgua .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Treses con Cinco Cuatro Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeElectrico, poker:UnoDeAgua, poker:CincoDePlanta, poker:CuatroDeElectrico .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Cuatros con Seis Tres Dos" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeBicho, poker:TresDeFuego, poker:DosDeVolador, poker:SeisDeVeneno .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Cuatros con Seis Cinco Tres" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CuatroDePlanta, poker:CincoDeVolador, poker:TresDeBicho, poker:SeisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
