# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Unos con Dos de Psiquico" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDePlanta, poker:UnoDeDragon, poker:UnoDeRoca, poker:DosDePsiquico .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Cincos con Uno de Agua" ;
    poker:contieneCarta poker:CincoDeFantasma, poker:CincoDeRoca, poker:CincoDeVeneno, poker:CincoDeDragon, poker:UnoDeAgua .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Doses con Seis de Veneno" ;
    poker:contieneCarta poker:DosDeLucha, poker:DosDeFuego, poker:DosDeBicho, poker:DosDeTierra, poker:SeisDeVeneno .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Uno de Electrico" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeFuego, poker:CuatroDeBicho, poker:CuatroDeTierra, poker:UnoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
