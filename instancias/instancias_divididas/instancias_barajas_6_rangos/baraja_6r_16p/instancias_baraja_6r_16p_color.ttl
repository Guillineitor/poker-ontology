# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 6. Color
# =============================================================================

@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 6. Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 6. Color." .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano1 a poker:Mano ;
    rdfs:label "Color de Seis Cuatro Tres Dos Uno de Psiquico" ;
    poker:contieneCarta poker:SeisDePsiquico, poker:DosDePsiquico, poker:UnoDePsiquico, poker:CuatroDePsiquico, poker:TresDePsiquico .

color:Mano2 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Dos Uno de Siniestro" ;
    poker:contieneCarta poker:UnoDeSiniestro, poker:CincoDeSiniestro, poker:DosDeSiniestro, poker:SeisDeSiniestro, poker:CuatroDeSiniestro .

color:Mano3 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Tres Dos Uno de Fuego" ;
    poker:contieneCarta poker:DosDeFuego, poker:SeisDeFuego, poker:CincoDeFuego, poker:UnoDeFuego, poker:TresDeFuego .

color:Mano4 a poker:Mano ;
    rdfs:label "Color de Seis Cinco Cuatro Tres Uno de Bicho" ;
    poker:contieneCarta poker:CincoDeBicho, poker:TresDeBicho, poker:UnoDeBicho, poker:CuatroDeBicho, poker:SeisDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano1 color:Mano2 color:Mano3 color:Mano4 ) .
