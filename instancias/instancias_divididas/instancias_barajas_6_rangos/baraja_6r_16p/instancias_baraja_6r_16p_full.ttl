# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Cuatros" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeNormal, poker:TresDeHielo, poker:CuatroDeNormal, poker:CuatroDeFuego ;
    poker:manoTienePar poker:Tres, poker:Cuatro .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Doses" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CuatroDeLucha, poker:CuatroDeFantasma, poker:DosDeVeneno, poker:DosDeRoca ;
    poker:manoTienePar poker:Cuatro, poker:Dos .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Unos" ;
    poker:contieneCarta poker:SeisDeTierra, poker:SeisDePsiquico, poker:SeisDeFuego, poker:UnoDePsiquico, poker:UnoDeDragon ;
    poker:manoTienePar poker:Seis, poker:Uno .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Unos" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeRoca, poker:CincoDePlanta, poker:UnoDePsiquico, poker:UnoDeTierra ;
    poker:manoTienePar poker:Cinco, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
