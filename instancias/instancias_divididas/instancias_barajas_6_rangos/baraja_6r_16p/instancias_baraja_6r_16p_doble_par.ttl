# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Doses y Unos con Seis" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeBicho, poker:DosDeRoca, poker:DosDeDragon, poker:SeisDeTierra ;
    poker:manoTienePar poker:Uno, poker:Dos .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cincos con Dos" ;
    poker:contieneCarta poker:SeisDeVolador, poker:SeisDeBicho, poker:CincoDeLucha, poker:CincoDeAgua, poker:DosDeSiniestro ;
    poker:manoTienePar poker:Seis, poker:Cinco .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Doses con Uno" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDeDragon, poker:DosDeRoca, poker:DosDeTierra, poker:UnoDeRoca ;
    poker:manoTienePar poker:Cuatro, poker:Dos .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Doses con Seis" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDePsiquico, poker:CuatroDeRoca, poker:CuatroDeBicho, poker:SeisDeFantasma ;
    poker:manoTienePar poker:Dos, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
