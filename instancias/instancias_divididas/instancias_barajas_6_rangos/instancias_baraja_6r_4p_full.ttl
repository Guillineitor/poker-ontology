# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Treses" ;
    poker:contieneCarta poker:DosDeAgua, poker:DosDePlanta, poker:DosDeFuego, poker:TresDeElectrico, poker:TresDeFuego ;
    poker:manoTienePar poker:Dos, poker:Tres .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Seises" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDePlanta, poker:UnoDeFuego, poker:SeisDeFuego, poker:SeisDePlanta ;
    poker:manoTienePar poker:Uno, poker:Seis .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Cuatros" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeElectrico, poker:CincoDeFuego, poker:CuatroDeElectrico, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Cinco, poker:Cuatro .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Treses" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:SeisDeElectrico, poker:TresDeFuego, poker:TresDeElectrico ;
    poker:manoTienePar poker:Seis, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
