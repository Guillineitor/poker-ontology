# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doblepar>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Doses con Uno" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDePlanta, poker:DosDeElectrico, poker:DosDeAgua, poker:UnoDeAgua ;
    poker:manoTienePar poker:Tres, poker:Dos .

doblepar:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Cincos y Treses con Cuatro" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:TresDePlanta, poker:TresDeElectrico, poker:CuatroDeElectrico ;
    poker:manoTienePar poker:Cinco, poker:Tres .

doblepar:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Doses con Uno" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDePlanta, poker:DosDeFuego, poker:DosDePlanta, poker:UnoDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Dos .

doblepar:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Doses y Unos con Cuatro" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeElectrico, poker:DosDePlanta, poker:DosDeElectrico, poker:CuatroDeElectrico ;
    poker:manoTienePar poker:Uno, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano1 doblepar:Mano2 doblepar:Mano3 doblepar:Mano4 ) .
