# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Treses con Cinco de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeAgua, poker:TresDeElectrico, poker:TresDePlanta, poker:CincoDeFuego .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Unos con Cinco de Electrico" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDePlanta, poker:UnoDeElectrico, poker:UnoDeAgua, poker:CincoDeElectrico .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Seises con Cinco de Agua" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeElectrico, poker:SeisDeAgua, poker:SeisDeFuego, poker:CincoDeAgua .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Seises con Cuatro de Agua" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeElectrico, poker:SeisDePlanta, poker:SeisDeFuego, poker:CuatroDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
