# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Treses con Seis de Fuego" ;
    poker:contieneCarta poker:TresDeFuego, poker:TresDeAgua, poker:TresDePlanta, poker:TresDeElectrico, poker:SeisDeFuego .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Unos con Tres de Planta" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeElectrico, poker:UnoDePlanta, poker:UnoDeAgua, poker:TresDePlanta .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Doses con Seis de Planta" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeAgua, poker:DosDeElectrico, poker:DosDePlanta, poker:SeisDePlanta .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Doses con Tres de Eléctrico" ;
    poker:contieneCarta poker:DosDeElectrico, poker:DosDePlanta, poker:DosDeFuego, poker:DosDeAgua, poker:TresDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
