# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Cincos" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeAgua, poker:CuatroDeFuego, poker:CincoDeFuego, poker:CincoDePlanta ;
    poker:manoTienePar poker:Cuatro, poker:Cinco .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Cuatros" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:SeisDeAgua, poker:CuatroDeElectrico, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Seis, poker:Cuatro .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Treses" ;
    poker:contieneCarta poker:CuatroDeAgua, poker:CuatroDeElectrico, poker:CuatroDeFuego, poker:TresDeAgua, poker:TresDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Tres .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Cuatros" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeFuego, poker:CincoDeAgua, poker:CuatroDeFuego, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Cinco, poker:Cuatro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
