# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Tres Uno" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDePlanta, poker:CuatroDeAgua, poker:TresDeFuego, poker:UnoDePlanta .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Treses con Seis Cuatro" ;
    poker:contieneCarta poker:TresDePlanta, poker:TresDeAgua, poker:TresDeFuego, poker:SeisDeElectrico, poker:CuatroDeAgua .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Cincos con Tres Uno" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeAgua, poker:CincoDeElectrico, poker:TresDeElectrico, poker:UnoDePlanta .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Cincos con Dos Uno" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDeElectrico, poker:CincoDePlanta, poker:UnoDeAgua, poker:DosDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
