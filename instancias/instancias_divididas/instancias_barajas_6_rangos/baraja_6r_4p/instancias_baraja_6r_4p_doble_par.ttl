# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Cincos con Dos" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDeElectrico, poker:CincoDeFuego, poker:CincoDeAgua, poker:DosDeAgua ;
    poker:manoTienePar poker:Seis, poker:Cinco .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Treses y Doses con Cuatro" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeElectrico, poker:TresDeFuego, poker:TresDePlanta, poker:CuatroDePlanta ;
    poker:manoTienePar poker:Dos, poker:Tres .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Unos con Tres" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeFuego, poker:CuatroDeAgua, poker:CuatroDeFuego, poker:TresDeElectrico ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Seises y Unos con Cinco" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeFuego, poker:SeisDePlanta, poker:SeisDeFuego, poker:CincoDeAgua ;
    poker:manoTienePar poker:Uno, poker:Seis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
