# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Cincos con Seis Cuatro Uno" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeAgua, poker:CuatroDeAgua, poker:UnoDePlanta, poker:SeisDeFuego .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Seises con Cinco Dos Uno" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeElectrico, poker:CincoDeFuego, poker:UnoDePlanta, poker:DosDeAgua .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Seises con Cuatro Dos Uno" ;
    poker:contieneCarta poker:SeisDeAgua, poker:SeisDeFuego, poker:UnoDeFuego, poker:CuatroDeAgua, poker:DosDeElectrico .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Doses con Cuatro Tres Uno" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeFuego, poker:UnoDePlanta, poker:CuatroDeElectrico, poker:TresDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
