# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Seises" ;
    poker:contieneCarta poker:CincoDeFuego, poker:CincoDeElectrico, poker:CincoDeRoca, poker:SeisDeVeneno, poker:SeisDeElectrico ;
    poker:manoTienePar poker:Cinco, poker:Seis .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Doses" ;
    poker:contieneCarta poker:TresDeVolador, poker:TresDeBicho, poker:TresDeElectrico, poker:DosDeVeneno, poker:DosDeRoca ;
    poker:manoTienePar poker:Tres, poker:Dos .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Cuatros" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:UnoDeRoca, poker:UnoDeVeneno, poker:CuatroDeRoca, poker:CuatroDePsiquico ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Cincos" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDeAgua, poker:SeisDeRoca, poker:CincoDeFuego, poker:CincoDeVeneno ;
    poker:manoTienePar poker:Seis, poker:Cinco .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
