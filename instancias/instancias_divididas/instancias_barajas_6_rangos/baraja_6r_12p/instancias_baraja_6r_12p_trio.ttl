# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Cincos con Cuatro Tres" ;
    poker:contieneCarta poker:CincoDeAgua, poker:CincoDePlanta, poker:CincoDePsiquico, poker:CuatroDeLucha, poker:TresDeBicho .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Treses con Dos Uno" ;
    poker:contieneCarta poker:TresDeVeneno, poker:TresDeFuego, poker:TresDePlanta, poker:DosDeVeneno, poker:UnoDeVolador .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Unos con Cuatro Dos" ;
    poker:contieneCarta poker:UnoDeTierra, poker:UnoDeLucha, poker:UnoDePsiquico, poker:CuatroDeLucha, poker:DosDeAgua .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Doses con Cinco Uno" ;
    poker:contieneCarta poker:DosDeRoca, poker:DosDeFuego, poker:DosDeVolador, poker:UnoDeElectrico, poker:CincoDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
