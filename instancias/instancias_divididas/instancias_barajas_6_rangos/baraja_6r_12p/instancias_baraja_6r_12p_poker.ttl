# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_6r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_6r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Doses con Cuatro de Tierra" ;
    poker:contieneCarta poker:DosDeNormal, poker:DosDeFuego, poker:DosDePsiquico, poker:DosDeVolador, poker:CuatroDeTierra .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Seises con Cinco de Veneno" ;
    poker:contieneCarta poker:SeisDeElectrico, poker:SeisDeVolador, poker:SeisDeFuego, poker:SeisDeLucha, poker:CincoDeVeneno .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Unos con Cinco de Fuego" ;
    poker:contieneCarta poker:UnoDeFuego, poker:UnoDeBicho, poker:UnoDeElectrico, poker:UnoDeLucha, poker:CincoDeFuego .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Cincos con Uno de Fuego" ;
    poker:contieneCarta poker:CincoDeTierra, poker:CincoDeBicho, poker:CincoDeLucha, poker:CincoDeVolador, poker:UnoDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
