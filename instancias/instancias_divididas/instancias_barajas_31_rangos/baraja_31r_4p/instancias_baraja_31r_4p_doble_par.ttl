# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Nueves con Diecinueve" ;
    poker:contieneCarta poker:VeintidosDePlanta, poker:VeintidosDeFuego, poker:NueveDeFuego, poker:NueveDeAgua, poker:DiecinueveDeElectrico ;
    poker:manoTienePar poker:Veintidos, poker:Nueve .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Diecisietes con Veintisiete" ;
    poker:contieneCarta poker:DiecinueveDeAgua, poker:DiecinueveDeElectrico, poker:DiecisieteDeAgua, poker:DiecisieteDePlanta, poker:VeintisieteDeAgua ;
    poker:manoTienePar poker:Diecinueve, poker:Diecisiete .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Treintayunos y Veintes con Ocho" ;
    poker:contieneCarta poker:TreintayunoDeAgua, poker:TreintayunoDeElectrico, poker:VeinteDePlanta, poker:VeinteDeAgua, poker:OchoDeAgua ;
    poker:manoTienePar poker:Treintayuno, poker:Veinte .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Treces con Seis" ;
    poker:contieneCarta poker:TreceDePlanta, poker:TreceDeFuego, poker:DieciochoDePlanta, poker:DieciochoDeFuego, poker:SeisDeFuego ;
    poker:manoTienePar poker:Trece, poker:Dieciocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
