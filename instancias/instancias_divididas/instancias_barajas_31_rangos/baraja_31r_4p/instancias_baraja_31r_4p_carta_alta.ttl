# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Diecisiete Trece Seis Cinco" ;
    poker:contieneCarta poker:TreceDeAgua, poker:SeisDePlanta, poker:CincoDeElectrico, poker:DiecisieteDeAgua, poker:TreintayunoDeAgua .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Diecisiete Dieciseis Nueve Tres" ;
    poker:contieneCarta poker:DieciseisDePlanta, poker:DiecisieteDeAgua, poker:TresDePlanta, poker:VeinticincoDePlanta, poker:NueveDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Diecinueve Catorce Cinco Uno" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:DiecinueveDeFuego, poker:CincoDeElectrico, poker:VeintidosDeAgua, poker:UnoDeAgua .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treintayuno con Dieciocho Nueve Ocho Cuatro" ;
    poker:contieneCarta poker:TreintayunoDeAgua, poker:NueveDeFuego, poker:CuatroDePlanta, poker:DieciochoDeAgua, poker:OchoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
