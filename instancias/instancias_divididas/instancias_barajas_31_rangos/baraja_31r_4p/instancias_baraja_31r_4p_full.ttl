# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Treintas con Par de Diecinueves" ;
    poker:contieneCarta poker:TreintaDeFuego, poker:TreintaDeElectrico, poker:TreintaDePlanta, poker:DiecinueveDeAgua, poker:DiecinueveDeFuego ;
    poker:manoTienePar poker:Treinta, poker:Diecinueve .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Sietes con Par de Catorces" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDeElectrico, poker:SieteDeAgua, poker:CatorceDeElectrico, poker:CatorceDePlanta ;
    poker:manoTienePar poker:Siete, poker:Catorce .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Treintas con Par de Doces" ;
    poker:contieneCarta poker:TreintaDeElectrico, poker:TreintaDeAgua, poker:TreintaDePlanta, poker:DoceDeElectrico, poker:DoceDeFuego ;
    poker:manoTienePar poker:Treinta, poker:Doce .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Veinticuatros con Par de Doses" ;
    poker:contieneCarta poker:VeinticuatroDeAgua, poker:VeinticuatroDePlanta, poker:VeinticuatroDeElectrico, poker:DosDePlanta, poker:DosDeElectrico ;
    poker:manoTienePar poker:Veinticuatro, poker:Dos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
