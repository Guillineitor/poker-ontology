# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera
# =============================================================================

@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 5. Escalera." .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Catorce-Quince-Dieciseis-Diecisiete-Dieciocho" ;
    poker:contieneCarta poker:CatorceDePlanta, poker:QuinceDePlanta, poker:DieciseisDePlanta, poker:DiecisieteDePlanta, poker:DieciochoDeElectrico .

escalera:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeFuego, poker:DosDeAgua, poker:TresDePlanta, poker:CuatroDeElectrico, poker:CincoDeAgua .

escalera:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Veintidos-Veintitres-Veinticuatro-Veinticinco-Veintiseis" ;
    poker:contieneCarta poker:VeintidosDeAgua, poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDePlanta, poker:VeintiseisDeAgua .

escalera:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Veintiseis-Veintisiete-Veintiocho-Veintinueve-Treinta" ;
    poker:contieneCarta poker:VeintiseisDeAgua, poker:VeintisieteDeFuego, poker:VeintiochoDeAgua, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano1 escalera:Mano2 escalera:Mano3 escalera:Mano4 ) .
