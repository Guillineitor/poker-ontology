# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Veintitreses con Par de Diecinueves" ;
    poker:contieneCarta poker:VeintitresDePsiquico, poker:VeintitresDeRoca, poker:VeintitresDePlanta, poker:DiecinueveDeRoca, poker:DiecinueveDeLucha ;
    poker:manoTienePar poker:Veintitres, poker:Diecinueve .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciochos con Par de Dieciseises" ;
    poker:contieneCarta poker:DieciochoDePlanta, poker:DieciochoDeHielo, poker:DieciochoDeSiniestro, poker:DieciseisDeFuego, poker:DieciseisDeTierra ;
    poker:manoTienePar poker:Dieciocho, poker:Dieciseis .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Quinces" ;
    poker:contieneCarta poker:OnceDeFuego, poker:OnceDeTierra, poker:OnceDeAgua, poker:QuinceDePsiquico, poker:QuinceDeVeneno ;
    poker:manoTienePar poker:Once, poker:Quince .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Dieciochos" ;
    poker:contieneCarta poker:VeintidosDeVolador, poker:VeintidosDeFantasma, poker:VeintidosDeFuego, poker:DieciochoDeNormal, poker:DieciochoDeRoca ;
    poker:manoTienePar poker:Veintidos, poker:Dieciocho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
