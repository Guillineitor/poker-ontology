# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color
# =============================================================================

@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 9. Escalera de Color." .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Color Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro de Volador" ;
    poker:contieneCarta poker:VeinteDeVolador, poker:VeintiunoDeVolador, poker:VeintidosDeVolador, poker:VeintitresDeVolador, poker:VeinticuatroDeVolador .

escalera_color:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Fuego" ;
    poker:contieneCarta poker:VeintitresDeFuego, poker:VeinticuatroDeFuego, poker:VeinticincoDeFuego, poker:VeintiseisDeFuego, poker:VeintisieteDeFuego .

escalera_color:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos de Fuego" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:DiecinueveDeFuego, poker:VeinteDeFuego, poker:VeintiunoDeFuego, poker:VeintidosDeFuego .

escalera_color:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Color Catorce-Quince-Dieciseis-Diecisiete-Dieciocho de Bicho" ;
    poker:contieneCarta poker:CatorceDeBicho, poker:QuinceDeBicho, poker:DieciseisDeBicho, poker:DiecisieteDeBicho, poker:DieciochoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano1 escalera_color:Mano2 escalera_color:Mano3 escalera_color:Mano4 ) .
