# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Veintisiete Veinticinco Nueve Seis" ;
    poker:contieneCarta poker:VeintisieteDeRoca, poker:VeintinueveDeSiniestro, poker:SeisDeBicho, poker:NueveDeHielo, poker:VeinticincoDePsiquico .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Diecinueve Dieciseis Nueve Cuatro" ;
    poker:contieneCarta poker:DiecinueveDeVolador, poker:DieciseisDeVolador, poker:CuatroDeRoca, poker:VeintitresDePsiquico, poker:NueveDeFantasma .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintisiete Veintiseis Diecisiete Cinco" ;
    poker:contieneCarta poker:TreintaDeFantasma, poker:DiecisieteDeRoca, poker:VeintiseisDeLucha, poker:VeintisieteDeDragon, poker:CincoDeVolador .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintitres Veintiuno Diez Dos" ;
    poker:contieneCarta poker:TreintaDePlanta, poker:DiezDePlanta, poker:VeintitresDeElectrico, poker:DosDeNormal, poker:VeintiunoDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
