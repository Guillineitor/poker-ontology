# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Sietes con Quince Diez" ;
    poker:contieneCarta poker:SieteDeBicho, poker:SieteDeElectrico, poker:SieteDeHielo, poker:QuinceDeVolador, poker:DiezDeVolador .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Treintayuno Veintinueve" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:CuatroDeVeneno, poker:CuatroDeSiniestro, poker:TreintayunoDePsiquico, poker:VeintinueveDeNormal .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Ochos con Diecinueve Once" ;
    poker:contieneCarta poker:OchoDeRoca, poker:OchoDeTierra, poker:OchoDeSiniestro, poker:DiecinueveDeHielo, poker:OnceDeNormal .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Diecinueves con Tres Uno" ;
    poker:contieneCarta poker:DiecinueveDeBicho, poker:DiecinueveDeSiniestro, poker:DiecinueveDeElectrico, poker:TresDeNormal, poker:UnoDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
