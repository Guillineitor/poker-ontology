# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Unos con Veintitres de Lucha" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeElectrico, poker:UnoDeLucha, poker:UnoDeFuego, poker:VeintitresDeLucha .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Dos de Veneno" ;
    poker:contieneCarta poker:VeinticincoDeLucha, poker:VeinticincoDeVeneno, poker:VeinticincoDeBicho, poker:VeinticincoDeVolador, poker:DosDeVeneno .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Ochos con Veintinueve de Electrico" ;
    poker:contieneCarta poker:OchoDeVolador, poker:OchoDeSiniestro, poker:OchoDeElectrico, poker:OchoDeDragon, poker:VeintinueveDeElectrico .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Veintisietes con Nueve de Planta" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintisieteDeHielo, poker:VeintisieteDePsiquico, poker:VeintisieteDeVolador, poker:NueveDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
