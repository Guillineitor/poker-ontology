# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Veintiochos con Diecinueve Uno" ;
    poker:contieneCarta poker:VeintiochoDeNormal, poker:VeintiochoDePlanta, poker:VeintiochoDeVolador, poker:DiecinueveDeTierra, poker:UnoDeElectrico .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Veinticuatros con Diez Siete" ;
    poker:contieneCarta poker:VeinticuatroDeBicho, poker:VeinticuatroDeFuego, poker:VeinticuatroDeElectrico, poker:SieteDeVolador, poker:DiezDeNormal .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Treintas con Diecisiete Tres" ;
    poker:contieneCarta poker:TreintaDeVolador, poker:TreintaDeNormal, poker:TreintaDeAgua, poker:DiecisieteDeRoca, poker:TresDePlanta .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Veintisietes con Treintayuno Veintiocho" ;
    poker:contieneCarta poker:VeintisieteDePlanta, poker:VeintisieteDeVeneno, poker:VeintisieteDeFuego, poker:TreintayunoDeLucha, poker:VeintiochoDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
