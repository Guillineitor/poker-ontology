# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 6. Color
# =============================================================================

@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 6. Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 6. Color." .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano1 a poker:Mano ;
    rdfs:label "Color de Treinta Veintiseis Catorce Doce Tres de Tierra" ;
    poker:contieneCarta poker:VeintiseisDeTierra, poker:CatorceDeTierra, poker:TreintaDeTierra, poker:DoceDeTierra, poker:TresDeTierra .

color:Mano2 a poker:Mano ;
    rdfs:label "Color de Diecisiete Catorce Doce Diez Nueve de Veneno" ;
    poker:contieneCarta poker:DoceDeVeneno, poker:CatorceDeVeneno, poker:DiezDeVeneno, poker:NueveDeVeneno, poker:DiecisieteDeVeneno .

color:Mano3 a poker:Mano ;
    rdfs:label "Color de Veintiocho Veintiuno Veinte Once Nueve de Lucha" ;
    poker:contieneCarta poker:NueveDeLucha, poker:OnceDeLucha, poker:VeintiochoDeLucha, poker:VeintiunoDeLucha, poker:VeinteDeLucha .

color:Mano4 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintiocho Veinte Cuatro Uno de Agua" ;
    poker:contieneCarta poker:VeinteDeAgua, poker:UnoDeAgua, poker:VeintinueveDeAgua, poker:VeintiochoDeAgua, poker:CuatroDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano1 color:Mano2 color:Mano3 color:Mano4 ) .
