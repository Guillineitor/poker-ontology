# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Veintes con Veintiseis de Normal" ;
    poker:contieneCarta poker:VeinteDeFuego, poker:VeinteDePsiquico, poker:VeinteDeAgua, poker:VeinteDeElectrico, poker:VeintiseisDeNormal .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Sietes con Diecisiete de Roca" ;
    poker:contieneCarta poker:SieteDeRoca, poker:SieteDeLucha, poker:SieteDeBicho, poker:SieteDeVolador, poker:DiecisieteDeRoca .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Seises con Tres de Tierra" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeVeneno, poker:SeisDeTierra, poker:SeisDeElectrico, poker:TresDeTierra .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Veinticincos con Siete de Psiquico" ;
    poker:contieneCarta poker:VeinticincoDeAgua, poker:VeinticincoDeBicho, poker:VeinticincoDeTierra, poker:VeinticincoDeRoca, poker:SieteDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
