# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Veintiochos con Par de Veintisietes" ;
    poker:contieneCarta poker:VeintiochoDeLucha, poker:VeintiochoDeTierra, poker:VeintiochoDeVeneno, poker:VeintisieteDeElectrico, poker:VeintisieteDeBicho ;
    poker:manoTienePar poker:Veintiocho, poker:Veintisiete .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Veintisietes con Par de Diecisietes" ;
    poker:contieneCarta poker:VeintisieteDeAgua, poker:VeintisieteDePlanta, poker:VeintisieteDeLucha, poker:DiecisieteDePsiquico, poker:DiecisieteDeRoca ;
    poker:manoTienePar poker:Veintisiete, poker:Diecisiete .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Unos" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeNormal, poker:DosDePsiquico, poker:UnoDePlanta, poker:UnoDeAgua ;
    poker:manoTienePar poker:Dos, poker:Uno .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Veintiseises" ;
    poker:contieneCarta poker:NueveDeFuego, poker:NueveDeVeneno, poker:NueveDeVolador, poker:VeintiseisDeRoca, poker:VeintiseisDeAgua ;
    poker:manoTienePar poker:Nueve, poker:Veintiseis .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
