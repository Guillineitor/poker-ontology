# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiocho con Veintisiete Diecisiete Catorce Dos" ;
    poker:contieneCarta poker:VeintiochoDeNormal, poker:CatorceDeBicho, poker:VeintisieteDeBicho, poker:DosDeRoca, poker:DiecisieteDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiocho con Veintisiete Veinticinco Veintiuno Seis" ;
    poker:contieneCarta poker:VeintiochoDeFuego, poker:VeintisieteDeBicho, poker:VeinticincoDeVolador, poker:VeintiunoDeFuego, poker:SeisDeRoca .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiocho con Nueve Ocho Seis Tres" ;
    poker:contieneCarta poker:SeisDePlanta, poker:TresDePlanta, poker:OchoDeVolador, poker:NueveDeNormal, poker:VeintiochoDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Diecinueve con Siete Tres Dos Uno" ;
    poker:contieneCarta poker:TresDeLucha, poker:DiecinueveDeElectrico, poker:UnoDeLucha, poker:SieteDeRoca, poker:DosDePsiquico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
