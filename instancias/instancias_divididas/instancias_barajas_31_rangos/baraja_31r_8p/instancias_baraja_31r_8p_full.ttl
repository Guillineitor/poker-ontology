# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Veintinueves con Par de Onces" ;
    poker:contieneCarta poker:VeintinueveDeFuego, poker:VeintinueveDeAgua, poker:VeintinueveDeBicho, poker:OnceDePlanta, poker:OnceDeNormal ;
    poker:manoTienePar poker:Veintinueve, poker:Once .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Veinticincos" ;
    poker:contieneCarta poker:DiezDeFuego, poker:DiezDeAgua, poker:DiezDePlanta, poker:VeinticincoDeElectrico, poker:VeinticincoDeBicho ;
    poker:manoTienePar poker:Diez, poker:Veinticinco .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Veintiseises con Par de Diecinueves" ;
    poker:contieneCarta poker:VeintiseisDeVolador, poker:VeintiseisDeVeneno, poker:VeintiseisDeFuego, poker:DiecinueveDeAgua, poker:DiecinueveDeVeneno ;
    poker:manoTienePar poker:Veintiseis, poker:Diecinueve .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Doses con Par de Doces" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeNormal, poker:DosDeAgua, poker:DoceDePlanta, poker:DoceDeNormal ;
    poker:manoTienePar poker:Dos, poker:Doce .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
