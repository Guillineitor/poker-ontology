# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Veintidoses con Veintiseis Veintiuno" ;
    poker:contieneCarta poker:VeintidosDePlanta, poker:VeintidosDeNormal, poker:VeintidosDeVeneno, poker:VeintiseisDeFuego, poker:VeintiunoDeNormal .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Veinticincos con Trece Siete" ;
    poker:contieneCarta poker:VeinticincoDeElectrico, poker:VeinticincoDeBicho, poker:VeinticincoDePlanta, poker:SieteDeNormal, poker:TreceDeVolador .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Veintisietes con Dieciocho Trece" ;
    poker:contieneCarta poker:VeintisieteDeNormal, poker:VeintisieteDeAgua, poker:VeintisieteDeBicho, poker:TreceDeAgua, poker:DieciochoDeFuego .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Doces con Veintiocho Veintiseis" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeBicho, poker:DoceDeElectrico, poker:VeintiseisDeFuego, poker:VeintiochoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
