# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Seises con Veinticinco Veintiuno Dieciseis" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SeisDeNormal, poker:VeinticincoDePlanta, poker:DieciseisDeAgua, poker:VeintiunoDeElectrico .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Treses con Veinticuatro Veintidos Diez" ;
    poker:contieneCarta poker:TresDeVeneno, poker:TresDeBicho, poker:VeinticuatroDePlanta, poker:DiezDeAgua, poker:VeintidosDeElectrico .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Veintitreses con Veintinueve Diecinueve Quince" ;
    poker:contieneCarta poker:VeintitresDePlanta, poker:VeintitresDeVeneno, poker:VeintinueveDeAgua, poker:QuinceDeFuego, poker:DiecinueveDeElectrico .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Catorces con Treinta Veintiocho Ocho" ;
    poker:contieneCarta poker:CatorceDeAgua, poker:CatorceDeElectrico, poker:VeintiochoDePlanta, poker:TreintaDeBicho, poker:OchoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
