# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color
# =============================================================================

@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 9. Escalera de Color." .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Bicho" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SieteDeBicho, poker:OchoDeBicho, poker:NueveDeBicho, poker:DiezDeBicho .

escalera_color:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Volador" ;
    poker:contieneCarta poker:OchoDeVolador, poker:NueveDeVolador, poker:DiezDeVolador, poker:OnceDeVolador, poker:DoceDeVolador .

escalera_color:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticinco-Veintiseis-Veintisiete-Veintiocho-Veintinueve de Fuego" ;
    poker:contieneCarta poker:VeinticincoDeFuego, poker:VeintiseisDeFuego, poker:VeintisieteDeFuego, poker:VeintiochoDeFuego, poker:VeintinueveDeFuego .

escalera_color:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Electrico" ;
    poker:contieneCarta poker:DoceDeElectrico, poker:TreceDeElectrico, poker:CatorceDeElectrico, poker:QuinceDeElectrico, poker:DieciseisDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano1 escalera_color:Mano2 escalera_color:Mano3 escalera_color:Mano4 ) .
