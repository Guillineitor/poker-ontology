# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera
# =============================================================================

@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 5. Escalera" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 5. Escalera." .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Uno-Dos-Tres-Cuatro-Cinco" ;
    poker:contieneCarta poker:UnoDeVolador, poker:DosDeFuego, poker:TresDeNormal, poker:CuatroDeBicho, poker:CincoDeElectrico .

escalera:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Diez-Once-Doce-Trece-Catorce" ;
    poker:contieneCarta poker:DiezDeFuego, poker:OnceDeVeneno, poker:DoceDeVeneno, poker:TreceDeVolador, poker:CatorceDeAgua .

escalera:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Nueve-Diez-Once-Doce-Trece" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:DiezDeElectrico, poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeVolador .

escalera:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Veintisiete-Veintiocho-Veintinueve-Treinta-Treintayuno" ;
    poker:contieneCarta poker:VeintisieteDeVolador, poker:VeintiochoDePlanta, poker:VeintinueveDeFuego, poker:TreintaDeNormal, poker:TreintayunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano1 escalera:Mano2 escalera:Mano3 escalera:Mano4 ) .
