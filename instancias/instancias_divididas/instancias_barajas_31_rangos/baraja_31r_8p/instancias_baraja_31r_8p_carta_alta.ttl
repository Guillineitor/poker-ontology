# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Trece Diez Seis Tres" ;
    poker:contieneCarta poker:DiezDeFuego, poker:VeintinueveDeAgua, poker:TreceDeAgua, poker:TresDeVeneno, poker:SeisDeVeneno .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veinte Nueve Seis Cinco" ;
    poker:contieneCarta poker:VeinteDeVolador, poker:SeisDeAgua, poker:TreintaDeBicho, poker:NueveDeNormal, poker:CincoDeFuego .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Nueve Ocho Siete Dos" ;
    poker:contieneCarta poker:DiezDeVeneno, poker:SieteDeFuego, poker:NueveDeFuego, poker:DosDeBicho, poker:OchoDePlanta .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintinueve Veintiocho Veinticuatro Tres" ;
    poker:contieneCarta poker:VeinticuatroDePlanta, poker:TreintaDeFuego, poker:VeintiochoDeBicho, poker:VeintinueveDeNormal, poker:TresDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
