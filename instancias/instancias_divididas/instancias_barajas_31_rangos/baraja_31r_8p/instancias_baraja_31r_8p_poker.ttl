# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Ochos con Veinticinco de Volador" ;
    poker:contieneCarta poker:OchoDeNormal, poker:OchoDeFuego, poker:OchoDeAgua, poker:OchoDeVolador, poker:VeinticincoDeVolador .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Treintayunos con Veintisiete de Fuego" ;
    poker:contieneCarta poker:TreintayunoDeVolador, poker:TreintayunoDeVeneno, poker:TreintayunoDeElectrico, poker:TreintayunoDeAgua, poker:VeintisieteDeFuego .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Dieces con Veintidos de Volador" ;
    poker:contieneCarta poker:DiezDeAgua, poker:DiezDePlanta, poker:DiezDeVolador, poker:DiezDeVeneno, poker:VeintidosDeVolador .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Veintisietes con Diecinueve de Electrico" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintisieteDeVeneno, poker:VeintisieteDeVolador, poker:VeintisieteDeNormal, poker:DiecinueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
