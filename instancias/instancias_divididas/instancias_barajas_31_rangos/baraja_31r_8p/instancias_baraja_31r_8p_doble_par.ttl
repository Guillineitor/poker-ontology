# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Cuatros con Catorce" ;
    poker:contieneCarta poker:CuatroDeElectrico, poker:CuatroDeAgua, poker:VeinteDeFuego, poker:VeinteDeBicho, poker:CatorceDeFuego ;
    poker:manoTienePar poker:Cuatro, poker:Veinte .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Veintes y Nueves con Quince" ;
    poker:contieneCarta poker:NueveDeNormal, poker:NueveDeElectrico, poker:VeinteDeVeneno, poker:VeinteDeVolador, poker:QuinceDeAgua ;
    poker:manoTienePar poker:Nueve, poker:Veinte .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Unos con Cuatro" ;
    poker:contieneCarta poker:TreceDeNormal, poker:TreceDeFuego, poker:UnoDeFuego, poker:UnoDeNormal, poker:CuatroDeAgua ;
    poker:manoTienePar poker:Trece, poker:Uno .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Veintisietes y Veintidoses con Veinte" ;
    poker:contieneCarta poker:VeintidosDeFuego, poker:VeintidosDeVeneno, poker:VeintisieteDeVolador, poker:VeintisieteDeBicho, poker:VeinteDeFuego ;
    poker:manoTienePar poker:Veintidos, poker:Veintisiete .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
