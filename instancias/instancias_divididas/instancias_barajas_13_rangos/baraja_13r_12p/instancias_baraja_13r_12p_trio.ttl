# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Treses con Ocho Cinco" ;
    poker:contieneCarta poker:TresDeElectrico, poker:TresDePsiquico, poker:TresDeRoca, poker:CincoDeLucha, poker:OchoDeVeneno .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Nueves con Trece Cuatro" ;
    poker:contieneCarta poker:NueveDeFuego, poker:NueveDeTierra, poker:NueveDeLucha, poker:TreceDeNormal, poker:CuatroDeVolador .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Onces con Tres Dos" ;
    poker:contieneCarta poker:OnceDeAgua, poker:OnceDeElectrico, poker:OnceDeRoca, poker:DosDePlanta, poker:TresDePsiquico .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Doces con Ocho Seis" ;
    poker:contieneCarta poker:DoceDeFuego, poker:DoceDeVolador, poker:DoceDePlanta, poker:SeisDeElectrico, poker:OchoDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
