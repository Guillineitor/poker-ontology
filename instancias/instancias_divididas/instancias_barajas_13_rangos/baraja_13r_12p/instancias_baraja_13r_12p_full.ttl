# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Cuatros" ;
    poker:contieneCarta poker:OnceDeVolador, poker:OnceDeAgua, poker:OnceDeRoca, poker:CuatroDeBicho, poker:CuatroDeTierra ;
    poker:manoTienePar poker:Once, poker:Cuatro .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Cincos" ;
    poker:contieneCarta poker:OchoDeRoca, poker:OchoDeFuego, poker:OchoDeVeneno, poker:CincoDeElectrico, poker:CincoDeTierra ;
    poker:manoTienePar poker:Ocho, poker:Cinco .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Cincos" ;
    poker:contieneCarta poker:TresDeAgua, poker:TresDeRoca, poker:TresDePlanta, poker:CincoDePsiquico, poker:CincoDeAgua ;
    poker:manoTienePar poker:Tres, poker:Cinco .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Onces" ;
    poker:contieneCarta poker:TresDeLucha, poker:TresDeVeneno, poker:TresDeVolador, poker:OnceDeAgua, poker:OnceDeNormal ;
    poker:manoTienePar poker:Tres, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
