# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Ocho de Electrico" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeRoca, poker:CuatroDeVeneno, poker:CuatroDeVolador, poker:OchoDeElectrico .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Doces con Uno de Veneno" ;
    poker:contieneCarta poker:DoceDePlanta, poker:DoceDeNormal, poker:DoceDeFuego, poker:DoceDeBicho, poker:UnoDeVeneno .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Nueves con Ocho de Tierra" ;
    poker:contieneCarta poker:NueveDeAgua, poker:NueveDeElectrico, poker:NueveDePsiquico, poker:NueveDeRoca, poker:OchoDeTierra .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Seises con Siete de Agua" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SeisDeTierra, poker:SeisDeRoca, poker:SeisDeFuego, poker:SieteDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
