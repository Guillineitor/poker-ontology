# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_12p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Ochos con Trece Nueve Siete" ;
    poker:contieneCarta poker:OchoDePsiquico, poker:OchoDeVolador, poker:NueveDeElectrico, poker:TreceDePsiquico, poker:SieteDePlanta .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Doces con Once Nueve Tres" ;
    poker:contieneCarta poker:DoceDeVeneno, poker:DoceDeLucha, poker:OnceDeFuego, poker:NueveDePsiquico, poker:TresDePlanta .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Unos con Nueve Cinco Dos" ;
    poker:contieneCarta poker:UnoDeRoca, poker:UnoDeElectrico, poker:CincoDeNormal, poker:NueveDeTierra, poker:DosDeRoca .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Unos con Diez Siete Tres" ;
    poker:contieneCarta poker:UnoDeElectrico, poker:UnoDeBicho, poker:TresDeElectrico, poker:DiezDeRoca, poker:SieteDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
