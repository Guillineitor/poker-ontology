# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 2. Par
# =============================================================================

@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 2. Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 2. Par." .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano1 a poker:Mano ;
    rdfs:label "Par de Ochos con Nueve Dos Uno" ;
    poker:contieneCarta poker:OchoDeRoca, poker:OchoDePlanta, poker:UnoDeNormal, poker:DosDeFantasma, poker:NueveDePsiquico .

par:Mano2 a poker:Mano ;
    rdfs:label "Par de Doses con Doce Cinco Tres" ;
    poker:contieneCarta poker:DosDePlanta, poker:DosDeSiniestro, poker:CincoDeAgua, poker:DoceDeFuego, poker:TresDeSiniestro .

par:Mano3 a poker:Mano ;
    rdfs:label "Par de Seises con Trece Doce Nueve" ;
    poker:contieneCarta poker:SeisDeTierra, poker:SeisDeAgua, poker:NueveDeVolador, poker:TreceDeAgua, poker:DoceDeTierra .

par:Mano4 a poker:Mano ;
    rdfs:label "Par de Sietes con Nueve Seis Dos" ;
    poker:contieneCarta poker:SieteDeFuego, poker:SieteDeTierra, poker:SeisDeFantasma, poker:NueveDeDragon, poker:DosDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano1 par:Mano2 par:Mano3 par:Mano4 ) .
