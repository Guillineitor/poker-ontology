# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Ocho Siete Seis Uno" ;
    poker:contieneCarta poker:SeisDePlanta, poker:SieteDeBicho, poker:OchoDeAgua, poker:UnoDeDragon, poker:TreceDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Ocho Cinco Cuatro Uno" ;
    poker:contieneCarta poker:UnoDeLucha, poker:CuatroDeHielo, poker:TreceDePlanta, poker:OchoDeRoca, poker:CincoDeNormal .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Ocho Cinco Cuatro Dos" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CincoDePlanta, poker:DosDeLucha, poker:DiezDeRoca, poker:OchoDeSiniestro .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Nueve Seis Cinco" ;
    poker:contieneCarta poker:TreceDeVeneno, poker:NueveDeFuego, poker:SeisDeAgua, poker:CincoDeBicho, poker:DoceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
