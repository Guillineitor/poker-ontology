# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Treces con Siete de Bicho" ;
    poker:contieneCarta poker:TreceDeDragon, poker:TreceDeVolador, poker:TreceDeFantasma, poker:TreceDeVeneno, poker:SieteDeBicho .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Ochos con Cinco de Roca" ;
    poker:contieneCarta poker:OchoDeSiniestro, poker:OchoDeElectrico, poker:OchoDePsiquico, poker:OchoDeFantasma, poker:CincoDeRoca .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Onces con Siete de Bicho" ;
    poker:contieneCarta poker:OnceDePsiquico, poker:OnceDeFuego, poker:OnceDeVolador, poker:OnceDeDragon, poker:SieteDeBicho .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Cincos con Cuatro de Siniestro" ;
    poker:contieneCarta poker:CincoDePlanta, poker:CincoDeHielo, poker:CincoDeAgua, poker:CincoDeElectrico, poker:CuatroDeSiniestro .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
