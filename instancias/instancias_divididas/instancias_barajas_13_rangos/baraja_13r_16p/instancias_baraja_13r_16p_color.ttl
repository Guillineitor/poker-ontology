# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 6. Color
# =============================================================================

@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 6. Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 6. Color." .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano1 a poker:Mano ;
    rdfs:label "Color de Nueve Seis Cinco Tres Dos de Dragon" ;
    poker:contieneCarta poker:NueveDeDragon, poker:CincoDeDragon, poker:TresDeDragon, poker:DosDeDragon, poker:SeisDeDragon .

color:Mano2 a poker:Mano ;
    rdfs:label "Color de Ocho Siete Seis Cuatro Tres de Fuego" ;
    poker:contieneCarta poker:OchoDeFuego, poker:TresDeFuego, poker:SeisDeFuego, poker:SieteDeFuego, poker:CuatroDeFuego .

color:Mano3 a poker:Mano ;
    rdfs:label "Color de Trece Doce Once Cinco Cuatro de Tierra" ;
    poker:contieneCarta poker:CuatroDeTierra, poker:CincoDeTierra, poker:DoceDeTierra, poker:OnceDeTierra, poker:TreceDeTierra .

color:Mano4 a poker:Mano ;
    rdfs:label "Color de Trece Ocho Seis Cinco Uno de Volador" ;
    poker:contieneCarta poker:SeisDeVolador, poker:UnoDeVolador, poker:OchoDeVolador, poker:CincoDeVolador, poker:TreceDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano1 color:Mano2 color:Mano3 color:Mano4 ) .
