# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_16p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_16p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Cuatros con Doce" ;
    poker:contieneCarta poker:TreceDeDragon, poker:TreceDeVeneno, poker:CuatroDeFuego, poker:CuatroDeVeneno, poker:DoceDeVeneno ;
    poker:manoTienePar poker:Trece, poker:Cuatro .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Cuatros y Doses con Uno" ;
    poker:contieneCarta poker:CuatroDeSiniestro, poker:CuatroDeElectrico, poker:DosDeVolador, poker:DosDeTierra, poker:UnoDeRoca ;
    poker:manoTienePar poker:Cuatro, poker:Dos .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Onces y Cuatros con Tres" ;
    poker:contieneCarta poker:OnceDeHielo, poker:OnceDeLucha, poker:CuatroDeFuego, poker:CuatroDePlanta, poker:TresDeElectrico ;
    poker:manoTienePar poker:Once, poker:Cuatro .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Unos con Siete" ;
    poker:contieneCarta poker:UnoDeBicho, poker:UnoDePlanta, poker:TreceDeHielo, poker:TreceDePlanta, poker:SieteDeAgua ;
    poker:manoTienePar poker:Uno, poker:Trece .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
