# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 4. Trío
# =============================================================================

@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/trio>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 4. Trío" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 4. Trío." .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano1 a poker:Mano ;
    rdfs:label "Trío de Treces con Nueve Tres" ;
    poker:contieneCarta poker:TreceDeVolador, poker:TreceDeNormal, poker:TreceDeBicho, poker:TresDeBicho, poker:NueveDePlanta .

trio:Mano2 a poker:Mano ;
    rdfs:label "Trío de Cuatros con Diez Uno" ;
    poker:contieneCarta poker:CuatroDeFuego, poker:CuatroDeBicho, poker:CuatroDeElectrico, poker:UnoDeElectrico, poker:DiezDeAgua .

trio:Mano3 a poker:Mano ;
    rdfs:label "Trío de Unos con Once Dos" ;
    poker:contieneCarta poker:UnoDeBicho, poker:UnoDeVolador, poker:UnoDeFuego, poker:DosDeVeneno, poker:OnceDeFuego .

trio:Mano4 a poker:Mano ;
    rdfs:label "Trío de Treces con Tres Dos" ;
    poker:contieneCarta poker:TreceDeBicho, poker:TreceDeVeneno, poker:TreceDeVolador, poker:TresDePlanta, poker:DosDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano1 trio:Mano2 trio:Mano3 trio:Mano4 ) .
