# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par
# =============================================================================

@prefix doble_par: <http://www.poker-ontology.org/instancias/doble_par#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/doble_par>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 3. Doble Par" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 3. Doble Par." .

# =============================================================================
# 3. Doble Par
# =============================================================================

doble_par:Mano1 a poker:Mano ;
    rdfs:label "Doble Par de Doces y Ochos con Diez" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:OchoDeAgua, poker:DoceDeNormal, poker:DoceDeBicho, poker:DiezDeAgua ;
    poker:manoTienePar poker:Ocho, poker:Doce .

doble_par:Mano2 a poker:Mano ;
    rdfs:label "Doble Par de Treces y Cuatros con Siete" ;
    poker:contieneCarta poker:TreceDeBicho, poker:TreceDeNormal, poker:CuatroDeVeneno, poker:CuatroDeElectrico, poker:SieteDeElectrico ;
    poker:manoTienePar poker:Trece, poker:Cuatro .

doble_par:Mano3 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Treses con Seis" ;
    poker:contieneCarta poker:TresDeVeneno, poker:TresDeNormal, poker:NueveDePlanta, poker:NueveDeBicho, poker:SeisDeVolador ;
    poker:manoTienePar poker:Tres, poker:Nueve .

doble_par:Mano4 a poker:Mano ;
    rdfs:label "Doble Par de Sietes y Treses con Seis" ;
    poker:contieneCarta poker:SieteDePlanta, poker:SieteDeElectrico, poker:TresDeAgua, poker:TresDeNormal, poker:SeisDeVeneno ;
    poker:manoTienePar poker:Siete, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doble_par:Mano1 doble_par:Mano2 doble_par:Mano3 doble_par:Mano4 ) .
