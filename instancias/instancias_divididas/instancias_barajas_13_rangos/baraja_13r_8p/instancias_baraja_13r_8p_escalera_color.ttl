# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color
# =============================================================================

@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/escalera_color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 9. Escalera de Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 9. Escalera de Color." .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano1 a poker:Mano ;
    rdfs:label "Escalera de Color Siete-Ocho-Nueve-Diez-Once de Veneno" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:OchoDeVeneno, poker:NueveDeVeneno, poker:DiezDeVeneno, poker:OnceDeVeneno .

escalera_color:Mano2 a poker:Mano ;
    rdfs:label "Escalera de Color Tres-Cuatro-Cinco-Seis-Siete de Veneno" ;
    poker:contieneCarta poker:TresDeVeneno, poker:CuatroDeVeneno, poker:CincoDeVeneno, poker:SeisDeVeneno, poker:SieteDeVeneno .

escalera_color:Mano3 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Volador" ;
    poker:contieneCarta poker:CincoDeVolador, poker:SeisDeVolador, poker:SieteDeVolador, poker:OchoDeVolador, poker:NueveDeVolador .

escalera_color:Mano4 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Fuego" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeFuego, poker:DiezDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano1 escalera_color:Mano2 escalera_color:Mano3 escalera_color:Mano4 ) .
