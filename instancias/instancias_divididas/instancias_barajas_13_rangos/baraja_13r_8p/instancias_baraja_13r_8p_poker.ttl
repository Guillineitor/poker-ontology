# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 8. Póker
# =============================================================================

@prefix pokerh: <http://www.poker-ontology.org/instancias/pokerh#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/pokerh>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 8. Póker" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 8. Póker." .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano1 a poker:Mano ;
    rdfs:label "Póker de Seises con Uno de Normal" ;
    poker:contieneCarta poker:SeisDeBicho, poker:SeisDeAgua, poker:SeisDeFuego, poker:SeisDeNormal, poker:UnoDeNormal .

pokerh:Mano2 a poker:Mano ;
    rdfs:label "Póker de Ochos con Dos de Electrico" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:OchoDeElectrico, poker:OchoDeNormal, poker:OchoDeBicho, poker:DosDeElectrico .

pokerh:Mano3 a poker:Mano ;
    rdfs:label "Póker de Ochos con Uno de Veneno" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDeNormal, poker:OchoDeVeneno, poker:OchoDeAgua, poker:UnoDeVeneno .

pokerh:Mano4 a poker:Mano ;
    rdfs:label "Póker de Onces con Nueve de Electrico" ;
    poker:contieneCarta poker:OnceDeFuego, poker:OnceDeAgua, poker:OnceDeBicho, poker:OnceDePlanta, poker:NueveDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano1 pokerh:Mano2 pokerh:Mano3 pokerh:Mano4 ) .
