# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Siete Seis Cuatro Dos" ;
    poker:contieneCarta poker:DosDeNormal, poker:CuatroDeNormal, poker:SeisDeBicho, poker:DiezDeElectrico, poker:SieteDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Ocho Siete Cinco Dos" ;
    poker:contieneCarta poker:OnceDePlanta, poker:SieteDeNormal, poker:OchoDePlanta, poker:CincoDePlanta, poker:DosDeNormal .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Ocho con Siete Seis Cuatro Tres" ;
    poker:contieneCarta poker:SieteDeElectrico, poker:SeisDeElectrico, poker:CuatroDeVolador, poker:TresDeBicho, poker:OchoDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Diez Seis Cinco Cuatro" ;
    poker:contieneCarta poker:DiezDeFuego, poker:CuatroDeVeneno, poker:TreceDeFuego, poker:CincoDeNormal, poker:SeisDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
