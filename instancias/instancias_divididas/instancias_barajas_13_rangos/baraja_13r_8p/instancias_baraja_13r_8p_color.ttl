# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 6. Color
# =============================================================================

@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/color>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 6. Color" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 6. Color." .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano1 a poker:Mano ;
    rdfs:label "Color de Once Siete Seis Cinco Tres de Veneno" ;
    poker:contieneCarta poker:CincoDeVeneno, poker:OnceDeVeneno, poker:TresDeVeneno, poker:SeisDeVeneno, poker:SieteDeVeneno .

color:Mano2 a poker:Mano ;
    rdfs:label "Color de Once Diez Nueve Tres Dos de Normal" ;
    poker:contieneCarta poker:DosDeNormal, poker:TresDeNormal, poker:NueveDeNormal, poker:OnceDeNormal, poker:DiezDeNormal .

color:Mano3 a poker:Mano ;
    rdfs:label "Color de Doce Ocho Siete Cuatro Uno de Bicho" ;
    poker:contieneCarta poker:UnoDeBicho, poker:SieteDeBicho, poker:DoceDeBicho, poker:OchoDeBicho, poker:CuatroDeBicho .

color:Mano4 a poker:Mano ;
    rdfs:label "Color de Trece Ocho Siete Cinco Dos de Veneno" ;
    poker:contieneCarta poker:OchoDeVeneno, poker:DosDeVeneno, poker:SieteDeVeneno, poker:TreceDeVeneno, poker:CincoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano1 color:Mano2 color:Mano3 color:Mano4 ) .
