# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_8p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Ochos con Par de Nueves" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:OchoDeAgua, poker:OchoDeFuego, poker:NueveDeBicho, poker:NueveDePlanta ;
    poker:manoTienePar poker:Ocho, poker:Nueve .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Nueves con Par de Unos" ;
    poker:contieneCarta poker:NueveDeFuego, poker:NueveDeBicho, poker:NueveDeAgua, poker:UnoDeVeneno, poker:UnoDeElectrico ;
    poker:manoTienePar poker:Nueve, poker:Uno .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Cuatros con Par de Onces" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CuatroDeNormal, poker:CuatroDeVeneno, poker:OnceDeVeneno, poker:OnceDeElectrico ;
    poker:manoTienePar poker:Cuatro, poker:Once .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Dieces con Par de Unos" ;
    poker:contieneCarta poker:DiezDeVolador, poker:DiezDeFuego, poker:DiezDeVeneno, poker:UnoDePlanta, poker:UnoDeNormal ;
    poker:manoTienePar poker:Diez, poker:Uno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
