# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/carta_alta>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 1. Carta Alta" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 1. Carta Alta." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Ocho Seis Dos Uno" ;
    poker:contieneCarta poker:DosDeFuego, poker:UnoDeFuego, poker:OchoDePlanta, poker:DiezDePlanta, poker:SeisDePlanta .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Diez con Siete Cuatro Tres Uno" ;
    poker:contieneCarta poker:DiezDeFuego, poker:TresDeElectrico, poker:UnoDeAgua, poker:SieteDeElectrico, poker:CuatroDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Once con Diez Siete Cinco Dos" ;
    poker:contieneCarta poker:CincoDePlanta, poker:OnceDeElectrico, poker:DiezDePlanta, poker:SieteDeFuego, poker:DosDeFuego .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Ocho Seis Cuatro Uno" ;
    poker:contieneCarta poker:UnoDePlanta, poker:CuatroDeAgua, poker:SeisDeElectrico, poker:OchoDeAgua, poker:DoceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .
