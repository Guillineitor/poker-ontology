# =============================================================================
# Instancias de manos divididas de Póker Texas Hold'em - 7. Full
# =============================================================================

@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_13r_4p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/full>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_13r_4p> ;
    rdfs:label "Instancias de manos divididas de Póker Texas Hold'em - 7. Full" ;
    rdfs:comment "ABox con 4 manos de prueba del tipo 7. Full." .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano1 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Dieces" ;
    poker:contieneCarta poker:UnoDePlanta, poker:UnoDeAgua, poker:UnoDeFuego, poker:DiezDePlanta, poker:DiezDeAgua ;
    poker:manoTienePar poker:Uno, poker:Diez .

full:Mano2 a poker:Mano ;
    rdfs:label "Full de Trío de Seises con Par de Cincos" ;
    poker:contieneCarta poker:SeisDeFuego, poker:SeisDePlanta, poker:SeisDeAgua, poker:CincoDeElectrico, poker:CincoDeAgua ;
    poker:manoTienePar poker:Seis, poker:Cinco .

full:Mano3 a poker:Mano ;
    rdfs:label "Full de Trío de Unos con Par de Cuatros" ;
    poker:contieneCarta poker:UnoDeAgua, poker:UnoDeFuego, poker:UnoDePlanta, poker:CuatroDeElectrico, poker:CuatroDeFuego ;
    poker:manoTienePar poker:Uno, poker:Cuatro .

full:Mano4 a poker:Mano ;
    rdfs:label "Full de Trío de Treces con Par de Onces" ;
    poker:contieneCarta poker:TreceDeElectrico, poker:TreceDePlanta, poker:TreceDeAgua, poker:OnceDeElectrico, poker:OnceDePlanta ;
    poker:manoTienePar poker:Trece, poker:Once .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano1 full:Mano2 full:Mano3 full:Mano4 ) .
