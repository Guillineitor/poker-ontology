# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_31r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_31r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Treinta con Veintinueve Trece Once Uno" ;
    poker:contieneCarta poker:OnceDeBicho, poker:TreceDeVeneno, poker:UnoDePsiquico, poker:VeintinueveDeLucha, poker:TreintaDeVolador .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticinco con Diecinueve Catorce Siete Cinco" ;
    poker:contieneCarta poker:CatorceDeLucha, poker:SieteDeLucha, poker:VeinticincoDePsiquico, poker:DiecinueveDeElectrico, poker:CincoDeRoca .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintinueve con Quince Doce Diez Dos" ;
    poker:contieneCarta poker:DoceDeVolador, poker:QuinceDePlanta, poker:VeintinueveDeBicho, poker:DiezDeNormal, poker:DosDeTierra .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiocho con Veintitres Veinte Doce Once" ;
    poker:contieneCarta poker:VeinteDeTierra, poker:OnceDeVolador, poker:VeintitresDePlanta, poker:DoceDePsiquico, poker:VeintiochoDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Veintidoses con Treintayuno Treinta Diecisiete" ;
    poker:contieneCarta poker:VeintidosDeLucha, poker:VeintidosDeVolador, poker:TreintaDePsiquico, poker:TreintayunoDePsiquico, poker:DiecisieteDeElectrico .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Sietes con Trece Nueve Seis" ;
    poker:contieneCarta poker:SieteDeTierra, poker:SieteDeVolador, poker:NueveDePlanta, poker:SeisDeLucha, poker:TreceDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintiseises con Veinte Doce Ocho" ;
    poker:contieneCarta poker:VeintiseisDeLucha, poker:VeintiseisDeNormal, poker:OchoDeLucha, poker:DoceDeVeneno, poker:VeinteDeTierra .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veintiochos con Veintiseis Siete Uno" ;
    poker:contieneCarta poker:VeintiochoDeVeneno, poker:VeintiochoDeAgua, poker:SieteDeNormal, poker:UnoDeFuego, poker:VeintiseisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veinticincos y Cincos con Siete" ;
    poker:contieneCarta poker:CincoDeNormal, poker:CincoDePlanta, poker:VeinticincoDeBicho, poker:VeinticincoDeNormal, poker:SieteDeNormal ;
    poker:manoTienePar poker:Cinco, poker:Veinticinco .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Treintayunos y Doces con Trece" ;
    poker:contieneCarta poker:TreintayunoDeFuego, poker:TreintayunoDeLucha, poker:DoceDeTierra, poker:DoceDeBicho, poker:TreceDeAgua ;
    poker:manoTienePar poker:Treintayuno, poker:Doce .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Catorces con Dieciocho" ;
    poker:contieneCarta poker:CatorceDeVeneno, poker:CatorceDeFuego, poker:VeintidosDePsiquico, poker:VeintidosDeVeneno, poker:DieciochoDeLucha ;
    poker:manoTienePar poker:Catorce, poker:Veintidos .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Catorces y Nueves con Doce" ;
    poker:contieneCarta poker:CatorceDeNormal, poker:CatorceDeElectrico, poker:NueveDePlanta, poker:NueveDeNormal, poker:DoceDeElectrico ;
    poker:manoTienePar poker:Catorce, poker:Nueve .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Doses con Veintiseis Veintiuno" ;
    poker:contieneCarta poker:DosDeBicho, poker:DosDeLucha, poker:DosDeElectrico, poker:VeintiseisDeNormal, poker:VeintiunoDeRoca .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Treses con Treinta Nueve" ;
    poker:contieneCarta poker:TresDeTierra, poker:TresDeVolador, poker:TresDePsiquico, poker:TreintaDePlanta, poker:NueveDeNormal .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Treces con Veintitres Diecisiete" ;
    poker:contieneCarta poker:TreceDeLucha, poker:TreceDeVolador, poker:TreceDeRoca, poker:DiecisieteDeVolador, poker:VeintitresDeLucha .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veinticincos con Veintisiete Once" ;
    poker:contieneCarta poker:VeinticincoDeBicho, poker:VeinticincoDeLucha, poker:VeinticincoDeRoca, poker:OnceDeAgua, poker:VeintisieteDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Doce-Trece-Catorce-Quince-Dieciseis" ;
    poker:contieneCarta poker:DoceDeVolador, poker:TreceDePsiquico, poker:CatorceDeNormal, poker:QuinceDePlanta, poker:DieciseisDeRoca .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos" ;
    poker:contieneCarta poker:DieciochoDeLucha, poker:DiecinueveDeVeneno, poker:VeinteDeFuego, poker:VeintiunoDeVeneno, poker:VeintidosDePsiquico .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete" ;
    poker:contieneCarta poker:VeintitresDeVeneno, poker:VeinticuatroDeElectrico, poker:VeinticincoDeVeneno, poker:VeintiseisDePsiquico, poker:VeintisieteDeRoca .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno" ;
    poker:contieneCarta poker:DiecisieteDeLucha, poker:DieciochoDeFuego, poker:DiecinueveDeAgua, poker:VeinteDePsiquico, poker:VeintiunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veintitres Diecisiete Trece Doce Siete de Agua" ;
    poker:contieneCarta poker:TreceDeAgua, poker:SieteDeAgua, poker:DiecisieteDeAgua, poker:VeintitresDeAgua, poker:DoceDeAgua .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Treinta Veintisiete Veintidos Dieciseis Quince de Planta" ;
    poker:contieneCarta poker:TreintaDePlanta, poker:VeintisieteDePlanta, poker:DieciseisDePlanta, poker:QuinceDePlanta, poker:VeintidosDePlanta .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintiocho Veinte Ocho Siete de Tierra" ;
    poker:contieneCarta poker:VeinteDeTierra, poker:SieteDeTierra, poker:VeintiochoDeTierra, poker:OchoDeTierra, poker:VeintinueveDeTierra .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veintinueve Veintiocho Veinticuatro Diecisiete Diez de Eléctrico" ;
    poker:contieneCarta poker:DiecisieteDeElectrico, poker:VeinticuatroDeElectrico, poker:DiezDeElectrico, poker:VeintinueveDeElectrico, poker:VeintiochoDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Diecinueves con Par de Veintinueves" ;
    poker:contieneCarta poker:DiecinueveDeElectrico, poker:DiecinueveDeVeneno, poker:DiecinueveDeRoca, poker:VeintinueveDePlanta, poker:VeintinueveDeAgua ;
    poker:manoTienePar poker:Diecinueve, poker:Veintinueve .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Catorces" ;
    poker:contieneCarta poker:DiecisieteDeVolador, poker:DiecisieteDeBicho, poker:DiecisieteDeAgua, poker:CatorceDeBicho, poker:CatorceDePsiquico ;
    poker:manoTienePar poker:Diecisiete, poker:Catorce .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Treintas con Par de Ochos" ;
    poker:contieneCarta poker:TreintaDeFuego, poker:TreintaDeRoca, poker:TreintaDeVolador, poker:OchoDeVolador, poker:OchoDeRoca ;
    poker:manoTienePar poker:Treinta, poker:Ocho .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Diecinueves con Par de Treces" ;
    poker:contieneCarta poker:DiecinueveDePsiquico, poker:DiecinueveDeAgua, poker:DiecinueveDeLucha, poker:TreceDeVolador, poker:TreceDeElectrico ;
    poker:manoTienePar poker:Diecinueve, poker:Trece .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Nueves con Doce de Lucha" ;
    poker:contieneCarta poker:NueveDeVolador, poker:NueveDePsiquico, poker:NueveDeTierra, poker:NueveDeElectrico, poker:DoceDeLucha .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Doses con Veintiocho de Agua" ;
    poker:contieneCarta poker:DosDeVeneno, poker:DosDeRoca, poker:DosDeFuego, poker:DosDeNormal, poker:VeintiochoDeAgua .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Diecisietes con Uno de Volador" ;
    poker:contieneCarta poker:DiecisieteDeFuego, poker:DiecisieteDeLucha, poker:DiecisieteDePlanta, poker:DiecisieteDeNormal, poker:UnoDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Treces con Siete de Lucha" ;
    poker:contieneCarta poker:TreceDeTierra, poker:TreceDeNormal, poker:TreceDeRoca, poker:TreceDeElectrico, poker:SieteDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Veinticuatro-Veinticinco-Veintiseis-Veintisiete-Veintiocho de Psíquico" ;
    poker:contieneCarta poker:VeinticuatroDePsiquico, poker:VeinticincoDePsiquico, poker:VeintiseisDePsiquico, poker:VeintisieteDePsiquico, poker:VeintiochoDePsiquico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Tierra" ;
    poker:contieneCarta poker:OchoDeTierra, poker:NueveDeTierra, poker:DiezDeTierra, poker:OnceDeTierra, poker:DoceDeTierra .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Cinco-Seis-Siete-Ocho-Nueve de Fuego" ;
    poker:contieneCarta poker:CincoDeFuego, poker:SeisDeFuego, poker:SieteDeFuego, poker:OchoDeFuego, poker:NueveDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Veintitres-Veinticuatro-Veinticinco-Veintiseis-Veintisiete de Roca" ;
    poker:contieneCarta poker:VeintitresDeRoca, poker:VeinticuatroDeRoca, poker:VeinticincoDeRoca, poker:VeintiseisDeRoca, poker:VeintisieteDeRoca .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Roca" ;
    poker:contieneCarta poker:VeintisieteDeRoca, poker:VeintiochoDeRoca, poker:VeintinueveDeRoca, poker:TreintaDeRoca, poker:TreintayunoDeRoca .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Fuego" ;
    poker:contieneCarta poker:VeintisieteDeFuego, poker:VeintiochoDeFuego, poker:VeintinueveDeFuego, poker:TreintaDeFuego, poker:TreintayunoDeFuego .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:VeintisieteDeElectrico, poker:VeintiochoDeElectrico, poker:VeintinueveDeElectrico, poker:TreintaDeElectrico, poker:TreintayunoDeElectrico .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:VeintisieteDeTierra, poker:VeintiochoDeTierra, poker:VeintinueveDeTierra, poker:TreintaDeTierra, poker:TreintayunoDeTierra .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
