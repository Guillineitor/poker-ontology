# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_8p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_8p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Dieciseis con Quince Once Cinco Dos" ;
    poker:contieneCarta poker:DosDeVolador, poker:OnceDeBicho, poker:QuinceDeVolador, poker:CincoDeFuego, poker:DieciseisDeFuego .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veinticuatro con Trece Cinco Tres Dos" ;
    poker:contieneCarta poker:CincoDeBicho, poker:VeinticuatroDeNormal, poker:TresDeVeneno, poker:TreceDeVolador, poker:DosDeElectrico .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Veintiuno Diecisiete Dieciseis Seis" ;
    poker:contieneCarta poker:SeisDeFuego, poker:DieciseisDeElectrico, poker:DiecisieteDeElectrico, poker:VeintitresDePlanta, poker:VeintiunoDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Veintiuno con Veinte Catorce Once Cinco" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:CatorceDeVeneno, poker:VeinteDeAgua, poker:CincoDeNormal, poker:VeintiunoDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Doses con Veinticuatro Once Cinco" ;
    poker:contieneCarta poker:DosDeFuego, poker:DosDeElectrico, poker:VeinticuatroDePlanta, poker:OnceDeElectrico, poker:CincoDeNormal .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Seises con Catorce Doce Cinco" ;
    poker:contieneCarta poker:SeisDeNormal, poker:SeisDeVolador, poker:CincoDeVolador, poker:DoceDePlanta, poker:CatorceDeFuego .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veintes con Veinticuatro Dieciocho Uno" ;
    poker:contieneCarta poker:VeinteDeNormal, poker:VeinteDeFuego, poker:DieciochoDePlanta, poker:UnoDeFuego, poker:VeinticuatroDeFuego .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veintes con Veinticuatro Dieciseis Catorce" ;
    poker:contieneCarta poker:VeinteDeVeneno, poker:VeinteDeAgua, poker:VeinticuatroDeVeneno, poker:CatorceDeVolador, poker:DieciseisDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Nueves con Dieciseis" ;
    poker:contieneCarta poker:VeintidosDeNormal, poker:VeintidosDeVeneno, poker:NueveDeVolador, poker:NueveDePlanta, poker:DieciseisDeAgua ;
    poker:manoTienePar poker:Veintidos, poker:Nueve .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Dieciochos y Dieciseises con Seis" ;
    poker:contieneCarta poker:DieciseisDeVeneno, poker:DieciseisDePlanta, poker:DieciochoDeElectrico, poker:DieciochoDeVolador, poker:SeisDeNormal ;
    poker:manoTienePar poker:Dieciseis, poker:Dieciocho .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Veintitreses y Quinces con Veinticuatro" ;
    poker:contieneCarta poker:QuinceDeElectrico, poker:QuinceDeAgua, poker:VeintitresDeBicho, poker:VeintitresDeFuego, poker:VeinticuatroDePlanta ;
    poker:manoTienePar poker:Quince, poker:Veintitres .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veinticuatros y Treses con Seis" ;
    poker:contieneCarta poker:VeinticuatroDeNormal, poker:VeinticuatroDeBicho, poker:TresDeAgua, poker:TresDeBicho, poker:SeisDeBicho ;
    poker:manoTienePar poker:Veinticuatro, poker:Tres .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Quince Siete" ;
    poker:contieneCarta poker:DieciochoDeBicho, poker:DieciochoDeNormal, poker:DieciochoDeVeneno, poker:SieteDeAgua, poker:QuinceDeFuego .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Veintiunos con Trece Diez" ;
    poker:contieneCarta poker:VeintiunoDeBicho, poker:VeintiunoDeFuego, poker:VeintiunoDeAgua, poker:DiezDeElectrico, poker:TreceDeElectrico .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Dieciochos con Veintiuno Siete" ;
    poker:contieneCarta poker:DieciochoDeAgua, poker:DieciochoDeNormal, poker:DieciochoDeVolador, poker:VeintiunoDeFuego, poker:SieteDePlanta .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veinticincos con Dieciseis Diez" ;
    poker:contieneCarta poker:VeinticincoDeElectrico, poker:VeinticincoDeNormal, poker:VeinticincoDeFuego, poker:DieciseisDeVolador, poker:DiezDeElectrico .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dos-Tres-Cuatro-Cinco-Seis" ;
    poker:contieneCarta poker:DosDeVeneno, poker:TresDeElectrico, poker:CuatroDePlanta, poker:CincoDeFuego, poker:SeisDeBicho .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Veinte-Veintiuno-Veintidos-Veintitres-Veinticuatro" ;
    poker:contieneCarta poker:VeinteDeAgua, poker:VeintiunoDeVolador, poker:VeintidosDeBicho, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeVolador, poker:CincoDeBicho, poker:SeisDeFuego, poker:SieteDeVeneno, poker:OchoDeVeneno .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve" ;
    poker:contieneCarta poker:QuinceDeVeneno, poker:DieciseisDeBicho, poker:DiecisieteDeVeneno, poker:DieciochoDeFuego, poker:DiecinueveDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Veinticinco Quince Catorce Diez Seis de Veneno" ;
    poker:contieneCarta poker:VeinticincoDeVeneno, poker:QuinceDeVeneno, poker:CatorceDeVeneno, poker:SeisDeVeneno, poker:DiezDeVeneno .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Dieciocho Trece Once Nueve Seis de Fuego" ;
    poker:contieneCarta poker:TreceDeFuego, poker:SeisDeFuego, poker:NueveDeFuego, poker:OnceDeFuego, poker:DieciochoDeFuego .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veintitres Veintidos Dieciseis Doce Cuatro de Bicho" ;
    poker:contieneCarta poker:CuatroDeBicho, poker:DoceDeBicho, poker:VeintitresDeBicho, poker:VeintidosDeBicho, poker:DieciseisDeBicho .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veinticinco Nueve Siete Seis Tres de Bicho" ;
    poker:contieneCarta poker:NueveDeBicho, poker:VeinticincoDeBicho, poker:TresDeBicho, poker:SeisDeBicho, poker:SieteDeBicho .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Veintidoses con Par de Dieciseises" ;
    poker:contieneCarta poker:VeintidosDeVeneno, poker:VeintidosDeBicho, poker:VeintidosDePlanta, poker:DieciseisDePlanta, poker:DieciseisDeVeneno ;
    poker:manoTienePar poker:Veintidos, poker:Dieciseis .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Onces con Par de Catorces" ;
    poker:contieneCarta poker:OnceDeElectrico, poker:OnceDeVeneno, poker:OnceDePlanta, poker:CatorceDeVeneno, poker:CatorceDeVolador ;
    poker:manoTienePar poker:Once, poker:Catorce .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Cincos" ;
    poker:contieneCarta poker:CatorceDeElectrico, poker:CatorceDeNormal, poker:CatorceDeVolador, poker:CincoDeFuego, poker:CincoDeElectrico ;
    poker:manoTienePar poker:Catorce, poker:Cinco .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Dieciochos con Par de Quinces" ;
    poker:contieneCarta poker:DieciochoDeFuego, poker:DieciochoDeAgua, poker:DieciochoDePlanta, poker:QuinceDeFuego, poker:QuinceDeNormal ;
    poker:manoTienePar poker:Dieciocho, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Veintitreses con Siete de Planta" ;
    poker:contieneCarta poker:VeintitresDeVolador, poker:VeintitresDeBicho, poker:VeintitresDeFuego, poker:VeintitresDePlanta, poker:SieteDePlanta .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Veintes con Veinticinco de Veneno" ;
    poker:contieneCarta poker:VeinteDeAgua, poker:VeinteDeFuego, poker:VeinteDePlanta, poker:VeinteDeElectrico, poker:VeinticincoDeVeneno .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Cuatros con Dieciseis de Volador" ;
    poker:contieneCarta poker:CuatroDePlanta, poker:CuatroDeVolador, poker:CuatroDeElectrico, poker:CuatroDeNormal, poker:DieciseisDeVolador .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Doces con Ocho de Veneno" ;
    poker:contieneCarta poker:DoceDeAgua, poker:DoceDeElectrico, poker:DoceDeFuego, poker:DoceDeNormal, poker:OchoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Agua" ;
    poker:contieneCarta poker:OchoDeAgua, poker:NueveDeAgua, poker:DiezDeAgua, poker:OnceDeAgua, poker:DoceDeAgua .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Doce-Trece-Catorce-Quince-Dieciseis de Fuego" ;
    poker:contieneCarta poker:DoceDeFuego, poker:TreceDeFuego, poker:CatorceDeFuego, poker:QuinceDeFuego, poker:DieciseisDeFuego .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Diecisiete-Dieciocho-Diecinueve-Veinte-Veintiuno de Fuego" ;
    poker:contieneCarta poker:DiecisieteDeFuego, poker:DieciochoDeFuego, poker:DiecinueveDeFuego, poker:VeinteDeFuego, poker:VeintiunoDeFuego .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Quince-Dieciseis-Diecisiete-Dieciocho-Diecinueve de Normal" ;
    poker:contieneCarta poker:QuinceDeNormal, poker:DieciseisDeNormal, poker:DiecisieteDeNormal, poker:DieciochoDeNormal, poker:DiecinueveDeNormal .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Eléctrico" ;
    poker:contieneCarta poker:VeintiunoDeElectrico, poker:VeintidosDeElectrico, poker:VeintitresDeElectrico, poker:VeinticuatroDeElectrico, poker:VeinticincoDeElectrico .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Planta" ;
    poker:contieneCarta poker:VeintiunoDePlanta, poker:VeintidosDePlanta, poker:VeintitresDePlanta, poker:VeinticuatroDePlanta, poker:VeinticincoDePlanta .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Volador" ;
    poker:contieneCarta poker:VeintiunoDeVolador, poker:VeintidosDeVolador, poker:VeintitresDeVolador, poker:VeinticuatroDeVolador, poker:VeinticincoDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
