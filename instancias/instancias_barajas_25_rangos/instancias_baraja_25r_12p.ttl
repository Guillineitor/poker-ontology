# =============================================================================
# Instancias de manos de Póker Texas Hold'em
# =============================================================================

@prefix carta_alta: <http://www.poker-ontology.org/instancias/carta_alta#> .
@prefix par: <http://www.poker-ontology.org/instancias/par#> .
@prefix doblepar: <http://www.poker-ontology.org/instancias/doblepar#> .
@prefix trio: <http://www.poker-ontology.org/instancias/trio#> .
@prefix escalera: <http://www.poker-ontology.org/instancias/escalera#> .
@prefix color: <http://www.poker-ontology.org/instancias/color#> .
@prefix full: <http://www.poker-ontology.org/instancias/full#> .
@prefix pokerh: <http://www.poker-ontology.org/instancias/poker#> .
@prefix escalera_color: <http://www.poker-ontology.org/instancias/escalera_color#> .
@prefix escalera_real: <http://www.poker-ontology.org/instancias/escalera_real#> .
@prefix poker: <http://www.ontologia-baraja.org/baraja_25r_12p#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.poker-ontology.org/instancias/todas>
    a owl:Ontology ;
    owl:imports <http://www.ontologia-baraja.org/baraja_25r_12p> ;
    rdfs:label "Instancias de manos de Póker Texas Hold'em" ;
    rdfs:comment "ABox unificado con 40 manos de prueba, 4 por cada uno de los 10 tipos de manos de Póker Texas Hold'em." .

# =============================================================================
# 1. Carta Alta
# =============================================================================

carta_alta:Mano1 a poker:Mano ;
    rdfs:label "Carta Alta de Veintidos con Dieciocho Once Cinco Tres" ;
    poker:contieneCarta poker:DieciochoDeLucha, poker:CincoDeFuego, poker:TresDeLucha, poker:OnceDePlanta, poker:VeintidosDeFuego .

carta_alta:Mano2 a poker:Mano ;
    rdfs:label "Carta Alta de Veintitres con Veintidos Veintiuno Veinte Once" ;
    poker:contieneCarta poker:VeintitresDeElectrico, poker:OnceDePlanta, poker:VeintiunoDeAgua, poker:VeintidosDeNormal, poker:VeinteDeAgua .

carta_alta:Mano3 a poker:Mano ;
    rdfs:label "Carta Alta de Trece con Doce Siete Cinco Dos" ;
    poker:contieneCarta poker:DoceDeAgua, poker:SieteDePsiquico, poker:CincoDeElectrico, poker:TreceDePlanta, poker:DosDeBicho .

carta_alta:Mano4 a poker:Mano ;
    rdfs:label "Carta Alta de Doce con Nueve Ocho Seis Dos" ;
    poker:contieneCarta poker:DoceDeRoca, poker:OchoDeVolador, poker:NueveDeVeneno, poker:SeisDeBicho, poker:DosDeLucha .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( carta_alta:Mano1 carta_alta:Mano2 carta_alta:Mano3 carta_alta:Mano4 ) .

# =============================================================================
# 2. Par
# =============================================================================

par:Mano5 a poker:Mano ;
    rdfs:label "Par de Unos con Nueve Siete Cinco" ;
    poker:contieneCarta poker:UnoDePsiquico, poker:UnoDeRoca, poker:SieteDeRoca, poker:NueveDeRoca, poker:CincoDeNormal .

par:Mano6 a poker:Mano ;
    rdfs:label "Par de Onces con Veinticinco Catorce Diez" ;
    poker:contieneCarta poker:OnceDeVeneno, poker:OnceDeFuego, poker:VeinticincoDeAgua, poker:DiezDePsiquico, poker:CatorceDeAgua .

par:Mano7 a poker:Mano ;
    rdfs:label "Par de Veinticincos con Veintitres Doce Once" ;
    poker:contieneCarta poker:VeinticincoDeRoca, poker:VeinticincoDeFuego, poker:VeintitresDePsiquico, poker:DoceDeVolador, poker:OnceDeVolador .

par:Mano8 a poker:Mano ;
    rdfs:label "Par de Veintiunos con Veinticuatro Veinte Seis" ;
    poker:contieneCarta poker:VeintiunoDeNormal, poker:VeintiunoDeRoca, poker:VeinticuatroDeAgua, poker:VeinteDeBicho, poker:SeisDeVolador .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( par:Mano5 par:Mano6 par:Mano7 par:Mano8 ) .

# =============================================================================
# 3. Doble Par
# =============================================================================

doblepar:Mano9 a poker:Mano ;
    rdfs:label "Doble Par de Nueves y Treses con Ocho" ;
    poker:contieneCarta poker:NueveDeVolador, poker:NueveDeRoca, poker:TresDePsiquico, poker:TresDeNormal, poker:OchoDeBicho ;
    poker:manoTienePar poker:Nueve, poker:Tres .

doblepar:Mano10 a poker:Mano ;
    rdfs:label "Doble Par de Veinticincos y Diecisietes con Veinticuatro" ;
    poker:contieneCarta poker:DiecisieteDeVeneno, poker:DiecisieteDeTierra, poker:VeinticincoDeVeneno, poker:VeinticincoDeNormal, poker:VeinticuatroDeBicho ;
    poker:manoTienePar poker:Diecisiete, poker:Veinticinco .

doblepar:Mano11 a poker:Mano ;
    rdfs:label "Doble Par de Diecinueves y Treces con Siete" ;
    poker:contieneCarta poker:TreceDeFuego, poker:TreceDeAgua, poker:DiecinueveDeElectrico, poker:DiecinueveDeBicho, poker:SieteDeNormal ;
    poker:manoTienePar poker:Trece, poker:Diecinueve .

doblepar:Mano12 a poker:Mano ;
    rdfs:label "Doble Par de Veintidoses y Seises con Diecisiete" ;
    poker:contieneCarta poker:SeisDeRoca, poker:SeisDeTierra, poker:VeintidosDeVolador, poker:VeintidosDeTierra, poker:DiecisieteDeRoca ;
    poker:manoTienePar poker:Seis, poker:Veintidos .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( doblepar:Mano9 doblepar:Mano10 doblepar:Mano11 doblepar:Mano12 ) .

# =============================================================================
# 4. Trío
# =============================================================================

trio:Mano13 a poker:Mano ;
    rdfs:label "Trío de Quinces con Diecinueve Once" ;
    poker:contieneCarta poker:QuinceDeVeneno, poker:QuinceDeRoca, poker:QuinceDeAgua, poker:DiecinueveDeElectrico, poker:OnceDeVolador .

trio:Mano14 a poker:Mano ;
    rdfs:label "Trío de Cincos con Veintitres Diecisiete" ;
    poker:contieneCarta poker:CincoDeElectrico, poker:CincoDeVolador, poker:CincoDeNormal, poker:VeintitresDeVeneno, poker:DiecisieteDeVeneno .

trio:Mano15 a poker:Mano ;
    rdfs:label "Trío de Nueves con Veinticinco Seis" ;
    poker:contieneCarta poker:NueveDeVeneno, poker:NueveDeFuego, poker:NueveDeRoca, poker:VeinticincoDeAgua, poker:SeisDePlanta .

trio:Mano16 a poker:Mano ;
    rdfs:label "Trío de Veintidoses con Siete Uno" ;
    poker:contieneCarta poker:VeintidosDeVolador, poker:VeintidosDeRoca, poker:VeintidosDeAgua, poker:UnoDeBicho, poker:SieteDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( trio:Mano13 trio:Mano14 trio:Mano15 trio:Mano16 ) .

# =============================================================================
# 5. Escalera
# =============================================================================

escalera:Mano17 a poker:Mano ;
    rdfs:label "Escalera de Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos" ;
    poker:contieneCarta poker:DieciochoDeNormal, poker:DiecinueveDePsiquico, poker:VeinteDeVeneno, poker:VeintiunoDeTierra, poker:VeintidosDeLucha .

escalera:Mano18 a poker:Mano ;
    rdfs:label "Escalera de Once-Doce-Trece-Catorce-Quince" ;
    poker:contieneCarta poker:OnceDeTierra, poker:DoceDeElectrico, poker:TreceDeNormal, poker:CatorceDeVeneno, poker:QuinceDeNormal .

escalera:Mano19 a poker:Mano ;
    rdfs:label "Escalera de Cuatro-Cinco-Seis-Siete-Ocho" ;
    poker:contieneCarta poker:CuatroDeNormal, poker:CincoDeVolador, poker:SeisDeElectrico, poker:SieteDePlanta, poker:OchoDeNormal .

escalera:Mano20 a poker:Mano ;
    rdfs:label "Escalera de Siete-Ocho-Nueve-Diez-Once" ;
    poker:contieneCarta poker:SieteDeVeneno, poker:OchoDePlanta, poker:NueveDePlanta, poker:DiezDeVolador, poker:OnceDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera:Mano17 escalera:Mano18 escalera:Mano19 escalera:Mano20 ) .

# =============================================================================
# 6. Color
# =============================================================================

color:Mano21 a poker:Mano ;
    rdfs:label "Color de Diecisiete Once Diez Tres Uno de Planta" ;
    poker:contieneCarta poker:DiezDePlanta, poker:UnoDePlanta, poker:DiecisieteDePlanta, poker:TresDePlanta, poker:OnceDePlanta .

color:Mano22 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Dieciseis Quince Catorce Cuatro de Agua" ;
    poker:contieneCarta poker:DieciseisDeAgua, poker:CuatroDeAgua, poker:VeinticuatroDeAgua, poker:CatorceDeAgua, poker:QuinceDeAgua .

color:Mano23 a poker:Mano ;
    rdfs:label "Color de Veinte Quince Catorce Doce Dos de Roca" ;
    poker:contieneCarta poker:DoceDeRoca, poker:CatorceDeRoca, poker:VeinteDeRoca, poker:QuinceDeRoca, poker:DosDeRoca .

color:Mano24 a poker:Mano ;
    rdfs:label "Color de Veinticuatro Veintidos Diecisiete Trece Once de Fuego" ;
    poker:contieneCarta poker:OnceDeFuego, poker:DiecisieteDeFuego, poker:TreceDeFuego, poker:VeintidosDeFuego, poker:VeinticuatroDeFuego .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( color:Mano21 color:Mano22 color:Mano23 color:Mano24 ) .

# =============================================================================
# 7. Full
# =============================================================================

full:Mano25 a poker:Mano ;
    rdfs:label "Full de Trío de Catorces con Par de Veintidoses" ;
    poker:contieneCarta poker:CatorceDeVeneno, poker:CatorceDeTierra, poker:CatorceDeElectrico, poker:VeintidosDeBicho, poker:VeintidosDeLucha ;
    poker:manoTienePar poker:Catorce, poker:Veintidos .

full:Mano26 a poker:Mano ;
    rdfs:label "Full de Trío de Treses con Par de Veintitreses" ;
    poker:contieneCarta poker:TresDePsiquico, poker:TresDeFuego, poker:TresDeNormal, poker:VeintitresDePsiquico, poker:VeintitresDeNormal ;
    poker:manoTienePar poker:Tres, poker:Veintitres .

full:Mano27 a poker:Mano ;
    rdfs:label "Full de Trío de Cincos con Par de Veintidoses" ;
    poker:contieneCarta poker:CincoDeRoca, poker:CincoDeAgua, poker:CincoDeBicho, poker:VeintidosDeVeneno, poker:VeintidosDeAgua ;
    poker:manoTienePar poker:Cinco, poker:Veintidos .

full:Mano28 a poker:Mano ;
    rdfs:label "Full de Trío de Diecisietes con Par de Quinces" ;
    poker:contieneCarta poker:DiecisieteDeBicho, poker:DiecisieteDeAgua, poker:DiecisieteDeTierra, poker:QuinceDeElectrico, poker:QuinceDeTierra ;
    poker:manoTienePar poker:Diecisiete, poker:Quince .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( full:Mano25 full:Mano26 full:Mano27 full:Mano28 ) .

# =============================================================================
# 8. Póker
# =============================================================================

pokerh:Mano29 a poker:Mano ;
    rdfs:label "Póker de Quinces con Veintidos de Veneno" ;
    poker:contieneCarta poker:QuinceDeFuego, poker:QuinceDeRoca, poker:QuinceDeElectrico, poker:QuinceDeNormal, poker:VeintidosDeVeneno .

pokerh:Mano30 a poker:Mano ;
    rdfs:label "Póker de Diecinueves con Veintidos de Bicho" ;
    poker:contieneCarta poker:DiecinueveDeNormal, poker:DiecinueveDeRoca, poker:DiecinueveDeFuego, poker:DiecinueveDeBicho, poker:VeintidosDeBicho .

pokerh:Mano31 a poker:Mano ;
    rdfs:label "Póker de Unos con Siete de Lucha" ;
    poker:contieneCarta poker:UnoDeVolador, poker:UnoDeNormal, poker:UnoDePlanta, poker:UnoDeLucha, poker:SieteDeLucha .

pokerh:Mano32 a poker:Mano ;
    rdfs:label "Póker de Catorces con Seis de Planta" ;
    poker:contieneCarta poker:CatorceDeTierra, poker:CatorceDeNormal, poker:CatorceDeFuego, poker:CatorceDeElectrico, poker:SeisDePlanta .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( pokerh:Mano29 pokerh:Mano30 pokerh:Mano31 pokerh:Mano32 ) .

# =============================================================================
# 9. Escalera de Color
# =============================================================================

escalera_color:Mano33 a poker:Mano ;
    rdfs:label "Escalera de Color Ocho-Nueve-Diez-Once-Doce de Eléctrico" ;
    poker:contieneCarta poker:OchoDeElectrico, poker:NueveDeElectrico, poker:DiezDeElectrico, poker:OnceDeElectrico, poker:DoceDeElectrico .

escalera_color:Mano34 a poker:Mano ;
    rdfs:label "Escalera de Color Seis-Siete-Ocho-Nueve-Diez de Veneno" ;
    poker:contieneCarta poker:SeisDeVeneno, poker:SieteDeVeneno, poker:OchoDeVeneno, poker:NueveDeVeneno, poker:DiezDeVeneno .

escalera_color:Mano35 a poker:Mano ;
    rdfs:label "Escalera de Color Dieciocho-Diecinueve-Veinte-Veintiuno-Veintidos de Lucha" ;
    poker:contieneCarta poker:DieciochoDeLucha, poker:DiecinueveDeLucha, poker:VeinteDeLucha, poker:VeintiunoDeLucha, poker:VeintidosDeLucha .

escalera_color:Mano36 a poker:Mano ;
    rdfs:label "Escalera de Color Once-Doce-Trece-Catorce-Quince de Agua" ;
    poker:contieneCarta poker:OnceDeAgua, poker:DoceDeAgua, poker:TreceDeAgua, poker:CatorceDeAgua, poker:QuinceDeAgua .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_color:Mano33 escalera_color:Mano34 escalera_color:Mano35 escalera_color:Mano36 ) .

# =============================================================================
# 10. Escalera Real
# =============================================================================

escalera_real:Mano37 a poker:Mano ;
    rdfs:label "Escalera Real de Tierra" ;
    poker:contieneCarta poker:VeintiunoDeTierra, poker:VeintidosDeTierra, poker:VeintitresDeTierra, poker:VeinticuatroDeTierra, poker:VeinticincoDeTierra .

escalera_real:Mano38 a poker:Mano ;
    rdfs:label "Escalera Real de Agua" ;
    poker:contieneCarta poker:VeintiunoDeAgua, poker:VeintidosDeAgua, poker:VeintitresDeAgua, poker:VeinticuatroDeAgua, poker:VeinticincoDeAgua .

escalera_real:Mano39 a poker:Mano ;
    rdfs:label "Escalera Real de Lucha" ;
    poker:contieneCarta poker:VeintiunoDeLucha, poker:VeintidosDeLucha, poker:VeintitresDeLucha, poker:VeinticuatroDeLucha, poker:VeinticincoDeLucha .

escalera_real:Mano40 a poker:Mano ;
    rdfs:label "Escalera Real de Veneno" ;
    poker:contieneCarta poker:VeintiunoDeVeneno, poker:VeintidosDeVeneno, poker:VeintitresDeVeneno, poker:VeinticuatroDeVeneno, poker:VeinticincoDeVeneno .

# Unicidad de Instancias
[] a owl:AllDifferent ;
    owl:distinctMembers ( escalera_real:Mano37 escalera_real:Mano38 escalera_real:Mano39 escalera_real:Mano40 ) .
